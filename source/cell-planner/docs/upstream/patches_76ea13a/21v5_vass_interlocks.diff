+    assert len(t_b) == 1                                   # one plain goal, never re-timed
+    # a releases at 0.9 + guard of its 1.5 s leg (~0.95 s after its dispatch): b left after that
+    t_a = [d[0] for d in rt.t_disp if d[1] == "a"][0]
+    assert t_b[0] - t_a > 0.9
