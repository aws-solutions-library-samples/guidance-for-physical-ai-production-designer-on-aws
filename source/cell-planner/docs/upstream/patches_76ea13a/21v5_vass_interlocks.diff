@@ -0,0 +1,419 @@
+"""Path-preserving re-timing for interlocked legs: stop smoothly before a zone, resume on the grant.
+
+An interlock never changes WHERE a robot goes, only WHEN: the commanded motion is
+always ``q(t) = C_leg(tau(t))`` with a monotone path clock ``tau(t)`` and the leg's
+own smooth command ``C_leg``: the C2 curve through the leg's knots that
+``utils.fjt_trajectory`` gives the plain goal (patch 20), i.e. exactly what
+joint_trajectory_controller executes when the leg runs without an interlock stop.
+The knots are passed exactly, so every static check the plan passed at its knots
+still holds there, and only the robot-robot timing changes, which the zones protect.
+
+``Profile`` is that clock: cosine ramps of the path rate (C1 rate, bounded rate
+change ``pi * r_nom / (2 * T_stop)``), a cruise at the nominal rate, and a ramp to
+rest that ends EXACTLY at the limit (the stop point of the first zone not yet
+granted). ``sample`` turns a profile into a dispatchable trajectory on a UNIFORM
+time grid (``dt``) with the exact derivatives of ``C_leg(tau(t))``:
+positions C(tau), velocities C'(tau) r, accelerations C''(tau) r^2 + C'(tau) r'.
+The robot agent forwards them unchanged (``_build_fjt_goal_exact``), so the JTC's
+quintic segments reproduce the re-timed command and its acceleration stays at the
+re-timing's own (round-3 verification: mixing 20 ms ramp points with the mapped
+knots gave spacings down to 1 ms, and the spline / Hermite through them rang to
+2-4 a_max on brake, resume and in-motion goals). A replacement goal starts from the
+running goal's exact state on the same curve (same position and velocity).
+``sample_polyline`` is the old knot-mapping sampler (reference only).
+``LegPath.project_cmd`` turns measured joints back into a path position on that
+smooth command (the curve the arm follows; ``LegPath.project`` is the polyline
+version, kept for reference and the path-deviation checks), for the entry /
+release checks and for splicing a replacement goal; ``LegPath.cmd_q`` is the
+commanded position the tracking error is measured against.
+
+numpy only (+ utils.fjt_trajectory).
+"""
+from __future__ import annotations
+
+import math
+from typing import Optional
+
+import numpy as np
+
+CMD_PROJECT_STEP_S = 0.002       # LegPath.project_cmd: dense sampling of the smooth command (leg seconds)
+
+
+class LegPath:
+    """One leg's joint polyline on its own clock (``time_s`` of the trajectory, before velocity_scale)."""
+
+    def __init__(self, traj: list):
+        self.t = np.array([float(p["time_s"]) for p in traj], float)
+        self.Q = np.array([list(p["positions"])[:6] for p in traj], float)
+        if len(self.t) == 1:
+            self.t = np.array([0.0, max(self.t[0], 1e-6)])
+            self.Q = np.vstack([self.Q, self.Q])
+        self.t0 = float(self.t[0])
+        self.t_end = float(self.t[-1])
+        self._cmd = None
+
+    # ── the leg's smooth command (what the plain goal executes) ──
+    def _command(self):
+        """(t, Q, V, A) of the plain goal's points on the leg's own clock: ``utils.fjt_trajectory.with_derivatives``
+        of the dispatched points (positions + time_s, as the executor sends a plain leg)."""
+        if self._cmd is None:
+            from utils.fjt_trajectory import with_derivatives
+            pts = [{"positions": [float(x) for x in q], "time_s": float(t)} for t, q in zip(self.t, self.Q)]
+            wd = with_derivatives(pts, n_joints=self.Q.shape[1])
+            t = np.array([p["time_s"] for p in wd], float)
+            Q = np.array([p["positions"] for p in wd], float)
+            V = np.array([p["velocities"] for p in wd], float)
+            A = np.array([p["accelerations"] for p in wd], float)
+            self._cmd = (t, Q, V, A)
+        return self._cmd
+
+    def cmd_eval(self, tau):
+        """(Q, Qd, Qdd) of the smooth command at leg times ``tau`` (arrays (n, dof)): the JTC quintic segments
+        through the plain goal's points; held (at rest) outside [t0, t_end]."""
+        t, Q, V, A = self._command()
+        tau = np.atleast_1d(np.asarray(tau, float))
+        n, dof = len(tau), Q.shape[1]
+        if len(t) < 2:
+            return np.repeat(Q[:1], n, 0), np.zeros((n, dof)), np.zeros((n, dof))
+        i = np.clip(np.searchsorted(t, tau, side="right") - 1, 0, len(t) - 2)
+        T = np.maximum(t[i + 1] - t[i], 1e-12)[:, None]
+        x = np.clip(tau - t[i], 0.0, None)[:, None]
+        x = np.minimum(x, T)
+        p0, p1, v0, v1, a0, a1 = Q[i], Q[i + 1], V[i], V[i + 1], A[i], A[i + 1]
+        c3 = (-20 * p0 + 20 * p1 - 3 * a0 * T ** 2 + a1 * T ** 2 - 12 * v0 * T - 8 * v1 * T) / (2 * T ** 3)
+        c4 = (30 * p0 - 30 * p1 + 3 * a0 * T ** 2 - 2 * a1 * T ** 2 + 16 * v0 * T + 14 * v1 * T) / (2 * T ** 4)
+        c5 = (-12 * p0 + 12 * p1 - a0 * T ** 2 + a1 * T ** 2 - 6 * v0 * T - 6 * v1 * T) / (2 * T ** 5)
+        q = p0 + x * (v0 + x * (0.5 * a0 + x * (c3 + x * (c4 + x * c5))))
+        qd = v0 + x * (a0 + x * (3 * c3 + x * (4 * c4 + x * 5 * c5)))
+        qdd = a0 + x * (6 * c3 + x * (12 * c4 + x * 20 * c5))
+        zero = (T[:, 0] <= 1e-12)
+        out = (tau <= t[0]) | (tau >= t[-1]) | zero
+        if out.any():
+            j = np.where(tau <= t[0], 0, np.where(tau >= t[-1], len(t) - 1, i + 1))[out]
+            q[out], qd[out], qdd[out] = Q[j], 0.0, 0.0
+        return q, qd, qdd
+
+    def cmd_q(self, tau) -> np.ndarray:
+        """Commanded position of the smooth command at leg time ``tau`` ((dof,))."""
+        return self.cmd_eval([float(tau)])[0][0]
+
+    def _cmd_dense(self, step: float = CMD_PROJECT_STEP_S):
+        """(tau, Q) of the smooth command at every knot and on a uniform grid of <= ``step`` leg seconds (cached)."""
+        c = self.__dict__.get("_dense")
+        if c is None or c[0] != step:
+            n = max(2, int(math.ceil((self.t_end - self.t0) / step)) + 1)
+            tau = np.union1d(np.linspace(self.t0, self.t_end, n), self.t)
+            c = (step, tau, self.cmd_eval(tau)[0])
+            self.__dict__["_dense"] = c
+        return c[1], c[2]
+
+    def project_cmd(self, q, lo: float, hi: float) -> "tuple[float, float]":
+        """Path position in [lo, hi] whose SMOOTH-COMMAND point C(tau) is closest to joint vector ``q`` (max-norm, on
+        the chords of a dense sampling of C) and that error (rad).
+
+        The arm follows C (the plain goal's curve under patch 20 and every re-timed goal of 21 v2), not the
+        polyline: between knots C is up to ~1 mrad off the polyline, so the POLYLINE projection of an arm that came
+        to rest exactly at a stop point C(lim) is short of ``lim`` at 20-35 % of the stop points of the U3 + v4
+        welding_cell_2t plans (round 4), and progress measured that way never reached the limit (stall).
+        Ties go to the later position (dwell / repeated knots: the arm is credited with the end of the dwell)."""
+        q = np.asarray(q, float)[: self.Q.shape[1]]
+        lo, hi = max(self.t0, float(lo)), min(self.t_end, float(hi))
+        if hi < lo:
+            hi = lo
+        tau, Q = self._cmd_dense()
+        i0 = max(0, int(np.searchsorted(tau, lo, "right")) - 1)
+        i1 = min(len(tau) - 1, int(np.searchsorted(tau, hi, "left")))
+        if i1 <= i0:
+            i1 = min(len(tau) - 1, i0 + 1)
+        A, B = Q[i0:i1], Q[i0 + 1:i1 + 1]
+        ta, tb = tau[i0:i1], tau[i0 + 1:i1 + 1]
+        if len(A) == 0:
+            ref = self.cmd_q(lo)
+            return lo, float(np.max(np.abs(_wrap(q - ref))))
+        D = B - A
+        dd = (D * D).sum(1)
+        u = np.where(dd > 1e-18, ((_wrap(q[None] - A)) * D).sum(1) / np.maximum(dd, 1e-18), 1.0).clip(0.0, 1.0)
+        t = (ta + u * (tb - ta)).clip(lo, hi)
+        # the chord point at the clipped position (u recomputed on the clipped tau)
+        uu = np.where(tb - ta > 1e-15, (t - ta) / np.maximum(tb - ta, 1e-15), 1.0).clip(0.0, 1.0)
+        P = A + uu[:, None] * D
+        err = np.abs(_wrap(q[None] - P)).max(1)
+        m = float(err.min())
+        j = int(np.nonzero(err <= m + 1e-12)[0].max())
+        return float(t[j]), float(err[j])
+
+    def q_at(self, tau) -> np.ndarray:
+        tau = np.atleast_1d(np.asarray(tau, float))
+        out = np.empty((len(tau), self.Q.shape[1]))
+        for j in range(self.Q.shape[1]):
+            out[:, j] = np.interp(tau, self.t, self.Q[:, j])
+        return out
+
+    def slope(self, tau: float) -> np.ndarray:
+        """dQ/dtau at ``tau`` (a knot: the mean of its two segments)."""
+        t = self.t
+        if len(t) < 2:
+            return np.zeros(self.Q.shape[1])
+        i = int(np.clip(np.searchsorted(t, tau, "right") - 1, 0, len(t) - 2))
+
+        def seg(j):
+            h = t[j + 1] - t[j]
+            return (self.Q[j + 1] - self.Q[j]) / h if h > 1e-12 else np.zeros(self.Q.shape[1])
+        if abs(tau - t[i]) <= 1e-9 and i > 0:
+            return 0.5 * (seg(i - 1) + seg(i))
+        return seg(i)
+
+    def project(self, q, lo: float, hi: float) -> "tuple[float, float]":
+        """Path position in [lo, hi] closest to joint vector ``q`` (max-norm) and that error (rad)."""
+        q = np.asarray(q, float)[: self.Q.shape[1]]
+        lo, hi = max(self.t0, float(lo)), min(self.t_end, float(hi))
+        if hi < lo:
+            hi = lo
+        i0 = max(0, int(np.searchsorted(self.t, lo, "right")) - 1)
+        i1 = min(len(self.t) - 1, int(np.searchsorted(self.t, hi, "left")))
+        best_tau, best_err = lo, float("inf")
+        for i in range(i0, max(i0 + 1, i1)):
+            a, b = self.Q[i], self.Q[min(i + 1, len(self.t) - 1)]
+            ta, tb = self.t[i], self.t[min(i + 1, len(self.t) - 1)]
+            d = b - a
+            dd = float(d @ d)
+            # a stationary segment (repeated knots, dwell): the arm is there for the whole segment, so it
+            # is credited with the segment's end (bounded by ``hi``, what was commanded)
+            u = 1.0 if dd <= 1e-18 else float(np.clip((q - a) @ d / dd, 0.0, 1.0))
+            tau = ta + u * (tb - ta)
+            tau = min(max(tau, lo), hi)
+            ref = self.q_at(tau)[0]
+            err = float(np.max(np.abs(_wrap(q - ref))))
+            if err < best_err - 1e-12 or (abs(err - best_err) <= 1e-12 and tau > best_tau):
+                best_tau, best_err = tau, err
+        return best_tau, best_err
+
+
+def _wrap(d):
+    return (np.asarray(d, float) + math.pi) % (2 * math.pi) - math.pi
+
+
+class Profile:
+    """Path clock tau(t), t >= 0 from the profile start: phases of (t0, dur, tau0, r0, r1)."""
+
+    def __init__(self, phases: list, hard_brake: bool = False):
+        self.phases = phases
+        self.hard_brake = hard_brake
+        last = phases[-1]
+        self.t_end = last[0] + last[1]
+        self.tau_end = self._tau_in(last, last[1])
+        self.r_end = last[4]
+
+    @staticmethod
+    def _tau_in(ph, s):
+        t0, dur, tau0, r0, r1 = ph
+        s = min(max(s, 0.0), dur)
+        if dur <= 0:
+            return tau0
+        if r0 == r1:
+            return tau0 + r0 * s
+        return tau0 + r0 * s + (r1 - r0) * (s / 2.0 - dur / (2.0 * math.pi) * math.sin(math.pi * s / dur))
+
+    @staticmethod
+    def _rate_in(ph, s):
+        t0, dur, tau0, r0, r1 = ph
+        if dur <= 0:
+            return r1
+        s = min(max(s, 0.0), dur)
+        return r0 + (r1 - r0) * (1.0 - math.cos(math.pi * s / dur)) / 2.0
+
+    def _phase(self, t):
+        for ph in self.phases:
+            if t < ph[0] + ph[1]:
+                return ph
+        return self.phases[-1]
+
+    def tau(self, t: float) -> float:
+        if t <= 0:
+            return self.phases[0][2]
+        if t >= self.t_end:
+            return self.tau_end
+        ph = self._phase(t)
+        return self._tau_in(ph, t - ph[0])
+
+    def rate(self, t: float) -> float:
+        if t >= self.t_end:
+            return self.r_end
+        ph = self._phase(max(t, 0.0))
+        return self._rate_in(ph, t - ph[0])
+
+    def rate_dot(self, t: float) -> float:
+        """d rate / dt (the cosine blends: (r1 - r0) pi / (2 dur) sin(pi s / dur); 0 in a cruise and after the end)."""
+        if t >= self.t_end or t < 0:
+            return 0.0
+        t0, dur, _tau0, r0, r1 = self._phase(t)
+        if dur <= 0 or r0 == r1:
+            return 0.0
+        s = min(max(t - t0, 0.0), dur)
+        return (r1 - r0) * math.pi / (2.0 * dur) * math.sin(math.pi * s / dur)
+
+    def time_of_tau(self, tau: float) -> float:
+        """Smallest t with tau(t) >= tau (bisection per phase; tau is monotone)."""
+        if tau <= self.phases[0][2]:
+            return 0.0
+        if tau >= self.tau_end:
+            return self.t_end
+        for ph in self.phases:
+            end = self._tau_in(ph, ph[1])
+            if tau <= end + 1e-15:
+                lo, hi = 0.0, ph[1]
+                for _ in range(60):
+                    mid = 0.5 * (lo + hi)
+                    if self._tau_in(ph, mid) < tau:
+                        lo = mid
+                    else:
+                        hi = mid
+                return ph[0] + hi
+        return self.t_end
+
+    @classmethod
+    def plan(cls, tau0: float, r0: float, lim: Optional[float], r_nom: float, t_stop: float,
+             tau_end: float) -> "Profile":
+        """From (tau0, rate r0) to rest at ``lim`` (or to ``tau_end`` at r_nom when lim is None).
+
+        Ramps are cosine blends whose duration is proportional to the rate change
+        (``t_stop`` for a full 0 <-> r_nom change), so the path acceleration never
+        exceeds pi * r_nom / (2 t_stop). When the limit is too close to stop within
+        that bound (only after a grant was withdrawn) the stop is made anyway, with a
+        steeper ramp, and ``hard_brake`` is set: the limit is never passed.
+        """
+        r_nom = max(float(r_nom), 1e-9)
+        T = max(float(t_stop), 1e-3)
+        r0 = max(0.0, float(r0))
+        tau0 = float(tau0)
+        end = float(tau_end) if lim is None else min(float(lim), float(tau_end))
+        d = max(0.0, end - tau0)
+        to_end = lim is None or float(lim) >= float(tau_end) - 1e-12
+        ph = []
+        t = 0.0
+        if to_end:
+            # ramp to r_nom, cruise to the leg end (the leg's own timing brings it to rest)
+            tr = T * abs(r_nom - r0) / r_nom
+            dr = (r0 + r_nom) / 2.0 * tr
+            if dr > d and r0 < r_nom:          # cannot even finish the ramp: ramp to a lower rate
+                tr = d * 2.0 / (r0 + r_nom) if (r0 + r_nom) > 0 else 0.0
+            if tr > 0:
+                ph.append((t, tr, tau0, r0, r_nom))
+                t += tr
+                tau0 = cls._tau_in(ph[-1], tr)
+            rem = max(0.0, end - tau0)
+            ph.append((t, rem / r_nom, tau0, r_nom, r_nom))
+            return cls(ph)
+        if d <= 1e-12:
+            if r0 > 1e-9:
+                return cls([(0.0, 0.0, tau0, r0, 0.0)], hard_brake=True)
+            return cls([(0.0, 0.0, tau0, 0.0, 0.0)])
+        brake_from_r0 = r0 * r0 * T / (2.0 * r_nom)
+        if r0 > 0 and d < brake_from_r0:
+            tb = 2.0 * d / r0                  # steeper than allowed: never pass the limit
+            return cls([(0.0, tb, tau0, r0, 0.0)], hard_brake=True)
+        rp = math.sqrt(max(0.0, (2.0 * d * r_nom / T + r0 * r0) / 2.0))
+        rp = min(rp, r_nom)
+        tu = T * abs(rp - r0) / r_nom
+        du = (r0 + rp) / 2.0 * tu
+        td = T * rp / r_nom
+        dd = rp * td / 2.0
+        cruise = max(0.0, d - du - dd)
+        if tu > 0:
+            ph.append((t, tu, tau0, r0, rp))
+            t += tu
+            tau0 = cls._tau_in(ph[-1], tu)
+        if cruise > 1e-12:
+            ph.append((t, cruise / rp, tau0, rp, rp))
+            t += cruise / rp
+            tau0 = cls._tau_in(ph[-1], ph[-1][1])
+        ph.append((t, td, tau0, rp, 0.0))
+        p = cls(ph)
+        # land exactly on the limit (rounding)
+        last = p.phases[-1]
+        p.phases[-1] = (last[0], last[1], last[2] + (end - p.tau_end), last[3], last[4])
+        p.tau_end = end
+        return p
+
+    def sample(self, path: LegPath, dt: float = 0.02) -> list:
+        """Trajectory points [{positions, velocities, accelerations, time_s, tau}] from t = 0 on a uniform grid of
+        step <= ``dt`` (the last step ends exactly at the profile end): the exact state of the re-timed smooth
+        command C(tau(t)) (module docstring). A profile that ends at rest ends with velocity and acceleration 0."""
+        n = max(1, int(math.ceil(self.t_end / dt - 1e-9))) if self.t_end > 0 else 1
+        ts = np.linspace(0.0, self.t_end, n + 1) if self.t_end > 0 else np.array([0.0])
+        taus = np.array([self.tau(float(t)) for t in ts])
+        r = np.array([self.rate(float(t)) for t in ts])
+        rd = np.array([self.rate_dot(float(t)) for t in ts])
+        r[0] = self.phases[0][3]                     # the profile's start rate (a splice starts in motion)
+        q, qd, qdd = path.cmd_eval(taus)
+        v = qd * r[:, None]
+        a = qdd * (r * r)[:, None] + qd * rd[:, None]
+        if self.r_end <= 1e-12:
+            v[-1] = 0.0
+            a[-1] = 0.0
+        out = [{"positions": [float(x) for x in q[i]], "time_s": round(float(ts[i]), 6), "tau": round(float(taus[i]), 6),
+                "velocities": [round(float(x), 9) for x in v[i]], "accelerations": [round(float(x), 9) for x in a[i]]}
+               for i in range(len(ts))]
+        if len(out) == 1:
+            out.append(dict(out[0], time_s=round(out[0]["time_s"] + 1e-3, 6),
+                            velocities=[0.0] * len(out[0]["velocities"]),
+                            accelerations=[0.0] * len(out[0]["accelerations"])))
+        return out
+
+    def sample_polyline(self, path: LegPath, dt: float = 0.02) -> list:
+        """The round-3 v4 sampler (reference only): trajectory points [{positions, time_s}] from t = 0, every path
+        knot in the window + dense ramp points on the polyline (irregular spacing: do not dispatch)."""
+        tau_a = self.phases[0][2]
+        tau_b = self.tau_end
+        ts = {0.0, self.t_end}
+        for ph in self.phases:
+            t0, dur, _tau0, r0, r1 = ph
+            if r0 != r1 and dur > 0:
+                n = max(2, int(math.ceil(dur / dt)))
+                ts.update(t0 + dur * i / n for i in range(n + 1))
+        inner = path.t[(path.t > tau_a + 1e-12) & (path.t < tau_b - 1e-12)]
+        for tau in inner:
+            ts.add(self.time_of_tau(float(tau)))
+        times = sorted(ts)
+        out, last_t = [], -1.0
+        for t in times:
+            if t <= last_t + 1e-6 and out:
+                continue
+            tau = self.tau(t)
+            v = path.slope(tau) * self.rate(t)
+            out.append({"positions": [float(x) for x in path.q_at(tau)[0]], "time_s": round(float(t), 6),
+                        "tau": round(float(tau), 6), "velocities": [round(float(x), 9) for x in v]})
+            last_t = t
+        if len(out) == 1:
+            out.append(dict(out[0], time_s=round(out[0]["time_s"] + 1e-3, 6)))
+        return out
+
+
+def ramp_ok(path: LegPath, stop_t: float, t_stop_s: float, r_nom: float, a_max, accel_tol: float = 0.05,
+            dt: float = 0.05) -> bool:
+    """Do the brake into ``stop_t`` and the resume out of it keep joint accelerations within
+    max(a_max, the plan's own peak over the window) + accel_tol * a_max (finite differences at ``dt``)?"""
+    a_max = np.asarray(a_max, float)
+    T = t_stop_s
+    lo = max(path.t0, stop_t - r_nom * T * 1.5)
+    hi = min(path.t_end, stop_t + r_nom * T * 1.5)
+    if hi - lo < 1e-6:
+        return True
+
+    def acc(taus, h):
+        Q = path.q_at(taus)
+        if len(Q) < 3:
+            return np.zeros(len(a_max))
+        A = (Q[2:] - 2 * Q[1:-1] + Q[:-2]) / (h * h)
+        return np.abs(A).max(axis=0)
+
+    hn = dt * r_nom
+    nom = acc(np.arange(lo, hi + hn, hn), dt)
+    cap = np.maximum(a_max, nom) + accel_tol * a_max
+    brake = Profile.plan(lo, r_nom, stop_t, r_nom, T, path.t_end)
+    tt = np.arange(0.0, brake.t_end + dt, dt)
+    a1 = acc(np.array([brake.tau(t) for t in tt]), dt)
+    resume = Profile.plan(stop_t, 0.0, None, r_nom, T, min(path.t_end, stop_t + r_nom * T * 2.0))
+    tt = np.arange(0.0, resume.t_end + dt, dt)
+    a2 = acc(np.array([resume.tau(t) for t in tt]), dt)
+    return bool(np.all(a1 <= cap + 1e-9) and np.all(a2 <= cap + 1e-9))
