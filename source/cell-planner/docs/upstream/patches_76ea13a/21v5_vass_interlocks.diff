+def test_a_waiting_arm_fails_fast_when_the_plc_faults():
+    """A FAULTed PLC never grants; the waiting arm ends its leg with vass_fault after fault_abort_s (it used to
+    wait out INTERLOCK_TIMEOUT_S = 900 s)."""
+    from agents.cell.bt_executor import BehaviourTreeExecutor
+    table = _r2_first_table(stop=0.3, enter=0.35, exit_=0.8, r2_exit=50.0)
+    ilk1 = [{"zone": "z0001", "occ": "z0001/r1", "k": 0, "enter_t": 0.35, "exit_t": 0.8, "stop_t": 0.3,
