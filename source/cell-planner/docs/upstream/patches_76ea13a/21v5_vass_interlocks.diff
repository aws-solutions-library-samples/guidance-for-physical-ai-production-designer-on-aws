+            w = self._vass_report["waits"]
+            w[robot_id] = round(w.get(robot_id, 0.0) + dt, 4)
+
+    def _exec_request_interlock(self, node: dict) -> "tuple[bool, Optional[dict]]":
+        from agents.cell.vass_protocol import parse_zone_list
+        robot_id = bt_port(node, "robot_ns")
+        zones = parse_zone_list(bt_resolve(bt_port(node, "zones"), self._bb))
+        c = self._vsess.client(robot_id) if self._vsess is not None else None
+        if c is None or not zones:
+            return False, {"failed_node_id": node.get("id"), "node_type": "RequestInterlock",
+                           "robot_ns": robot_id, "reason_code": "vass_unavailable",
+                           "reason": "RequestInterlock needs a PLC session and a zone list"}
+        c.request_set(zones)
+        if bt_port(node, "wait", True) in (False, "false", 0):
+            return True, None
+        ok, fail = self._wait_grants(c, [f"{z}/{robot_id}" for z in zones], node.get("id"),
+                                     "RequestInterlock", robot_id)
+        if ok:
+            c.enter_set(zones)
+        return ok, fail
+
+    def _exec_release_interlock(self, node: dict) -> "tuple[bool, Optional[dict]]":
+        from agents.cell.vass_protocol import parse_zone_list
+        robot_id = bt_port(node, "robot_ns")
+        zones = parse_zone_list(bt_resolve(bt_port(node, "zones"), self._bb))
+        c = self._vsess.client(robot_id) if self._vsess is not None else None
+        if c is None:
+            return False, {"failed_node_id": node.get("id"), "node_type": "ReleaseInterlock",
+                           "robot_ns": robot_id, "reason_code": "vass_unavailable",
+                           "reason": "ReleaseInterlock needs a PLC session"}
+        c.release_set(zones)
+        return True, None
