+    ib = [{"zone": "z0001", "occ": "z0001/b", "k": 0, "enter_t": 0.3, "exit_t": 0.7, "stop_t": 0.0,
+           "t_stop_s": 0.25}]
+    root = {"type": "Parallel", "children": [
+        {"type": "ExecuteTrajectory", "ports": {"robot_ns": "a", "operation_id": "A", "trajectory": ta,
+                                               "hold_duration_s": 0.0, "interlocks": ia}},
+        {"type": "ExecuteTrajectory", "ports": {"robot_ns": "b", "operation_id": "B", "trajectory": tb,
+                                               "hold_duration_s": 0.0, "interlocks": ib}}]}
+    tree = {"cell_id": "toy", "root": root, "metadata": {"vass": {"table": table.to_json()}}}
+    rt = OpLagRuntime({"a": [0.0] * 6, "b": [0.0] * 6})
