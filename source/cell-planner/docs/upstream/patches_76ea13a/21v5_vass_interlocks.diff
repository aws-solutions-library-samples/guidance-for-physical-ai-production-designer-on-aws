+def test_relaxed_leg_start_stop_moves_only_leg_start_stops():
+    """Round 4 (INTEGRATE): a stop that step 4 moved back to the leg start (no admissible stop between the leg start
+    and the entry) is moved up to guard_s before the entry, snapped down to a program sample of that leg."""
+    guard = 0.05
+    got = V.relaxed_leg_start_stop(_occ({"k": 4, "t": 0.52135}, {"k": 4, "t": 0.0}), guard)
+    assert got == {"k": 4, "t": round(0.52135 - guard, 6)}
+    taus = np.array([0.0, 0.1, 0.2, 0.3, 0.4, 0.46, 0.5, 0.6])
+    assert V.relaxed_leg_start_stop(_occ({"k": 4, "t": 0.52135}, {"k": 4, "t": 0.0}), guard, taus) == \
+        {"k": 4, "t": 0.46}
+    assert V.relaxed_leg_start_stop(_occ({"k": 4, "t": 0.52}, {"k": 4, "t": 0.31}), guard) is None   # not at the start
+    assert V.relaxed_leg_start_stop(_occ({"k": 4, "t": 0.52}, {"k": 3, "t": 0.0}), guard) is None    # other leg
+    assert V.relaxed_leg_start_stop(_occ({"k": 4, "t": 0.04}, {"k": 4, "t": 0.0}), guard) is None    # no room
+    assert V.relaxed_leg_start_stop(_occ(None, None), guard) is None                                  # inside at HOME
+    assert V.relaxed_leg_start_stop(_occ({"k": 4, "t": 0.52}, {"k": 4, "t": 0.0}), guard, [0.0]) is None
+
