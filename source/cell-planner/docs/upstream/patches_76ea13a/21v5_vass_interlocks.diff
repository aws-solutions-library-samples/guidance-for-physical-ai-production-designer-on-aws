+def _build_fjt_goal_exact(trajectory: list[dict]):
+    """FJT goal from points that already carry the exact velocities and
+    accelerations of the commanded curve (VASS re-timed goals: ``vass_motion.
+    Profile.sample``, a uniform grid). Forwarded unchanged, so the JTC's quintic
+    segments reproduce the command; refitting a spline through them (``fjt_points``)
+    would only add the fit's error. A goal that ends at rest ends with velocity and
+    acceleration 0 (the sampler guarantees it; enforced here for the last point)."""
