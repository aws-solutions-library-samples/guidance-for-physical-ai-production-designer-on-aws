+def test_a_partner_resting_in_the_corridor_until_the_barrier_is_not_interlocked_against_the_step():
+    """b's step-1 leg ends in the corridor a's compound leg crosses; in the compound step b leaves first (b leads).
+    b rests there only until the barrier, and from then on the compound plan keeps the two apart: no zone may make
+    a's lockstep leg wait for b's release inside the step (that would deadlock at the barrier)."""
+    joint = compound_step(b_start=math.pi, b_goal=math.pi - 0.6, lead="b")
+    tree = two_step_tree(joint, b_mid=math.pi)
+    on = V.derive_zones(tree, _cfg(True), geometry=_geo())          # raises nominal_deadlock without the rule
+    assert on.stats["nominal"]["completed"]
+    for z in on.zones:
+        legs = _legs_of(z)
+        assert not (1 in legs["a"] and 1 in legs["b"]), (z.id, legs)
+    off = V.derive_zones(tree, _cfg(False), geometry=_geo())
+    assert any(1 in _legs_of(z)["a"] and _legs_of(z)["b"] & {0, 1} for z in off.zones)
+    ann = V.annotate_tree(tree, on)
+    rt = OpLagRuntime({"a": [A1] + [0.0] * 5, "b": [B0] + [0.0] * 5}, op_lag={"a1": 0.8})
+    res, rep = _run(ann, on, rt, lockstep=True)
+    assert res["success"], res
+    assert rep["I7_ok"] and rep["counters"]["violations"] == 0
