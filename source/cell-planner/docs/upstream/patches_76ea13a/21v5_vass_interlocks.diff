+"""Robot side of the VASS interlocks: one client per arm, used by the BT executor.
+
+umarell's cell executor runs every arm's branch of the tree, so it is the robot
+program in VASS terms: it requests each zone ahead of the arm's stop point, never
+lets the arm pass the stop point without the grant (``vass_motion``: the leg is
+re-timed to come to rest there, the path is unchanged), reports "occupied" at the
+entry and releases a zone only once the arm's MEASURED position is past the exit.
+
+``VassSession`` owns the transport (zenoh client by default) and one
+``RobotClient`` per arm, plus a level thread that republishes each arm's status
+image and heartbeat (so a lost event is repaired by the next level, and the PLC
+watchdog sees the arm alive). Grant state is the newest PLC statement per zone:
+a grant event, or an io image that lists (or, being newer, omits) the zone.
+
+Configuration (the cell's robots.yaml, optional, default OFF)::
+
+    vass:
+      enabled: true                 # run interlocked plans under the PLC
+      connect: tcp/127.0.0.1:7447   # the cell's zenoh router
+      required: false               # true: refuse plans without a zone table
+      plc_wait_s: 10                # how long to wait for the PLC in RUN
+      replace_lead_s: 0.15          # goal-time lead of a spliced (replacement) goal
+      fault_abort_s: 20             # a waiting arm ends the leg (vass_fault) when the PLC stays in FAULT
+      plc_lost_abort_s: 120         # ... (vass_unavailable) when the PLC stays silent this long
+      arrive_tol_m: 0.005           # a goal whose clock ended counts as arrived this close to its end
+
+or ``UMARELL_VASS_CONNECT=tcp/...`` (+ ``UMARELL_VASS_REQUIRED=1``) in the
+environment. Without either, an interlocked plan runs exactly as before (the
+``interlocks`` ports are ignored, nothing is protected against lag).
+"""
+from __future__ import annotations
+
+import os
+import threading
+import time
+from typing import Optional
+
+from agents.cell import vass_protocol as P
+
+
+class RobotClient:
+    """One arm's interlock state (thread-safe; the executor thread and the transport thread share it)."""
+
+    def __init__(self, session: "VassSession", rid: str):
+        self.s = session
+        self.rid = rid
+        self.keys = session.keys
+        self.env = P.Envelope(session.cell, rid)
+        self.env.table = session.table.short if session.table else ""
+        self.lock = threading.RLock()
+        self.cv = threading.Condition(self.lock)
+        # request window in STOP order (the arm needs each grant before its stop point, and a stop can come
+        # before the entry of occupancies that enter earlier: entry order let a full window of not-yet-entered
+        # occupancies hide the next stop's zone, a self-deadlock; round 4)
+        occs = session.table.occupancies(rid) if session.table else []
+        self.occs = sorted(occs, key=lambda o: (P.pos_key(o.stop or o.enter), P.pos_key(o.enter), o.zone))
+        self.by_occ = {o.id: o for o in self.occs}
+        self.state: dict = {}            # occ id -> AHEAD | REQUESTED | GRANTED | INSIDE | RELEASED
+        self.req_ids: dict = {}          # occ id -> req_id
+        self.grant_cycle: dict = {}      # zone -> cycle of the newest PLC statement that granted it
+        self.io_enabled: set = set()
+        self.io_cycle = -1
+        self.plc_mode = "INIT"
+        self.plc_epoch = 0
+        self.plc_last_rx: Optional[float] = None
+        self.pos = {"k": -1, "t": 0.0}
+        self.q = None
+        self.track_err = None
+        self.mode = "INIT"
+        self.waiting_for = None
+        self.waiting_gate = None
+        self.approaching = None          # the zone the arm brakes / will stop for (diagnostics)
+        self.plc_fault_why = None        # the PLC's fault reason (heartbeat), when it reports one
+        self._n = 0
+        self.log: list = []
+        # plan mode: the client requests every occupancy of the arm's program ahead of time;
+        # fifo / priority tables are driven by RequestInterlock / ReleaseInterlock nodes
+        self.auto = (session.table.arbitration if session.table else "plan") == "plan"
+        for o in self.occs:
+            if o.enter is None and self.auto:
+                self.state[o.id] = "INSIDE"           # inside from the initial HOME pose
+            else:
+                self.state[o.id] = "AHEAD"
+        self.node_sets: dict = {}        # RequestInterlock: tuple(zones) -> req_id
+        # state version: +1 on every request / entry / release; carried by those events and by the status
+        # level, so the PLC can tell a status built BEFORE an event it already processed (stale) from a new one
+        self.ver = 0
+
+    # ── PLC inputs ────────────────────────────────────────────────────────────
+    def on_grant(self, msg: dict, rx_t: float) -> None:
+        if msg.get("rid") != self.rid:
+            return
+        with self.cv:
+            cyc = int(msg.get("cycle") or 0)
+            for z in msg.get("zones") or []:
+                if cyc >= self.grant_cycle.get(z, -1):
+                    self.grant_cycle[z] = cyc
+            for oid, rq in self.req_ids.items():
+                if rq == msg.get("req_id") and self.state.get(oid) == "REQUESTED":
+                    self.state[oid] = "GRANTED"
+            self.log.append({"t": rx_t, "ev": "grant", "zones": msg.get("zones"), "req_id": msg.get("req_id")})
+            self.cv.notify_all()
+
+    def on_io(self, msg: dict, rx_t: float) -> None:
+        with self.cv:
+            cyc = int(msg.get("cycle") or 0)
+            if cyc < self.io_cycle:
+                return
+            self.io_cycle = cyc
+            self.plc_mode = msg.get("mode", self.plc_mode)
+            self.plc_epoch = int(msg.get("epoch") or self.plc_epoch)
+            self.plc_last_rx = rx_t
+            en = set(msg.get("enabled") or [])
+            self.io_enabled = en
+            for z in en:
+                if cyc >= self.grant_cycle.get(z, -1):
+                    self.grant_cycle[z] = cyc
+            for oid, st in self.state.items():
+                z = self.by_occ[oid].zone if oid in self.by_occ else oid.split("/")[0]
+                if st == "REQUESTED" and z in en:
+                    self.state[oid] = "GRANTED"
+                elif st == "GRANTED" and z not in en and cyc > self.grant_cycle.get(z, -1):
+                    self.state[oid] = "REQUESTED"     # withdrawn (PLC FAULT), not yet entered
+            self.cv.notify_all()
+
+    def on_plc_heartbeat(self, msg: dict, rx_t: float) -> None:
+        with self.cv:
+            self.plc_last_rx = rx_t
+            self.plc_mode = msg.get("mode", self.plc_mode)
+            self.plc_fault_why = msg.get("fault") if self.plc_mode == "FAULT" else None
+            ep = int(msg.get("epoch") or 0)
+            if ep and self.plc_epoch and ep != self.plc_epoch:
+                self._new_epoch(ep)
+            self.plc_epoch = ep or self.plc_epoch
+
+    def _new_epoch(self, ep):
+        """PLC restart: drop grants not yet entered and request them again."""
+        for oid, st in self.state.items():
+            if st in ("GRANTED", "REQUESTED"):
+                self.state[oid] = "AHEAD"
+                self.req_ids.pop(oid, None)
+        self.grant_cycle.clear()
+        self.io_cycle = -1
+        self.env.epoch = ep
+
+    def plc_ok(self, now: Optional[float] = None) -> bool:
+        now = time.time() if now is None else now
+        return (self.plc_last_rx is not None and now - self.plc_last_rx <= self.s.hb_timeout_s
+                and self.plc_mode in ("RUN", "HOLD"))
+
+    # ── requests ──────────────────────────────────────────────────────────────
+    def _req_id(self) -> str:
+        self._n += 1
+        return f"{self.rid}.{self.env.sess[:4]}.{self._n}"
+
+    def ensure_requests(self) -> None:
+        """Keep the next MAX_OUTSTANDING occupancies (program order) requested."""
+        if not self.auto:
+            return
+        out = []
+        with self.cv:
+            outstanding = sum(1 for o in self.occs if self.state.get(o.id) in ("REQUESTED", "GRANTED"))
+            for o in self.occs:
+                if outstanding >= self.s.max_outstanding:
+                    break
+                if self.state.get(o.id) == "AHEAD":
+                    rq = self._req_id()
+                    self.req_ids[o.id] = rq
+                    self.state[o.id] = "REQUESTED"
+                    self.ver += 1
+                    outstanding += 1
+                    out.append(self._req_msg(o, rq))
+        for key, msg in out:
+            self.s.put(key, msg, "ctrl")
+
+    def request_now(self, oid: str) -> None:
+        """Request ``oid`` now if it is still AHEAD (bypasses the MAX_OUTSTANDING window): the executor calls it
+        for the zone of the arm's next stop point, so the window can never hide the grant the arm waits for."""
+        if not self.auto:
+            return
+        with self.cv:
+            o = self.by_occ.get(oid)
+            if o is None or self.state.get(oid) != "AHEAD":
+                return
+            rq = self._req_id()
+            self.req_ids[oid] = rq
+            self.state[oid] = "REQUESTED"
+            self.ver += 1
+            key, msg = self._req_msg(o, rq)
+            self.log.append({"t": time.time(), "ev": "req_forced", "occ": oid})
+        self.s.put(key, msg, "ctrl")
+
+    def _req_msg(self, o, rq):
+        k = self.keys.zone(o.zone, "req")
+        return k, self.env.wrap(k, {"rid": self.rid, "req_id": rq, "zones": [o.zone], "occ": o.id,
+                                    "enter": o.enter, "exit": o.exit, "prio": 0, "ver": self.ver})
+
+    def granted(self, oid: str) -> bool:
+        with self.lock:
+            st = self.state.get(oid)
+            if st in ("INSIDE", "RELEASED"):
+                return True
+            if st != "GRANTED":
+                return False
+            return self.plc_ok()
+
+    def wait_change(self, timeout: float) -> None:
+        with self.cv:
+            self.cv.wait(timeout=max(0.0, timeout))
+
+    # ── position, entry, release ──────────────────────────────────────────────
+    def set_pos(self, k: int, t: float, q=None, track_err=None, mode: Optional[str] = None,
+                waiting_for: Optional[str] = None, approaching: Optional[str] = None) -> None:
+        """``mode`` WAIT + ``waiting_for`` only while the arm is at rest at that occupancy's stop point (the
+        PLC's deadlock check relies on it); ``approaching`` = the zone of the next stop (braking toward it)."""
+        with self.lock:
+            self.pos = {"k": int(k), "t": round(float(t), 6)}
+            if q is not None:
+                self.q = [float(v) for v in q]
+            self.track_err = track_err
+            if mode:
+                self.mode = mode
+            self.waiting_for = waiting_for
+            self.approaching = approaching
+
+    def entered(self, oid: str, k: int, t: float) -> None:
+        with self.cv:
+            if self.state.get(oid) not in ("GRANTED", "REQUESTED", "AHEAD"):
+                return
+            if self.state.get(oid) != "GRANTED":
+                # entering without a grant must never happen: the supervisor stops at the stop point
+                self.log.append({"t": time.time(), "ev": "violation_entry_without_grant", "occ": oid})
+            self.state[oid] = "INSIDE"
+            self.ver += 1
+            o = self.by_occ[oid]
+            rq = self.req_ids.get(oid)
+            key = self.keys.zone(o.zone, "occ")
+            msg = self.env.wrap(key, {"rid": self.rid, "req_id": rq, "zone": o.zone, "pos": {"k": k, "t": t},
+                                      "ver": self.ver})
+            self.log.append({"t": time.time(), "ev": "occ", "occ": oid, "pos": [k, t]})
+        self.s.put(key, msg, "ctrl")
+        self.ensure_requests()
+
+    def release(self, oid: str, k: int, t: float, q=None, track_err=None) -> None:
+        with self.cv:
+            if self.state.get(oid) != "INSIDE":
+                return
+            self.state[oid] = "RELEASED"
+            self.ver += 1
+            o = self.by_occ[oid]
+            key = self.keys.zone(o.zone, "rel")
+            body = {"rid": self.rid, "req_id": self.req_ids.get(oid), "zone": o.zone, "pos": {"k": k, "t": t},
+                    "ver": self.ver}
+            if q is not None:
+                body["q"] = [float(v) for v in q]
+            if track_err is not None:
+                body["track_err_m"] = float(track_err)
+            msg = self.env.wrap(key, body)
+            self.log.append({"t": time.time(), "ev": "rel", "occ": oid, "pos": [k, t]})
+        self.s.put(key, msg, "ctrl")
+        self.ensure_requests()
+
+    # ── RequestInterlock / ReleaseInterlock nodes (zone sets, at rest between legs) ──
+    def request_set(self, zones: list) -> str:
+        zones = sorted(zones)
+        with self.cv:
+            rq = self.node_sets.get(tuple(zones))
+            if rq is None:
+                rq = self._req_id()
+                self.node_sets[tuple(zones)] = rq
+                for z in zones:
+                    self.state[P.occ_id(z, self.rid)] = "REQUESTED"
+                    self.req_ids[P.occ_id(z, self.rid)] = rq
+                self.ver += 1
+                key = self.keys.zone(zones[0], "req")
+                msg = self.env.wrap(key, {"rid": self.rid, "req_id": rq, "zones": zones,
+                                          "occ": P.occ_id(zones[0], self.rid), "prio": 0, "ver": self.ver})
+            else:
+                msg = None
+        if msg is not None:
+            self.s.put(key, msg, "ctrl")
+        return rq
+
+    def set_granted(self, zones: list) -> bool:
+        with self.lock:
+            return all(self.state.get(P.occ_id(z, self.rid)) in ("GRANTED", "INSIDE") or
+                       (self.grant_cycle.get(z, -1) >= 0 and z in self.io_enabled) for z in zones) \
+                and self.plc_ok()
+
+    def enter_set(self, zones: list) -> None:
+        with self.lock:
+            for z in zones:
+                self.state[P.occ_id(z, self.rid)] = "INSIDE"
+            self.ver += 1
+            ver = self.ver
+        for z in zones:
+            key = self.keys.zone(z, "occ")
+            self.s.put(key, self.env.wrap(key, {"rid": self.rid, "zone": z, "pos": dict(self.pos), "ver": ver}),
+                       "ctrl")
+
+    def release_set(self, zones: list) -> None:
+        msgs = []
+        with self.cv:
+            self.ver += 1
+            for z in zones:
+                oid = P.occ_id(z, self.rid)
+                self.state[oid] = "RELEASED"
+                key = self.keys.zone(z, "rel")
+                msgs.append((key, self.env.wrap(key, {"rid": self.rid, "req_id": self.req_ids.get(oid), "zone": z,
+                                                      "pos": dict(self.pos), "node": True, "ver": self.ver})))
+            for k_ in [k_ for k_ in self.node_sets if set(k_) <= set(zones)]:
+                self.node_sets.pop(k_, None)
+        for key, msg in msgs:
+            self.s.put(key, msg, "ctrl")
+
+    # ── levels ────────────────────────────────────────────────────────────────
+    def status_msg(self) -> "tuple[str, dict]":
+        with self.lock:
+            pending, granted, inside = [], [], []
+            for oid, st in self.state.items():
+                z = oid.split("/")[0]
+                if st == "REQUESTED" and self.req_ids.get(oid):
+                    pending.append({"req_id": self.req_ids[oid], "zones": [z], "occ": oid})
+                elif st == "GRANTED":
+                    granted.append(z)
+                elif st == "INSIDE":
+                    inside.append(z)
+            body = {"rid": self.rid, "mode": self.mode, "pos": dict(self.pos), "pending": pending,
+                    "granted": sorted(granted), "inside": sorted(inside), "waiting_for": self.waiting_for,
+                    "waiting_gate": self.waiting_gate, "approaching": self.approaching, "fault": None,
+                    "ver": self.ver}
+            if self.track_err is not None:
+                body["track_err_m"] = self.track_err
+            key = self.keys.robot(self.rid, "status")
+            return key, self.env.wrap(key, body)
+
+    def heartbeat_msg(self) -> "tuple[str, dict]":
+        key = self.keys.robot(self.rid, "heartbeat")
+        self._hb = getattr(self, "_hb", 0) + 1
+        return key, self.env.wrap(key, {"n": self._hb, "mono": time.monotonic()})
+
+    def done(self) -> None:
+        with self.lock:
+            self.mode = "DONE"
+        key, msg = self.status_msg()
+        self.s.put(key, msg, "level")
+
+
+class VassSession:
+    """Transport + one RobotClient per arm + the level / heartbeat thread."""
+
+    def __init__(self, cell: str, table: P.ZoneTable, transport, robots=None, *,
+                 hb_period_s: float = P.HB_PERIOD_S, level_period_s: float = P.LEVEL_PERIOD_S,
+                 hb_timeout_s: float = P.HB_TIMEOUT_S, max_outstanding: int = P.MAX_OUTSTANDING,
+                 replace_lead_s: float = 0.15, own_transport: bool = False,
+                 fault_abort_s: float = P.FAULT_ABORT_S, plc_lost_abort_s: float = P.PLC_LOST_ABORT_S,
+                 arrive_tol_m: Optional[float] = None):
+        self.cell = cell
+        self.keys = P.Keys(cell)
+        self.table = table
+        self.tr = transport
+        self.own_transport = own_transport
+        self.hb_period_s = hb_period_s
+        self.level_period_s = level_period_s
+        self.hb_timeout_s = hb_timeout_s
+        self.max_outstanding = max_outstanding
+        self.replace_lead_s = replace_lead_s
+        self.guard_s = float(table.config.get("guard_s", P.GUARD_S)) if table else P.GUARD_S
+        self.track_tol_m = P.TRACK_TOL_M
+        # a waiting arm gives up (vass_fault / vass_unavailable) when the PLC stays in FAULT / gone this long
+        self.fault_abort_s = float(fault_abort_s)
+        self.plc_lost_abort_s = float(plc_lost_abort_s)
+        # a goal whose clock has ended counts as arrived within this TCP-equivalent distance of its end point
+        self.arrive_tol_m = float(arrive_tol_m) if arrive_tol_m is not None else self.track_tol_m
+        self.radii = (table.raw.get("geometry") or {}).get("sweep_radii") or {} if table else {}
+        self.clients = {rid: RobotClient(self, rid) for rid in (robots or (table.robots if table else []))}
+        self._stop = threading.Event()
+        self._thread = None
+        self._put_lock = threading.Lock()
+
+    def put(self, key, msg, qos="ctrl"):
+        with self._put_lock:
+            self.tr.put(key, msg, qos)
+
+    def start(self) -> "VassSession":
+        k = self.keys
+        for rid, c in self.clients.items():
+            self.tr.subscribe(k.plc_io(rid), lambda key, m, rx, c=c: c.on_io(m, rx))
+            try:
+                self.tr.liveliness_token(k.robot(rid, "alive"))
+            except Exception:  # noqa: BLE001
+                pass
+        self.tr.subscribe(k.zone_any("grant"), self._on_grant)
+        self.tr.subscribe(k.plc_heartbeat, self._on_hb)
+        self._thread = threading.Thread(target=self._levels, daemon=True, name="vass-levels")
+        self._thread.start()
+        for c in self.clients.values():
+            c.ensure_requests()
+        return self
+
+    def _on_grant(self, key, msg, rx_t):
+        c = self.clients.get(msg.get("rid"))
+        if c is not None:
+            c.on_grant(msg, rx_t)
+
+    def _on_hb(self, key, msg, rx_t):
+        for c in self.clients.values():
+            c.on_plc_heartbeat(msg, rx_t)
+
+    def _levels(self):
+        last_hb = 0.0
+        while not self._stop.is_set():
+            now = time.monotonic()
+            for c in self.clients.values():
+                key, msg = c.status_msg()
+                self.put(key, msg, "level")
+            if now - last_hb >= self.hb_period_s:
+                last_hb = now
+                for c in self.clients.values():
+                    key, msg = c.heartbeat_msg()
+                    self.put(key, msg, "hb")
+            self._stop.wait(self.level_period_s)
+
+    def wait_plc_run(self, timeout_s: float) -> bool:
+        deadline = time.time() + timeout_s
+        while time.time() < deadline:
+            if all(c.plc_ok() for c in self.clients.values()):
+                return True
+            time.sleep(0.02)
+        return False
+
+    def client(self, rid: str) -> Optional[RobotClient]:
+        return self.clients.get(rid)
+
+    def close(self) -> None:
+        for c in self.clients.values():
+            if c.mode != "DONE":
+                c.done()
+        time.sleep(min(0.2, 2 * self.level_period_s))
+        self._stop.set()
+        if self._thread:
+            self._thread.join(timeout=1.0)
+        if self.own_transport:
+            try:
+                self.tr.close()
+            except Exception:  # noqa: BLE001
+                pass
+
+
+def cell_vass_config(cell_id: str) -> dict:
+    """The cell's ``vass:`` block (robots.yaml) merged with UMARELL_VASS_* env overrides; {} = off."""
+    cfg: dict = {}
+    try:
+        from agents.trajectory.tools.robot_kinematics import _load_robots_config
+        cfg = dict((_load_robots_config(cell_id) or {}).get("vass") or {})
+    except Exception:  # noqa: BLE001 - no cell store: env only
+        cfg = {}
+    env = os.environ
+    if env.get("UMARELL_VASS_CONNECT"):
+        cfg.update(enabled=True, connect=env["UMARELL_VASS_CONNECT"])
+    if env.get("UMARELL_VASS_REQUIRED", "").strip() in ("1", "true", "yes"):
+        cfg["required"] = True
+    if env.get("UMARELL_VASS", "").strip().lower() in ("0", "off", "false"):
+        cfg["enabled"] = False
+    return cfg
+
+
+def open_session(cell_id: str, table: P.ZoneTable, cfg: dict) -> VassSession:
+    from agents.cell.vass_transport import open_transport
+    tr = open_transport(cfg)
+    s = VassSession(cfg.get("cell") or table.cell_id or cell_id, table, tr,
+                    replace_lead_s=float(cfg.get("replace_lead_s", 0.15)), own_transport=True,
+                    fault_abort_s=float(cfg.get("fault_abort_s", P.FAULT_ABORT_S)),
+                    plc_lost_abort_s=float(cfg.get("plc_lost_abort_s", P.PLC_LOST_ABORT_S)),
+                    arrive_tol_m=cfg.get("arrive_tol_m"))
+    return s.start()
