+def _dense_block(ca, ra, cb, rb, thr):
+    return V._dense_conflicts(ca, ra, cb, rb, thr)
+
+
+def test_kd_block_conflicts_equal_the_dense_pass():
+    rng = np.random.default_rng(3)
+    for _ in range(5):
+        na, nb, S, T = rng.integers(20, 60), rng.integers(20, 60), rng.integers(3, 12), rng.integers(3, 12)
+        ca = rng.normal(0, 1, (na, S, 3)).cumsum(0) * 0.05
+        cb = rng.normal(0, 1, (nb, T, 3)).cumsum(0) * 0.05 + np.array([0.5, 0.0, 0.0])
+        ra = rng.uniform(0.05, 0.4, (na, S))
+        rb = rng.uniform(0.05, 0.4, (nb, T))
+        thr = float(rng.uniform(0.02, 0.2))
+        a = _dense_block(ca, ra, cb, rb, thr)
+        b = V._block_conflicts_kd(ca, ra, cb, rb, thr)
+        # the dense pass is float32: the KD pass (float64) may only differ at the float32 rounding of a boundary
+        assert (a != b).sum() <= 1
+
+
+def test_kd_sample_hits_equal_the_dense_float32_rule():
+    rng = np.random.default_rng(5)
+    for _ in range(5):
+        na, nb, S, T = rng.integers(10, 40), rng.integers(10, 40), rng.integers(2, 8), rng.integers(2, 8)
+        Ca = rng.normal(0, 1, (na, S, 3)).cumsum(0) * 0.03
+        Cb = rng.normal(0, 1, (nb, T, 3)).cumsum(0) * 0.03 + np.array([0.3, 0.0, 0.0])
+        ra, rb = rng.uniform(0.05, 0.15, S), rng.uniform(0.05, 0.15, T)
+        ea, eb = rng.uniform(0, 0.02, na), rng.uniform(0, 0.02, nb)
+        thr = 0.06
+        A, Bq = Ca.astype(np.float32), Cb.astype(np.float32)
+        d = np.sqrt(((A[:, :, None, None, :] - Bq[None, None, :, :, :]) ** 2).sum(-1))
+        d = d - ra[None, :, None, None] - rb[None, None, None, :] - 0.5 * (ea[:, None, None, None] + eb[None, None, :, None])
+        dense = (d <= thr).any(axis=(1, 3))
+        assert np.array_equal(dense, V._sample_hits_kd(Ca, ra, ea, Cb, rb, eb, thr))
+
+
+def _toy_table():
+    geo = ToyGeometry({"a": [0.0, 0.0, 0.0], "b": [2.0, 0.0, 0.0]})
+    tree = _toy_tree()
+    cfg = V.ZoneConfig(path_step_m=0.02, block=4, margin_m=0.0, hull_rule=False)
+    table = V.derive_zones(tree, cfg, geometry=geo)
+    legs = V.program_legs(tree)
+    legs.pop("_end")
+    legs.pop("_problems")
+    return geo, tree, cfg, table, legs
+
+
+def test_fast_and_v1_paths_derive_the_same_toy_table():
+    geo = ToyGeometry({"a": [0.0, 0.0, 0.0], "b": [2.0, 0.0, 0.0]})
+    tree = _toy_tree()
+    out = {}
+    for fast in (False, True):
+        cfg = V.ZoneConfig(path_step_m=0.02, block=4, margin_m=0.0, hull_rule=False, fast=fast,
+                           nominal_model="event" if fast else "ticks")
+        t = V.derive_zones(tree, cfg, geometry=geo)
+        out[fast] = [z.to_json() for z in t.zones]
+    assert out[True] and out[True] == out[False]
+
+
+def test_event_nominal_check_agrees_with_the_fixed_step_run():
+    geo, tree, cfg, table, legs = _toy_table()
+    a = V.nominal_check(tree, table, legs, cfg, model="ticks")
+    b = V.nominal_check(tree, table, legs, cfg, model="event")
+    assert a["completed"] and b["completed"]
+    assert abs(a["end_s"] - b["end_s"]) <= 0.02
+    for lag in (0.5, 1.5):
+        a = V.nominal_check(tree, table, legs, cfg, model="ticks", lag={"b": lag})
+        b = V.nominal_check(tree, table, legs, cfg, model="event", lag={"b": lag})
+        assert a["completed"] == b["completed"] and abs(a["end_s"] - b["end_s"]) <= 0.05
