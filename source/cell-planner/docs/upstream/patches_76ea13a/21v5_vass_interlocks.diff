+def _cycle_table(true_cycle=False):
+    za = {"id": "za", "pair": ["r1", "r2"], "first": "r2", "occ": [
+        {"rid": "r2", "order": 0, "enter": {"k": 0, "t": 0.5}, "exit": {"k": 1, "t": 0.3},
+         "stop": {"k": 0, "t": 0.45}, "t_nom": [0.5, 3.3]},
+        {"rid": "r1", "order": 1, "enter": {"k": 0, "t": 1.05}, "exit": {"k": 0, "t": 1.5},
+         "stop": {"k": 0, "t": 1.0}, "t_nom": [4.0, 4.5]}]}
+    zb = {"id": "zb", "pair": ["r1", "r2"], "first": "r1", "occ": [
+        {"rid": "r1", "order": 0, "enter": {"k": 0, "t": 1.6}, "exit": {"k": 0, "t": 1.8},
+         "stop": {"k": 0, "t": 1.55}, "t_nom": [4.6, 4.8]},
+        {"rid": "r2", "order": 1, "enter": {"k": 1, "t": 1.05}, "exit": {"k": 1, "t": 1.5},
+         "stop": {"k": 1, "t": 1.0}, "t_nom": [5.0, 5.5]}]}
+    if true_cycle:      # r2's stop for zb comes BEFORE its exit of za: a real wait-for cycle once both stop there
+        zb["occ"][1].update(enter={"k": 1, "t": 0.25}, stop={"k": 1, "t": 0.2})
+    return _table([za, zb], legs={"r1": [{"k": 0, "t_end": 2.0}], "r2": [{"k": 0, "t_end": 1.0},
+                                                                     {"k": 1, "t_end": 2.0}]})
