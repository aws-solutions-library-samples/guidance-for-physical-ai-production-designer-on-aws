+"""VASS interlocks (patch 21) under umarell's opt-in lockstep (``LOCKSTEP=1``).
+
+The rule: under lockstep no interlock zone is derived between the arms of one
+ompl-compound step (``sync_group``): its plan proves them apart at each instant on
+one clock, the executor starts them off one barrier and e-stops on drift. Every
+other conflict (other steps, Delay-staggered legs, coordinated trees, compound legs
+without lockstep) is interlocked as before. A lockstep leg is never held in motion
+(that would trip ``lockstep_lost``): the zones it enters are granted at rest, at its
+start, before the barrier; the derivation puts their stop points there and the
+nominal check models the barrier. Host-runnable (toy planar geometry, in-process
+PLC bus, a runtime that follows the dispatched goals).
+"""
+from __future__ import annotations
+
+import inspect
+import json
+import math
+import threading
+import time
+
+import numpy as np
+import pytest
+
+from agents.cell import vass_protocol as P
+from agents.cell.bt_executor import BehaviourTreeExecutor, ExecConfig
+from agents.cell.vass_client import VassSession
+from agents.cell.vass_motion import LegPath
+from agents.cell.vass_plc import PlcConfig, PlcEmulator
+from agents.cell.vass_transport import LocalBus, LocalTransport
+from agents.trajectory.backends.ompl_compound import planner as cp
+from agents.trajectory.tools import btcpp
+from agents.trajectory.tools import vass_zones as V
+from tests.test_vass_interlocks import FollowRuntime, HealthyMonitor, ToyGeometry, _table
+
+A0, A1 = -0.6, 0.6                      # arm a's tip angle (base at the origin)
+B0, B1 = math.pi + 0.6, math.pi - 0.6   # arm b's (base at x = 2.1): both tips cross x ~ 1
+
+
+def _geo():
+    return ToyGeometry({"a": [0.0, 0.0, 0.0], "b": [2.1, 0.0, 0.0]})
+
+
+def _lin(q0, q1, t0, t1, n=21, phase="transit"):
+    return [{"positions": [q0 + (q1 - q0) * i / (n - 1)] + [0.0] * 5,
+             "time_s": round(t0 + (t1 - t0) * i / (n - 1), 6), "phase": phase} for i in range(n)]
+
+
+def compound_step(b_start=B1, b_goal=B0, lead="a"):
+    """An ompl-compound step the way the backend emits it: per-arm lift-offs padded with a hold to end together
+    (a lifts 0.3 s, b 0.6 s), a staggered transit candidate (``staggered_paths``: one arm leads by its whole line,
+    the other waits, then goes) on ONE clock, ``tag_sync``. The arms' paths cross the same corridor, never at once."""
+    sb = -0.05 if b_goal < b_start else 0.05
+    lift = {"a": _lin(A0, A0 + 0.05, 0.0, 0.3, n=4), "b": _lin(b_start, b_start + sb, 0.0, 0.6, n=7)}
+    starts, goals = [[A0 + 0.05] + [0.0] * 5, [b_start + sb] + [0.0] * 5], [[A1] + [0.0] * 5, [b_goal] + [0.0] * 5]
+    if lead == "a":
+        cand = next(c for c in cp.staggered_paths(starts, goals)
+                    if np.allclose(c[1][:6], goals[0]) and np.allclose(c[1][6:], starts[1]))  # a first, all the way
+    else:
+        cand = next(c for c in cp.staggered_paths(starts, goals)
+                    if np.allclose(c[1][:6], starts[0]) and np.allclose(c[1][6:], goals[1]))  # b first, all the way
+    transit = []
+    for seg, (p, q) in enumerate(zip(cand, cand[1:])):
+        for i in range(0 if seg == 0 else 1, 21):
+            u = i / 20
+            transit.append({"positions": [float(x) + u * (float(y) - float(x)) for x, y in zip(p, q)],
+                            "time_s": round(seg * 1.0 + u, 6)})
+    joint = cp.compose_timelines(lift, transit, {"a": 6, "b": 6}, {}, {})
+    gid = cp.tag_sync(joint, "cmp_test")
+    return joint, gid
+
+
+def _leg(rid, op, traj, delay_ms=0):
+    n = {"type": "ExecuteTrajectory", "ports": {"robot_ns": rid, "operation_id": op, "operation_type": "move",
+                                               "trajectory": traj, "hold_duration_s": 0.0}}
+    if delay_ms:
+        n = {"type": "Delay", "ports": {"delay_msec": delay_ms}, "children": [n]}
+    return n
+
+
+def two_step_tree(compound_legs=None, b_mid=B1):
+    """Step 1: plain legs, b staggered by a Delay (interlocked under every mode); step 2: the compound step."""
+    joint, _gid = compound_legs or compound_step()
+    root = {"type": "Sequence", "children": [
+        {"type": "Parallel", "children": [_leg("a", "a1", _lin(A1, A0, 0.0, 2.0, n=41)),
+                                          _leg("b", "b1", _lin(B0, b_mid, 0.0, 2.0, n=41), delay_ms=1500)]},
+        {"type": "Parallel", "children": [_leg("a", "a2", joint["a"]), _leg("b", "b2", joint["b"])]}]}
+    return btcpp.to_btcpp({"cell_id": "toy_no_such_cell", "root": root})
+
+
+def _cfg(lockstep):
+    return V.ZoneConfig(path_step_m=0.02, block=4, margin_m=0.0, hull_rule=False, lockstep=lockstep)
+
+
+def _derive(lockstep, tree=None):
+    return V.derive_zones(tree or two_step_tree(), _cfg(lockstep), geometry=_geo())
+
+
+def _legs_of(z):
+    return {o.rid: {o.enter["k"] if o.enter else None, o.exit["k"] if o.exit else None} - {None} for o in z.occ}
+
+
+# ── derivation ──────────────────────────────────────────────────────────────────
+def test_the_compound_step_is_apart_at_each_instant_but_shares_space():
+    joint, _ = compound_step()
+    geo = _geo()
+    from agents.cell.bt_executor import interpolate_trajectory
+    ta = [p["time_s"] for p in joint["a"]]
+    assert ta[-1] == joint["b"][-1]["time_s"] and joint["a"][-21]["time_s"] == joint["b"][-21]["time_s"]
+    ts = np.linspace(0.0, ta[-1], 2001)                                     # one clock for both arms
+    qa = np.array([interpolate_trajectory(joint["a"], t) for t in ts])
+    qb = np.array([interpolate_trajectory(joint["b"], t) for t in ts])
+    ca, cb = geo.spheres("a", qa)[0][:, 0], geo.spheres("b", qb)[0][:, 0]
+    instant = np.linalg.norm(ca - cb, axis=-1) - 2 * geo.r
+    space = np.linalg.norm(ca[:, None] - cb[None], axis=-1) - 2 * geo.r
+    assert instant.min() > 0.05                     # what the compound plan proves
+    assert space.min() < 0.05                       # what a path-only (timing-free) zone derivation sees
+
