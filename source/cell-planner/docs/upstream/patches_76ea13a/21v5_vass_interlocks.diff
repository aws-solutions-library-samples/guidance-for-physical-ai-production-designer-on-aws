+def _smooth_leg(T=3.0, hz=20.0):
+    """A 6-joint leg with a corner, umarell-like knots (20 Hz + a short last sample, as TOPP-RA emits)."""
+    ts = list(np.arange(0.0, T, 1.0 / hz)) + [T - 0.013, T]
+    ts = sorted(set(round(t, 6) for t in ts))
+    out = []
+    for t in ts:
+        x = t / T
+        s = 10 * x ** 3 - 15 * x ** 4 + 6 * x ** 5
+        q = [0.9 * s, -0.6 * s * s, 0.4 * math.sin(math.pi * s), 1.1 * s, -0.8 * s, 1.5 * s]
+        out.append({"positions": [round(v, 6) for v in q], "time_s": round(t, 4)})
+    return out
+
+
+def _jtc_cycle_acc(pts, cycle=0.004):
+    from utils.fjt_trajectory import cycle_accelerations
+    return cycle_accelerations([p["time_s"] for p in pts], [p["positions"] for p in pts],
+                               [p["velocities"] for p in pts], [p["accelerations"] for p in pts], cycle)
+
+
+def _ideal_acc(path, prof, cycle=0.004):
+    ts = np.arange(0.0, prof.t_end + cycle, cycle)
+    Q = path.cmd_eval(np.array([prof.tau(t) for t in ts]))[0]
+    return np.abs(np.diff(Q, 2, axis=0)).max(axis=0) / cycle ** 2
+
+
+@pytest.mark.parametrize("stop_frac,T_stop", [(0.3, 0.5), (0.55, 0.3), (0.8, 1.0)])
+def test_retimed_goals_keep_the_retimings_acceleration(stop_frac, T_stop):
+    """Round-3 verification: brake / resume goals (from rest) and in-motion replacements reached 2-4 a_max in the JTC
+    because 20 ms ramp points were mixed with the mapped knots (spacings down to 1 ms). On the uniform grid with the
+    exact derivatives the JTC command keeps the re-timing's own acceleration."""
+    from utils.fjt_trajectory import fjt_points, sample
+    leg = _smooth_leg()
+    path = LegPath(leg)
+    st = stop_frac * path.t_end
+    for prof in (Profile.plan(path.t0, 0.0, st, 1.0, T_stop, path.t_end),       # brake from rest
+                 Profile.plan(st, 0.0, None, 1.0, T_stop, path.t_end)):          # resume from the stop point
+        pts = prof.sample(path)
+        new = _jtc_cycle_acc(pts)
+        ideal = _ideal_acc(path, prof)
+        assert np.all(new <= 1.05 * ideal + 0.05), (new, ideal)
+        # the v4 sampler through the agent's spline fit rang above it
+        old = fjt_points([{"positions": p["positions"], "time_s": p["time_s"]} for p in prof.sample_polyline(path)])
+        old_a = _jtc_cycle_acc(old)
+        assert new.max() <= old_a.max() + 1e-9
+    # in-motion replacement: a grant during the brake -> the rest of the leg from the running goal's state
+    brake = Profile.plan(path.t0, 0.0, st, 1.0, T_stop, path.t_end)
+    run = brake.sample(path)
+    ts = 0.4 * brake.t_end + 0.15
+    if ts < brake.t_end - 1e-3:
+        rep = Profile.plan(brake.tau(ts), brake.rate(ts), None, 1.0, T_stop, path.t_end)
+        if not rep.hard_brake:
+            pr = rep.sample(path)
+            q_run, v_run, _a = sample([dict(p, t=p["time_s"]) for p in run], ts)
+            assert np.allclose(pr[0]["positions"], q_run, atol=2e-6)       # same position ...
+            assert np.allclose(pr[0]["velocities"], v_run, atol=2e-4)      # ... and velocity at the switch
+            assert np.all(_jtc_cycle_acc(pr) <= 1.05 * _ideal_acc(path, rep) + 0.05)
+
