+# ── derivation on a toy planar geometry ─────────────────────────────────────────
+class ToyGeometry:
+    """Two one-link planar arms (one sphere at the tip) whose tips sweep the same corridor."""
+
+    def __init__(self, bases, length=1.0, radius=0.1, threshold=0.05):
+        self.bases = {r: np.asarray(b, float) for r, b in bases.items()}
+        self.L = length
+        self.r = radius
+        self.rules = [{"name": "umarell_spheres", "threshold_m": threshold, "radius_m": radius}]
+
+    def spheres(self, rid, Q):
+        Q = np.asarray(Q, float)
+        b = self.bases[rid]
+        tip = np.stack([b[0] + self.L * np.cos(Q[:, 0]), b[1] + self.L * np.sin(Q[:, 0]), np.zeros(len(Q))], 1)
+        C = tip[:, None, :]
+        J = np.repeat(np.repeat(b[None, None, :], len(Q), 0), 6, 1)
+        return C, np.array([1]), J
+
+    def tcp(self, rid, Q):
+        return self.spheres(rid, Q)[0][:, 0, :]
+
+    def a_max(self, rid):
+        return np.full(6, 10.0)
+
+
+def _toy_tree(lag_b=0.0):
+    # arm a sweeps its tip through the corridor first; arm b passes through the same place later
+    ta = _traj(-0.6, 0.6, T=2.0, n=41)
+    tb = _traj(math.pi + 0.6, math.pi - 0.6, T=2.0, n=41)
+    for p in ta + tb:
+        p["phase"] = "transit"
+    root = {"type": "Parallel", "children": [
+        {"type": "ExecuteTrajectory", "ports": {"robot_ns": "a", "operation_id": "A", "operation_type": "move",
+                                               "trajectory": ta, "hold_duration_s": 0.0}},
+        {"type": "Sequence", "children": [
+            {"type": "Delay", "ports": {"delay_msec": 1500}, "children": [
+                {"type": "ExecuteTrajectory", "ports": {"robot_ns": "b", "operation_id": "B",
+                                                       "operation_type": "move", "trajectory": tb,
+                                                       "hold_duration_s": 0.0}}]}]}]}
+    return btcpp.to_btcpp({"cell_id": "toy_no_such_cell", "root": root})
+
+
+def test_derived_zones_cover_every_conflicting_sample_pair():
+    from agents.trajectory.tools import vass_zones as V
+    geo = ToyGeometry({"a": [0.0, 0.0, 0.0], "b": [2.0, 0.0, 0.0]})
+    tree = _toy_tree()
+    cfg = V.ZoneConfig(path_step_m=0.02, block=4, margin_m=0.0, hull_rule=False)
+    table = V.derive_zones(tree, cfg, geometry=geo)
+    assert table.zones, "the arms' tips share a corridor: there must be zones"
+    assert table.stats["nominal"]["completed"]
+    # brute force: every conflicting configuration pair is inside some zone's two intervals
+    legs = V.program_legs(tree)
+    qa = np.array([p["positions"] for p in legs["a"][0]["traj"]])
+    qb = np.array([p["positions"] for p in legs["b"][0]["traj"]])
+    ta = [p["time_s"] for p in legs["a"][0]["traj"]]
+    tb = [p["time_s"] for p in legs["b"][0]["traj"]]
+    ca, cb = geo.spheres("a", qa)[0][:, 0], geo.spheres("b", qb)[0][:, 0]
+    d = np.linalg.norm(ca[:, None] - cb[None], axis=-1) - 2 * geo.r
+    for i, j in zip(*np.nonzero(d <= 0.05)):
+        covered = False
+        for z in table.zones:
+            oa = next(o for o in z.occ if o.rid == "a")
+            ob = next(o for o in z.occ if o.rid == "b")
+            ina = (oa.enter is None or ta[i] >= oa.enter["t"]) and (oa.exit is None or ta[i] <= oa.exit["t"])
+            inb = (ob.enter is None or tb[j] >= ob.enter["t"]) and (ob.exit is None or tb[j] <= ob.exit["t"])
+            covered |= ina and inb
+        assert covered, (i, j)
+    ann = V.annotate_tree(tree, table)
+    assert V.check_bt(ann) == []
+    assert "metadata" in ann and ann["metadata"]["vass"]["table_sha256"] == table.sha256
