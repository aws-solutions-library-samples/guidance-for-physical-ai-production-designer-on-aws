+def test_leg_dependencies_of_parallel_and_delay():
+    tree = _toy_tree()
+    assert V.leg_dependencies(tree) == []                      # a Parallel: no cross-arm order
+    seq = btcpp.to_btcpp({"cell_id": "toy", "root": {"type": "Sequence", "children": [
+        tree["root"]["children"][0], tree["root"]["children"][1]]}})
