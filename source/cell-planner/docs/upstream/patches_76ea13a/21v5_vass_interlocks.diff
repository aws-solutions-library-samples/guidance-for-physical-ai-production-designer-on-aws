+"""VASS-style PLC interlocks: zone table, PLC emulator, path-preserving supervisor, executor, derivation.
+
+No ROS, no pinocchio: the executor runs on a fake runtime that follows dispatched goals
+exactly (with ROS-1-style goal replacement), the PLC and the clients talk over the
+in-process bus, and the zone derivation runs on a toy planar geometry.
+"""
+from __future__ import annotations
+
+import json
+import math
+import threading
+import time
+
+import numpy as np
+import pytest
+
+from agents.cell import vass_protocol as P
+from agents.cell.vass_motion import LegPath, Profile, ramp_ok
+from agents.cell.vass_plc import PlcConfig, PlcCore, PlcEmulator
+from agents.cell.vass_transport import LocalBus, LocalTransport, keyexpr_match
+from agents.cell.vass_client import VassSession
+from agents.trajectory.tools import btcpp
+
+
+# ── helpers ─────────────────────────────────────────────────────────────────────
+def _traj(q0, q1, T=1.0, n=21):
+    return [{"positions": [q0 + (q1 - q0) * i / (n - 1)] + [0.0] * 5, "time_s": T * i / (n - 1)}
+            for i in range(n)]
+
+
+def _table(zones, robots=("r1", "r2"), legs=None, arbitration="plan"):
+    d = {"format": P.TABLE_FORMAT, "proto": 1, "cell_id": "toy", "robots": list(robots),
+         "arbitration": arbitration, "config": {"guard_s": 0.05},
+         "legs": legs or {r: [{"k": 0, "t_end": 1.0}] for r in robots}, "zones": zones}
+    d["sha256"] = P.table_sha256(d)
+    return P.ZoneTable(d)
+
+
+def _zone(zid, first, second, f_rng, w_rng, f_t=(0.0, 1.0), w_t=(2.0, 3.0)):
+    def occ(rid, order, rng, tn):
+        return {"rid": rid, "order": order, "enter": {"k": 0, "t": rng[0]}, "exit": {"k": 0, "t": rng[1]},
+                "stop": {"k": 0, "t": max(0.0, rng[0] - 0.05)}, "t_stop_s": 0.25, "t_nom": list(tn)}
+    return {"id": zid, "pair": sorted([first, second]), "first": first,
+            "occ": [occ(first, 0, f_rng, f_t), occ(second, 1, w_rng, w_t)]}
+
+
+def _msg(env, key, body, now=0.0):
+    return env.wrap(key, body, now)
+
+
+# ── format layer ────────────────────────────────────────────────────────────────
+def test_leaf_ports_declare_interlocks_and_nodes():
+    assert "interlocks" in btcpp.LEAF_PORTS["ExecuteTrajectory"]
+    assert "interlocks" in btcpp.LEAF_PORTS["MoveHome"]
+    assert {"RequestInterlock", "ReleaseInterlock"} <= set(btcpp.LEAF_PORTS)
+
+
+def test_interlocks_port_goes_to_the_blackboard_and_round_trips_xml():
+    ilk = [{"zone": "z0001", "occ": "z0001/robot1", "k": 0, "enter_t": 0.2, "exit_t": 0.6, "stop_t": 0.15}]
+    tree = btcpp.to_btcpp({"root": {"type": "Sequence", "children": [
+        {"type": "ExecuteTrajectory", "ports": {"robot_ns": "robot1", "operation_id": "W1",
+                                               "trajectory": _traj(0, 1), "interlocks": ilk}},
+        {"type": "RequestInterlock", "ports": {"robot_ns": "robot1", "zones": ["z0001", "z0002"]}},
+        {"type": "ReleaseInterlock", "ports": {"robot_ns": "robot1", "zones": "z0001;z0002"}}]}})
+    leaf = tree["root"]["children"][0]
+    ref = leaf["ports"]["interlocks"]
+    assert ref.startswith("{") and tree["blackboard"][ref[1:-1]] == ilk
+    back = btcpp.from_xml(tree["xml"], tree["blackboard"])
+    req = back["root"]["children"][1]
+    assert P.parse_zone_list(req["ports"]["zones"]) == ["z0001", "z0002"]
+    assert P.parse_zone_list(back["root"]["children"][2]["ports"]["zones"]) == ["z0001", "z0002"]
+    assert P.parse_interlocks(btcpp.resolve(back["root"]["children"][0]["ports"]["interlocks"],
+                                            tree["blackboard"])) == ilk
+
+
+def test_tree_without_interlocks_converts_unchanged():
+    src = {"root": {"type": "ExecuteTrajectory", "ports": {"robot_ns": "r", "operation_id": "o",
+                                                         "trajectory": _traj(0, 1)}}}
+    t = btcpp.to_btcpp(src)
+    assert "interlocks" not in t["root"]["ports"]
+    assert not [k for k in t["blackboard"] if k.startswith("ilk_")]
