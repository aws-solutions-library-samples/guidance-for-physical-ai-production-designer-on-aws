+class _LockstepLegZones:
+    """Entries and releases of a lockstep leg's zones on the arm's MEASURED progress. The leg itself runs as
+    planned (upstream's dispatch, barrier, lag e-stop and arrival check); every zone it enters was granted before
+    it left. Progress = projection of the joints on the leg's smooth command, bounded by the plain goal's own
+    clock (+0.05 s); the end is credited once the clock has ended and the arm is within ``arrive_tol_m``."""
+
+    def __init__(self, ex, c, robot_id, k, traj, ilks):
+        import numpy as np
+        from agents.cell.vass_motion import LegPath
+        from agents.cell.vass_protocol import occ_id
+        sess = ex._vsess
+        self.ex, self.c, self.rid, self.k = ex, c, robot_id, k
+        self.path = LegPath(traj)
+        self.sigma = self.path.t0
+        self.guard = sess.guard_s
+        self.track_tol = sess.track_tol_m
+        self.arrive_tol = float(getattr(sess, "arrive_tol_m", None) or sess.track_tol_m)
+        self.R = np.asarray(sess.radii.get(robot_id) or [3.0] * 6, float)[:6]
+        self.last_q = None
+        self.at_end = False
+        self.occ = [{"oid": e.get("occ") or occ_id(e["zone"], robot_id),
+                     "enter": None if e.get("enter_t") is None else float(e["enter_t"]),
+                     "exit": None if e.get("exit_t") is None else float(e["exit_t"]),
+                     "entered": e.get("enter_t") is None, "released": False} for e in ilks]
+
+    def _weighted(self, qa, qb) -> float:
+        import numpy as np
+        d = np.abs(np.asarray(qa, float)[:6] - np.asarray(qb, float)[:6])
+        d = np.minimum(d, 2 * np.pi - d)
+        return float(d @ self.R[: len(d)])
+
+    def update(self, q, tau_clock: float) -> bool:
+        """One tick: progress, entries, releases, status level. True once the arm is at the leg end."""
+        if not q:
+            return self.at_end
+        import numpy as np
+        p = self.path
+        hi = min(float(tau_clock), p.t_end) + 0.05
+        s_new, _err = p.project_cmd(q, self.sigma - 1e-3, max(hi, self.sigma) + 1e-6)
+        self.sigma = max(self.sigma, s_new)
+        if self.sigma >= p.t_end - 1e-6 or (tau_clock >= p.t_end - 1e-3 and
+                                             self._weighted(q, p.cmd_q(p.t_end)) <= self.arrive_tol):
+            self.sigma, self.at_end = p.t_end, True
+        track = self._weighted(q, p.cmd_q(self.sigma))
+        self.last_q = np.asarray(q, float)
+        for o in self.occ:
+            if not o["entered"] and o["enter"] is not None and self.sigma > o["enter"] + 1e-9:
+                o["entered"] = True
+                self.c.entered(o["oid"], self.k, self.sigma)
+            if o["entered"] and not o["released"] and o["exit"] is not None and \
+                    (self.sigma > o["exit"] + self.guard - 1e-9 or (self.at_end and self.sigma >= o["exit"])) and \
+                    (track <= self.track_tol or self.at_end):
+                o["released"] = True
+                self.c.release(o["oid"], self.k, self.sigma, q=q, track_err=track)
+        self.c.set_pos(self.k, self.sigma, q=q, track_err=track, mode="RUN")
+        return self.at_end
+
+    def finish(self, node, timeout_s: float) -> "tuple[bool, Optional[dict]]":
+        """After upstream's arrival check: wait (bounded) until the end is credited, then release what is left."""
+        ex = self.ex
+        deadline = ex._rt.now() + float(timeout_s)
+        while not self.update(ex._joints(self.rid), float("inf")):
+            if ex._abort.is_set():
+                return False, ex._abort_failure
+            if ex._rt.now() >= deadline:
+                return False, {"failed_node_id": node.get("id"), "node_type": "ExecuteTrajectory",
+                               "robot_ns": self.rid, "reason_code": "arrival_timeout",
+                               "reason": (f"{self.rid} is not within {self.arrive_tol * 1000:.0f} mm of the end of "
+                                          f"its lockstep leg after {timeout_s:.1f} s: its zones stay held")}
+            time.sleep(ex._tick)
+        self.c.set_pos(self.k, self.path.t_end, mode="RUN", waiting_for=None)
+        return True, None
+
+
+def _sync_groups_of(tree: dict, bb: dict) -> set:
+    """The ``sync_group`` tags of the tree's legs (ompl-compound steps)."""
+    out: set = set()
+
+    def walk(n):
+        if not isinstance(n, dict):
+            return
+        if node_kind(n) in ("ExecuteTrajectory", "MoveHome"):
+            tr = trajectory_of(n, bb)
+            if tr and isinstance(tr[0], dict) and tr[0].get("sync_group"):
+                out.add(str(tr[0]["sync_group"]))
+        for ch in bt_children(n):
+            walk(ch)
+    walk(tree.get("root"))
+    return out
+
+
+def _lockstep_table_mismatch(tree: dict, table, bb: dict, lockstep: bool) -> Optional[str]:
+    """Why the zone table cannot run under this executor's lockstep setting, or None.
+
+    A table derived for LOCKSTEP=1 has no zones between the arms of one compound step (the barrier and the lag
+    e-stop keep them apart); run without lockstep those legs would be unguarded. A table derived without it
+    has such zones, and a lockstep leg cannot wait inside its step. Only trees with compound legs care."""
+    if table is None or not _sync_groups_of(tree, bb):
+        return None
+    derived = bool(((table.raw or {}).get("config") or {}).get("lockstep", False))
+    if derived == bool(lockstep):
+        return None
+    return (f"zone table {getattr(table, 'short', '')} was derived for LOCKSTEP={int(derived)} but the executor runs "
+            f"LOCKSTEP={int(bool(lockstep))}, and the tree has ompl-compound (sync_group) legs: re-derive the zones "
+            f"with the executor's setting (robots.yaml vass: lockstep / $LOCKSTEP; vass_zones --lockstep)")
+
+
+def _tree_has_kind(node, kinds) -> bool:
+    if not isinstance(node, dict):
+        return False
+    if node_kind(node) in kinds:
+        return True
+    return any(_tree_has_kind(ch, kinds) for ch in bt_children(node))
+
 
 def _collision_failure(col: dict, robot_ns: Optional[str] = None) -> dict:
     """Normalise a collision-monitor detail into the executor failure shape."""
