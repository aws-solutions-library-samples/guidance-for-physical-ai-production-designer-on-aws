+def test_pair_path_reorders_a_two_cycle():
+    """Two zones of one crossing with opposite orders (a first in one, b first in the other, intervals
+    interleaved): every execution deadlocks; the monotone-path orders complete."""
+    geo, tree, cfg, table, legs = _toy_table()
+    zs = sorted(table.zones, key=lambda z: P.pos_key(z.occ[0].enter))
+    assert len(zs) >= 2
+    bad = copy.deepcopy(table)
+    z = bad.zones[len(bad.zones) // 2]
+    f, w = z.occ
+    f.order, w.order = 1, 0
+    z.occ, z.first = [w, f], w.rid
+    r = V.nominal_check(tree, bad, legs, cfg, model="event")
+    if r["completed"]:
+        pytest.skip("this toy table tolerates the flip (no 2-cycle)")
+    deps = V.leg_dependencies(tree)
+    orders = V._pair_path_orders(bad.zones, "a", "b", legs, bad, deps, cfg.guard_s)
+    assert orders is not None
+    for zz in bad.zones:
+        if orders.get(zz.id, zz.first) != zz.first:
+            f, w = zz.occ
+            f.order, w.order = 1, 0
+            zz.occ, zz.first = [w, f], w.rid
+    assert V.nominal_check(tree, bad, legs, cfg, model="event")["completed"]
+
+
+def _occ(enter, stop, exit_=None):
+    return P.Occupancy(zone="z0001", rid="a", order=1, enter=enter, exit=exit_, stop=stop, t_stop_s=0.25)
+
