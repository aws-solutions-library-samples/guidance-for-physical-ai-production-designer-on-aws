+def _wait_status(core, rid, wz, pos, now, mode="WAIT", inside=(), granted=()):
+    _feed(core, rid, core.keys.robot(rid, "status"), {"rid": rid, "mode": mode, "pos": pos, "waiting_for": wz,
+                                                       "inside": list(inside), "granted": list(granted),
