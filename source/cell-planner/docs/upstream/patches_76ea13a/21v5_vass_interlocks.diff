+         "stop": {"k": 0, "t": 0.15}, "t_stop_s": 0.25, "t_nom": [0.2, 0.9]},
+        {"rid": "b", "order": 1, "enter": {"k": 0, "t": 0.3}, "exit": {"k": 0, "t": 0.7},
+         "stop": {"k": 0, "t": 0.0}, "t_stop_s": 0.25, "t_nom": [1.0, 1.4]}]}
+    table = _table([z], robots=("a", "b"), legs={"a": [{"k": 0, "t_end": 1.5}], "b": [{"k": 0, "t_end": 1.0}]})
