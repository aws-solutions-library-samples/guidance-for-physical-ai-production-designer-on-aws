+                sess = open_session(self._cell_id, table, cfg)
+                self._vass_owned = True
+            except Exception as exc:  # noqa: BLE001 - no zenoh / no router
+                sess = None
+                self._vass_report["error"] = f"cannot open the PLC session: {exc}"
+        if sess is None:
+            if required or uses_nodes:
