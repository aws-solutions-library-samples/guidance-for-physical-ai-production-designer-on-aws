+# ── executor end to end (in-process bus) ──────────────────────────────────────────
+class FollowRuntime:
+    """Follows dispatched goals exactly; ``lag`` delays new goals of a robot; ROS-1 goal replacement."""
+
+    def __init__(self, home, lag=None, kappa=None):
+        self.t0 = time.monotonic()
+        self.lock = threading.Lock()
+        self.lag = lag or {}
+        self.kappa = kappa or {}
+        self.seg = {r: [(0.0, np.array([0.0, 1e-6]), np.array([q, q], float), None)] for r, q in home.items()}
+        self.trace = {r: [] for r in home}
+        self.dispatched = []
+
+    def now(self):
+        return time.monotonic() - self.t0
+
+    def robots(self):
+        return list(self.seg)
+
+    def _active(self, r, t):
+        cur = self.seg[r][0]
+        for s in self.seg[r]:
+            if s[0] <= t:
+                cur = s
+        return cur
+
+    def q(self, r, t):
+        st, ts, qs, gid = self._active(r, t)
+        lt = (t - st) * self.kappa.get(r, 1.0)
+        return np.array([np.interp(lt, ts, qs[:, j]) for j in range(qs.shape[1])]), gid, lt
+
+    def latest_status(self, r):
+        with self.lock:
+            q, gid, lt = self.q(r, self.now())
+        return {"joint_positions": list(q), "goal_id": gid, "goal_time_s": lt}
+
+    def dispatch(self, r, task):
+        vs = float(task.get("velocity_scale", 1.0)) or 1.0
+        ts = np.array([float(p["time_s"]) / vs for p in task["trajectory"]])
+        qs = np.array([p["positions"][:6] for p in task["trajectory"]], float)
+        self.dispatched.append((r, task))
+        rep = task.get("replace")
+        if rep:
+            with self.lock:
+                now = self.now()
+                st, _t, _q, gid = self._active(r, now)
+                lt = (now - st) * self.kappa.get(r, 1.0)
+                if gid != rep["of"] or lt >= rep["at_s"]:
+                    return
+                t_sw = st + rep["at_s"] / self.kappa.get(r, 1.0)
+                self.seg[r] = [s for s in self.seg[r] if s[0] <= t_sw] + [(t_sw, ts, qs, task.get("goal_id"))]
+            return
+        if self.lag.get(r):
+            time.sleep(self.lag[r])
+        with self.lock:
+            now = self.now()
+            self.seg[r] = [s for s in self.seg[r] if s[0] <= now] + [(now, ts, qs, task.get("goal_id"))]
+
+    def estop(self, reason):
+        pass
+
+
+class HealthyMonitor:
+    """The collision monitor as umarell 76ea13a's executor checks it (``health()`` / ``wait_ready()`` before and
+    during every leg, ``imminent()`` each tick): watching, nothing imminent. ``why`` makes it stop watching."""
+
+    def __init__(self):
+        self.why = None
+
+    def imminent(self):
+        return None
+
+    def health(self):
+        return self.why
+
+    def wait_ready(self, timeout_s):
+        return self.why
+
