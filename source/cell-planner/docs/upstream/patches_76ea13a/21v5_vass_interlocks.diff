+# ── motion ──────────────────────────────────────────────────────────────────────
+@pytest.mark.parametrize("r0,lim", [(0.0, 0.6), (1.0, 0.9), (1.0, 0.3), (0.4, 0.05), (1.0, 0.0)])
+def test_profile_never_passes_the_limit_and_ends_at_rest(r0, lim):
+    pr = Profile.plan(0.0, r0, lim, 1.0, 0.5, 2.0)
+    ts = np.linspace(0, pr.t_end, 400)
+    taus = np.array([pr.tau(t) for t in ts])
+    assert taus.max() <= lim + 1e-9
+    assert np.all(np.diff(taus) >= -1e-12)
+    assert abs(pr.tau_end - lim) < 1e-9 or lim == 0.0
+    assert pr.rate(pr.t_end) == pytest.approx(0.0, abs=1e-9)
+    if not pr.hard_brake:
+        acc = np.abs(np.diff([pr.rate(t) for t in ts])) / max(ts[1] - ts[0], 1e-9)
+        assert acc.max() <= math.pi * 1.0 / (2 * 0.5) * 1.05
