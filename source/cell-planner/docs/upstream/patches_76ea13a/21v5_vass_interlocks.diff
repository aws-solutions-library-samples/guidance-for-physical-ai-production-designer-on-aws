+            table = P.table_of_tree(tree)
+        except ValueError as exc:
+            return self._vass_fail("vass_violation", f"unreadable zone table: {exc}")
+        meta = P.vass_metadata(tree)
+        uses_nodes = _tree_has_kind(tree.get("root"), ("RequestInterlock", "ReleaseInterlock"))
+        cfg: dict = {}
+        if self._vass_given is None and (table is not None or uses_nodes or meta):
+            from agents.cell.vass_client import cell_vass_config
+            cfg = cell_vass_config(self._cell_id)
+        elif self._vass_given is None:
+            from agents.cell.vass_client import cell_vass_config
+            cfg = cell_vass_config(self._cell_id) if os.environ.get("UMARELL_VASS_REQUIRED") else {}
+        required = bool(meta.get("required") or cfg.get("required"))
+        if table is None and not uses_nodes:
+            if required:
+                return self._vass_fail("vass_required",
+                                       "the cell requires PLC interlocks but this tree carries no zone table "
+                                       "(metadata.vass.table) - derive it with vass_zones.annotate_tree")
+            return None
+        sess = self._vass_given
+        if sess is None and cfg.get("enabled", bool(cfg.get("connect"))) and table is not None:
+            try:
