+def test_plc_deadlock_check_needs_both_arms_at_their_stops_for_the_confirm_time():
+    core = _plc(_cycle_table(true_cycle=True), deadlock_confirm_s=1.0)
+    k = core.keys
+    for r in ("r1", "r2"):
+        _feed(core, r, k.robot(r, "status"), {"rid": r, "mode": "RUN", "pos": {"k": 0, "t": 0.0}, "ver": 0}, 0.0)
+    core.cycle(0.0)
+    # r2 holds za (inside), r1 holds the grant of zb
+    for rid, z, rq in (("r2", "za", "r2.1"), ("r1", "zb", "r1.1")):
+        _feed(core, rid, k.zone(z, "req"), {"rid": rid, "req_id": rq, "zones": [z], "occ": f"{z}/{rid}"}, 0.01)
+    core.cycle(0.01)
+    _feed(core, "r2", k.zone("za", "occ"), {"rid": "r2", "zone": "za", "pos": {"k": 0, "t": 0.5}}, 0.02)
+    core.cycle(0.02)
+    assert core.zones["za"]["holder"] == "r2" and core.zones["zb"]["holder"] == "r1"
+    # r1 waits at its stop for za; r2 reports WAIT for zb at the START of leg 1, before its stop (a 21 v2 arm
+    # whose next goal was still being dispatched): no deadlock however long that lasts
+    t = 1.0
+    for _ in range(40):
+        _wait_status(core, "r1", "za/r1", {"k": 0, "t": 1.0}, t, granted=["zb"])
+        _wait_status(core, "r2", "zb/r2", {"k": 1, "t": 0.0}, t, inside=["za"])
+        core.cycle(t)
+        t += 0.1
+    assert core.mode == "RUN" and core.counters["deadlocks"] == 0
+    # both at their stops: a real cycle, confirmed after deadlock_confirm_s
+    t0 = t
+    while t - t0 < 0.8:
+        _wait_status(core, "r1", "za/r1", {"k": 0, "t": 1.0}, t, granted=["zb"])
+        _wait_status(core, "r2", "zb/r2", {"k": 1, "t": 0.2}, t, inside=["za"])
+        core.cycle(t)
+        t += 0.1
+    assert core.mode == "RUN"
+    while t - t0 < 2.0:
+        _wait_status(core, "r1", "za/r1", {"k": 0, "t": 1.0}, t, granted=["zb"])
+        _wait_status(core, "r2", "zb/r2", {"k": 1, "t": 0.2}, t, inside=["za"])
+        core.cycle(t)
+        t += 0.1
+    assert core.mode == "FAULT" and core.counters["deadlocks"] == 1
+    assert "deadlock" in core.fault_why and core.report()["fault_why"] == core.fault_why
+    hb = [m for kk, m, _q in core.cycle(t + 1.0) if kk.endswith("/heartbeat")]
+    assert hb and hb[-1]["mode"] == "FAULT" and "deadlock" in hb[-1]["fault"]
+
