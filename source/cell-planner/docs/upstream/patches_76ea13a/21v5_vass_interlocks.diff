+def test_a_lockstep_leg_waits_for_its_zone_at_rest_before_the_barrier():
+    """b's one-arm compound leg needs a zone a (a plain leg in parallel) holds first: b takes the grant at its
+    start, at rest, and only then leaves the barrier -- no stop in motion, no lockstep_lost."""
