+# ── round 4 (U21FIX): liveness of interlocked legs ────────────────────────────────
+def _curve(T=2.0, n=11, j0=0.6, j1=0.4):
+    """A curved leg whose smooth command (patch 20's spline, at rest at both ends) runs behind the polyline in
+    leg time near its start: the POLYLINE projection of C(s) is short of s (the 21 v2 stall condition)."""
+    return [{"positions": [j0 * i / (n - 1), j1 * (i / (n - 1)) ** 2] + [0.0] * 4, "time_s": T * i / (n - 1)}
+            for i in range(n)]
