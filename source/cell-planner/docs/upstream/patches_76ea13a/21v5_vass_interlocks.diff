+    sess = VassSession("toy", table, LocalTransport(bus), fault_abort_s=1.0).start()
+    rt = FollowRuntime({"r1": [0.0] * 6, "r2": [0.0] * 6})
+    ex = BehaviourTreeExecutor(rt, HealthyMonitor(), _exec_cfg(), vass=sess)
+
+    def fault():
+        time.sleep(1.5)
+        plc.core.mode = "FAULT"
+        plc.core.fault_why = "operator test"
+    threading.Thread(target=fault, daemon=True).start()
+    timer = threading.Timer(30.0, ex.abort, args=("test watchdog",))
+    timer.start()
+    t0 = time.monotonic()
+    try:
+        res = ex.execute(tree)
+    finally:
+        timer.cancel()
+        plc.stop()
