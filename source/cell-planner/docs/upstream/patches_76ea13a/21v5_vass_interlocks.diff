+    def _plc_health(self, c, since: Optional[float]) -> "tuple[Optional[float], Optional[dict]]":
+        """While an arm waits for a grant: the PLC in FAULT (or gone) for longer than the session's
+        ``fault_abort_s`` / ``plc_lost_abort_s`` ends the leg with ``vass_fault`` / ``vass_unavailable``
+        instead of waiting out ``INTERLOCK_TIMEOUT_S`` (900 s: a FAULTed PLC never grants, so the cell
+        just hung). Returns (the new 'bad since' time, a failure or None)."""
+        sess = self._vsess
+        if c.plc_ok():
+            return None, None
+        now = self._rt.now()
+        since = since if since is not None else now
+        fault = c.plc_mode == "FAULT" and c.plc_last_rx is not None and \
+            time.time() - c.plc_last_rx <= sess.hb_timeout_s
+        lim = float(getattr(sess, "fault_abort_s", 20.0) if fault else getattr(sess, "plc_lost_abort_s", 120.0))
+        if now - since > lim:
+            why = getattr(c, "plc_fault_why", None)
+            if fault:
+                return since, {"node_type": "RUN", "robot_ns": c.rid, "reason_code": "vass_fault",
+                               "reason": f"station PLC in FAULT for {now - since:.0f} s"
+                                         + (f" ({why})" if why else "") + f" while {c.rid} waited for "
+                                         f"{c.waiting_for}: reset the PLC (operator) and restart the program"}
+            return since, {"node_type": "RUN", "robot_ns": c.rid, "reason_code": "vass_unavailable",
+                           "reason": f"no station PLC (mode {c.plc_mode}) for {now - since:.0f} s while {c.rid} "
+                                     f"waited for {c.waiting_for}"}
+        return since, None
