+    ilk2 = [{"zone": "z0001", "occ": "z0001/r2", "k": 0, "enter_t": 0.05, "exit_t": r2_exit, "stop_t": 0.0,
+             "t_stop_s": 0.25}]
+    root = {"type": "Parallel", "children": [
+        {"type": "ExecuteTrajectory", "ports": {"robot_ns": "r1", "operation_id": "A", "trajectory": r1_traj,
+                                               "hold_duration_s": 0.0, "interlocks": r1_ilk}},
+        {"type": "ExecuteTrajectory", "ports": {"robot_ns": "r2", "operation_id": "B", "trajectory": tr2,
+                                               "hold_duration_s": 0.0, "interlocks": ilk2}}]}
+    return {"cell_id": "toy", "root": root, "metadata": {"vass": {"table": table.to_json()}}}
