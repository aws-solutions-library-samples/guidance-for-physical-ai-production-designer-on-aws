+# ── protocol ────────────────────────────────────────────────────────────────────
+def test_seq_filter_drops_duplicates_and_detects_restart():
+    f = P.SeqFilter()
+    e = P.Envelope("c", "r1")
+    m1 = e.wrap("k", {})
+    assert f.accept("k", m1) == (True, False)
+    assert f.accept("k", m1)[0] is False
+    e2 = P.Envelope("c", "r1")
+    assert f.accept("k", e2.wrap("k", {})) == (True, True)
+    assert f.accept("k", {"v": 99})[0] is False
+
