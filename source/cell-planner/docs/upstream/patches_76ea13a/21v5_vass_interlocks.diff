+# ── PLC core ────────────────────────────────────────────────────────────────────
+def _plc(table, **cfg):
+    core = PlcCore("toy", table, None, PlcConfig(**cfg), epoch=7)
+    return core
+
+
+def _feed(core, src, key, body, now):
+    env = core._envs.setdefault(src, P.Envelope("toy", src)) if hasattr(core, "_envs") else None
+    if env is None:
+        core._envs = {}
+        env = core._envs.setdefault(src, P.Envelope("toy", src))
+    core.on_sample(key, env.wrap(key, body, now), now)
+
+
+def _grants(outs):
+    return [m for k, m, _q in outs if k.endswith("/grant")]
+
+
+def test_plan_mode_grants_in_plan_order_and_verifies_release():
+    t = _table([_zone("z0001", "r1", "r2", (0.2, 0.6), (0.3, 0.7))])
+    core = _plc(t)
+    keys = core.keys
+    for r in ("r1", "r2"):
+        _feed(core, r, keys.robot(r, "status"), {"rid": r, "mode": "RUN", "pos": {"k": 0, "t": 0.0}}, 0.0)
+    core.cycle(0.0)
+    assert core.mode == "RUN"
+    # the second robot asks first: no grant, the first robot's occupancy is next
+    _feed(core, "r2", keys.zone("z0001", "req"), {"rid": "r2", "req_id": "r2.a.1", "zones": ["z0001"],
+                                                 "occ": "z0001/r2"}, 0.01)
+    assert not _grants(core.cycle(0.01))
+    _feed(core, "r1", keys.zone("z0001", "req"), {"rid": "r1", "req_id": "r1.a.1", "zones": ["z0001"],
+                                                 "occ": "z0001/r1"}, 0.02)
+    g = _grants(core.cycle(0.02))
+    assert [m["rid"] for m in g] == ["r1"]
+    _feed(core, "r1", keys.zone("z0001", "occ"), {"rid": "r1", "zone": "z0001", "pos": {"k": 0, "t": 0.25}}, 0.03)
+    core.cycle(0.03)
+    assert core.zones["z0001"]["state"] == "OCCUPIED"
+    # a release before exit + guard is rejected
+    _feed(core, "r1", keys.zone("z0001", "rel"), {"rid": "r1", "zone": "z0001", "pos": {"k": 0, "t": 0.62}}, 0.04)
+    assert not _grants(core.cycle(0.04))
+    assert core.counters["releases_rejected"] == 1
+    _feed(core, "r1", keys.zone("z0001", "rel"), {"rid": "r1", "zone": "z0001", "pos": {"k": 0, "t": 0.66}}, 0.05)
+    g = _grants(core.cycle(0.05))
+    assert [m["rid"] for m in g] == ["r2"]
+    assert core.counters["I1_double_holder"] == 0 and core.counters["violations"] == 0
+
+
+def test_entry_without_grant_is_a_violation():
+    t = _table([_zone("z0001", "r1", "r2", (0.2, 0.6), (0.3, 0.7))])
+    core = _plc(t)
+    core.cycle(0.0)
+    _feed(core, "r2", core.keys.zone("z0001", "occ"), {"rid": "r2", "zone": "z0001"}, 0.01)
+    core.cycle(0.01)
+    assert core.mode == "FAULT" and core.counters["violations"] == 1
