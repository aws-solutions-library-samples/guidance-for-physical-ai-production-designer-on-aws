+def test_zone_table_round_trip_and_hash():
+    t = _table([_zone("z0001", "r1", "r2", (0.2, 0.6), (0.3, 0.7))])
+    t2 = P.ZoneTable.from_json(json.loads(json.dumps(t.to_json())))
+    assert t2.sha256 == t.sha256 and len(t2.zones) == 1
+    assert [o.id for o in t2.occupancies("r2")] == ["z0001/r2"]
+    assert keyexpr_match("cell/c/plc/zone/*/req", "cell/c/plc/zone/z1/req")
+    assert keyexpr_match("cell/c/**", "cell/c/robot/r1/status")
+    assert not keyexpr_match("cell/c/plc/zone/*/req", "cell/c/plc/zone/z1/grant")
