+    def _vass_take_leg(self, node, robot_id, traj, ilks, leg_k) -> "tuple[bool, Optional[dict], Optional[_LockstepLegZones]]":
+        """A lockstep leg (``sync_group`` under LOCKSTEP=1) takes every zone it enters at rest, at its start,
+        before the barrier: once the group is released nothing may hold it (a held arm is ``lockstep_lost``).
+        The derivation puts these occupancies' stop points at the leg start (``ZoneConfig.lockstep``), so the
+        nominal check certifies this order. Returns (ok, failure, the leg's entry / release tracker)."""
+        node_type = "ExecuteTrajectory"
+        sess = self._vsess
+        c = sess.client(robot_id)
+        if c is None:
+            return False, {"failed_node_id": node.get("id"), "node_type": node_type, "robot_ns": robot_id,
+                           "reason_code": "vass_violation",
+                           "reason": f"{robot_id} has interlocks but no occupancy in the PLC's zone table"}, None
+        k = int(ilks[0].get("k", leg_k))
+        late = [e.get("occ") for e in ilks if e.get("enter_t") is not None and
+                float(e.get("stop_t", 0.0) or 0.0) > 1e-6]
+        if late:
+            fail = {"failed_node_id": node.get("id"), "node_type": node_type, "robot_ns": robot_id,
+                    "reason_code": "vass_lockstep_mismatch",
+                    "reason": (f"lockstep leg {bt_port(node, 'operation_id')} of {robot_id} would stop in motion for "
+                               f"{', '.join(map(str, late[:4]))}: its zone table was not derived for LOCKSTEP=1")}
+            self._raise_abort(fail)
+            return False, fail, None
+        tr = _LockstepLegZones(self, c, robot_id, k, traj, ilks)
+        c.set_pos(k, tr.sigma, mode="RUN")
+        c.ensure_requests()
+        need = [o["oid"] for o in tr.occ if not o["entered"]]
+        for oid in need:
+            c.request_now(oid)
+        for oid in need:                         # one at a time: waiting_for names the zone really awaited
+            ok, fail = self._wait_grants(c, [oid], node.get("id"), node_type, robot_id)
+            if not ok:
+                if fail is not None:
+                    self._raise_abort(fail)
+                return False, fail, None
+        c.set_pos(k, tr.sigma, mode="RUN", waiting_for=None)
+        return True, None, tr
+
+    def _wait_grants(self, c, oids, node_id, node_type, robot_id) -> "tuple[bool, Optional[dict]]":
+        from agents.cell.vass_protocol import INTERLOCK_TIMEOUT_S
+        deadline = self._rt.now() + INTERLOCK_TIMEOUT_S
+        t0 = self._rt.now()
+        bad_since = None
+        while not all(c.granted(o) for o in oids):
+            if self._abort.is_set():
+                return False, self._abort_failure
+            col = self._collision()
+            if col is not None:
+                self._estop(col.get("reason", "imminent collision"))
+                fail = _collision_failure(col, robot_id)
+                self._raise_abort(fail)
+                return False, fail
+            if self._rt.now() >= deadline:
+                return False, {"failed_node_id": node_id, "node_type": node_type, "robot_ns": robot_id,
+                               "reason_code": "interlock_timeout",
+                               "reason": f"no PLC grant for {', '.join(oids)} within {INTERLOCK_TIMEOUT_S:.0f} s"}
+            c.mode, c.waiting_for = "WAIT", oids[0]
+            bad_since, fail = self._plc_health(c, bad_since)
+            if fail is not None:
+                fail.update(failed_node_id=node_id, node_type=node_type)
+                self._raise_abort(fail)
+                return False, fail
+            c.wait_change(min(self._tick, 0.02))
+        self._add_wait(robot_id, self._rt.now() - t0)
+        c.mode, c.waiting_for = "RUN", None
+        return True, None
