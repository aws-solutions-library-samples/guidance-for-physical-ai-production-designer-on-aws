+# ── executor ────────────────────────────────────────────────────────────────────
+class OpLagRuntime(FollowRuntime):
+    """FollowRuntime with a per-operation acceptance lag and dispatch times."""
+
+    def __init__(self, home, op_lag=None):
+        super().__init__(home)
+        self.op_lag = op_lag or {}
+        self.t_disp = []
+
+    def dispatch(self, r, task):
+        if not task.get("replace") and self.op_lag.get(task.get("operation_id")):
+            time.sleep(self.op_lag[task["operation_id"]])
+        self.t_disp.append((self.now(), r, task.get("operation_id"), bool(task.get("replace"))))
+        task = dict(task)
+        super().dispatch(r, task)
+
+
+def _exec_cfg(lockstep):
+    return ExecConfig(tick_hz=100.0, completion_margin_s=0.0, schedule_check_warmup_s=10.0, lockstep=lockstep,
+                      lockstep_start_timeout_s=10.0)
+
+
+def _run(tree, table, rt, lockstep, monitor=None, timeout_s=60.0):
+    bus = LocalBus()
+    plc = PlcEmulator(LocalTransport(bus), "toy", table, cfg=PlcConfig()).start()
+    sess = VassSession("toy", table, LocalTransport(bus)).start()
+    ex = BehaviourTreeExecutor(rt, monitor or HealthyMonitor(), _exec_cfg(lockstep), vass=sess)
+    timer = threading.Timer(timeout_s, ex.abort, args=("test watchdog",))
+    timer.daemon = True
+    timer.start()
+    try:
+        res = ex.execute(tree)
+    finally:
+        timer.cancel()
+        rep = plc.stop()
+        sess.close()
+        bus.close()
+    return res, rep
+
+
+def _home():
+    return {"a": [A1] + [0.0] * 5, "b": [B0] + [0.0] * 5}
+
+
+def test_lockstep_run_interlocks_the_staggered_step_and_never_holds_the_compound_step():
+    table = _derive(True)
+    tree = V.annotate_tree(two_step_tree(), table)
+    rt = OpLagRuntime(_home(), op_lag={"a1": 1.2})      # a is late in step 1: b must wait for it there
+    res, rep = _run(tree, table, rt, lockstep=True)
+    assert res["success"], res
+    assert rep["I7_ok"] and rep["counters"]["violations"] == 0
+    assert res["vass"]["mode"] == "interlocked"
+    assert res["vass"]["stops"].get("b", 0) >= 1                         # step 1: b held before the corridor
+    comp = [d for d in rt.t_disp if d[2] in ("a2", "b2")]
+    assert len(comp) == 2 and not any(d[3] for d in comp)                 # one plain goal each, no splice
+    assert abs(comp[0][0] - comp[1][0]) < 0.05                            # off the barrier
+    for r, task in rt.dispatched:
+        if task["operation_id"] in ("a2", "b2"):
+            assert task["trajectory"] is tree_traj(tree, r, task["operation_id"])   # exactly as planned
+
+
+def tree_traj(tree, rid, op):
+    found = []
+
+    def walk(n):
+        if btcpp.node_kind(n) == "ExecuteTrajectory" and btcpp.port(n, "operation_id") == op:
+            found.append(btcpp.trajectory_of(n, tree.get("blackboard") or {}))
+        for ch in btcpp.children(n):
+            walk(ch)
+    walk(tree["root"])
+    return found[0]
+
