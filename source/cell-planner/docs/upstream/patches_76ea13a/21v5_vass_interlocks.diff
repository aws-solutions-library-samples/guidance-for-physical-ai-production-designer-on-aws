+    # ── VASS interlocks ───────────────────────────────────────────────────────────
+    def _next_leg(self, robot_id) -> int:
+        """Index of this robot's leg in its program (ExecuteTrajectory / MoveHome, walk order),
+        the ``k`` of the zone table's program positions."""
+        with self._leg_lock:
+            k = self._leg_k.get(str(robot_id), -1) + 1
+            self._leg_k[str(robot_id)] = k
+            return k
+
+    def _leg_interlocks(self, node: dict) -> list:
+        from agents.cell.vass_protocol import parse_interlocks
+        return parse_interlocks(bt_resolve(bt_port(node, "interlocks"), self._bb))
+
+    def _vass_pos(self, robot_id, k, t) -> None:
+        if self._vsess is not None:
+            c = self._vsess.client(robot_id)
+            if c is not None:
+                c.set_pos(k, t, mode="RUN")
+
+    def _vass_fail(self, code: str, reason: str, **extra) -> dict:
+        f = {"node_type": "ROOT", "reason_code": code, "reason": reason}
+        f.update(extra)
+        return f
+
