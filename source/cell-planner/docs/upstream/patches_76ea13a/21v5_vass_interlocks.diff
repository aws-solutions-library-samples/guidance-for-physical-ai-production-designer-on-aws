@@ -0,0 +1,893 @@
+"""Reference VASS-like station PLC emulator for umarell's interlock zones (zenoh, PROFINET later).
+
+    python -m agents.cell.vass_plc --plan cells/<cell>/agentic_planner/plans/<tree>.json \
+        --router tcp/0.0.0.0:7447 --log /tmp/vass_run          # embed the zenoh router
+    python -m agents.cell.vass_plc --plan plan.json --connect tcp/<router>:7447 --log <dir>
+
+The PLC is the single arbiter of the zones a plan carries (``metadata.vass.table``,
+see ``agents.cell.vass_protocol``). Every zone has at most one holder. Robots
+(umarell's executor, one client per arm) request a zone ahead of its stop point,
+enter only with the grant, report "occupied" when they pass the entry and
+"released" once their measured position is past the exit; the PLC verifies the
+release against the zone table (position past the exit + guard, tracking error)
+before it frees the zone and grants the next robot.
+
+Arbitration:
+  * ``plan`` (default): each zone has a fixed order from the nominal plan. A
+    request is granted when the zone is FREE and the request is for the zone's
+    next occupancy ``occ[served]``; a request for a later occupancy waits for its
+    predecessor's release even if the predecessor has not requested yet - that IS
+    the plan order. Deadlock-free for any timing once the interlocked nominal run
+    completes (the derivation checks that run).
+  * ``fifo`` / ``priority``: per-zone FIFO of atomic zone sets (hand-written trees,
+    ``RequestInterlock`` nodes), all-or-nothing grants, no starvation.
+
+All decisions are taken in the single-threaded :meth:`PlcCore.cycle`; transport
+threads only queue inputs. Levels repeat (robot status, PLC io image, zone state),
+so a lost event is repaired by the next level message. A robot whose heartbeat /
+status stops for ``hb_timeout_s`` (or whose liveliness token disappears) is LOST:
+the zones it holds become BLOCKED and only the robots that need them stop.
+
+Outputs: ``events.jsonl`` (one JSON object per event) and ``plc_report.json`` at
+stop (per zone: grants, waits, hand-over gaps; per robot: requests, waits; the live
+invariant counters). This is a coordination layer, NOT a safety PLC: personnel
+safety and the independent collision backstop stay with the safety controller.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import threading
+import time
+from dataclasses import dataclass
+from typing import Optional
+
+from agents.cell import vass_protocol as P
+
+
+@dataclass
+class PlcConfig:
+    arbitration: Optional[str] = None      # None = the table's
+    cycle_s: float = P.PLC_CYCLE_S
+    hb_period_s: float = P.HB_PERIOD_S
+    hb_timeout_s: float = P.HB_TIMEOUT_S
+    level_period_s: float = P.LEVEL_PERIOD_S
+    zone_state_period_s: float = P.ZONE_STATE_PERIOD_S
+    recover_timeout_s: float = P.RECOVER_TIMEOUT_S
+    release_reject_s: float = P.RELEASE_REJECT_S
+    grant_warn_s: float = P.GRANT_WARN_S
+    deadlock_confirm_s: float = P.DEADLOCK_CONFIRM_S
+    guard_s: Optional[float] = None        # None = the table's config.guard_s
+    track_tol_m: float = P.TRACK_TOL_M
+    verify_tracking: bool = True
+    fault_action: str = "stop"
+    expected_robots: Optional[list] = None  # None = the table's robots
+    mutant_double_grant: bool = False       # positive control ONLY: grant a zone to two robots
+
+
+class PlcCore:
+    """Sans-IO PLC: ``on_sample`` / ``on_liveliness`` queue inputs, ``cycle(now)`` decides and returns outputs."""
+
+    def __init__(self, cell: str, table: P.ZoneTable, plan: Optional[dict] = None,
+                 cfg: Optional[PlcConfig] = None, epoch: Optional[int] = None):
+        self.cfg = cfg or PlcConfig()
+        self.cell = cell
+        self.keys = P.Keys(cell)
+        self.table = table
+        self.arbitration = self.cfg.arbitration or table.arbitration or "plan"
+        self.guard_s = float(self.cfg.guard_s if self.cfg.guard_s is not None
+                             else table.config.get("guard_s", P.GUARD_S))
+        self.env = P.Envelope(cell, "plc")
+        self.env.epoch = int(epoch if epoch is not None else time.time())
+        self.env.table = table.short
+        self.mode = "RECOVER"
+        self.cycle_n = 0
+        self.events: list = []
+        self.on_event = None
+        self._inputs: list = []
+        self._lock = threading.Lock()
+        self._seq = P.SeqFilter()
+        self.robots: dict = {}
+        for rid in (self.cfg.expected_robots or table.robots):
+            self.robots[rid] = {"seen": False, "lost": False, "last_rx": None, "sess": None,
+                                "status": {}, "mode": "INIT", "requests": 0, "wait_s": 0.0}
+        self.zones: dict = {}
+        for z in table.zones:
+            self.zones[z.id] = {"state": "FREE", "holder": None, "req_id": None, "served": 0,
+                                "since": None, "grants": 0, "occupied_s": 0.0, "waits": [],
+                                "handover": [], "freed_at": None, "skipped": set(), "fifo": [],
+                                "reject_since": None, "holders": set()}
+        self.pending: dict = {}          # req_id -> request
+        self.counters = {"I1_double_holder": 0, "I2_out_of_order": 0, "violations": 0,
+                         "releases_rejected": 0, "stale": 0, "bad_msg": 0, "deadlocks": 0}
+        self._t_recover = None
+        self._last_level = -1e9
+        self._last_hb = -1e9
+        self._last_zstate = -1e9
+        self._last_dl = -1e9
+        self._dl_cand = None             # (signature, first seen) of a wait-for cycle not yet confirmed
+        self.fault_why = None            # why the PLC is in FAULT (heartbeat / io / report)
+        self._zone_dirty: set = set()
+        self.plan = plan
+        self._paths = _plan_paths(plan, table) if (plan and self.cfg.verify_tracking) else {}
+        self._radii = {rid: list(v) for rid, v in
+                       ((table.raw.get("geometry") or {}).get("sweep_radii") or {}).items()}
+        self._order_key = {}
+        ridx = {r: i for i, r in enumerate(table.robots)}
+        for z in table.zones:
+            for o in z.occ:
+                self._order_key[o.id] = (float(o.t_nom[0]) if o.t_nom else 0.0, ridx.get(o.rid, 99), z.id)
+        self._init_zones_from_table()
+
+    # ── inputs ────────────────────────────────────────────────────────────────
+    def on_sample(self, key: str, msg: dict, rx_t: float) -> None:
+        with self._lock:
+            self._inputs.append((rx_t, key, msg))
+
+    def on_liveliness(self, key: str, alive: bool, rx_t: float) -> None:
+        with self._lock:
+            self._inputs.append((rx_t, key, {"_liveliness": bool(alive)}))
+
+    # ── helpers ───────────────────────────────────────────────────────────────
+    def _ev(self, now, ev, zone=None, rid=None, req_id=None, **detail):
+        e = {"cycle": self.cycle_n, "t": round(float(now), 6), "ev": ev}
+        if zone is not None:
+            e["zone"] = zone
+        if rid is not None:
+            e["rid"] = rid
+        if req_id is not None:
+            e["req_id"] = req_id
+        if detail:
+            e["detail"] = detail
+        self.events.append(e)
+        if self.on_event:
+            try:
+                self.on_event(e)
+            except Exception:  # noqa: BLE001
+                pass
+        return e
+
+    def _init_zones_from_table(self):
+        """Occupancies that start at the robots' initial HOME pose (enter = None) are inside from the start."""
+        if self.arbitration != "plan":
+            return
+        for z in self.table.zones:
+            if z.occ and z.occ[0].enter is None:
+                st = self.zones[z.id]
+                st.update(state="OCCUPIED", holder=z.occ[0].rid, req_id=f"{z.occ[0].rid}.home", since=0.0)
+                st["holders"] = {z.occ[0].rid}
+
+    def _next_occ(self, zid):
+        z = self.table.zone(zid)
+        st = self.zones[zid]
+        while st["served"] < len(z.occ) and z.occ[st["served"]].id in st["skipped"]:
+            st["served"] += 1
+        return z.occ[st["served"]] if st["served"] < len(z.occ) else None
+
+    def _set_zone(self, zid, now, **kw):
+        self.zones[zid].update(kw)
+        self._zone_dirty.add(zid)
+
+    # ── cycle ─────────────────────────────────────────────────────────────────
+    def cycle(self, now: float) -> list:
+        self.cycle_n += 1
+        outs: list = []
+        with self._lock:
+            inputs, self._inputs = self._inputs, []
+        inputs.sort(key=lambda x: (x[0], str(x[2].get("src", "")), int(x[2].get("seq", 0) or 0)))
+        for rx_t, key, msg in inputs:
+            try:
+                self._handle(now, key, msg, rx_t, outs)
+            except Exception as exc:  # noqa: BLE001 - a bad message is an event, never a crash
+                self.counters["bad_msg"] += 1
+                self._ev(now, "bad_msg", detail=repr(exc)[:200], key=key)
+        self._watchdogs(now)
+        self._mode_step(now, outs)
+        if self.mode == "RUN":
+            self._arbitrate(now, outs)
+        self._release_timeouts(now)
+        if now - self._last_dl >= min(1.0, max(0.1, self.cfg.deadlock_confirm_s / 4.0)):
+            self._last_dl = now
+            self._deadlock_check(now)
+        self._levels(now, outs)
+        return outs
+
+    def _handle(self, now, key, msg, rx_t, outs):
+        if "_liveliness" in msg:
+            rid = P.key_part(key, 3)
+            if rid in self.robots and not msg["_liveliness"]:
+                self._robot_lost(now, rid, "liveliness")
+            elif rid in self.robots:
+                self._ev(now, "robot_up", rid=rid, via="liveliness")
+            return
+        ok, restarted = self._seq.accept(key, msg)
+        if not ok:
+            self.counters["stale"] += 1
+            return
+        if msg.get("cell") not in (None, self.keys.cell):
+            return
+        parts = key.split("/")
+        src = msg.get("src")
+        if src in self.robots:
+            r = self.robots[src]
+            r["last_rx"] = rx_t
+            if len(parts) >= 6 and parts[3] == "zone" and parts[5] in ("req", "occ", "rel"):
+                r["ver_ev"] = max(int(r.get("ver_ev") or 0), int(msg.get("ver") or 0))
+            if not r["seen"]:
+                r["seen"] = True
+                self._ev(now, "robot_up", rid=src)
+            if restarted:
+                self._ev(now, "robot_back", rid=src, sess=msg.get("sess"))
+            if r["lost"]:
+                self._robot_back(now, src, msg)
+        if len(parts) >= 6 and parts[2] == "plc" and parts[3] == "zone":
+            zid, what = parts[4], parts[5]
+            if what == "req":
+                self._on_req(now, msg, rx_t)
+            elif what == "occ":
+                self._on_occ(now, msg)
+            elif what == "rel":
+                self._on_rel(now, msg)
+        elif len(parts) >= 5 and parts[2] == "robot":
+            if parts[4] == "status":
+                self._on_status(now, src, msg, rx_t)
+        elif len(parts) >= 4 and parts[2] == "plc" and parts[3] == "cmd":
+            self._on_cmd(now, msg, outs)
+
+    def _on_req(self, now, msg, rx_t):
+        rid, req_id = msg.get("rid"), msg.get("req_id")
+        if rid not in self.robots or not req_id:
+            return
+        if msg.get("table") and msg["table"] != self.table.short:
+            self._ev(now, "table_mismatch", rid=rid, req_id=req_id)
+            return
+        if req_id in self.pending:
+            self._ev(now, "req_dup", rid=rid, req_id=req_id)
+            return
+        zones = [z for z in (msg.get("zones") or []) if z in self.zones]
+        if not zones:
+            return
+        for zid in zones:                      # already granted to this robot (a re-sent request)
+            st = self.zones[zid]
+            if st["holder"] == rid and st["req_id"] == req_id:
+                return
+        self.pending[req_id] = {"rid": rid, "req_id": req_id, "zones": zones, "occ": msg.get("occ"),
+                                "arrival": rx_t, "prio": int(msg.get("prio") or 0), "t_req": now}
+        self.robots[rid]["requests"] += 1
+        for zid in zones:
+            self.zones[zid]["fifo"].append(req_id)
+        self._ev(now, "req", zone=zones[0], rid=rid, req_id=req_id, zones=zones)
+
+    def _grant(self, now, req, outs):
+        rid = req["rid"]
+        for zid in req["zones"]:
+            st = self.zones[zid]
+            if st["holder"] is not None and st["holder"] != rid:
+                self.counters["I1_double_holder"] += 1
+            st["holders"] = {h for h in st["holders"] if h == rid} | {rid}
+            if st["freed_at"] is not None:
+                st["handover"].append(now - st["freed_at"])
+            st["waits"].append(now - req["t_req"])
+            self._set_zone(zid, now, state="GRANTED", holder=rid, req_id=req["req_id"], since=now)
+            st["grants"] += 1
+            if req["req_id"] in st["fifo"]:
+                st["fifo"].remove(req["req_id"])
+        self.robots[rid]["wait_s"] += now - req["t_req"]
+        self.pending.pop(req["req_id"], None)
+        body = {"rid": rid, "req_id": req["req_id"], "zones": req["zones"], "cycle": self.cycle_n}
+        if self.arbitration == "plan":
+            z = self.table.zone(req["zones"][0])
+            body["order"] = next((o.order for o in z.occ if o.rid == rid), None)
+        outs.append((self.keys.zone(req["zones"][0], "grant"),
+                     self.env.wrap(self.keys.zone(req["zones"][0], "grant"), body, now), "ctrl"))
+        self._ev(now, "grant", zone=req["zones"][0], rid=rid, req_id=req["req_id"],
+                 zones=req["zones"], wait_s=round(now - req["t_req"], 4))
+
+    def _on_occ(self, now, msg):
+        rid, zid = msg.get("rid"), msg.get("zone")
+        st = self.zones.get(zid)
+        if st is None or rid not in self.robots:
+            return
+        if st["holder"] != rid:
+            self._violation(now, zid, rid, "entered without holding the zone")
+            return
+        if st["state"] == "GRANTED":
+            self._set_zone(zid, now, state="OCCUPIED", since=now)
+            self._ev(now, "occ", zone=zid, rid=rid, req_id=msg.get("req_id"), pos=msg.get("pos"))
+
+    def _verify_release(self, zid, rid, pos, q, err):
+        z = self.table.zone(zid)
+        o = next((o for o in z.occ if o.rid == rid), None)
+        if o is None:
+            return False, "robot has no occupancy in this zone"
+        if self.arbitration in ("fifo", "priority") and o.exit is None and o.enter is None:
+            return True, "node release"
+        if o.exit is None:
+            return False, "occupancy has no exit (held to the end)"
+        if not pos:
+            return False, "no position"
+        pk = P.pos_key(pos)
+        ek = P.pos_key(o.exit)
+        need = (ek[0], ek[1] + self.guard_s)
+        end_t = self.table.leg_end_t(rid, ek[0])
+        if end_t is not None and need[1] > end_t:
+            need = (ek[0], max(ek[1], end_t - 1e-6))
+        if pk < need:
+            return False, f"position {pk} not past exit {ek} + guard"
+        if q is not None and self._paths.get(rid):
+            dev = _tracking_err(self._paths[rid], self._radii.get(rid), pos, q)
+            if dev is not None and dev > self.cfg.track_tol_m:
+                return False, f"tracking error {dev:.4f} m > {self.cfg.track_tol_m}"
+        elif err is not None and float(err) > self.cfg.track_tol_m:
+            return False, f"reported tracking error {float(err):.4f} m"
+        return True, "ok"
+
+    def _on_rel(self, now, msg):
+        rid, zid = msg.get("rid"), msg.get("zone")
+        st = self.zones.get(zid)
+        if st is None or rid not in self.robots:
+            return
+        if st["holder"] != rid:
+            return                                   # stale / duplicate release
+        if msg.get("node") and self.arbitration in ("fifo", "priority"):
+            ok, why = True, "ReleaseInterlock node"   # the node releases at rest, past its legs
+        else:
+            ok, why = self._verify_release(zid, rid, msg.get("pos"), msg.get("q"), msg.get("track_err_m"))
+        if not ok:
+            self.counters["releases_rejected"] += 1
+            if st["reject_since"] is None:
+                st["reject_since"] = now
+            self._ev(now, "release_rejected", zone=zid, rid=rid, req_id=msg.get("req_id"), why=why)
+            return
+        self._free(now, zid, rid, msg.get("req_id"))
+
+    def _free(self, now, zid, rid, req_id=None):
+        st = self.zones[zid]
+        if st["since"] is not None:
+            st["occupied_s"] += now - st["since"]
+        z = self.table.zone(zid)
+        if self.arbitration == "plan":
+            nxt = self._next_occ(zid)
+            if nxt is not None and nxt.rid == rid:
+                st["served"] += 1
+            else:
+                o = next((o for o in z.occ if o.rid == rid), None)
+                if o is not None:
+                    st["skipped"].add(o.id)
+        st["holders"] = set()
+        self._set_zone(zid, now, state="FREE", holder=None, req_id=None, since=None, reject_since=None,
+                       freed_at=now)
+        self._ev(now, "free", zone=zid, rid=rid, req_id=req_id, served=st["served"])
+
+    def _on_status(self, now, rid, msg, rx_t):
+        r = self.robots.get(rid)
+        if r is None:
+            return
+        prev_mode = r["mode"]
+        r["status"] = msg
+        r["mode"] = msg.get("mode", r["mode"])
+        if int(msg.get("ver") or 0) < int(r.get("ver_ev") or 0):
+            # built before an event of this robot that was already processed (a level can be overtaken by a
+            # later event): its pending / granted / inside lists are stale; position and mode are still news
+            if r["mode"] == "DONE" and prev_mode != "DONE":
+                self._robot_done(now, rid)
+            return
+        # level repair: requests that never arrived as events
+        for p in msg.get("pending") or []:
+            if p.get("req_id") and p["req_id"] not in self.pending:
+                held = any(self.zones.get(z, {}).get("req_id") == p["req_id"] for z in p.get("zones") or [])
+                if not held:
+                    self._on_req(now, {"rid": rid, "req_id": p["req_id"], "zones": p.get("zones"),
+                                       "occ": p.get("occ"), "table": msg.get("table")}, rx_t)
+        # requests the robot no longer has (cancelled)
+        live = {p.get("req_id") for p in msg.get("pending") or []}
+        for req_id, req in list(self.pending.items()):
+            if req["rid"] == rid and req_id not in live and msg.get("pending") is not None \
+                    and req.get("t_req", now) < now - 2 * self.cfg.level_period_s:
+                self.pending.pop(req_id, None)
+                for zid in req["zones"]:
+                    if req_id in self.zones[zid]["fifo"]:
+                        self.zones[zid]["fifo"].remove(req_id)
+                self._ev(now, "cancel", rid=rid, req_id=req_id)
+        # level repair for occ; violations
+        for zid in msg.get("inside") or []:
+            st = self.zones.get(zid)
+            if st is None:
+                continue
+            if st["holder"] == rid:
+                if st["state"] == "GRANTED":
+                    self._set_zone(zid, now, state="OCCUPIED", since=now)
+                    self._ev(now, "occ", zone=zid, rid=rid, via="level")
+            elif st["state"] != "BLOCKED":
+                self._violation(now, zid, rid, "reports inside a zone it does not hold")
+        # level repair for rel: held zone no longer inside / granted, position past its exit. A GRANTED zone
+        # counts too: its occ AND rel events were both lost while the arm passed through (round 3 fix of the
+        # project's own PLC, ported in round 4: the zone stayed GRANTED forever and its partner waited)
+        inside = set(msg.get("inside") or [])
+        granted = set(msg.get("granted") or [])
+        # a level that still lists the grant's own request as pending was built before the robot saw the grant
+        # (21 v5: a FIFO node zone, which needs no position to be released, was freed by such a level the cycle
+        # after its grant, and the robot's entry then counted as a violation)
+        unseen = {p_.get("req_id") for p_ in msg.get("pending") or [] if p_.get("req_id")}
+        for zid, st in self.zones.items():
+            if st["holder"] == rid and st["state"] in ("OCCUPIED", "GRANTED") and zid not in inside \
+                    and zid not in granted and msg.get("pos") and st["req_id"] not in unseen:
+                ok, _why = self._verify_release(zid, rid, msg.get("pos"), None, msg.get("track_err_m"))
+                if ok:
+                    if st["state"] == "GRANTED":
+                        self._ev(now, "occ", zone=zid, rid=rid, via="level (passed through)")
+                    self._free(now, zid, rid, st["req_id"])
+        if r["mode"] == "DONE" and prev_mode != "DONE":
+            self._robot_done(now, rid)
+
+    def _robot_done(self, now, rid):
+        """Program end: unserved occupancies of this robot are skipped, so no partner waits forever."""
+        n = 0
+        for z in self.table.zones:
+            st = self.zones[z.id]
+            for o in z.occ:
+                if o.rid != rid:
+                    continue
+                idx = z.occ.index(o)
+                if idx >= st["served"] and st["holder"] != rid:
+                    st["skipped"].add(o.id)
+                    n += 1
+        self._ev(now, "skip", rid=rid, n=n, reason="program done")
+
+    def _on_cmd(self, now, msg, outs):
+        cmd = msg.get("cmd")
+        args = msg.get("args") or {}
+        if cmd == "hold" and self.mode == "RUN":
+            self.mode = "HOLD"
+        elif cmd == "run" and self.mode == "HOLD":
+            self.mode = "RUN"
+        elif cmd == "stop":
+            self.mode = "STOP"
+        elif cmd == "reset":
+            for zid in args.get("zones") or [z for z, s in self.zones.items() if s["state"] in ("BLOCKED", "FAULT")]:
+                if zid in self.zones and self.zones[zid]["state"] in ("BLOCKED", "FAULT"):
+                    self._free(now, zid, self.zones[zid]["holder"])
+            if self.mode == "FAULT":
+                self.mode = "RUN"
+                self.fault_why = None
+                self._dl_cand = None
+        elif cmd == "skip":
+            o = args.get("occ")
+            if o and "/" in o:
+                zid = o.split("/")[0]
+                if zid in self.zones:
+                    self.zones[zid]["skipped"].add(o)
+        self._ev(now, "cmd_ack", cmd=cmd, args=args, mode=self.mode)
+
+    def _violation(self, now, zid, rid, why):
+        self.counters["violations"] += 1
+        self._set_zone(zid, now, state="FAULT")
+        self._ev(now, "violation", zone=zid, rid=rid, why=why)
+        if self.mode in ("RUN", "HOLD", "RECOVER"):
+            self.mode = "FAULT"
+            self.fault_why = f"violation in {zid}: {why}"
+            self._ev(now, "fault", why=self.fault_why)
+
+    def _robot_lost(self, now, rid, why):
+        r = self.robots[rid]
+        if r["lost"]:
+            return
+        r["lost"] = True
+        for zid, st in self.zones.items():
+            if st["holder"] == rid and st["state"] in ("GRANTED", "OCCUPIED"):
+                st["blocked_from"] = st["state"]
+                self._set_zone(zid, now, state="BLOCKED")
+        for req_id, req in list(self.pending.items()):
+            if req["rid"] == rid:
+                self.pending.pop(req_id, None)
+                for zid in req["zones"]:
+                    if req_id in self.zones[zid]["fifo"]:
+                        self.zones[zid]["fifo"].remove(req_id)
+        self._ev(now, "robot_lost", rid=rid, why=why)
+
+    def _robot_back(self, now, rid, msg):
+        r = self.robots[rid]
+        r["lost"] = False
+        for zid, st in self.zones.items():
+            if st["holder"] == rid and st["state"] == "BLOCKED":
+                self._set_zone(zid, now, state=st.get("blocked_from") or "OCCUPIED")
+        self._ev(now, "robot_back", rid=rid)
+
+    def _watchdogs(self, now):
+        for rid, r in self.robots.items():
+            if r["seen"] and not r["lost"] and r["last_rx"] is not None and r["mode"] != "DONE" \
+                    and now - r["last_rx"] > self.cfg.hb_timeout_s and self.mode != "STOP":
+                self._robot_lost(now, rid, "heartbeat timeout")
+
+    def _mode_step(self, now, outs):
+        if self.mode == "RECOVER":
+            if self._t_recover is None:
+                self._t_recover = now
+                self._ev(now, "boot", epoch=self.env.epoch, table=self.table.short,
+                         zones=len(self.zones), arbitration=self.arbitration)
+            all_seen = all(r["seen"] for r in self.robots.values())
+            if all_seen or now - self._t_recover >= self.cfg.recover_timeout_s:
+                self._recover(now)
+                self.mode = "RUN"
+                self._ev(now, "mode", mode="RUN", all_seen=all_seen)
+        if self.mode != "STOP" and self.robots and all(r["mode"] == "DONE" for r in self.robots.values()):
+            self.mode = "STOP"
+            self._ev(now, "mode", mode="STOP")
+
+    def _recover(self, now):
+        """Rebuild zones from the robots' levels (a PLC restart in the middle of a run)."""
+        for rid, r in self.robots.items():
+            s = r["status"] or {}
+            if not r["seen"]:
+                continue
+            for zid in s.get("inside") or []:
+                st = self.zones.get(zid)
+                if st is not None and st["holder"] in (None, rid):
+                    self._set_zone(zid, now, state="OCCUPIED", holder=rid, req_id=f"{rid}.recover", since=now)
+            if self.arbitration == "plan" and s.get("pos"):
+                for z in self.table.zones:
+                    st = self.zones[z.id]
+                    for i, o in enumerate(z.occ):
+                        if o.rid == rid and o.exit is not None and P.pos_after(s["pos"], o.exit) \
+                                and i >= st["served"] and st["holder"] != rid:
+                            st["served"] = i + 1
+
+    def _arbitrate(self, now, outs):
+        if not self.pending:
+            return
+        if self.arbitration == "plan":
+            reqs = sorted(self.pending.values(), key=lambda r: self._order_key.get(r.get("occ"), (1e18, 99, "")))
+            for req in reqs:
+                zid = req["zones"][0]
+                st = self.zones[zid]
+                if self.robots[req["rid"]]["lost"]:
+                    continue
+                nxt = self._next_occ(zid)
+                if self.cfg.mutant_double_grant and st["state"] != "FREE" and st["holder"] != req["rid"]:
+                    self._grant(now, req, outs)
+                    continue
+                if st["state"] == "FREE" and nxt is not None and nxt.id == req.get("occ"):
+                    self._grant(now, req, outs)
+                elif st["state"] == "FREE" and nxt is not None and nxt.rid != req["rid"]:
+                    pass   # the predecessor goes first (plan order)
+        else:
+            if self.arbitration == "priority":
+                age = self.cfg.grant_warn_s
+                key = lambda r: (-(1 << 20) if now - r["t_req"] > age else -r["prio"], r["arrival"])
+            else:
+                key = lambda r: (r["arrival"],)
+            for req in sorted(self.pending.values(), key=key):
+                if self.robots[req["rid"]]["lost"]:
+                    continue
+                ok = all(self.zones[z]["state"] == "FREE" for z in req["zones"])
+                if ok and self.arbitration == "fifo":
+                    ok = all(self.zones[z]["fifo"] and self.zones[z]["fifo"][0] == req["req_id"]
+                             for z in req["zones"])
+                if ok:
+                    self._grant(now, req, outs)
+
+    def _release_timeouts(self, now):
+        for zid, st in self.zones.items():
+            if st.get("reject_since") is not None and st["state"] in ("OCCUPIED", "GRANTED") \
+                    and now - st["reject_since"] > self.cfg.release_reject_s:
+                self._set_zone(zid, now, state="FAULT")
+                self._ev(now, "fault", zone=zid, why="release rejected too long")
+                st["reject_since"] = None
+        for req in self.pending.values():
+            if now - req["t_req"] > self.cfg.grant_warn_s and not req.get("warned"):
+                req["warned"] = True
+                self._ev(now, "wait_long", rid=req["rid"], req_id=req["req_id"], zones=req["zones"])
+
+    def _deadlock_check(self, now):
+        """Wait-for graph: robot -> holder of the zone it waits for (plan: or the predecessor's robot).
+
+        A robot is an edge only while it is at rest at the stop point of the occupancy it waits for (mode WAIT
+        and its reported position at that stop; round 4: an arm whose next goal was still being dispatched
+        reported WAIT at the start of its leg, before the stop, while it was about to leave the zone its partner
+        waited for: a false deadlock, FAULT, and the cell stood still). A cycle FAULTs the PLC only when the same
+        cycle, with the same positions, persists for ``deadlock_confirm_s`` (levels lag the arms by a level
+        period and the link delay)."""
+        edges, waits = {}, {}
+        for rid, r in self.robots.items():
+            s = r["status"] or {}
+            w = s.get("waiting_for")
+            if not w or s.get("mode") != "WAIT":
+                continue
+            zid = str(w).split("/")[0]
+            st = self.zones.get(zid)
+            if st is None:
+                continue
+            o = next((o for o in self.table.zone(zid).occ if o.rid == rid), None)
+            stop = (o.stop or o.enter) if o is not None else None
+            pos = s.get("pos")
+            if stop is not None and pos and P.pos_key(pos) < (P.pos_key(stop)[0], P.pos_key(stop)[1] - 0.01):
+                continue                       # not (yet) at its stop point: it is still moving there
+            if st["holder"] and st["holder"] != rid:
+                edges[rid] = st["holder"]
+            elif self.arbitration == "plan":
+                nxt = self._next_occ(zid)
+                if nxt is not None and nxt.rid != rid:
+                    edges[rid] = nxt.rid
+            if rid in edges:
+                waits[rid] = (zid, P.pos_key(pos) if pos else None)
+        cyc = None
+        for start in edges:
+            seen, cur = [], start
+            while cur in edges and cur not in seen:
+                seen.append(cur)
+                cur = edges[cur]
+            if cur == start and len(seen) > 1:
+                cyc = sorted(seen)
+                break
+        if cyc is None:
+            self._dl_cand = None
+            return
+        sig = tuple((x, waits[x][0], (waits[x][1][0], round(waits[x][1][1], 3)) if waits[x][1] else None)
+                    for x in cyc)
+        if self._dl_cand is None or self._dl_cand[0] != sig:
+            self._dl_cand = (sig, now)
+            self._ev(now, "deadlock_suspect", cycle_robots=cyc, waits={x: waits[x][0] for x in cyc})
+            return
+        if now - self._dl_cand[1] < self.cfg.deadlock_confirm_s:
+            return
+        self.counters["deadlocks"] += 1
+        self._ev(now, "deadlock", cycle_robots=cyc, waits={x: waits[x][0] for x in cyc},
+                 since_s=round(now - self._dl_cand[1], 3))
+        self._dl_cand = None
+        if self.mode == "RUN":
+            self.mode = "FAULT"
+            self.fault_why = "deadlock: " + ", ".join(f"{x} waits for {waits[x][0]}" for x in cyc)
+            self._ev(now, "fault", why="deadlock")
+
+    def _levels(self, now, outs):
+        if now - self._last_hb >= self.cfg.hb_period_s:
+            self._last_hb = now
+            hb = {"n": self.cycle_n, "mode": self.mode}
+            if self.mode == "FAULT":
+                hb["fault"] = self.fault_why or "plc_fault"
+            outs.append((self.keys.plc_heartbeat, self.env.wrap(self.keys.plc_heartbeat, hb, now), "hb"))
+        if now - self._last_level >= self.cfg.level_period_s:
+            self._last_level = now
+            for rid in self.robots:
+                enabled = sorted(z for z, st in self.zones.items()
+                                 if st["holder"] == rid and st["state"] in ("GRANTED", "OCCUPIED"))
+                grants = sorted({st["req_id"] for z, st in self.zones.items()
+                                 if st["holder"] == rid and st["state"] in ("GRANTED", "OCCUPIED") and st["req_id"]})
+                body = {"rid": rid, "mode": self.mode, "enabled": enabled, "grants": grants,
+                        "fault": None if self.mode != "FAULT" else (self.fault_why or "plc_fault"),
+                        "cycle": self.cycle_n}
+                outs.append((self.keys.plc_io(rid), self.env.wrap(self.keys.plc_io(rid), body, now), "level"))
+        periodic = now - self._last_zstate >= self.cfg.zone_state_period_s
+        if periodic:
+            self._last_zstate = now
+        # on change for every zone; the periodic republish only for zones that are not FREE (a FREE zone with
+        # no change is the default state, and a few hundred zones per plan would flood the bus at 2 Hz)
+        todo = set(self._zone_dirty)
+        if periodic:
+            todo |= {z for z, st in self.zones.items() if st["state"] != "FREE"}
+        for zid in sorted(todo):
+            st = self.zones[zid]
+            nxt = self._next_occ(zid) if self.arbitration == "plan" else None
+            body = {"zone": zid, "state": st["state"], "holder": st["holder"], "req_id": st["req_id"],
+                    "served": st["served"], "next": nxt.id if nxt else None, "since": st["since"]}
+            k = self.keys.zone(zid, "state")
+            outs.append((k, self.env.wrap(k, body, now), "level"))
+        self._zone_dirty.clear()
+        for e in self.events[getattr(self, "_ev_sent", 0):]:
+            outs.append((self.keys.plc_event, self.env.wrap(self.keys.plc_event, e, now), "log"))
+        self._ev_sent = len(self.events)
+
+    # ── reporting ─────────────────────────────────────────────────────────────
+    def snapshot(self) -> dict:
+        return {"mode": self.mode, "epoch": self.env.epoch, "cycle": self.cycle_n, "table": self.table.short,
+                "arbitration": self.arbitration,
+                "zones": {z: {k: (sorted(v) if isinstance(v, set) else v) for k, v in st.items()
+                              if k not in ("waits", "handover", "fifo")} for z, st in self.zones.items()},
+                "robots": {r: {k: v for k, v in s.items() if k != "status"} for r, s in self.robots.items()},
+                "pending": list(self.pending), "counters": dict(self.counters)}
+
+    def report(self) -> dict:
+        zones = {}
+        for zid, st in self.zones.items():
+            w = st["waits"]
+            zones[zid] = {"grants": st["grants"], "served": st["served"], "state": st["state"],
+                          "occupied_s": round(st["occupied_s"], 4),
+                          "wait_mean_s": round(sum(w) / len(w), 4) if w else None,
+                          "wait_max_s": round(max(w), 4) if w else None,
+                          "handover_min_s": round(min(st["handover"]), 4) if st["handover"] else None,
+                          "skipped": sorted(st["skipped"])}
+        unserved = []
+        for z in self.table.zones:
+            st = self.zones[z.id]
+            for i, o in enumerate(z.occ):
+                done = i < st["served"] or o.id in st["skipped"] or (st["holder"] == o.rid and o.exit is None)
+                if not done:
+                    unserved.append(o.id)
+        bad = [z for z, st in self.zones.items() if st["state"] in ("BLOCKED", "FAULT")]
+        return {"mode": self.mode, "fault_why": self.fault_why, "cycles": self.cycle_n,
+                "arbitration": self.arbitration,
+                "n_zones": len(self.zones), "grants": sum(s["grants"] for s in self.zones.values()),
+                "robots": {r: {"requests": s["requests"], "wait_s": round(s["wait_s"], 3), "lost": s["lost"],
+                               "mode": s["mode"]} for r, s in self.robots.items()},
+                "counters": dict(self.counters), "unserved": unserved, "blocked_or_fault": bad,
+                "I7_ok": not unserved and not bad, "zones": zones}
+
+
+def _plan_paths(plan, table) -> dict:
+    """rid -> {k: (times, positions[, LegPath])} of the plan's legs, for the release tracking check. The LegPath
+    (when numpy / the planner stack is importable) gives the leg's smooth command, the curve the arm follows
+    (patch 20 / 21 v2); without it the check falls back to the polyline."""
+    try:
+        from agents.trajectory.tools.vass_zones import program_legs
+    except Exception:  # noqa: BLE001 - the PLC also runs without the planner stack
+        return {}
+    try:
+        legs = program_legs(plan.get("behaviour_tree") or plan)
+    except Exception:  # noqa: BLE001
+        return {}
+    try:
+        from agents.cell.vass_motion import LegPath
+    except Exception:  # noqa: BLE001
+        LegPath = None
+    out = {}
+    for rid, ls in legs.items():
+        if str(rid).startswith("_"):
+            continue
+        out[rid] = {}
+        for l in ls:
+            if not l.get("traj"):
+                continue
+            ts = [float(p["time_s"]) for p in l["traj"]]
+            qs = [list(p["positions"])[:6] for p in l["traj"]]
+            lp = None
+            if LegPath is not None:
+                try:
+                    lp = LegPath(l["traj"])
+                except Exception:  # noqa: BLE001
+                    lp = None
+            out[rid][l["k"]] = (ts, qs, lp)
+    return out
+
+
+def _tracking_err(paths, radii, pos, q):
+    leg = paths.get(int(pos.get("k", -1)))
+    if not leg or q is None:
+        return None
+    ts, qs = leg[0], leg[1]
+    lp = leg[2] if len(leg) > 2 else None
+    t = float(pos.get("t", 0.0))
+    if lp is not None:
+        try:
+            ref = [float(x) for x in lp.cmd_q(min(max(t, ts[0]), ts[-1]))]
+        except Exception:  # noqa: BLE001
+            lp = None
+    if lp is None:
+        if t <= ts[0]:
+            ref = qs[0]
+        elif t >= ts[-1]:
+            ref = qs[-1]
+        else:
+            import bisect
+            i = max(1, bisect.bisect_left(ts, t))
+            a = (t - ts[i - 1]) / ((ts[i] - ts[i - 1]) or 1.0)
+            ref = [qs[i - 1][j] + a * (qs[i][j] - qs[i - 1][j]) for j in range(len(qs[i]))]
+    R = radii or [3.0] * len(ref)
+    import math
+    tot = 0.0
+    for j in range(min(len(ref), len(q), len(R))):
+        d = abs(float(q[j]) - float(ref[j])) % (2 * math.pi)
+        tot += min(d, 2 * math.pi - d) * float(R[j])
+    return tot
+
+
+class PlcEmulator:
+    """``PlcCore`` on a transport: subscriptions, a cycle thread, ``events.jsonl``, ``plc_report.json``."""
+
+    def __init__(self, transport, cell, table, plan=None, cfg: Optional[PlcConfig] = None, log_dir=None):
+        self.core = PlcCore(cell, table, plan, cfg)
+        self.tr = transport
+        self.log_dir = log_dir
+        self._stop = threading.Event()
+        self._thread = None
+        self._ev_file = None
+        self.overruns = 0
+
+    def start(self):
+        k = self.core.keys
+        for ex in (k.zone_any("req"), k.zone_any("occ"), k.zone_any("rel"), k.robot_any("status"),
+                   k.robot_any("heartbeat"), k.plc_cmd):
+            self.tr.subscribe(ex, self.core.on_sample)
+        try:
+            self.tr.liveliness_subscribe(k.robot_any("alive"), self.core.on_liveliness)
+        except Exception:  # noqa: BLE001 - liveliness is the fast path only; watchdogs are primary
+            pass
+        if self.log_dir:
+            os.makedirs(self.log_dir, exist_ok=True)
+            self._ev_file = open(os.path.join(self.log_dir, "events.jsonl"), "a")
+            self.core.on_event = lambda e: self._ev_file.write(json.dumps(e, default=str) + "\n")
+        self._thread = threading.Thread(target=self._run, daemon=True, name="vass-plc")
+        self._thread.start()
+        return self
+
+    def _run(self):
+        cyc = self.core.cfg.cycle_s
+        nxt = time.monotonic()
+        last_flush = time.monotonic()
+        while not self._stop.is_set():
+            outs = self.core.cycle(time.time())
+            for key, msg, qos in outs:
+                self.tr.put(key, msg, qos)
+            if self._ev_file and time.monotonic() - last_flush > 1.0:
+                self._ev_file.flush()
+                last_flush = time.monotonic()
+            nxt += cyc
+            wait = nxt - time.monotonic()
+            if wait > 0:
+                self._stop.wait(wait)
+            else:
+                self.overruns += 1
+                nxt = time.monotonic()
+
+    def stop(self) -> dict:
+        self._stop.set()
+        if self._thread:
+            self._thread.join(timeout=2.0)
+        rep = self.core.report()
+        rep["cycle_overruns"] = self.overruns
+        if self._ev_file:
+            self._ev_file.flush()
+            self._ev_file.close()
+            self._ev_file = None
+        if self.log_dir:
+            with open(os.path.join(self.log_dir, "plc_report.json"), "w") as f:
+                json.dump(rep, f, indent=1, default=str)
+        return rep
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--plan", required=True, help="plan / behaviour-tree JSON carrying metadata.vass.table, or a zones.json")
+    ap.add_argument("--cell", default=None, help="cell key (default: the table's cell_id)")
+    ap.add_argument("--connect", default=None, help="zenoh router endpoint(s), e.g. tcp/127.0.0.1:7447")
+    ap.add_argument("--router", default=None, help="embed a zenoh router listening here, e.g. tcp/0.0.0.0:7447")
+    ap.add_argument("--arbitration", choices=["plan", "fifo", "priority"], default=None)
+    ap.add_argument("--log", default=None, help="run directory for events.jsonl / plc_report.json")
+    ap.add_argument("--duration", type=float, default=0.0, help="stop after this many seconds (0 = until STOP / Ctrl-C)")
+    a = ap.parse_args(argv)
+    with open(a.plan) as f:
+        doc = json.load(f)
+    tree = doc.get("behaviour_tree") or doc
+    table = P.table_of_tree(tree) if ("root" in tree) else P.ZoneTable(doc)
+    if table is None:
+        print("no metadata.vass.table in this plan (derive it with agents.trajectory.tools.vass_zones)", file=sys.stderr)
+        return 2
+    from agents.cell.vass_transport import ZenohTransport
+    if a.router:
+        tr = ZenohTransport(mode="router", listen=a.router)
+    else:
+        tr = ZenohTransport(mode="client", connect=a.connect or "tcp/127.0.0.1:7447")
+    cell = a.cell or table.cell_id or tree.get("cell_id") or "cell"
+    plc = PlcEmulator(tr, cell, table, plan=doc if "root" in tree else None,
+                      cfg=PlcConfig(arbitration=a.arbitration), log_dir=a.log).start()
+    print(f"[vass_plc] cell={cell} zones={len(table.zones)} table={table.short} "
+          f"arbitration={plc.core.arbitration} epoch={plc.core.env.epoch}", flush=True)
+    t0 = time.time()
+    try:
+        while True:
+            time.sleep(0.2)
+            if plc.core.mode == "STOP" or (a.duration and time.time() - t0 >= a.duration):
+                break
+    except KeyboardInterrupt:
+        pass
+    rep = plc.stop()
+    tr.close()
+    summary = {k: rep[k] for k in ("mode", "grants", "counters", "I7_ok")}
+    summary["unserved"] = len(rep["unserved"])
+    print(json.dumps(summary, default=str), flush=True)
+    return 0 if rep["I7_ok"] and not rep["counters"]["violations"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
