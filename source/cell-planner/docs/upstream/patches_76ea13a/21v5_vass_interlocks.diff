+class OffsetRuntime(FollowRuntime):
+    """FollowRuntime whose joint feedback carries a constant residual (a real controller's steady tracking error
+    / encoder offset): the arm never reports exactly the commanded end point."""
+
+    def __init__(self, home, offset, **kw):
+        super().__init__(home, **kw)
+        self.offset = np.asarray(offset, float)
+
+    def latest_status(self, r):
+        st = super().latest_status(r)
+        st["joint_positions"] = list(np.asarray(st["joint_positions"], float) + self.offset)
+        return st
+
