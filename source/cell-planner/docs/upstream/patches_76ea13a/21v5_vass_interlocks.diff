+class _Later:
+    """A result future that completes at ``t`` (monotonic): a goal the JTC runs to its end."""
+    def __init__(self, t, code=0):
+        self._t, self._r = t, types.SimpleNamespace(result=types.SimpleNamespace(error_code=code))
+
+    def done(self):
+        import time
+        return time.monotonic() >= self._t
+
+    def result(self):
+        return self._r
+
+
+def _goal_s(goal):
+    p = goal.trajectory.points[-1].time_from_start
+    return p.sec + 1e-9 * p.nanosec
+
+
+class _Accepted:
+    """An accepted goal whose result arrives after the goal's duration (from its stamp, or from now)."""
+    def __init__(self, goal, dropped=False):
+        import time
+        st = goal.trajectory.header.stamp.sec + 1e-9 * goal.trajectory.header.stamp.nanosec
+        self.accepted = True
+        t_end = time.monotonic() + (0.0 if dropped else _goal_s(goal))
+        self._f = _Later(t_end)
+
+    def done(self):
+        return True
+
+    def result(self):
+        return self
+
+    def get_result_async(self):
+        return self._f
+
+    def cancel_goal_async(self):
+        return None
+
+
+def _agent_stub(robot_agent, client, off=1234.5):
+    import threading
+    import time
+    ns = lambda: int((time.monotonic() + off) * 1e9)        # noqa: E731
+    ag = object.__new__(robot_agent.RobotAgent)
+    ag._node = types.SimpleNamespace(get_clock=lambda: types.SimpleNamespace(
+        now=lambda: types.SimpleNamespace(nanoseconds=ns())))
+    ag._log = []
+    ag._logger = types.SimpleNamespace(info=lambda *a, **k: ag._log.append(("info", a)),
+                                       warning=lambda *a, **k: ag._log.append(("warning", a)),
+                                       error=lambda *a, **k: ag._log.append(("error", a)))
+    ag._fjt_client, ag._estopped, ag._active_goal_handle, ag._current_task = client, False, None, None
+    ag._goal_lock, ag._goal_gen, ag._goal_stamp, ag._goal_clocked = threading.Lock(), 0, {}, set()
+    ag._goal_done, ag._joint_positions = set(), [0.0] * 6
+    ag._goal_id, ag._goal_t0 = None, None
+    return ag
+
+
+def _wait(pred, s=3.0):
+    import time
+    t = time.monotonic() + s
+    while time.monotonic() < t:
+        if pred():
+            return True
+        time.sleep(0.005)
+    return False
+
+
+def test_robot_agent_resends_a_goal_the_jtc_dropped(ros_stubs):
+    """Round-4 verification on ROS 2 Jazzy (JTC 4.42.1): a goal accepted in the update cycle in which the previous
+    goal ends is reported "Goal reached, success!" at once and never executed; v5's agent then spliced the next
+    replacement onto that dropped goal on its (wrong) clock: a 25 mrad command step. The agent now detects the
+    impossible success (before the goal's duration, no feedback), re-sends the goal from rest where the arm holds
+    (unstamped, new generation, same goal id, new clock) and splices replacements onto the re-sent goal."""
+    import threading
+    import time
+    from agents.robot import robot_agent
+    sent = []
+
+    class _RaceClient:
+        def wait_for_server(self, timeout_sec=None):
+            return True
+
+        def send_goal_async(self, goal, feedback_callback=None):
+            sent.append((time.monotonic(), goal))
+            return _Done(_Accepted(goal, dropped=len(sent) == 1))     # the first goal hits the race
+
+    ag = _agent_stub(robot_agent, _RaceClient())
+    leg = _leg(T=0.6)
+    with ag._goal_lock:
+        ag._goal_gen += 1
+        gen = ag._goal_gen
+        ag._goal_id, ag._goal_t0 = "g1", time.monotonic()
+    threading.Thread(target=ag._execute_trajectory, args=(leg, "W05", 0.0, gen, False, False), daemon=True).start()
+    assert _wait(lambda: len(sent) >= 2), "the dropped goal was not re-sent"
+    t_resend, g2 = sent[1]
+    assert g2.trajectory.header.stamp.sec == 0 and g2.trajectory.header.stamp.nanosec == 0   # from rest, unstamped
+    assert ag._goal_gen == gen + 1 and ag._goal_id == "g1" and ag._goal_t0 >= sent[0][0]
+    assert gen in ag._goal_done and any("dropped" in str(m) for _, m in ag._log)
+    # a replacement of g1 is stamped on the RE-SENT goal's clock
+    t0 = ag._goal_t0
+    ag._schedule_replacement(_leg(T=0.5), "W05", 0.0, "g1r", {"of": "g1", "at_s": 0.2}, exact=False)
+    assert _wait(lambda: len(sent) >= 3)
+    g3 = sent[2][1]
+    st = g3.trajectory.header.stamp.sec + 1e-9 * g3.trajectory.header.stamp.nanosec
+    assert abs(st - (t0 + 0.2 + 1234.5)) < 3e-3
+    assert len(sent) == 3 and ag._goal_id == "g1r"
+    time.sleep(0.05)
+    assert len(sent) == 3                                     # the executed goals are not mistaken for drops
+
+
+def test_robot_agent_replacement_scheduled_before_the_drop_follows_the_new_clock(ros_stubs):
+    """A replacement scheduled on the dropped goal's clock (before the drop was detected) is re-scheduled on the
+    re-sent goal's clock instead of being stamped on the old one."""
+    import threading
+    import time
+    from agents.robot import robot_agent
+    sent = []
+
+    class _RaceClient:
+        def wait_for_server(self, timeout_sec=None):
+            return True
+
+        def send_goal_async(self, goal, feedback_callback=None):
+            time.sleep(0.03 if not sent else 0.0)               # the drop is noticed ~30-50 ms after the send
+            sent.append((time.monotonic(), goal))
+            return _Done(_Accepted(goal, dropped=len(sent) == 1))
+
+    ag = _agent_stub(robot_agent, _RaceClient())
+    with ag._goal_lock:
+        ag._goal_gen += 1
+        gen = ag._goal_gen
+        ag._goal_id, ag._goal_t0 = "g1", time.monotonic()
+    t_old = ag._goal_t0
+    threading.Thread(target=ag._execute_trajectory, args=(_leg(T=0.8), "W05", 0.0, gen, False, False),
+                     daemon=True).start()
+    ag._schedule_replacement(_leg(T=0.5), "W05", 0.0, "g1r", {"of": "g1", "at_s": 0.15}, exact=False)
+    assert _wait(lambda: len(sent) >= 3), [len(sent), ag._log]
+    t_new = sent[1][0]
+    g3 = sent[2][1]
+    st = g3.trajectory.header.stamp.sec + 1e-9 * g3.trajectory.header.stamp.nanosec - 1234.5
+    assert abs(st - (t_old + 0.15)) > 0.02                   # not on the dropped goal's clock
+    assert t_new - 0.01 <= st - 0.15 <= t_new + 0.01          # on the re-sent goal's clock
+    assert any("re-scheduled" in str(m) for _, m in ag._log)
+
+
+def test_robot_agent_refuses_a_replacement_of_a_finished_goal(ros_stubs):
+    import time
+    from agents.robot import robot_agent
+    sent = []
+
+    class _C:
+        def wait_for_server(self, timeout_sec=None):
+            return True
+
+        def send_goal_async(self, goal, feedback_callback=None):
+            sent.append(goal)
+            return _Done(_Accepted(goal))
