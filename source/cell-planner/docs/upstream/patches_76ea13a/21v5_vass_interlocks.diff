+def test_progress_and_release_inside_a_padded_hold():
+    """A padded lift-off hold (a's standoff held 0.3 s while b lifts) and the staggered wait are dwells: the
+    projection credits the end of the dwell only up to the goal's clock, and a release inside a dwell happens at
+    the same pose whenever it is credited."""
+    joint, _ = compound_step()
+    p = LegPath(joint["a"])
+    q_hold = joint["a"][3]["positions"]                     # end of a's lift-off = the padded hold (0.3..0.6 s)
+    assert joint["a"][4]["positions"] == q_hold
+    t, err = p.project_cmd(q_hold, 0.0, 10.0)
+    assert t == pytest.approx(0.6, abs=1e-6) and err < 1e-9  # ties go to the later position: the hold's end
+    t, _ = p.project_cmd(q_hold, 0.0, 0.45)
+    assert t <= 0.45 + 1e-9                                 # never past the goal's own clock
+    pb = LegPath(joint["b"])
+    q_wait = joint["b"][-21]["positions"]                   # b waits for a's whole line (staggered candidate)
+    tw, _ = pb.project_cmd(q_wait, 0.0, 10.0)
+    assert tw == pytest.approx(float(joint["b"][-21]["time_s"]), abs=1e-6)
