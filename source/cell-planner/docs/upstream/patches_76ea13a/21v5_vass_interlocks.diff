+"""VASS-style robot <-> PLC interlocks: protocol constants, keys, messages, zone table.
+
+In VASS body-shop cells robots never talk to each other. Every robot talks to the
+station PLC, and where two robots' workspaces overlap the cell has an *interlock
+area* with a request -> enable -> occupied -> released handshake: the robot
+requests the area before it gets there, waits at a wait point outside it until the
+PLC enables it, signals "occupied" while inside and "left" once its motion is out
+of the area volume. Only then does the PLC enable the next robot. The PLC is the
+single arbiter and every area has at most one holder.
+
+This module is the shared, dependency-free part of that scheme for umarell:
+
+* the zone table a plan carries (``vass_zones_v1``, derived by
+  ``agents.trajectory.tools.vass_zones`` from the plan's own trajectories and
+  stored in ``behaviour_tree.metadata.vass``);
+* the key expressions and message envelopes on the bus (zenoh today, PROFINET
+  cyclic IO later: every message is either an *event* (req / grant / occ / rel)
+  or a *level* (robot status, PLC io image, zone state) that repeats, so a lost
+  event is repaired by the next level message);
+* the timing constants.
+
+A zone is a pair of path intervals of two robots whose swept volumes come closer
+than the cell's robot-robot rules (plus a margin). The PLC lets at most one of
+the two be inside its interval at any time, so robot-robot safety holds under any
+lag, slowdown, stop or message delay: stops only re-time the path, they never
+change it. ``arbitration: plan`` fixes the order of each zone from the nominal
+plan (which robot goes first), which makes the interlocked execution deadlock
+free under any timing once the interlocked nominal run completes.
+
+stdlib only (numpy is not needed here), so the PLC emulator runs anywhere.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import secrets
+import time
+from dataclasses import dataclass, field
+from typing import Any, Optional
+
+PROTO = 1
+TABLE_FORMAT = "vass_zones_v1"
+
+# ── timing constants (seconds; all overridable through PlcConfig / RobotConfig) ──
+PLC_CYCLE_S = 0.010          # PLC scan
+HB_PERIOD_S = 0.100          # heartbeat, both directions
+HB_TIMEOUT_S = 0.500         # gap between two heartbeats / levels that means "peer lost"
+LEVEL_PERIOD_S = 0.050       # robot status / PLC io republish
+ZONE_STATE_PERIOD_S = 0.5    # zone state republish
+MAX_OUTSTANDING = 16         # pending + granted-not-entered occupancies per robot
+GUARD_S = 0.05               # entry guard (stop point) and exit guard (release), leg time
+TRACK_TOL_M = 0.005          # release needs the tracking error below this (TCP-equivalent metres)
+GRANT_WARN_S = 30.0          # event wait_long
+INTERLOCK_TIMEOUT_S = 900.0  # = ExecConfig.op_gate_timeout_s
+RECOVER_TIMEOUT_S = 5.0      # PLC boot: wait for every robot's status
+RELEASE_REJECT_S = 3.0       # an unverifiable release for this long -> zone FAULT
+DEADLOCK_CONFIRM_S = 2.0     # a wait-for cycle must persist this long, every arm at rest at its stop, before FAULT
+FAULT_ABORT_S = 20.0         # an arm waiting for a grant ends its leg (vass_fault) when the PLC stays in FAULT
+PLC_LOST_ABORT_S = 120.0     # ... (vass_unavailable) when the PLC stays silent this long
+
+ROBOT_MODES = ("INIT", "IDLE", "RUN", "WAIT", "HOLD", "FAULT", "DONE")
+PLC_MODES = ("INIT", "RECOVER", "RUN", "HOLD", "FAULT", "STOP")
+ZONE_STATES = ("FREE", "GRANTED", "OCCUPIED", "BLOCKED", "FAULT")
+
+
+# ── key expressions ───────────────────────────────────────────────────────────
+def _chunk(s: str) -> str:
+    """A zenoh key chunk: no '/', '*', '$', '#', '?' and not empty."""
+    out = "".join(c if (c.isalnum() or c in "_.-") else "_" for c in str(s))
+    return out or "_"
+
+
+class Keys:
+    """Key expressions of one cell (``cell/<cell>/...``)."""
+
+    def __init__(self, cell: str):
+        self.cell = _chunk(cell)
+        self.base = f"cell/{self.cell}"
+
+    def zone(self, zone: str, what: str) -> str:            # req | grant | occ | rel | state
+        return f"{self.base}/plc/zone/{_chunk(zone)}/{what}"
+
+    def zone_any(self, what: str) -> str:
+        return f"{self.base}/plc/zone/*/{what}"
+
+    def plc_io(self, rid: str) -> str:
+        return f"{self.base}/plc/io/{_chunk(rid)}"
+
+    @property
+    def plc_io_any(self) -> str:
+        return f"{self.base}/plc/io/*"
+
+    @property
+    def plc_heartbeat(self) -> str:
+        return f"{self.base}/plc/heartbeat"
+
+    @property
+    def plc_event(self) -> str:
+        return f"{self.base}/plc/event"
+
+    @property
+    def plc_cmd(self) -> str:
+        return f"{self.base}/plc/cmd"
+
+    @property
+    def plc_state(self) -> str:
+        return f"{self.base}/plc/state"
+
+    def robot(self, rid: str, what: str) -> str:            # status | heartbeat | pos | alive
+        return f"{self.base}/robot/{_chunk(rid)}/{what}"
+
+    def robot_any(self, what: str) -> str:
+        return f"{self.base}/robot/*/{what}"
+
+    @property
+    def everything(self) -> str:
+        return f"{self.base}/**"
+
+
+def key_part(key: str, index: int) -> str:
+    return str(key).split("/")[index]
+
+
+# ── envelope ──────────────────────────────────────────────────────────────────
+def new_session() -> str:
+    return secrets.token_hex(8)
+
+
+class Envelope:
+    """Builds the common envelope of every message of one sender (src, sess, seq per key)."""
+
+    def __init__(self, cell: str, src: str, sess: Optional[str] = None):
+        self.cell = _chunk(cell)
+        self.src = str(src)
+        self.sess = sess or new_session()
+        self._seq: dict = {}
+        self.epoch = 0
+        self.table = ""
+
+    def wrap(self, key: str, body: dict, now: Optional[float] = None) -> dict:
+        n = self._seq.get(key, 0) + 1
+        self._seq[key] = n
+        msg = {"v": PROTO, "cell": self.cell, "src": self.src, "sess": self.sess, "seq": n,
+               "t": time.time() if now is None else float(now), "epoch": int(self.epoch)}
+        if self.table:
+            msg["table"] = self.table
+        msg.update(body)
+        return msg
+
+
+class SeqFilter:
+    """Receiver side of the envelope rules: drop stale / duplicate messages per (src, sess, key)."""
+
+    def __init__(self):
+        self._last: dict = {}
+        self.sessions: dict = {}
+        self.dropped = 0
+        self.bad_version = 0
+
+    def accept(self, key: str, msg: dict) -> "tuple[bool, bool]":
+        """``(accept, new_session)``."""
+        if not isinstance(msg, dict) or msg.get("v") != PROTO:
+            self.bad_version += 1
+            return False, False
+        src, sess, seq = msg.get("src"), msg.get("sess"), msg.get("seq")
+        restarted = src in self.sessions and self.sessions[src] != sess
+        self.sessions[src] = sess
+        k = (src, sess, key)
+        if isinstance(seq, int):
+            if seq <= self._last.get(k, 0):
+                self.dropped += 1
+                return False, restarted
+            self._last[k] = seq
+        return True, restarted
+
+
+def encode(msg: dict) -> bytes:
+    return json.dumps(msg, separators=(",", ":"), default=_json_default).encode()
+
+
+def decode(payload) -> Optional[dict]:
+    try:
+        if hasattr(payload, "to_bytes"):
+            payload = payload.to_bytes()
+        if isinstance(payload, (bytes, bytearray, memoryview)):
+            payload = bytes(payload).decode()
+        d = json.loads(payload)
+        return d if isinstance(d, dict) else None
+    except Exception:  # noqa: BLE001 - a bad message is counted, never raised
+        return None
+
+
+def _json_default(o):
+    try:
+        import numpy as np
+        if isinstance(o, np.generic):
+            return o.item()
+        if isinstance(o, np.ndarray):
+            return o.tolist()
+    except ImportError:  # pragma: no cover
+        pass
+    raise TypeError(f"not JSON serialisable: {type(o).__name__}")
+
+
+# ── program positions ─────────────────────────────────────────────────────────
+def pos_key(p: Optional[dict]) -> tuple:
+    """Lexicographic order key of a program position {k, t}; None = HOME before the program."""
+    if not p:
+        return (-1, 0.0)
+    return (int(p.get("k", -1)), float(p.get("t", 0.0)))
+
+
+def pos_after(p: Optional[dict], q: Optional[dict]) -> bool:
+    return pos_key(p) > pos_key(q)
+
+
+# ── zone table ────────────────────────────────────────────────────────────────
+def canonical_sha256(obj: Any) -> str:
+    return hashlib.sha256(json.dumps(obj, sort_keys=True, separators=(",", ":"),
+                                     default=_json_default).encode()).hexdigest()
+
+
+def occ_id(zone: str, rid: str) -> str:
+    return f"{zone}/{rid}"
+
+
+@dataclass
+class Occupancy:
+    zone: str
+    rid: str
+    order: int
+    enter: Optional[dict]          # {k, t} or None (inside from the initial HOME pose)
+    exit: Optional[dict]           # {k, t} or None (still inside at the end of the program)
+    stop: Optional[dict]           # {k, t}: where the robot waits for the grant
+    t_stop_s: float = 0.5
+    t_nom: tuple = (0.0, 0.0)
+
+    @property
+    def id(self) -> str:
+        c = self.__dict__.get("_id")
+        return c if c is not None else occ_id(self.zone, self.rid)
+
+    def to_json(self) -> dict:
+        return {"rid": self.rid, "order": self.order, "enter": self.enter, "exit": self.exit,
+                "stop": self.stop, "t_stop_s": self.t_stop_s, "t_nom": list(self.t_nom)}
+
+
+@dataclass
+class Zone:
+    id: str
+    pair: list
+    occ: list                       # [Occupancy], index = order
+    first: str = ""
+    min_bound_m: float = 0.0
+    cells: int = 0
+    tight: bool = False
+    extra: dict = field(default_factory=dict)
+
+    def to_json(self) -> dict:
+        d = {"id": self.id, "pair": list(self.pair), "first": self.first,
+             "occ": [o.to_json() for o in self.occ], "min_bound_m": self.min_bound_m,
+             "cells": self.cells, "tight": self.tight}
+        d.update(self.extra)
+        return d
+
+
+class ZoneTable:
+    """The ``vass_zones_v1`` table (see the module docstring)."""
+
+    def __init__(self, d: dict):
+        if d.get("format") != TABLE_FORMAT:
+            raise ValueError(f"not a {TABLE_FORMAT} table (format={d.get('format')!r})")
+        self.raw = d
+        self.cell_id = str(d.get("cell_id") or "")
+        self.robots = list(d.get("robots") or [])
+        self.arbitration = str(d.get("arbitration") or "plan")
+        self.legs = d.get("legs") or {}
+        self.config = d.get("config") or {}
+        self.stats = d.get("stats") or {}
+        self.zones: list = []
+        self._by_id: dict = {}
+        for z in d.get("zones") or []:
+            occ = []
+            for i, o in enumerate(z.get("occ") or []):
+                occ.append(Occupancy(zone=z["id"], rid=o["rid"], order=int(o.get("order", i)),
+                                     enter=o.get("enter"), exit=o.get("exit"), stop=o.get("stop"),
+                                     t_stop_s=float(o.get("t_stop_s") or 0.5),
+                                     t_nom=tuple(o.get("t_nom") or (0.0, 0.0))))
+            occ.sort(key=lambda o: o.order)
+            zone = Zone(id=z["id"], pair=list(z.get("pair") or [o.rid for o in occ]), occ=occ,
+                        first=z.get("first") or (occ[0].rid if occ else ""),
+                        min_bound_m=float(z.get("min_bound_m") or 0.0), cells=int(z.get("cells") or 0),
+                        tight=bool(z.get("tight")),
+                        extra={k: v for k, v in z.items() if k not in
+                               ("id", "pair", "first", "occ", "min_bound_m", "cells", "tight")})
+            self.zones.append(zone)
+            self._by_id[zone.id] = zone
+        self.sha256 = d.get("sha256") or table_sha256(d)
+
+    @property
+    def short(self) -> str:
+        return self.sha256[:12]
+
+    def zone(self, zid: str) -> Optional[Zone]:
+        return self._by_id.get(zid)
+
+    def occupancies(self, rid: str) -> list:
+        """The robot's occupancies in program order (entry position, then zone id)."""
+        out = [o for z in self.zones for o in z.occ if o.rid == rid]
+        out.sort(key=lambda o: (pos_key(o.enter), pos_key(o.exit) if o.exit else (1 << 30, 0.0), o.zone))
+        return out
+
+    def leg_end_t(self, rid: str, k: int) -> Optional[float]:
+        for leg in self.legs.get(rid) or []:
+            if int(leg.get("k", -1)) == int(k):
+                return float(leg.get("t_end", 0.0))
+        return None
+
+    def to_json(self) -> dict:
+        return dict(self.raw)
+
+    @classmethod
+    def from_json(cls, d: dict) -> "ZoneTable":
+        return cls(d)
+
+    def save(self, path) -> None:
+        with open(path, "w") as f:
+            json.dump(self.raw, f, indent=1, default=_json_default)
+
+    @classmethod
+    def load(cls, path) -> "ZoneTable":
+        with open(path) as f:
+            d = json.load(f)
+        if "behaviour_tree" in d or "root" in d:          # a plan file: the table rides in its metadata
+            return table_of_tree(d.get("behaviour_tree") or d)
+        return cls(d)
+
+
+def table_sha256(d: dict) -> str:
+    return canonical_sha256({k: v for k, v in d.items() if k != "sha256"})
+
+
+def table_of_tree(tree: dict) -> Optional[ZoneTable]:
+    """The zone table a behaviour tree carries in ``metadata.vass.table``, or None."""
+    md = (tree or {}).get("metadata") or {}
+    v = md.get("vass") if isinstance(md, dict) else None
+    if not isinstance(v, dict) or not isinstance(v.get("table"), dict):
+        return None
+    return ZoneTable(v["table"])
+
+
+def vass_metadata(tree: dict) -> dict:
+    md = (tree or {}).get("metadata") or {}
+    v = md.get("vass") if isinstance(md, dict) else None
+    return v if isinstance(v, dict) else {}
+
+
+def parse_zone_list(value) -> list:
+    """A ``zones`` port: list, JSON list string, or 'a;b' / 'a,b' (BT.CPP vector syntax)."""
+    if value is None or value == "":
+        return []
+    if isinstance(value, (list, tuple)):
+        return [str(v) for v in value]
+    s = str(value).strip()
+    if s.startswith("["):
+        try:
+            return [str(v) for v in json.loads(s)]
+        except ValueError:
+            pass
+    return [p.strip() for p in s.replace(",", ";").split(";") if p.strip()]
+
+
+def parse_interlocks(value) -> list:
+    """An ``interlocks`` port value: a list of dicts, or its JSON text (inline XML attribute)."""
+    if value is None or value == "":
+        return []
+    if isinstance(value, str):
+        try:
+            value = json.loads(value)
+        except ValueError:
+            return []
+    if isinstance(value, dict):
+        value = [value]
+    return [dict(v) for v in value if isinstance(v, dict) and v.get("zone")]
+
+
+def env_flag(name: str, default: str = "") -> str:
+    return os.environ.get(name, default).strip().lower()
