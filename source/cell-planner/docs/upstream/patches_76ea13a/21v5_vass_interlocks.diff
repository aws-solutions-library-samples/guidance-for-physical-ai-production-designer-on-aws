+
+@dataclass(frozen=True)
+class ZoneConfig:
+    arbitration: str = "plan"
+    margin_m: float = 0.010
+    path_step_m: float = 0.010
+    block: int = 16
+    band_s: float = 0.5
+    guard_s: float = P.GUARD_S
+    no_stop_radius_m: float = 0.05
+    stop_times_s: tuple = (0.25, 0.5, 0.75, 1.0, 1.5, 2.0, 3.0)
+    accel_tol: float = 0.05
+    max_zones: int = 1024
+    max_order_flips: int = 64
+    nominal_model: str = "event"          # round 4: "event" (event-driven nominal check) | "ticks" (fixed-step)
+    fast: bool = True                     # round 4: batched FK, KD-tree block conflicts, caches (False: v1 paths)
+    pair_repair: bool = True              # round 4: exact pair re-ordering before the flip / merge search
+    stop_relax: bool = True               # round 4: leg-start stops of stuck arms moved up to guard_s before the entry
+    hull_rule: bool = True
+    sphere_rule: bool = True
+    # umarell 76ea13a (21 v5): the executor's LOCKSTEP=1. The legs of one ompl-compound step (``sync_group``) then
+    # leave off one barrier and an arm off the shared clock e-stops the cell, so (a) no zone is derived between
+    # two arms' legs of the SAME sync_group (the compound plan proves them apart at each instant on one clock),
+    # (b) the nominal clock has the barrier, and (c) a zone a lockstep leg enters has its stop point at that leg's
+    # START: the executor takes those grants at rest before the barrier, never in motion. Everything else (other
+    # steps, Delay-staggered legs, coordinated trees, compound legs without lockstep) is interlocked as before.
+    lockstep: bool = False
+
+
+class DeriveError(Exception):
+    def __init__(self, code: str, msg: str):
+        super().__init__(f"{code}: {msg}")
+        self.code = code
+
+
+# ── 1. the tree on the executor's nominal clock ─────────────────────────────
+def _margin_s(cell_id: str) -> float:
+    try:
+        from agents.cell.bt_executor import ExecConfig
+        return float(ExecConfig.for_cell(cell_id).completion_margin_s)
+    except Exception:  # noqa: BLE001
+        return 1.0
+
+
+def leg_sync_group(traj) -> Optional[str]:
+    """The ``sync_group`` tag of an ompl-compound leg (on its first sample), or None."""
+    if traj and isinstance(traj[0], dict) and traj[0].get("sync_group"):
+        return str(traj[0]["sync_group"])
+    return None
+
+
+def program_legs(tree: dict, margin_s: Optional[float] = None, lockstep: bool = False) -> dict:
+    """rid -> [leg] in execution order, with the nominal executor clock of each leg.
+
+    leg = {k, kind, node, op, traj, vscale, hold, t0 (dispatch), t1 (motion end), t_done, sync}.
+    Semantics are those of ``BehaviourTreeExecutor``: a leg completes at
+    traj_end / velocity_scale + hold + completion_margin, Sequence runs in order,
+    Parallel joins its children, Delay waits, WaitForRobot(depends_on_ops) waits for
+    the operations' completion (resolved by a fixpoint over the whole tree).
+    ``lockstep`` (the executor's LOCKSTEP=1): the legs of one ``sync_group`` start
+    together, when the last of them arrives at the barrier (also a fixpoint); ``sync``
+    is the leg's group then, else None.
+    """
+    bb = tree.get("blackboard") or {}
+    cell = tree.get("cell_id") or ""
+    margin = _margin_s(cell) if margin_s is None else float(margin_s)
+    done: dict = {}
+    barrier: dict = {}
+
+    def run(pass_done, pass_bar):
+        legs: dict = {}
+        out_done: dict = {}
+        out_bar: dict = {}
+        problems: list = []
+
+        def ex(n, t):
+            k = node_kind(n)
+            if k in ("Sequence", "SequenceWithMemory"):
+                for ch in bt_children(n):
+                    t = ex(ch, t)
+                return t
+            if k == "Parallel":
+                ends = [ex(ch, t) for ch in bt_children(n)]
+                return max(ends + [t])
+            if k == "Delay":
+                t += float(bt_port(n, "delay_msec", 0) or 0) / 1000.0
+                for ch in bt_children(n):
+                    t = ex(ch, t)
+                return t
+            if k == "WaitForRobot":
+                if bt_resolve(bt_port(n, "depends_on_joints"), bb) or bt_resolve(bt_port(n, "depends_on_positions"), bb):
+                    problems.append(("unsupported_node", "WaitForRobot on joints / positions cannot be placed on "
+                                                         "the nominal clock"))
+                for d in bt_resolve(bt_port(n, "depends_on_ops"), bb) or []:
+                    t = max(t, pass_done.get((str(d.get("robot")), str(d.get("operation_id"))), t))
+                return t
+            if k in ("CheckSafety", "RequestInterlock", "ReleaseInterlock"):
+                return t
+            if k in ("ExecuteTrajectory", "MoveHome"):
+                rid = str(bt_port(n, "robot_ns"))
+                tr = trajectory_of(n, bb)
+                lst = legs.setdefault(rid, [])
+                if k == "ExecuteTrajectory":
+                    t += float(bt_port(n, "start_delay_s", 0.0) or 0.0)
+                    if bt_port(n, "has_interlock") and bt_resolve(bt_port(n, "interlock_target"), bb):
+                        problems.append(("blind_move", f"{rid} {bt_port(n, 'operation_id')}: has_interlock moves "
+                                                       f"to a one-point target that no path describes"))
+                    vs = float(bt_port(n, "velocity_scale", 1.0) or 1.0)
+                    hold = float(bt_port(n, "hold_duration_s", 0.5))
+                    op = str(bt_port(n, "operation_id"))
+                else:
+                    vs, hold, op = 1.0, 0.0, "home"
+                    if not tr:
+                        problems.append(("blind_move", f"{rid}: MoveHome without a planned trajectory"))
+                if not tr:
+                    lst.append({"k": len(lst), "kind": k, "node": n, "op": op, "traj": [], "vscale": vs,
+                                "hold": hold, "t0": t, "t1": t, "t_done": t + margin, "sync": None})
+                    return t + margin
+                grp = leg_sync_group(tr) if (lockstep and k == "ExecuteTrajectory") else None
+                if grp:
+                    out_bar[grp] = max(out_bar.get(grp, t), t)
+                    t = max(t, pass_bar.get(grp, t))
+                t_end = float(tr[-1]["time_s"]) / vs
+                td = t + t_end + hold + margin
+                lst.append({"k": len(lst), "kind": k, "node": n, "op": op, "traj": tr, "vscale": vs,
+                            "hold": hold, "t0": t, "t1": t + t_end, "t_done": td, "sync": grp})
+                if k == "ExecuteTrajectory":
+                    out_done[(rid, op)] = td
+                return td
+            problems.append(("unsupported_node", f"node {k!r}"))
+            return t
+
+        end = ex(tree.get("root") or {}, 0.0)
+        return legs, out_done, end, problems, out_bar
+
+    for _ in range(64):
+        legs, nd, end, problems, nb = run(done, barrier)
+        if nd == done and nb == barrier:
+            break
+        done, barrier = nd, nb
+    for rid, ls in legs.items():
+        ls.sort(key=lambda l: l["k"])
+    legs["_end"] = end
+    legs["_problems"] = problems
+    return legs
+
+
+# ── 2. geometry: umarell's own robot-robot rules as sphere envelopes ───────────
+def _axis_rot(axis: int, q: np.ndarray) -> np.ndarray:
+    """(N, 3, 3) rotations about the local x / y / z axis by the angles q (N,)."""
+    c, s_ = np.cos(q), np.sin(q)
+    R = np.zeros((len(q), 3, 3))
+    i, j = [(1, 2), (2, 0), (0, 1)][axis]
+    R[:, axis, axis] = 1.0
+    R[:, i, i] = c
+    R[:, j, j] = c
+    R[:, i, j] = -s_
+    R[:, j, i] = s_
+    return R
+
+
+_AXES = {"JointModelRX": 0, "JointModelRY": 1, "JointModelRZ": 2}
+
+
+def _fk_batch(model, Q):
+    """Joint placements oMi of a serial revolute chain (RX / RY / RZ joints) for every configuration, vectorised
+    (round 4: the per-sample pinocchio loop was the derivation's largest single cost). -> (R (N, nj, 3, 3),
+    t (N, nj, 3)), index 0 = universe; None when the model has another joint type (callers fall back)."""
+    Q = np.asarray(Q, float).reshape(-1, model.nq if model.nq else 6)
+    N, nj = len(Q), model.njoints
+    R = np.zeros((N, nj, 3, 3))
+    t = np.zeros((N, nj, 3))
+    R[:, 0] = np.eye(3)
+    for j in range(1, nj):
+        ax = _AXES.get(model.joints[j].shortname())
+        if ax is None:
+            return None
+        p = model.parents[j]
+        M = model.jointPlacements[j]
+        Rp = R[:, p] @ np.asarray(M.rotation)
+        t[:, j] = np.einsum("nij,j->ni", R[:, p], np.asarray(M.translation)) + t[:, p]
+        R[:, j] = Rp @ _axis_rot(ax, Q[:, model.joints[j].idx_q])
+    return R, t
+
+
+def _place_batch(R, t, parent, M):
+    """(N, 3, 3), (N, 3): oMi[parent] * M for a fixed placement M (a frame or a geometry object)."""
+    return R[:, parent] @ np.asarray(M.rotation), np.einsum("nij,j->ni", R[:, parent], np.asarray(M.translation)) + \
+        t[:, parent]
+
+
+class Geometry:
+    """Envelope spheres per arm and rule, from umarell's models (pinocchio + the cell config)."""
+
+    def __init__(self, cell_id: str, robots: list, cfg: ZoneConfig):
+        from agents.trajectory.tools import robot_kinematics as rk
+        self.cell = cell_id
+        self.rk = rk
+        coll = rk._load_collision_config(cell_id)
+        self.rules = []
+        if cfg.sphere_rule:
+            self.rules.append({"name": "umarell_spheres", "threshold_m": float(coll["warning_distance"]),
+                               "radius_m": 0.12})
+        if cfg.hull_rule and coll.get("hull_min_distance") is not None:
+            self.rules.append({"name": "hull_cover", "threshold_m": float(coll["hull_min_distance"])})
+        self.robots = list(robots)
+        self._m = {}
+        for rid in self.robots:
+            m, _ = rk._load_pinocchio_model(cell_id, rid)
+            rc = rk._load_robot_config(cell_id, rid)
+            self._m[rid] = {"model": m, "data": m.createData(), "base": np.asarray(rc["base_position"], float),
+                            "yaw": float(rc.get("base_orientation_yaw", 0.0)), "tool": rc.get("tool_collision"),
+                            "rc": rc}
+
+    def _world(self, rid, P_):
+        g = self._m[rid]
+        cy, sy = math.cos(g["yaw"]), math.sin(g["yaw"])
+        R = np.array([[cy, -sy, 0.0], [sy, cy, 0.0], [0.0, 0.0, 1.0]])
+        return P_ @ R.T + g["base"]
+
+    def spheres(self, rid, Q) -> "tuple[np.ndarray, np.ndarray, np.ndarray]":
+        """umarell's inter-arm spheres: centres (N, S, 3), parent joint (S,), joint origins (N, 6, 3)."""
+        out = self._spheres_batch(rid, Q)
+        if out is not None:
+            return out
+        return self._spheres_loop(rid, Q)
+
+    def _spheres_batch(self, rid, Q):
+        """``_spheres_loop`` vectorised (``robot_kinematics._config_spheres``: frame origins, link-fill spheres every
+        ``_LINK_SPHERE_STEP_M`` between consecutive joint origins, tool spheres on the mount frame; the same order),
+        or None when the model is not a plain revolute chain."""
+        g = self._m[rid]
+        m = g["model"]
+        Q = np.asarray(Q, float).reshape(-1, 6)
+        if not len(Q):
+            return None
+        fk = _fk_batch(m, Q)
+        if fk is None:
+            return None
+        R, t = fk
+        cy, sy = math.cos(g["yaw"]), math.sin(g["yaw"])
+        Rw = np.array([[cy, -sy, 0.0], [sy, cy, 0.0], [0.0, 0.0, 1.0]])
+        base = np.asarray(g["base"], float)
+        fr = []
+        for f in m.frames:
+            par = int(getattr(f, "parentJoint", getattr(f, "parent", 0)))
+            fr.append(_place_batch(R, t, par, f.placement)[1])
+        Fp = np.stack(fr, 1) @ Rw.T + base                       # (N, F, 3)
+        Jw = t[:, 1:] @ Rw.T + base                              # joint origins (N, nj - 1, 3)
+        fill = []
+        step = self.rk._LINK_SPHERE_STEP_M
+        if step > 0:
+            for j in range(1, m.njoints - 1):
+                a, b = t[:, j] @ Rw.T + base, t[:, j + 1] @ Rw.T + base
+                seg = np.linalg.norm(b - a, axis=-1)
+                n = (seg / step).astype(int)
+                if not (n == n[0]).all():
+                    return None
+                n0 = int(n[0])
+                if n0 < 1:
+                    continue
+                d = (b - a) / seg[:, None]
+                for k in range(1, n0 + 1):
+                    tk = k * step
+                    if (tk >= seg).any():
+                        if not (tk >= seg).all():
+                            return None
+                        break
+                    fill.append(a + d * tk)
+        tool = []
+        offs = self.rk._tool_offsets(g["tool"])
+        if offs:
+            token = (g["tool"] or {}).get("mount_link", "")
+            idx = next((i for i, f in enumerate(m.frames) if token and token in f.name), -1)
+            if idx >= 0:
+                f = m.frames[idx]
+                Rm, tm = _place_batch(R, t, int(getattr(f, "parentJoint", getattr(f, "parent", 0))), f.placement)
+                O = np.asarray(offs, float)                       # (T, 3)
+                Pt = np.einsum("nij,tj->nti", Rm, O) + tm[:, None, :]
+                tool = [Pt @ Rw.T + base]
+        parts = [Fp] + ([np.stack(fill, 1)] if fill else []) + tool
+        C = np.concatenate(parts, 1)
+        return C, self._sphere_parents(rid, C.shape[1]), Jw
+
+    def _spheres_loop(self, rid, Q) -> "tuple[np.ndarray, np.ndarray, np.ndarray]":
+        g = self._m[rid]
+        m, d = g["model"], g["data"]
+        rk = self.rk
+        C, J = [], []
+        for q in np.asarray(Q, float):
+            s = rk._config_spheres(m, d, q, g["base"], g["yaw"], g["tool"])
+            C.append(np.asarray(s, float))
+            J.append(np.array([d.oMi[j].translation for j in range(1, m.njoints)], float))
+        C = np.asarray(C)
+        J = self._world(rid, np.asarray(J).reshape(-1, 3)).reshape(len(C), -1, 3)
+        return C, self._sphere_parents(rid, C.shape[1]), J
+
+    def _sphere_parents(self, rid, n):
+        g = self._m[rid]
+        m = g["model"]
+        par = [int(getattr(f, "parentJoint", getattr(f, "parent", 0))) for f in m.frames]
+        nf = len(par)
+        n_tool = len(self.rk._tool_offsets(g["tool"]))
+        n_fill = n - nf - n_tool
+        fill = []
+        if n_fill > 0:
+            q0 = np.zeros(m.nq)
+            import pinocchio as pin
+            d = m.createData()
+            pin.forwardKinematics(m, d, q0)
+            step = self.rk._LINK_SPHERE_STEP_M
+            for j in range(1, m.njoints - 1):
+                seg = float(np.linalg.norm(d.oMi[j + 1].translation - d.oMi[j].translation))
+                cnt = int(seg / step) if step > 0 else 0
+                kk = 0
+                for i in range(1, cnt + 1):
+                    if i * step >= seg:
+                        break
+                    kk += 1
+                fill += [j] * kk
+        fill = (fill + [m.njoints - 1] * n_fill)[:n_fill]
+        mount = g["tool"].get("mount_link", "") if g["tool"] else ""
+        idx = max((i for i, f in enumerate(m.frames) if mount and mount in f.name), default=nf - 1)
+        tool_parent = par[idx] if idx >= 0 else m.njoints - 1
+        return np.array(par + fill + [tool_parent] * n_tool, int)
+
+    def hull_cover(self, rid, Q) -> "tuple[np.ndarray, np.ndarray, np.ndarray]":
+        """Spheres enclosing every URDF collision hull: centres (N, H, 3), radii (H,), parent joints (H,)."""
+        from agents.trajectory.tools import hull_clearance as hc
+        import pinocchio as pin
+        g = hc._geometry(self.cell, rid)
+        if "_cover" not in g:
+            loc, rad, gi = [], [], []
+            for k, go in enumerate(g["geom"].geometryObjects):
+                V = np.asarray(go.geometry.points(), float)
+                c0 = V.mean(0)
+                _, _, Vt = np.linalg.svd(V - c0, full_matrices=False)
+                Pp = (V - c0) @ Vt.T
+                lo, hi = Pp.min(0), Pp.max(0)
+                ext = hi - lo
+                n = int(max(1, math.ceil(ext[0] / max(ext[1], 0.12))))
+                for i in range(n):
+                    a0, a1 = lo[0] + ext[0] * i / n, lo[0] + ext[0] * (i + 1) / n
+                    mid = np.array([0.5 * (a0 + a1), 0.5 * (lo[1] + hi[1]), 0.5 * (lo[2] + hi[2])])
+                    loc.append(c0 + Vt.T @ mid)
+                    rad.append(0.5 * float(np.linalg.norm([a1 - a0, ext[1], ext[2]])) + 1e-4)
+                    gi.append(k)
+            g["_cover"] = (np.asarray(loc), np.asarray(rad), np.asarray(gi, int),
+                           np.array([int(go.parentJoint) for go in g["geom"].geometryObjects], int))
+        loc, rad, gi, gpar = g["_cover"]
+        model, data, geom, gdata, world = g["model"], g["data"], g["geom"], g["gdata"], g["world"]
+        Rw, tw = np.asarray(world.rotation), np.asarray(world.translation)
+        Qa = np.asarray(Q, float).reshape(len(Q), -1)
+        if len(Qa) and model.nq <= Qa.shape[1]:
+            fk = _fk_batch(model, Qa[:, :model.nq])
+            if fk is not None:
+                R, t = fk
+                Pg = []
+                for k_ in range(geom.ngeoms):
+                    go = geom.geometryObjects[k_]
+                    Pg.append(_place_batch(R, t, int(go.parentJoint), go.placement))
+                Rg = np.stack([x[0] for x in Pg], 1)               # (N, G, 3, 3)
+                tg = np.stack([x[1] for x in Pg], 1)
+                pl = np.einsum("nhij,hj->nhi", Rg[:, gi], loc) + tg[:, gi]
+                return pl @ Rw.T + tw, rad, gpar[gi]
+        out = np.empty((len(Q), len(loc), 3))
+        with hc._LOCK:
+            for i, q in enumerate(np.asarray(Q, float)):
+                qv = np.zeros(model.nq)
+                qv[: min(6, model.nq)] = q[: model.nq]
+                pin.forwardKinematics(model, data, qv)
+                pin.updateGeometryPlacements(model, data, geom, gdata)
+                Rg = np.array([gdata.oMg[k].rotation for k in range(geom.ngeoms)])
+                tg = np.array([gdata.oMg[k].translation for k in range(geom.ngeoms)])
+                pl = np.einsum("hij,hj->hi", Rg[gi], loc) + tg[gi]
+                out[i] = pl @ Rw.T + tw
+        return out, rad, gpar[gi]
+
+    def tcp(self, rid, Q) -> np.ndarray:
+        from utils import arm_model
+        import pinocchio as pin
+        g = self._m[rid]
+        m, d = g["model"], g["data"]
+        ee = arm_model.ee_frame_id(m)
+        Qa = np.asarray(Q, float).reshape(-1, 6)
+        fk = _fk_batch(m, Qa) if len(Qa) else None
+        if fk is not None:
+            f = m.frames[ee]
+            _, tf = _place_batch(fk[0], fk[1], int(getattr(f, "parentJoint", getattr(f, "parent", 0))), f.placement)
+            return self._world(rid, tf)
+        out = []
+        for q in np.asarray(Q, float):
+            pin.forwardKinematics(m, d, q)
+            pin.updateFramePlacements(m, d)
+            out.append(d.oMf[ee].translation.copy())
+        return self._world(rid, np.asarray(out))
+
+    def a_max(self, rid):
+        rc = self._m[rid]["rc"]
+        a = self.rk.joint_acceleration_limits(self.cell, rc)
+        return np.asarray(a if a is not None else [3.0, 3.0, 3.0, 6.0, 6.0, 8.0], float)[:6]
+
+
+def _sweep_radii(C, par, J) -> np.ndarray:
+    """R_j: max distance of any point that joint j moves (parent joint >= j) from joint j's origin, + 2 cm."""
+    R = np.zeros(J.shape[1])
+    for j in range(J.shape[1]):
+        sel = par >= (j + 1)
+        if not sel.any():
+            continue
+        R[j] = float(np.linalg.norm(C[:, sel, :] - J[:, j, None, :], axis=-1).max()) + 0.02
+    return R
+
+
+# ── program samples ───────────────────────────────────────────────────────────
+@dataclass
+class Program:
+    rid: str
+    legs: list
+    k: np.ndarray = None           # (N,) leg index
+    tau: np.ndarray = None         # (N,) leg-local time
+    Q: np.ndarray = None           # (N, 6)
+    t_in: np.ndarray = None        # (N,) nominal executor time the arm reaches the sample
+    t_out: np.ndarray = None       # (N,) ... and leaves it
+    phase: list = field(default_factory=list)
+
+
+def _densify(legs, end_t, R0, step_m) -> Program:
+    ks, taus, Qs, tin, tout, ph = [], [], [], [], [], []
+    for li, leg in enumerate(legs):
+        tr = leg["traj"]
+        if not tr:
+            continue
+        vs = leg["vscale"]
+        T = np.array([float(p["time_s"]) for p in tr])
+        Q = np.array([list(p["positions"])[:6] for p in tr], float)
+        phs = [str(p.get("phase", "")) for p in tr]
+        for i in range(len(T)):
+            if i > 0:
+                dq = np.abs(Q[i] - Q[i - 1])
+                n = int(math.ceil(float(dq @ R0) / step_m)) if step_m > 0 else 1
+                for s in range(1, max(n, 1)):
+                    a = s / n
+                    ks.append(li)
+                    taus.append(T[i - 1] + a * (T[i] - T[i - 1]))
+                    Qs.append(Q[i - 1] + a * (Q[i] - Q[i - 1]))
+                    t = leg["t0"] + taus[-1] / vs
+                    tin.append(t)
+                    tout.append(t)
+                    ph.append(phs[i])
+            ks.append(li)
+            taus.append(T[i])
+            Qs.append(Q[i])
+            t = leg["t0"] + T[i] / vs
+            tin.append(t)
+            tout.append(t)
+            ph.append(phs[i])
+        tout[-1] = None                      # rest at the leg end until the next leg starts
+    prog = Program(rid="", legs=legs)
+    prog.k = np.array(ks, int)
+    prog.tau = np.array(taus, float)
+    prog.Q = np.array(Qs, float).reshape(-1, 6)
+    tin_a = np.array(tin, float)
+    tout_l = list(tout)
+    # leg ends rest until the next leg's dispatch; the program end rests forever
+    starts = {li: leg["t0"] for li, leg in enumerate(legs) if leg["traj"]}
+    order = sorted(starts)
+    for idx in range(len(tout_l)):
+        if tout_l[idx] is None:
+            li = int(prog.k[idx])
+            nxt = [j for j in order if j > li]
+            tout_l[idx] = starts[nxt[0]] if nxt else float("inf")
+    if len(tin_a):
+        tin_a[0] = 0.0                       # at HOME from the start of the run
+    prog.t_in = tin_a
+    prog.t_out = np.array(tout_l, float)
+    prog.phase = ph
+    return prog
+
+
+def _step_margins(Q, R) -> np.ndarray:
+    if len(Q) < 2:
+        return np.zeros(len(Q))
+    D = np.abs(np.diff(Q, axis=0)) @ R
+    e = np.empty(len(Q))
+    e[0], e[-1] = D[0], D[-1]
+    e[1:-1] = np.maximum(D[:-1], D[1:])
+    return e
+
+
+# ── 3. conflicts and zones ────────────────────────────────────────────────────
+def _blocks(C, rad, e, B):
+    """Per block and envelope sphere: bounding sphere centre (nb, S, 3) and radius (nb, S)."""
+    N = len(C)
+    nb = (N + B - 1) // B
+    cen = np.empty((nb, C.shape[1], 3))
+    rr = np.empty((nb, C.shape[1]))
+    for b in range(nb):
+        blk = C[b * B:(b + 1) * B]
+        lo, hi = blk.min(0), blk.max(0)
+        cen[b] = 0.5 * (lo + hi)
+        rr[b] = 0.5 * np.linalg.norm(hi - lo, axis=-1) + rad + 0.5 * float(e[b * B:(b + 1) * B].max())
+    return cen, rr
+
+
+def _dense_conflicts(ca, ra, cb, rb, thr, chunk=6):
+    """(na, nb) bool, every block pair: some sphere pair closer than thr (lower bound)."""
+    na, S, _ = ca.shape
+    nb, T, _ = cb.shape
+    out = np.zeros((na, nb), bool)
+    fb = cb.reshape(-1, 3).astype(np.float32)
+    frb = rb.reshape(-1).astype(np.float32)
+    for i in range(0, na, chunk):
+        fa = ca[i:i + chunk].reshape(-1, 3).astype(np.float32)
+        fra = ra[i:i + chunk].reshape(-1).astype(np.float32)
+        d = np.sqrt(((fa[:, None, :] - fb[None, :, :]) ** 2).sum(-1)) - fra[:, None] - frb[None, :]
+        out[i:i + chunk] = (d <= thr).reshape(len(fa) // S, S, nb, T).any(axis=(1, 3))
+    return out
+
+
+def _coarsen(c, r, f):
+    """Bounding spheres of f consecutive blocks (per envelope sphere)."""
+    n = len(c)
+    m = (n + f - 1) // f
+    cc = np.empty((m, c.shape[1], 3))
+    rr = np.empty((m, c.shape[1]))
+    for g in range(m):
+        cs, rs = c[g * f:(g + 1) * f], r[g * f:(g + 1) * f]
+        lo, hi = cs.min(0), cs.max(0)
+        cc[g] = 0.5 * (lo + hi)
+        rr[g] = (np.linalg.norm(cs - cc[g][None], axis=-1) + rs).max(0)
+    return cc, rr
+
+
+def _block_conflicts_kd(ca, ra, cb, rb, thr, ncls: int = 6):
+    """(na, nb) bool: some sphere pair of block a and block b with d - r - r' <= thr (the dense rule, float64): a KD
+    tree per radius class over every block sphere, one flat scatter (round 4: replaces the dense float32 pass)."""
+    from scipy.spatial import cKDTree
+    na, S = ra.shape
+    nb, T = rb.shape
+    out = np.zeros(na * nb, bool)
+    Pa, Ra_ = ca.reshape(-1, 3), ra.reshape(-1)
+    Pb, Rb_ = cb.reshape(-1, 3), rb.reshape(-1)
+
+    def classes(rad):
+        q = np.quantile(rad, np.linspace(0, 1, ncls + 1)[1:-1])
+        lab = np.searchsorted(q, rad, side="left")
+        return [np.flatnonzero(lab == c) for c in range(ncls) if (lab == c).any()]
+    trees_b = [(cKDTree(Pb[ib]), Rb_[ib], (ib // T).astype(np.int64), float(Rb_[ib].max())) for ib in classes(Rb_)]
+    for ia in classes(Ra_):
+        ta = cKDTree(Pa[ia])
+        ra_c = Ra_[ia]
+        ba = (ia // S).astype(np.int64) * nb
+        rmax = float(ra_c.max())
+        for tb, rb_c, bb, rbmax in trees_b:
+            sdm = ta.sparse_distance_matrix(tb, rmax + rbmax + thr + 1e-9, output_type="ndarray")
+            if not len(sdm):
+                continue
+            i, j = sdm["i"], sdm["j"]
+            ok = sdm["v"] - ra_c[i] - rb_c[j] <= thr
+            out[ba[i[ok]] + bb[j[ok]]] = True
+    return out.reshape(na, nb)
+
+
+def _block_conflicts(ca, ra, cb, rb, thr, factor=4):
+    """(na, nb) bool: some sphere pair of block a and block b closer than thr (lower bound).
+
+    Two levels: block pairs are only examined inside groups of ``factor`` x ``factor`` blocks whose
+    bounding spheres conflict (the bounds are conservative, so nothing is lost)."""
+    na, nb = len(ca), len(cb)
+    if factor <= 1 or na * nb < 4096:
+        return _dense_conflicts(ca, ra, cb, rb, thr)
+    CA, RA = _coarsen(ca, ra, factor)
+    CB, RB = _coarsen(cb, rb, factor)
+    coarse = _dense_conflicts(CA, RA, CB, RB, thr)
+    out = np.zeros((na, nb), bool)
+    gi, gj = np.nonzero(coarse)
+    pairs = []
+    for I, J in zip(gi, gj):
+        for i in range(I * factor, min(na, (I + 1) * factor)):
+            for j in range(J * factor, min(nb, (J + 1) * factor)):
+                pairs.append((i, j))
+    if not pairs:
+        return out
+    pairs = np.asarray(pairs)
+    ca32, cb32 = ca.astype(np.float32), cb.astype(np.float32)
+    ra32, rb32 = ra.astype(np.float32), rb.astype(np.float32)
+    step = 256
+    for k in range(0, len(pairs), step):
+        pi, pj = pairs[k:k + step, 0], pairs[k:k + step, 1]
+        d = np.sqrt(((ca32[pi][:, :, None, :] - cb32[pj][:, None, :, :]) ** 2).sum(-1)) \
+            - ra32[pi][:, :, None] - rb32[pj][:, None, :]
+        out[pi, pj] = (d <= thr).any(axis=(1, 2))
+    return out
+
+
+def _sample_hits_kd(Ca, ra, ea, Cb, rb, eb, thr):
+    """(na, nb) bool: the dense rule of ``_sample_conflicts`` -- some sphere pair with
+    float32 |c - c'| - r - r' - (e + e') / 2 <= thr -- found with a KD tree over every (sample, sphere) point and the
+    dense expression re-evaluated on the candidates only (candidates at thr + 1e-5 in float64, a superset of the
+    float32 verdict), so the result equals the dense pass (round 4)."""
+    from scipy.spatial import cKDTree
+    na, S = Ca.shape[:2]
+    nb, T = Cb.shape[:2]
+    h = np.zeros((na, nb), bool)
+    if not na or not nb:
+        return h
+    Pa, Pb = Ca.reshape(-1, 3), Cb.reshape(-1, 3)
+    reach = float(np.max(ra) + np.max(rb) + 0.5 * (np.max(ea) + np.max(eb)) + thr + 1e-5)
+    sdm = cKDTree(Pa).sparse_distance_matrix(cKDTree(Pb), reach, output_type="ndarray")
+    if not len(sdm):
+        return h
+    i, j = sdm["i"], sdm["j"]
+    si, hi_ = i // S, i % S
+    sj, hj = j // T, j % T
+    A32 = Ca.astype(np.float32).reshape(-1, 3)
+    B32 = Cb.astype(np.float32).reshape(-1, 3)
+    df = A32[i] - B32[j]
+    d2 = df * df
+    d = np.sqrt((d2[:, 0] + d2[:, 1]) + d2[:, 2])
+    d = d - np.asarray(ra)[hi_] - np.asarray(rb)[hj] - 0.5 * (np.asarray(ea)[si] + np.asarray(eb)[sj])
+    ok = d <= thr
+    h[si[ok], sj[ok]] = True
+    return h
+
+
+def _sample_conflicts(env, geo, cfg, a, b, i, j, B, margin=None, fine=1, progs=None, cache=None):
+    """(n, 2) ABSOLUTE sample index pairs of blocks a:i and b:j whose lower bound conflicts.
+
+    ``fine`` > 1 re-densifies both blocks' paths ``fine`` times (smaller step margins); a fine point maps
+    back to the nearest path sample."""
+    m = cfg.margin_m if margin is None else margin
+    hits = None
+    if fine <= 1:
+        for rule in geo.rules:
+            Ca, ra, ea = env[a][rule["name"]][2:5]
+            Cb, rb, eb = env[b][rule["name"]][2:5]
+            if cfg.fast:
+                h = _sample_hits_kd(Ca[i * B:(i + 1) * B], ra, ea[i * B:(i + 1) * B], Cb[j * B:(j + 1) * B], rb,
+                                    eb[j * B:(j + 1) * B], rule["threshold_m"] + m)
+            else:
+                A = Ca[i * B:(i + 1) * B].astype(np.float32)
+                Bq = Cb[j * B:(j + 1) * B].astype(np.float32)
+                d = np.sqrt(((A[:, :, None, None, :] - Bq[None, None, :, :, :]) ** 2).sum(-1))
+                d = d - ra[None, :, None, None] - rb[None, None, None, :] \
+                    - 0.5 * (ea[i * B:(i + 1) * B][:, None, None, None] + eb[j * B:(j + 1) * B][None, None, :, None])
+                h = (d <= rule["threshold_m"] + m).any(axis=(1, 3))
+            hits = h if hits is None else (hits | h)
+        if hits is None:
+            return np.zeros((0, 2), int)
+        loc = np.argwhere(hits)
+        return np.stack([i * B + loc[:, 0], j * B + loc[:, 1]], axis=1)
+
+    def finer(rid, blk):
+        key = ("fine", rid, blk, fine)
+        if cache is not None and key in cache:
+            return cache[key]
+        pr = progs[rid]
+        n = len(pr.tau)
+        s0, s1 = max(0, blk * B - 1), min(n - 1, (blk + 1) * B)
+        ss = np.repeat(np.arange(s0, s1), fine)
+        uu = np.tile(np.arange(fine) / fine, max(s1 - s0, 0))
+        Q = pr.Q[ss] + uu[:, None] * (pr.Q[ss + 1] - pr.Q[ss]) if len(ss) else np.zeros((0, 6))
+        owner = np.where(uu < 0.5, ss, ss + 1)
+        Q = np.concatenate([Q, pr.Q[s1:s1 + 1]])
+        owner = np.concatenate([owner, [s1]]).astype(int)
+        env_f = {}
+        for rule in geo.rules:
+            if rule["name"] == "umarell_spheres":
+                C_, _, _ = geo.spheres(rid, Q)
+                env_f[rule["name"]] = (C_, np.full(C_.shape[1], rule["radius_m"]))
+            else:
+                C_, r_, _ = geo.hull_cover(rid, Q)
+                env_f[rule["name"]] = (C_, r_)
+        out = (Q, owner, env_f, _step_margins(Q, np.asarray(env[rid]["_R"])))
+        if cache is not None:
+            cache[key] = out
+        return out
+
+    Qa, oa, fa, ea = finer(a, i)
+    Qb, ob, fb, eb = finer(b, j)
+    for rule in geo.rules:
+        Ca, ra = fa[rule["name"]]
+        Cb, rb = fb[rule["name"]]
+        if cfg.fast:
+            h = _sample_hits_kd(Ca, ra, ea, Cb, rb, eb, rule["threshold_m"] + m)
+        else:
+            A = Ca.astype(np.float32)
+            Bq = Cb.astype(np.float32)
+            h = np.zeros((len(A), len(Bq)), bool)
+            for x in range(0, len(A), 16):
+                d = np.sqrt(((A[x:x + 16, :, None, None, :] - Bq[None, None, :, :, :]) ** 2).sum(-1))
+                d = d - ra[None, :, None, None] - rb[None, None, None, :] \
+                    - 0.5 * (ea[x:x + 16][:, None, None, None] + eb[None, None, :, None])
+                h[x:x + 16] = (d <= rule["threshold_m"] + m).any(axis=(1, 3))
+        hits = h if hits is None else (hits | h)
+    loc = np.argwhere(hits)
+    if not len(loc):
+        return np.zeros((0, 2), int)
+    pairs = np.unique(np.stack([oa[loc[:, 0]], ob[loc[:, 1]]], axis=1), axis=0)
+    return pairs
+
+
+def _label(mask):
+    try:
+        from scipy.ndimage import label
+        lab, n = label(mask, structure=np.ones((3, 3), int))
+        return lab, n
+    except ImportError:  # pragma: no cover - scipy is in umarell's requirements
+        lab = np.zeros(mask.shape, int)
+        n = 0
+        for (i, j) in zip(*np.nonzero(mask)):
+            if lab[i, j]:
+                continue
+            n += 1
+            stack = [(i, j)]
+            lab[i, j] = n
+            while stack:
+                a, b = stack.pop()
+                for da in (-1, 0, 1):
+                    for db in (-1, 0, 1):
+                        x, y = a + da, b + db
+                        if 0 <= x < mask.shape[0] and 0 <= y < mask.shape[1] and mask[x, y] and not lab[x, y]:
+                            lab[x, y] = n
+                            stack.append((x, y))
+        return lab, n
+
+
+def _rects(cells, f_out, w_in, band_s):
+    """Cover a blob's cells with rectangles the nominal path does not enter.
+
+    ``cells``: dicts with block indices (fi, wj) and sample ranges (f_lo, f_hi) on the first arm's path and
+    (w_lo, w_hi) on the second's. Bands of ``band_s`` of the second arm's nominal time; a band's bounding
+    rectangle is kept if the first arm leaves its interval before the second enters its own
+    (``f_out[f_hi] <= w_in[w_lo]``), else halved along its longer side, down to single cells (``tight``).
+    Returns [(f_lo, f_hi, w_lo, w_hi, tight)] in samples."""
+    out = []
+    cells = sorted(cells, key=lambda c: (w_in[c["w_lo"]], c["wj"], c["fi"]))
+    bands, cur, t0 = [], [], None
+    for c in cells:
+        t = w_in[c["w_lo"]]
+        if t0 is None or t - t0 > band_s:
+            if cur:
+                bands.append(cur)
+            cur, t0 = [], t
+        cur.append(c)
+    if cur:
+        bands.append(cur)
+
+    def cover(cs):
+        flo = min(c["f_lo"] for c in cs)
+        fhi = max(c["f_hi"] for c in cs)
+        wlo = min(c["w_lo"] for c in cs)
+        whi = max(c["w_hi"] for c in cs)
+        if f_out[fhi] <= w_in[wlo] + 1e-9:
+            out.append((flo, fhi, wlo, whi, False))
+            return
+        if len(cs) == 1:
+            out.append((flo, fhi, wlo, whi, True))
+            return
+        fs = [c["fi"] for c in cs]
+        ws = [c["wj"] for c in cs]
+        if max(fs) - min(fs) >= max(ws) - min(ws):
+            mid = float(np.median(fs))
+            left = [c for c in cs if c["fi"] <= mid]
+            right = [c for c in cs if c["fi"] > mid]
+        else:
+            mid = float(np.median(ws))
+            left = [c for c in cs if c["wj"] <= mid]
+            right = [c for c in cs if c["wj"] > mid]
+        if not left or not right:
+            half = len(cs) // 2
+            left, right = cs[:half], cs[half:]
+        cover(left)
+        cover(right)
+    for b in bands:
+        cover(b)
+    return out
+
+
+def derive_zones(tree: dict, cfg: ZoneConfig = ZoneConfig(), geometry: Optional[Geometry] = None,
+                 verbose: bool = False) -> P.ZoneTable:
+    t_start = time.time()
+    cell = tree.get("cell_id") or ""
+    lockstep = bool(getattr(cfg, "lockstep", False))
+    legs = program_legs(tree, lockstep=lockstep)
+    end_t = legs.pop("_end")
+    problems = legs.pop("_problems")
+    for code, msg in problems:
+        raise DeriveError(code, msg)
+    robots = sorted(legs)
+    if len(robots) < 2:
+        raise DeriveError("unsupported_node", "fewer than two arms: nothing to interlock")
+    geo = geometry or Geometry(cell, robots, cfg)
+    progs, env, radii = {}, {}, {}
+    for rid in robots:
+        # pre-pass: sweep radii from the knots (spheres + hull cover), then densify
+        knots = np.vstack([np.asarray([list(p["positions"])[:6] for p in l["traj"]], float)
+                           for l in legs[rid] if l["traj"]])
+        C, par, J = geo.spheres(rid, knots)
+        Rs = [_sweep_radii(C, par, J)]
+        if any(r["name"] == "hull_cover" for r in geo.rules):
+            Ch, _rh, parh = geo.hull_cover(rid, knots)
+            Rs.append(_sweep_radii(Ch, parh, J))
+        R0 = np.max(np.vstack(Rs), axis=0) * 1.05 + 0.02
+        radii[rid] = R0
+        prog = _densify(legs[rid], end_t, R0, cfg.path_step_m)
+        prog.rid = rid
+        progs[rid] = prog
+        e = _step_margins(prog.Q, R0)
+        env[rid] = {"_R": R0}
+        for rule in geo.rules:
+            if rule["name"] == "umarell_spheres":
+                C, _, _ = geo.spheres(rid, prog.Q)
+                rad = np.full(C.shape[1], rule["radius_m"])
+            else:
+                C, rad, _ = geo.hull_cover(rid, prog.Q)
+            env[rid][rule["name"]] = _blocks(C, rad, e, cfg.block) + (C, rad, e)
+        if verbose:
+            print(f"[vass_zones] {rid}: {len(prog.tau)} samples, R={np.round(R0, 2).tolist()}", flush=True)
+    B = cfg.block
+    # lockstep: the sync_group of every program sample ("" = none) and the groups present in each block
+    sgrp = {}
+    blk_grp = {}
+    for rid in robots:
+        pr = progs[rid]
+        lg = [str(l.get("sync") or "") for l in legs[rid]]
+        sgrp[rid] = np.array([lg[int(k_)] for k_ in pr.k], dtype=object) if len(pr.k) else np.zeros(0, object)
+        # the rest at the end of the leg before a lockstep leg is that leg's first configuration, and it lasts only
+        # until the barrier, i.e. until every partner starts its own leg of the group: it belongs to the group
+        for li in range(len(lg) - 1):
+            if lg[li + 1] and not lg[li]:
+                idx = np.nonzero(pr.k == li)[0]
+                if len(idx):
+                    sgrp[rid][int(idx[-1])] = lg[li + 1]
+        nb_ = (len(pr.tau) + B - 1) // B
+        blk_grp[rid] = [set(x for x in sgrp[rid][b_ * B:(b_ + 1) * B] if x) for b_ in range(nb_)]
+    lockstep_on = lockstep and any(any(bg) for bg in blk_grp.values())
+
+    def same_group(a, b, sa, sb):
+        """Sample pairs of a and b that lie in legs of the same sync_group (not interlocked under lockstep)."""
+        ga, gb = sgrp[a][sa], sgrp[b][sb]
+        return (ga != "") & (ga == gb)
+
+    def _segments(rid, lo, hi):
+        """[lo, hi] cut where the samples' sync_group label changes: [(lo_, hi_, label)]."""
+        g = sgrp[rid]
+        out, s0 = [], lo
+        for i in range(lo + 1, hi + 1):
+            if g[i] != g[i - 1]:
+                out.append((s0, i - 1, g[s0]))
+                s0 = i
+        out.append((s0, hi, g[s0]))
+        return out
+
+    def split_sync(f, w, flo, fhi, wlo, whi, cells):
+        """Lockstep: a rectangle (the union cover of a blob) can reach into the part where BOTH arms are in legs of
+        one sync_group (never interlocked: the barrier and the lag e-stop keep them apart). Cut it at the group
+        boundaries and keep the pieces outside that part which contain a conflicting cell."""
+        out = []
+        for (f0, f1, gf) in _segments(f, flo, fhi):
+            for (w0, w1, gw) in _segments(w, wlo, whi):
+                if gf and gf == gw:
+                    continue
+                if any(c["f_lo"] <= f1 and c["f_hi"] >= f0 and c["w_lo"] <= w1 and c["w_hi"] >= w0 for c in cells):
+                    out.append((f0, f1, w0, w1))
+        return out
+
+    def blk_times(prog):
+        n = len(prog.tau)
+        nb = (n + B - 1) // B
+        tin = np.array([prog.t_in[b * B:(b + 1) * B].min() for b in range(nb)])
+        tout = np.array([prog.t_out[b * B:(b + 1) * B].max() for b in range(nb)])
+        return tin, tout
+
+    bt_times = {rid: blk_times(progs[rid]) for rid in robots}
+    fcache: dict = {}                    # round 4: re-densified blocks (path + envelopes) per (robot, block, factor)
+    bh_cache: dict = {}                  # round 4: block_hits per (robot, block, other, partner blocks)
+    rects = []
+    stats_pairs = {}
+    confs = {}
+    for ia, a in enumerate(robots):
+        for b in robots[ia + 1:]:
+            conf = None
+            for rule in geo.rules:
+                ca, ra = env[a][rule["name"]][:2]
+                cb, rb = env[b][rule["name"]][:2]
+                bc = _block_conflicts_kd if cfg.fast else _block_conflicts
+                c = bc(ca, ra, cb, rb, rule["threshold_m"] + cfg.margin_m)
+                conf = c if conf is None else (conf | c)
+            n_sync_drop = 0
+            touch = None
+            if conf is not None and lockstep_on and conf.any():
+                # block cells whose samples are all in legs of one sync_group of both arms: no zone at all;
+                # cells that only partly are: decided on the sample pairs outside it (below)
+                touch = np.zeros(conf.shape, bool)
+                for i_, j_ in zip(*np.nonzero(conf)):
+                    common = blk_grp[a][i_] & blk_grp[b][j_]
+                    if not common:
+                        continue
+                    sa_ = sgrp[a][i_ * B:(i_ + 1) * B]
+                    sb_ = sgrp[b][j_ * B:(j_ + 1) * B]
+                    if len(set(sa_)) == 1 and len(set(sb_)) == 1 and sa_[0] == sb_[0]:
+                        conf[i_, j_] = False
+                        n_sync_drop += 1
+                    else:
+                        touch[i_, j_] = True
