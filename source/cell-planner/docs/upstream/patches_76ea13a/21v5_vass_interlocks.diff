index 0000000..5b4835f
--- /dev/null
+++ b/agents/cell/vass_transport.py
@@ -0,0 +1,244 @@
+"""Transports for the VASS interlock bus: zenoh (the cell bus) and an in-process bus (tests, single process).
+
+Both implement the same tiny interface, used by the PLC emulator and the robot
+clients::
+
+    put(key, msg: dict, qos="ctrl"|"level"|"hb"|"data"|"log")
+    subscribe(keyexpr, cb(key, msg, rx_t))
+    liveliness_token(key)                 # presence, withdrawn on close / crash
+    liveliness_subscribe(keyexpr, cb(key, alive: bool, rx_t))
+    close()
+
+Key expressions follow zenoh: ``*`` matches one chunk, ``**`` any number.
+
+``ZenohTransport`` opens one zenoh session (``mode`` client / peer / router).
+A cell runs one router (``python -m agents.cell.vass_plc --router`` embeds it in
+the PLC); robots and tools connect to it as clients. VASS keys start with
+``cell/`` and rmw_zenoh keys with the ROS domain id, so the plant router umarell
+already uses for ROS 2 over zenoh (``agents/middleware.py``) can carry both.
+zenoh is imported lazily: nothing else in umarell needs it.
+"""
+from __future__ import annotations
+
+import json
+import queue
+import threading
+import time
+from typing import Callable, Optional
+
+from agents.cell.vass_protocol import decode, encode
+
+QOS = ("ctrl", "level", "hb", "data", "log")
+
+
+def keyexpr_match(expr: str, key: str) -> bool:
+    """zenoh-style wildcard match (``*`` one chunk, ``**`` zero or more chunks)."""
+    e, k = expr.split("/"), key.split("/")
+
+    def m(i, j):
+        if i == len(e):
+            return j == len(k)
+        if e[i] == "**":
+            return any(m(i + 1, jj) for jj in range(j, len(k) + 1))
+        if j == len(k):
+            return False
+        return (e[i] == "*" or e[i] == k[j]) and m(i + 1, j + 1)
+    return m(0, 0)
+
+
+class LocalBus:
+    """In-process message bus shared by several ``LocalTransport`` endpoints.
+
+    Delivery runs on one dispatcher thread, in send order (FIFO per bus), with an
+    optional constant delay per message: enough to exercise the protocol without
+    a network. Messages are JSON-encoded and decoded on the way, so a message that
+    would not survive the wire does not survive here either.
+    """
+
+    def __init__(self, delay_s: float = 0.0):
+        self.delay_s = float(delay_s)
+        self._subs: list = []
+        self._lsubs: list = []
+        self._tokens: dict = {}
+        self._lock = threading.Lock()
+        self._q: "queue.Queue" = queue.Queue()
+        self._closed = False
+        self._thread = threading.Thread(target=self._run, daemon=True, name="vass-localbus")
+        self._thread.start()
+
+    def _run(self):
+        while not self._closed:
+            try:
+                due, fn = self._q.get(timeout=0.1)
+            except queue.Empty:
+                continue
+            wait = due - time.monotonic()
+            if wait > 0:
+                time.sleep(wait)
+            try:
+                fn()
+            except Exception:  # noqa: BLE001 - a subscriber error must not stop the bus
+                pass
+
+    def _post(self, fn):
+        self._q.put((time.monotonic() + self.delay_s, fn))
+
+    def put(self, key, payload: bytes):
+        with self._lock:
+            subs = [(ex, cb) for ex, cb in self._subs if keyexpr_match(ex, key)]
+        for _ex, cb in subs:
+            self._post(lambda cb=cb: cb(key, payload))
+
+    def subscribe(self, expr, cb):
+        with self._lock:
+            self._subs.append((expr, cb))
+
+    def token(self, key, alive: bool):
+        with self._lock:
+            if alive:
+                self._tokens[key] = self._tokens.get(key, 0) + 1
+            else:
+                self._tokens[key] = max(0, self._tokens.get(key, 0) - 1)
+            ls = [(ex, cb) for ex, cb in self._lsubs if keyexpr_match(ex, key)]
+        for _ex, cb in ls:
+            self._post(lambda cb=cb: cb(key, alive))
+
+    def lsubscribe(self, expr, cb):
+        with self._lock:
+            self._lsubs.append((expr, cb))
+            live = [k for k, n in self._tokens.items() if n > 0 and keyexpr_match(expr, k)]
+        for k in live:
+            self._post(lambda k=k: cb(k, True))
+
+    def close(self):
+        self._closed = True
+
+
+class LocalTransport:
+    """One endpoint on a ``LocalBus``."""
+
+    def __init__(self, bus: LocalBus):
+        self.bus = bus
+        self._tokens: list = []
+        self._closed = False
+
+    def put(self, key: str, msg: dict, qos: str = "ctrl") -> None:
+        if not self._closed:
+            self.bus.put(key, encode(msg))
+
+    def subscribe(self, keyexpr: str, cb: Callable) -> None:
+        def _cb(key, payload):
+            if self._closed:
+                return
+            m = decode(payload)
+            if m is not None:
+                cb(key, m, time.time())
+        self.bus.subscribe(keyexpr, _cb)
+
+    def liveliness_token(self, key: str) -> None:
+        self._tokens.append(key)
+        self.bus.token(key, True)
+
+    def liveliness_subscribe(self, keyexpr: str, cb: Callable) -> None:
+        self.bus.lsubscribe(keyexpr, lambda k, alive: (None if self._closed else cb(k, alive, time.time())))
+
+    def close(self) -> None:
+        if self._closed:
+            return
+        for k in self._tokens:
+            self.bus.token(k, False)
+        self._closed = True
+
+
+class ZenohTransport:
+    """A zenoh session (client by default) carrying the VASS keys."""
+
+    def __init__(self, *, mode: str = "client", connect=None, listen=None, lease_ms: int = 1000,
+                 multicast: bool = False):
+        import zenoh
+        self._z = zenoh
+        cfg = zenoh.Config()
+        cfg.insert_json5("mode", json.dumps(mode))
+        cfg.insert_json5("scouting/multicast/enabled", json.dumps(bool(multicast)))
+        if connect:
+            cfg.insert_json5("connect/endpoints", json.dumps(list(_as_list(connect))))
+        if listen:
+            cfg.insert_json5("listen/endpoints", json.dumps(list(_as_list(listen))))
+        try:
+            cfg.insert_json5("timestamping/enabled", "true")
+        except Exception:  # noqa: BLE001 - optional
+            pass
+        try:
+            cfg.insert_json5("transport/link/tx/lease", str(int(lease_ms)))
+        except Exception:  # noqa: BLE001 - key renamed in some releases
+            pass
+        self.session = zenoh.open(cfg)
+        self._keep: list = []
+        self._closed = False
+        CC, PR = zenoh.CongestionControl, zenoh.Priority
+        self._qos = {
+            "ctrl": dict(congestion_control=CC.BLOCK, priority=PR.REAL_TIME, express=True),
+            "hb": dict(congestion_control=CC.DROP, priority=PR.REAL_TIME, express=True),
+            "level": dict(congestion_control=CC.DROP, priority=PR.INTERACTIVE_HIGH),
+            "data": dict(congestion_control=CC.DROP, priority=PR.DATA),
+            "log": dict(congestion_control=CC.DROP, priority=PR.DATA_LOW),
+        }
+
+    def put(self, key: str, msg: dict, qos: str = "ctrl") -> None:
+        if self._closed:
+            return
+        kw = self._qos.get(qos, self._qos["ctrl"])
+        try:
+            self.session.put(key, encode(msg), **kw)
+        except TypeError:          # an older binding without one of the QoS keywords
+            self.session.put(key, encode(msg))
+
+    def subscribe(self, keyexpr: str, cb: Callable) -> None:
+        def _cb(sample):
+            m = decode(sample.payload)
+            if m is not None:
+                cb(str(sample.key_expr), m, time.time())
+        self._keep.append(self.session.declare_subscriber(keyexpr, _cb))
+
+    def liveliness_token(self, key: str) -> None:
+        self._keep.append(self.session.liveliness().declare_token(key))
+
+    def liveliness_subscribe(self, keyexpr: str, cb: Callable) -> None:
+        z = self._z
+
+        def _cb(sample):
+            cb(str(sample.key_expr), sample.kind == z.SampleKind.PUT, time.time())
+        try:
+            sub = self.session.liveliness().declare_subscriber(keyexpr, _cb, history=True)
+        except TypeError:
+            sub = self.session.liveliness().declare_subscriber(keyexpr, _cb)
+        self._keep.append(sub)
+
+    def close(self) -> None:
+        if self._closed:
+            return
+        self._closed = True
+        for k in reversed(self._keep):
+            try:
+                k.undeclare()
+            except Exception:  # noqa: BLE001
+                pass
+        try:
+            self.session.close()
+        except Exception:  # noqa: BLE001
+            pass
+
+
+def _as_list(v) -> list:
+    if isinstance(v, str):
+        return [p for p in v.split(",") if p]
+    return list(v)
+
+
+def open_transport(spec: Optional[dict] = None, bus: Optional[LocalBus] = None):
+    """``spec`` = the cell's ``vass:`` block (``connect`` / ``listen`` / ``mode``), or a LocalBus."""
+    if bus is not None:
+        return LocalTransport(bus)
+    spec = dict(spec or {})
+    return ZenohTransport(mode=spec.get("mode", "client"), connect=spec.get("connect") or spec.get("router"),
+                          listen=spec.get("listen"), lease_ms=int(spec.get("lease_ms", 1000)))
