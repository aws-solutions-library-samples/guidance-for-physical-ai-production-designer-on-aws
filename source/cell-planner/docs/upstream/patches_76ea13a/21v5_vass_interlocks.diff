+def test_robot_agent_splices_on_the_jtc_clock(ros_stubs):
+    """Patch 21 on a ROS 2 joint_trajectory_controller (round-4 run on ROS 2 Jazzy, ros2_controllers 4.42): the goal
+    clock follows the JTC's FJT feedback (``header.stamp - desired.time_from_start``), and a VASS replacement carries
+    ``header.stamp`` = the switch time on that clock. Unstamped, the JTC started the replacement at its first update
+    after acceptance, back at the switch point while the arm had moved on (a command step at every splice)."""
+    import threading
+    import time
+    from agents.robot import robot_agent
+    off = 1234.5                                            # ROS clock - monotonic clock
+    ns = lambda: int((time.monotonic() + off) * 1e9)        # noqa: E731
+    sent = []
+
+    class _FbClient:
+        def wait_for_server(self, timeout_sec=None):
+            return True
+
+        def send_goal_async(self, goal, feedback_callback=None):
+            sent.append((goal, feedback_callback))
+            return _Accepted(goal)
+
+    ag = object.__new__(robot_agent.RobotAgent)
+    ag._node = types.SimpleNamespace(get_clock=lambda: types.SimpleNamespace(
+        now=lambda: types.SimpleNamespace(nanoseconds=ns())))
+    ag._logger = types.SimpleNamespace(info=lambda *a, **k: None, warning=lambda *a, **k: None,
+                                       error=lambda *a, **k: None)
+    ag._fjt_client, ag._estopped, ag._active_goal_handle, ag._current_task = _FbClient(), False, None, None
+    ag._goal_lock, ag._goal_gen, ag._goal_stamp, ag._goal_clocked = threading.Lock(), 1, {}, set()
+    ag._goal_done, ag._joint_positions = set(), [0.0] * 6
+    ag._goal_id, ag._goal_t0 = "g1", time.monotonic()
+    assert abs(ag._ros_minus_mono() - off) < 1e-3
+    # FJT feedback of goal 1: the JTC started it 0.30 s before this update -> the goal clock moves to the JTC's origin
+    now_ros = ns() * 1e-9
+    fb = types.SimpleNamespace(feedback=types.SimpleNamespace(
+        header=types.SimpleNamespace(stamp=types.SimpleNamespace(sec=int(now_ros),
+                                                                 nanosec=int((now_ros % 1) * 1e9))),
+        desired=types.SimpleNamespace(time_from_start=types.SimpleNamespace(sec=0, nanosec=300_000_000))))
+    ag._feedback_cb(1)(fb)
+    t0 = ag._goal_t0
+    assert abs(t0 - (now_ros - off - 0.30)) < 2e-3
+    ag._goal_t0 = t0 + 1.0
+    ag._feedback_cb(1)(fb)                                  # only the first feedback of a goal sets the clock
+    assert ag._goal_t0 == t0 + 1.0
+    ag._goal_t0 = t0
+    ag._feedback_cb(7)(fb)                                  # feedback of an older / other goal: no change
+    assert ag._goal_t0 == t0
+    # replacement at goal time 0.45 s (0.15 s from now): sent at the switch, stamped with the switch on the ROS clock
+    ag._schedule_replacement(_leg(T=1.0), "op", 0.0, "g2", {"of": "g1", "at_s": 0.45}, exact=False)
+    for _ in range(200):
+        if sent:
+            break
+        time.sleep(0.01)
+    assert sent, "the replacement was not sent"
+    goal, cb = sent[-1]
+    st = goal.trajectory.header.stamp.sec + 1e-9 * goal.trajectory.header.stamp.nanosec
+    assert abs(st - (t0 + 0.45 + off)) < 2e-3
+    assert cb is not None and ag._goal_id == "g2" and abs(ag._goal_t0 - (t0 + 0.45)) < 1e-9
+    # a replacement that is already late is refused (the running goal ends at rest before the zone)
+    n = len(sent)
+    ag._schedule_replacement(_leg(T=1.0), "op", 0.0, "g3", {"of": "g2", "at_s": 0.0}, exact=False)
+    time.sleep(0.05)
+    assert len(sent) == n and ag._goal_id == "g2"
+
