+def test_false_deadlock_under_a_slow_dispatch_does_not_fault_the_plc():
+    """End to end: r1 waits at its stop for za (held by r2 since leg 0); r2's leg 1 starts with a 2.5 s dispatch
+    delay toward its stop for zb (granted to r1). 21 v2 reported WAIT during the delay, the PLC saw the cycle and
+    FAULTed (the round-3 U-PKG 2t stalls); now r2 moves on, leaves za, and the run completes."""
+    table = _cycle_table()
+    tr_r1 = _traj(0.0, 1.0, T=2.0)
+    ilk1 = [{"zone": "za", "occ": "za/r1", "k": 0, "enter_t": 1.05, "exit_t": 1.5, "stop_t": 1.0, "t_stop_s": 0.25},
+            {"zone": "zb", "occ": "zb/r1", "k": 0, "enter_t": 1.6, "exit_t": 1.8, "stop_t": 1.55, "t_stop_s": 0.25}]
+    ilk2a = [{"zone": "za", "occ": "za/r2", "k": 0, "enter_t": 0.5, "exit_t": None, "stop_t": 0.45,
+              "t_stop_s": 0.25}]
+    ilk2b = [{"zone": "za", "occ": "za/r2", "k": 1, "enter_t": None, "exit_t": 0.3, "stop_t": None, "t_stop_s": 0.25},
+             {"zone": "zb", "occ": "zb/r2", "k": 1, "enter_t": 1.05, "exit_t": 1.5, "stop_t": 1.0, "t_stop_s": 0.25}]
+    seq2 = {"type": "Sequence", "children": [
+        {"type": "ExecuteTrajectory", "ports": {"robot_ns": "r2", "operation_id": "B1", "trajectory":
+                                               _traj(0.0, 1.0, T=1.0), "hold_duration_s": 0.0, "interlocks": ilk2a}},
+        {"type": "ExecuteTrajectory", "ports": {"robot_ns": "r2", "operation_id": "B2", "trajectory":
+                                               _traj(1.0, 2.0, T=2.0), "hold_duration_s": 0.0, "interlocks": ilk2b}}]}
+    tree = {"cell_id": "toy", "root": {"type": "Parallel", "children": [
+        {"type": "ExecuteTrajectory", "ports": {"robot_ns": "r1", "operation_id": "A", "trajectory": tr_r1,
+                                               "hold_duration_s": 0.0, "interlocks": ilk1}}, seq2]},
+        "metadata": {"vass": {"table": table.to_json()}}}
+
+    class SlowSecond(FollowRuntime):
+        n = 0
+
+        def dispatch(self, r, task):
+            if r == "r2" and not task.get("replace"):
+                SlowSecond.n += 1
+                if SlowSecond.n == 2:
+                    time.sleep(2.5)                       # the second fresh goal of r2 (its leg 1) is late
+            return super().dispatch(r, task)
+    rt = SlowSecond({"r1": [0.0] * 6, "r2": [0.0] * 6})
+    res, rep, wall = _run(table, tree, rt, plc_cfg=PlcConfig(deadlock_confirm_s=1.0), timeout_s=40.0)
+    assert res["success"], res
+    assert rep["counters"]["deadlocks"] == 0 and rep["mode"] != "FAULT" and rep["I7_ok"]
+
