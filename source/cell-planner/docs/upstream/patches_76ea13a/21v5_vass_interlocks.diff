+    def _block_hits(rid, b, other, partners):
+        n = len(progs[rid].tau)
+        s0, s1 = b * B, min(n, (b + 1) * B)
+        hit = np.zeros(s1 - s0, bool)
+        for rule in geo.rules:
+            cen, rr = env[other][rule["name"]][0], env[other][rule["name"]][1]
+            C, rad, e = env[rid][rule["name"]][2:5]
+            cb = cen[partners].reshape(-1, 3)
+            rb = rr[partners].reshape(-1)
+            thr = rule["threshold_m"] + cfg.margin_m
+            ca = C[s0:s1]
+            reach = rad[None, :] + 0.5 * e[s0:s1, None] + thr
+            try:
+                from scipy.spatial import cKDTree
+                flat = ca.reshape(-1, 3)
+                S_ = ca.shape[1]
+                M = cKDTree(flat).sparse_distance_matrix(
