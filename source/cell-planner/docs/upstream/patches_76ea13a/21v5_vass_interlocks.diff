+def test_stop_relax_is_a_config_switch_and_keeps_completed_tables():
+    """A table whose nominal run completes is the same with and without the stop relaxation (it only acts on stuck
+    arms), and ``stop_relax=False`` restores the earlier repair sequence."""
+    geo = ToyGeometry({"a": [0.0, 0.0, 0.0], "b": [2.0, 0.0, 0.0]})
+    tree = _toy_tree()
+    out = {}
+    for relax in (False, True):
+        cfg = V.ZoneConfig(path_step_m=0.02, block=4, margin_m=0.0, hull_rule=False, stop_relax=relax)
+        t = V.derive_zones(tree, cfg, geometry=geo)
+        assert t.stats["nominal"]["completed"]
+        assert t.stats.get("stop_repairs") == []
+        out[relax] = [z.to_json() for z in t.zones]
+    assert out[True] == out[False]
