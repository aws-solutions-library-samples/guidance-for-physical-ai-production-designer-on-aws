+def test_validator_knows_the_interlock_nodes():
+    from agents.trajectory.tools.behaviour_tree import validate_behaviour_tree
+    fn = getattr(validate_behaviour_tree, "func", validate_behaviour_tree)
+    ok = fn({"root": {"type": "Sequence", "children": [
+        {"type": "RequestInterlock", "ports": {"robot_ns": "r1", "zones": ["z1"]}},
+        {"type": "ReleaseInterlock", "ports": {"robot_ns": "r1", "zones": ["z1"]}}]}})
+    assert ok["valid"], ok
+    bad = fn({"root": {"type": "RequestInterlock", "ports": {"robot_ns": "r1"}}})
+    assert not bad["valid"]
