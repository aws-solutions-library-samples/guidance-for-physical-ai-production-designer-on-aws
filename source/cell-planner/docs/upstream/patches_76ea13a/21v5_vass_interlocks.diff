+"""Round 4 (DERIVE): the fast derivation paths of agents/trajectory/tools/vass_zones.py give the v1 results -- KD-tree
+block / sample conflicts equal the dense float32 passes, the event-driven nominal check agrees with the fixed-step
+one -- and the exact pair re-ordering repairs a precedence 2-cycle that no flip of a single zone can."""
+from __future__ import annotations
+
+import copy
+import math
+
+import numpy as np
+import pytest
+
+from agents.cell import vass_protocol as P
+from agents.trajectory.tools import btcpp
+from agents.trajectory.tools import vass_zones as V
+
+from tests.test_vass_interlocks import ToyGeometry, _toy_tree
