+def test_profile_to_the_end_and_sampling_keeps_the_path():
+    path = LegPath([{"positions": [0, 0, 0, 0, 0, 0], "time_s": 0.0},
+                    {"positions": [1, 0, 0, 0, 0, 0], "time_s": 0.5},
+                    {"positions": [1, 1, 0, 0, 0, 0], "time_s": 1.0}])
+    pr = Profile.plan(0.0, 0.0, None, 1.0, 0.5, 1.0)
+    pts = pr.sample(path)
+    assert pts[-1]["positions"][:2] == pytest.approx([1, 1])
+    assert pts[-1]["velocities"] == [0.0] * 6 and pts[-1]["accelerations"] == [0.0] * 6
+    # every sampled point lies on the leg's smooth command (the plain goal's curve), which passes every knot
+    for p in pts:
+        assert np.allclose(p["positions"], path.cmd_q(p["tau"]), atol=1e-5)          # tau rounded to 1e-6
+    assert np.allclose(path.cmd_q(0.5)[:2], [1, 0], atol=1e-12)
+    # uniform grid (no near-duplicate points for the JTC to ring on)
+    dts = np.diff([p["time_s"] for p in pts])
+    assert dts.max() - dts.min() < 2e-6
+    tau, err = path.project([1, 0.5, 0, 0, 0, 0], 0, 1)
+    assert tau == pytest.approx(0.75) and err < 1e-9
+
