+def _run(table, tree, rt, plc_cfg=None, sess_kw=None, timeout_s=30.0):
+    from agents.cell.bt_executor import BehaviourTreeExecutor
+    bus = LocalBus()
+    plc = PlcEmulator(LocalTransport(bus), "toy", table, cfg=plc_cfg or PlcConfig()).start()
+    sess = VassSession("toy", table, LocalTransport(bus), **(sess_kw or {})).start()
+    ex = BehaviourTreeExecutor(rt, HealthyMonitor(), _exec_cfg(), vass=sess)
+    timer = threading.Timer(timeout_s, ex.abort, args=("test watchdog",))
+    timer.daemon = True
+    timer.start()
+    t0 = time.monotonic()
+    try:
