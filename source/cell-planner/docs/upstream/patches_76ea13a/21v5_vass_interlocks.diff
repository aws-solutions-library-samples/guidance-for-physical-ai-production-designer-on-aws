+                if ok:
+                    zones[:] = [zm if z is za else z for z in zones if z is not zb]
+                    trial = replay(0.02)
+                    zones[:] = saved
+                else:
+                    trial = None
+            if trial is None:
+                continue
+            score = (bool(trial["completed"]), float(trial.get("progress") or 0.0))
+            if best is None or score > best[0]:
+                best = (score, kind, ref, first)
+        if best is None:
+            break
+        _, kind, ref, first = best
+        if kind == "flip" and ref == last_flip and best[0] <= (bool(nominal["completed"]),
+                                                               float(nominal.get("progress") or 0.0)):
+            break            # round 4: it would only undo the last flip (same state, same replay): no repair left
+        last_flip = ref if kind == "flip" else None
+        if kind == "flip":
+            flip(by_id[ref])
+            flips.append(ref)
+        else:
+            za, zb = by_id[ref[0]], by_id[ref[1]]
+            zm = merged(za, zb, first)
+            zones[:] = [zm if z is za else z for z in zones if z is not zb]
+            by_id.pop(zb.id, None)
+            by_id[zm.id] = zm
+            merges.append([za.id, zb.id, first])
+        nominal = replay()
+    table["zones"] = [z.to_json() for z in zones]
+    table["stats"].update(zones=len(zones), tight=sum(1 for z in zones if z.tight), nominal=nominal,
+                          order_flips=flips, order_merges=merges, pair_repairs=pair_fix, stop_repairs=stop_fix,
+                          derive_s=round(time.time() - t_start, 2))
+    if not nominal["completed"]:
+        raise DeriveError("nominal_deadlock", f"the interlocked nominal run does not complete: {nominal.get('stuck')}")
+    table["sha256"] = P.table_sha256(table)
+    return P.ZoneTable(table)
+
+
+def relaxed_leg_start_stop(o: "P.Occupancy", guard_s: float, taus=None) -> Optional[dict]:
+    """Round 4 (INTEGRATE): for an occupancy whose stop sits at its leg START (t = 0) although its entry lies later in
+    the same leg, the latest admissible stop ``guard_s`` before the entry ({k, t}; snapped down to a program sample of
+    that leg when ``taus`` is given), or None (not a leg-start stop, no room before the entry)."""
+    if o is None or o.enter is None or o.stop is None:
+        return None
+    k = int(o.enter["k"])
+    if int(o.stop.get("k", -1)) != k or float(o.stop.get("t", 0.0)) > 1e-9:
+        return None
+    t = float(o.enter["t"]) - float(guard_s)
+    if taus is not None and len(taus):
+        tt = np.asarray(taus, float)
+        tt = tt[tt <= t + 1e-12]
+        if not len(tt):
+            return None
+        t = float(tt[-1])
+    if t <= 1e-6:
+        return None
+    return {"k": k, "t": round(t, 6)}
+
+
+# ── round 4: exact pair re-ordering (a monotone path through the pair's coordination space) ───────────────────
+# For arms a, b a zone is the open rectangle (stop_a, rel_a) x (stop_b, rel_b) of program positions (stop point to
+# release position = exit + guard, clipped to the leg end); an execution is a monotone path from (HOME, HOME) to
+# the program ends that enters no rectangle, and a zone's order is the side the path takes (below-right: a first).
+# A tree dependency "leg k_b of b starts after leg k_a of a is done" forbids {x < end of leg k_a, y > start of leg
+# k_b}. Dynamic programming over the compressed grid, cost = the nominal-time desynchronisation of the two arms
+# (the path hugs the nominal schedule); a pair without any path has no live order at all (finer zones needed).
+def leg_dependencies(tree: dict) -> list:
+    """[(rid_from, k_from, rid_to, k_to)]: leg k_to of rid_to cannot start before leg k_from of rid_from is done
+    (Sequence order across arms, Parallel joins, WaitForRobot on op completions)."""
+    bb = tree.get("blackboard") or {}
+    nxt: dict = {}
+    op_leg: dict = {}
+    out = []
+
+    def collect(n):
+        k = node_kind(n)
+        if k in ("ExecuteTrajectory", "MoveHome"):
+            rid = str(bt_port(n, "robot_ns"))
+            kk = nxt.get(rid, 0)
+            nxt[rid] = kk + 1
+            if k == "ExecuteTrajectory":
+                op_leg[(rid, str(bt_port(n, "operation_id")))] = kk
+        for c in bt_children(n):
+            collect(c)
+    collect(tree.get("root") or {})
+    nxt.clear()
+
+    def walk(n, pre):
+        k = node_kind(n)
+        kids = bt_children(n)
+        if k in ("Sequence", "SequenceWithMemory", "Delay"):
+            for c in kids:
+                pre = walk(c, pre)
+            return pre
+        if k == "Parallel":
+            res = dict(pre)
+            for c in kids:
+                r = walk(c, dict(pre))
+                for q, v in r.items():
+                    res[q] = max(res.get(q, -1), v)
+            return res
+        if k == "WaitForRobot":
+            pre = dict(pre)
+            for d in bt_resolve(bt_port(n, "depends_on_ops"), bb) or []:
+                key = (str(d.get("robot")), str(d.get("operation_id")))
+                if key in op_leg:
+                    pre[key[0]] = max(pre.get(key[0], -1), op_leg[key])
+            return pre
+        if k in ("ExecuteTrajectory", "MoveHome"):
+            rid = str(bt_port(n, "robot_ns"))
+            kk = nxt.get(rid, 0)
+            nxt[rid] = kk + 1
+            for q, v in pre.items():
+                if q != rid and v >= 0:
+                    out.append((q, v, rid, kk))
+            pre = dict(pre)
+            pre[rid] = max(pre.get(rid, -1), kk)
+            return pre
+        return pre
+    walk(tree.get("root") or {}, {})
+    return out
+
+
+def _pair_path_orders(zones, a, b, legs, table, deps, guard, max_cells: int = 36_000_000):
+    """{zone id: first arm} from a minimal-desynchronisation monotone path of arms a, b, or None."""
+    INFX = 1e18
+
+    def sc(p):
+        k, t = P.pos_key(p)
+        return float(k) * 1e5 + float(t)
+
+    def rel(o, rid):
+        if o.exit is None:
+            return INFX
+        ex = P.pos_key(o.exit)
+        end_t = table.leg_end_t(rid, ex[0]) or ex[1]
+        return ex[0] * 1e5 + min(ex[1] + guard, max(end_t, ex[1]))
+    rects = []
+    for z in zones:
+        oa = next(o for o in z.occ if o.rid == a)
+        ob = next(o for o in z.occ if o.rid == b)
+        x0 = -INFX if oa.enter is None or oa.stop is None else sc(oa.stop)
+        y0 = -INFX if ob.enter is None or ob.stop is None else sc(ob.stop)
+        rects.append((x0, rel(oa, a), y0, rel(ob, b), z))
+    gates = []
+    for (q, kq, r, kr) in deps:
+        if (q, r) in ((a, b), (b, a)):
+            te = table.leg_end_t(q, kq) or 0.0
+            if (q, r) == (a, b):
+                gates.append((-INFX, kq * 1e5 + te, kr * 1e5, INFX))
+            else:
+                gates.append((kr * 1e5, INFX, -INFX, kq * 1e5 + te))
+    allr = [(x0, x1, y0, y1) for x0, x1, y0, y1, _ in rects] + gates
+    xs = np.unique([v for x0, x1, _, _ in allr for v in (x0, x1) if abs(v) < INFX])
+    ys = np.unique([v for _, _, y0, y1 in allr for v in (y0, y1) if abs(v) < INFX])
+    nx, ny = len(xs) + 1, len(ys) + 1
+    if nx * ny > max_cells:
+        return None
+    blk = np.zeros((nx + 1, ny + 1), np.int32)
+
+    def span(v, lo, hi):
+        i0 = 0 if lo <= -INFX else int(np.searchsorted(v, lo, "left")) + 1
+        i1 = len(v) if hi >= INFX else int(np.searchsorted(v, hi, "right")) - 1
+        return i0, i1
+    for x0, x1, y0, y1 in allr:
+        i0, i1 = span(xs, x0, x1)
+        j0, j1 = span(ys, y0, y1)
+        if i0 > i1 or j0 > j1:
+            continue
+        blk[i0, j0] += 1
+        blk[i1 + 1, j0] -= 1
+        blk[i0, j1 + 1] -= 1
+        blk[i1 + 1, j1 + 1] += 1
+    blocked = np.cumsum(np.cumsum(blk, 0, dtype=np.int32), 1, dtype=np.int32)[:nx, :ny] > 0
+    del blk
+
+    def times(rid, v):
+        L = legs.get(rid) or []
+        k = np.floor(v / 1e5 + 1e-9).astype(int)
+        t = v - k * 1e5
+        if not L:
+            return np.zeros(len(v))
+        t0 = np.array([float(l["t0"]) for l in L])
+        vs = np.array([float(l["vscale"]) for l in L])
+        kk = np.clip(k, 0, len(L) - 1)
+        return np.where(k < 0, 0.0, t0[kk] + t / vs[kk])
+    tx, ty = times(a, xs), times(b, ys)
+    cx = np.concatenate([[tx[0] if len(tx) else 0.0], 0.5 * (tx[:-1] + tx[1:]), [tx[-1] if len(tx) else 0.0]])
+    cy = np.concatenate([[ty[0] if len(ty) else 0.0], 0.5 * (ty[:-1] + ty[1:]), [ty[-1] if len(ty) else 0.0]])
+    hx = int(np.searchsorted(xs, -1e5, "right"))
+    hy = int(np.searchsorted(ys, -1e5, "right"))
+    if blocked[hx, hy]:
+        return None
+    big = 1e12
+    dp = np.full((nx, ny), np.inf, dtype=np.float32)
+    for i in range(hx, nx):
+        c = np.abs(cx[i] - cy)
+        c[blocked[i]] = np.inf
+        if i == hx:
+            Bv = np.full(ny, np.inf)
+            Bv[hy] = 0.0
+        else:
+            prev = dp[i - 1].astype(np.float64)
+            Bv = prev.copy()
+            Bv[1:] = np.minimum(Bv[1:], prev[:-1])
+        Bv[:hy] = np.inf
+        free = np.isfinite(c)
+        run = np.cumsum(~free)
+        P_ = np.cumsum(np.where(free, c, 0.0))
+        Pm1 = np.concatenate([[0.0], P_[:-1]])
+        M = np.where(free & np.isfinite(Bv), Bv - Pm1, np.inf)
+        cm = np.minimum.accumulate(M - run * big) + run * big
+        row = np.where(free, P_ + cm, np.inf)
+        row[~np.isfinite(row) | (row > 1e11)] = np.inf
+        dp[i] = row
+    if not np.isfinite(dp[nx - 1, ny - 1]):
+        return None
+    lo_ = np.full(nx, ny, int)
+    hi_ = np.full(nx, -1, int)
+    i, j = nx - 1, ny - 1
+    while True:
+        lo_[i] = min(lo_[i], j)
+        hi_[i] = max(hi_[i], j)
+        if i == hx and j == hy:
+            break
+        cand = []
+        if j > hy:
+            cand.append((dp[i, j - 1], i, j - 1))
+        if i > hx:
+            cand.append((dp[i - 1, j], i - 1, j))
+            if j > hy:
+                cand.append((dp[i - 1, j - 1], i - 1, j - 1))
+        v, i, j = min(cand)
+        if not np.isfinite(v):
+            return None
+    out = {}
+    for x0, x1, y0, y1, z in rects:
+        i0, i1 = span(xs, x0, x1)
+        j0, j1 = span(ys, y0, y1)
+        cols = [c_ for c_ in range(max(i0, hx), min(i1, nx - 1) + 1) if hi_[c_] >= 0]
+        if i0 > i1 or j0 > j1 or not cols:
+            out[z.id] = z.first
+            continue
+        out[z.id] = a if min(lo_[c_] for c_ in cols) < j0 else b
+    return out
+
+
+def plan_sha256(tree: dict) -> str:
+    bb = tree.get("blackboard") or {}
+    trajs = {k: v for k, v in bb.items() if isinstance(v, list) and v and isinstance(v[0], dict) and "positions" in v[0]}
+
+    def strip(n):
+        if not isinstance(n, dict):
+            return n
+        ports = {k: v for k, v in (n.get("ports") or {}).items() if k != "interlocks"}
+        return {"type": n.get("type"), "ports": ports, "children": [strip(c) for c in n.get("children") or []]}
+    return P.canonical_sha256({"root": strip(tree.get("root")), "trajectories": trajs})
+
+
+# ── 5. nominal check: the interlocked plan at nominal speed must complete ────
+def nominal_check(tree: dict, table: P.ZoneTable, legs: dict, cfg: ZoneConfig, dt: float = 0.01,
+                  kappa: Optional[dict] = None, lag: Optional[dict] = None, horizon_factor: float = 4.0,
+                  model: Optional[str] = None) -> dict:
+    """The interlocked nominal run with plan-order grants (requests always ahead) and instant stops: event-driven
+    (``model`` "event", the default of ``cfg.nominal_model``: the same semantics as the fixed-step run, exact event
+    times, O(events)) or the fixed-step run (``"ticks"``, ``dt``)."""
+    model = model or getattr(cfg, "nominal_model", "event")
+    if any(l_.get("sync") for k_, ls_ in legs.items() if not str(k_).startswith("_") for l_ in ls_):
+        model = "event"                      # the lockstep barrier is modelled by the event-driven run only
+    if model == "event":
+        return _nominal_check_event(tree, table, legs, cfg, kappa=kappa, lag=lag)
+    return nominal_check_ticks(tree, table, legs, cfg, dt=dt, kappa=kappa, lag=lag, horizon_factor=horizon_factor)
+
+
+def _nominal_check_event(tree: dict, table: P.ZoneTable, legs: dict, cfg: ZoneConfig,
+                         kappa: Optional[dict] = None, lag: Optional[dict] = None) -> dict:
+    """Event-driven ``nominal_check``: robots move at their nominal rate between events (a stop limit, an entry or a
+    release position, a leg end, a clock wait), stop instantly at the first ungranted stop point and resume the moment
+    it is granted. Plan-order grant: the zone's previous occupancy is released and no robot is inside. The run
+    completes or stalls (nothing can move and no clock wait is left)."""
+    import bisect
+    import heapq
+    bb = tree.get("blackboard") or {}
+    margin = _margin_s(tree.get("cell_id") or "")
+    kappa = kappa or {}
+    lag = lag or {}
+    guard = cfg.guard_s
+    robots = list(table.robots)
+    zone_of = {z.id: z for z in table.zones}
+    served = {z.id: 0 for z in table.zones}
+    holder = {z.id: (z.occ[0].rid if z.occ and z.occ[0].enter is None else None) for z in table.zones}
+    st_o = {}                                   # occ id -> "AHEAD" | "INSIDE" | "RELEASED"
+    oid = {}
+    by_stop, by_ev = {}, {}
+    for rid in robots:
+        occs = table.occupancies(rid)
+        for o in occs:
+            i_ = P.occ_id(o.zone, o.rid)
+            oid[id(o)] = i_
+            st_o[i_] = "INSIDE" if o.enter is None else "AHEAD"
+        by_stop[rid] = sorted([o for o in occs if o.stop is not None], key=lambda o: P.pos_key(o.stop))
+        evs = []
+        for o in occs:
+            if o.enter is not None:
+                evs.append(P.pos_key(o.enter))
+            if o.exit is not None:
+                ex = P.pos_key(o.exit)
+                end_t = table.leg_end_t(rid, ex[0]) or ex[1]
+                evs.append((ex[0], min(ex[1] + guard, max(end_t, ex[1]))))
+        by_ev[rid] = (sorted(set(evs)), occs)
+    rel_need = {}
+    for rid in robots:
+        for o in by_ev[rid][1]:
+            if o.exit is not None:
+                ex = P.pos_key(o.exit)
+                end_t = table.leg_end_t(rid, ex[0]) or ex[1]
+                rel_need[oid[id(o)]] = (ex[0], min(ex[1] + guard, max(end_t, ex[1])))
+    pos = {rid: (-1, 0.0) for rid in robots}
+    waits = {rid: 0.0 for rid in robots}
+    wait_since = {rid: None for rid in robots}
+    # lockstep (legs with "sync", program_legs(lockstep=True)): a group's legs leave together once every member is
+    # at the barrier, and each member first takes, at rest, every zone whose stop is in that leg (the executor's
+    # _vass_take_leg)
+    bar_members: dict = {}
+    for rid in robots:
+        for l_ in legs.get(rid, []):
+            if l_.get("sync"):
+                bar_members.setdefault(l_["sync"], set()).add(rid)
+    bar_arrived: dict = {}
+    done_ops: set = set()
+    leg_ix = {rid: 0 for rid in robots}
+    moving = {}                                  # rid -> [k, rate, t_end]
+    order_seen = []
+    timers = []
+    now = [0.0]
+
+    def granted(o) -> bool:
+        i_ = oid[id(o)]
+        if st_o[i_] != "AHEAD":
+            return True
+        z = zone_of[o.zone]
+        return holder[z.id] is None and served[z.id] < len(z.occ) and z.occ[served[z.id]].rid == o.rid and \
+            z.occ[served[z.id]].order == o.order
+
+    def limit(rid):
+        for o in by_stop[rid]:
+            if st_o[oid[id(o)]] != "AHEAD":
+                continue
+            if not granted(o):
+                return P.pos_key(o.stop), o
+        return None, None
+
+    def cross(rid):
+        """Entries / releases up to the robot's position."""
+        p_ = pos[rid]
+        for o in by_ev[rid][1]:
+            i_ = oid[id(o)]
+            if st_o[i_] == "AHEAD" and o.enter is not None and p_ >= P.pos_key(o.enter) and granted(o):
+                st_o[i_] = "INSIDE"
+                holder[o.zone] = rid
+                order_seen.append(i_)
+            if st_o[i_] == "INSIDE" and o.exit is not None and p_ >= rel_need[i_]:
+                st_o[i_] = "RELEASED"
+                holder[o.zone] = None
+                served[o.zone] += 1
+
+    def wait_until(t1):
+        heapq.heappush(timers, t1)
+        while now[0] < t1 - 1e-12:
+            yield
+
+    def run(n):
+        k = node_kind(n)
+        kids = bt_children(n)
+        if k in ("Sequence", "SequenceWithMemory"):
+            for c in kids:
+                yield from run(c)
+            return
+        if k == "Parallel":
+            gens = [run(c) for c in kids]
+            alive = []
+            for g in gens:
+                try:
+                    next(g)
+                    alive.append(g)
+                except StopIteration:
+                    pass
+            while alive:
+                yield
+                nxt = []
+                for g in alive:
+                    try:
+                        next(g)
+                        nxt.append(g)
+                    except StopIteration:
+                        pass
+                alive = nxt
+            return
+        if k == "Delay":
+            yield from wait_until(now[0] + float(bt_port(n, "delay_msec", 0) or 0) / 1000.0)
+            for c in kids:
+                yield from run(c)
+            return
+        if k == "WaitForRobot":
+            need = {(str(d.get("robot")), str(d.get("operation_id")))
+                    for d in bt_resolve(bt_port(n, "depends_on_ops"), bb) or []}
+            while not need <= done_ops:
+                yield
+            return
+        if k in ("CheckSafety", "RequestInterlock", "ReleaseInterlock"):
+            return
+        if k in ("ExecuteTrajectory", "MoveHome"):
+            rid = str(bt_port(n, "robot_ns"))
+            li = leg_ix[rid]
+            leg_ix[rid] += 1
+            leg = legs[rid][li]
+            kap = float(kappa.get(rid, 1.0))
+            d = float(lag.get(rid, 0.0)) + (float(bt_port(n, "start_delay_s", 0.0) or 0.0)
+                                            if k == "ExecuteTrajectory" else 0.0)
+            if d > 0:
+                yield from wait_until(now[0] + d)
+            grp = leg.get("sync")
+            if grp:
+                mine = [o for o in by_stop[rid] if int(o.stop["k"]) == int(leg["k"])]
+                while any(st_o[oid[id(o)]] == "AHEAD" and not granted(o) for o in mine):
+                    yield
+                bar_arrived.setdefault(grp, set()).add(rid)
+                while not bar_members.get(grp, set()) <= bar_arrived[grp]:
+                    yield
+            target = (leg["k"], 0.0)
+            lim, _ = limit(rid)
+            if lim is not None and target > lim:
+                target = max(pos[rid], lim)
+            pos[rid] = max(pos[rid], target)
+            cross(rid)
+            if leg["traj"]:
+                t_end = float(leg["traj"][-1]["time_s"])
+                moving[rid] = [leg["k"], leg["vscale"] * kap, t_end]
+                while rid in moving:
+                    yield
+            hold = (float(bt_port(n, "hold_duration_s", 0.5)) / kap) if k == "ExecuteTrajectory" else 0.0
+            yield from wait_until(now[0] + hold + margin)
+            if k == "ExecuteTrajectory":
+                done_ops.add((rid, str(bt_port(n, "operation_id"))))
+            return
+        return
+
+    root = run(tree.get("root") or {})
+    completed = False
+    n_ev = 0
+    while n_ev < 2_000_000:
+        n_ev += 1
+        for _ in range(64):
+            before = (len(done_ops), sum(leg_ix.values()), len(moving), sum(served.values()),
+                      sum(len(v_) for v_ in bar_arrived.values()))
+            try:
+                next(root)
+            except StopIteration:
+                completed = True
+                break
+            if (len(done_ops), sum(leg_ix.values()), len(moving), sum(served.values()),
+                    sum(len(v_) for v_ in bar_arrived.values())) == before:
+                break
+        if completed:
+            break
+        plan_m = {}
+        dt_m = float("inf")
+        for rid, (k, rate, t_end) in moving.items():
+            lim, o = limit(rid)
+            tgt = t_end
+            if lim is not None and lim[0] == k:
+                tgt = min(tgt, lim[1])
+            cur = pos[rid][1] if pos[rid][0] == k else 0.0
+            nxt = tgt
+            evl = by_ev[rid][0]
+            j_ = bisect.bisect_right(evl, (k, cur + 1e-9))
+            if j_ < len(evl) and evl[j_][0] == k and evl[j_][1] < nxt:
+                nxt = evl[j_][1]
+            if nxt <= cur + 1e-12:
+                plan_m[rid] = (float("inf"), cur, o)
+            else:
+                plan_m[rid] = ((nxt - cur) / rate, nxt, o)
+                dt_m = min(dt_m, plan_m[rid][0])
+        while timers and timers[0] <= now[0] + 1e-12:
+            heapq.heappop(timers)
+        dt_t = (timers[0] - now[0]) if timers else float("inf")
+        step = min(dt_m, dt_t)
+        if step == float("inf"):
+            break                                # stalled: nothing moves, no clock wait left
+        for rid in list(moving):
+            k, rate, t_end = moving[rid]
+            dtr, tau1, o = plan_m[rid]
+            cur = pos[rid][1] if pos[rid][0] == k else 0.0
+            if dtr == float("inf"):
+                if wait_since[rid] is None:
+                    wait_since[rid] = now[0]
+                continue
+            if wait_since[rid] is not None:
+                waits[rid] += now[0] - wait_since[rid]
+                wait_since[rid] = None
+            new = tau1 if dtr <= step + 1e-12 else min(tau1, cur + rate * step)
+            pos[rid] = (k, new)
+            cross(rid)
+            if new >= t_end - 1e-12:
+                pos[rid] = (k, t_end)
+                cross(rid)
+                del moving[rid]
+        now[0] += step
+    end_nom = float(table.stats.get("nominal_end_s") or 0.0) or 60.0
+    for rid in robots:
+        if wait_since[rid] is not None:
+            waits[rid] += now[0] - wait_since[rid]
+    stuck = None
+    if not completed:
+        stuck = {}
+        for rid in robots:
+            w = None
+            for o in table.occupancies(rid):
+                i_ = oid.get(id(o)) or P.occ_id(o.zone, o.rid)
+                if st_o.get(i_) == "AHEAD" and not granted(o):
+                    w = i_
+                    break
+            stuck[rid] = {"pos": pos[rid], "waiting_for": w}
+    progress = float(sum(max(p_[0], 0) * 1000.0 + p_[1] for p_ in pos.values()))
+    return {"completed": bool(completed), "end_s": round(now[0], 3), "nominal_end_s": round(end_nom, 3),
+            "progress": round(progress, 4), "overhead_s": round(now[0] - end_nom, 3),
+            "waits_s": {r: round(w, 3) for r, w in waits.items()}, "entries": len(order_seen), "stuck": stuck,
+            "dt": None, "model": "event", "events": n_ev}
+
+
+def nominal_check_ticks(tree: dict, table: P.ZoneTable, legs: dict, cfg: ZoneConfig, dt: float = 0.01,
+                        kappa: Optional[dict] = None, lag: Optional[dict] = None,
+                        horizon_factor: float = 4.0) -> dict:
+    """Tick the tree in virtual time with plan-order grants (requests always ahead) and instant stops.
+
+    ``kappa`` (rid -> path-rate factor) and ``lag`` (rid -> extra start delay of every leg) let the same
+    simulation probe the order under slowdowns / lags. Returns completed, end time, waits per robot."""
+    bb = tree.get("blackboard") or {}
+    margin = _margin_s(tree.get("cell_id") or "")
+    kappa = kappa or {}
+    lag = lag or {}
+    occs = {rid: table.occupancies(rid) for rid in table.robots}
+    for z in table.zones:                 # ids are a property (string formatting): cache them
+        for o in z.occ:
+            o.__dict__["_id"] = o.id
+    zst = {z.id: {"served": 0, "holder": z.occ[0].rid if z.occ[0].enter is None else None} for z in table.zones}
+    inside = {o.id: o.enter is None for z in table.zones for o in z.occ}
+    released = {o.id: False for z in table.zones for o in z.occ}
+    zone_of = {z.id: z for z in table.zones}
+    pos = {rid: (-1, 0.0) for rid in table.robots}
+    waits = {rid: 0.0 for rid in table.robots}
+    done_ops: set = set()
+    leg_ix = {rid: 0 for rid in table.robots}
+    guard = cfg.guard_s
+    order_seen = []
+
+    def _all_blocked():
+        """Every arm is stopped at an interlock limit, or done, or waits at a gate (no clock wait left)."""
+        for st_ in nodes.values():
+            ph = st_.get("phase")
+            if ph in ("delay", "settle") and not st_.get("done"):
+                return False
+        return True
+
+    def granted(o):
+        z = zone_of[o.zone]
+        st = zst[z.id]
+        if inside[o.id]:
+            return True
+        return st["holder"] is None and st["served"] < len(z.occ) and z.occ[st["served"]].id == o.id
+
+    def limit(rid):
+        best = None
+        for o in occs[rid]:
+            if inside[o.id] or released[o.id] or o.stop is None:
+                continue
+            if granted(o):
+                continue
+            s = P.pos_key(o.stop)
+            if best is None or s < best:
+                best = s
+        return best
+
+    def advance(rid, k, tau_new):
+        """Move rid to (k, tau_new); process entries / releases; return the position actually reached."""
+        lim = limit(rid)
+        target = (k, tau_new)
+        if lim is not None and target > lim:
+            target = max(pos[rid], lim)
+        pos[rid] = target
+        for o in occs[rid]:
+            if not inside[o.id] and not released[o.id] and o.enter is not None and target > P.pos_key(o.enter):
+                z = zone_of[o.zone]
+                if not granted(o):
+                    continue
+                inside[o.id] = True
+                zst[z.id]["holder"] = rid
+                order_seen.append(o.id)
+            if inside[o.id] and not released[o.id] and o.exit is not None:
+                ex = P.pos_key(o.exit)
+                end_t = table.leg_end_t(rid, ex[0]) or ex[1]
+                need = (ex[0], min(ex[1] + guard, max(end_t, ex[1])))
+                if target >= need:
+                    released[o.id] = True
+                    inside[o.id] = False
+                    z = zone_of[o.zone]
+                    zst[z.id]["holder"] = None
+                    zst[z.id]["served"] += 1
+        return target
+
+    class Leaf:
+        def __init__(self, n):
+            self.n = n
+            self.state = "init"
+            self.t_wait = 0.0
+
+    nodes = {}
+
+    def tick(n, t):
+        """Returns True when the node has completed."""
+        key = id(n)
+        k = node_kind(n)
+        st = nodes.setdefault(key, {"i": 0, "t0": None, "done": False})
+        if st["done"]:
+            return True
+        if k in ("Sequence", "SequenceWithMemory"):
+            ch = bt_children(n)
+            while st["i"] < len(ch):
+                if not tick(ch[st["i"]], t):
+                    return False
+                st["i"] += 1
+            st["done"] = True
+            return True
+        if k == "Parallel":
+            res = [tick(c, t) for c in bt_children(n)]
+            st["done"] = all(res)
+            return st["done"]
+        if k == "Delay":
+            if st["t0"] is None:
+                st["t0"] = t
+            if t - st["t0"] < float(bt_port(n, "delay_msec", 0) or 0) / 1000.0:
+                return False
+            ok = all(tick(c, t) for c in bt_children(n))
+            st["done"] = ok
+            return ok
+        if k == "WaitForRobot":
+            need = {(str(d.get("robot")), str(d.get("operation_id")))
+                    for d in bt_resolve(bt_port(n, "depends_on_ops"), bb) or []}
+            st["done"] = need <= done_ops
+            return st["done"]
+        if k in ("CheckSafety", "RequestInterlock", "ReleaseInterlock"):
+            st["done"] = True
+            return True
+        if k in ("ExecuteTrajectory", "MoveHome"):
+            rid = str(bt_port(n, "robot_ns"))
+            if "leg" not in st:
+                st["leg"] = leg_ix[rid]
+                leg_ix[rid] += 1
+                st["phase"] = "delay"
+                st["t0"] = t
+                st["tau"] = 0.0
+            leg = legs[rid][st["leg"]]
+            kap = float(kappa.get(rid, 1.0))
+            if st["phase"] == "delay":
+                d = float(lag.get(rid, 0.0)) + (float(bt_port(n, "start_delay_s", 0.0) or 0.0)
+                                                if k == "ExecuteTrajectory" else 0.0)
+                if t - st["t0"] < d:
+                    return False
+                st["phase"] = "move"
+                pos[rid] = max(pos[rid], (leg["k"], 0.0))
+                advance(rid, leg["k"], 0.0)
+            if st["phase"] == "move":
+                if not leg["traj"]:
+                    st["phase"], st["t1"] = "settle", t
+                else:
+                    t_end = float(leg["traj"][-1]["time_s"])
+                    want = min(t_end, st["tau"] + leg["vscale"] * kap * dt)
+                    got = advance(rid, leg["k"], want)
+                    if got[0] == leg["k"]:
+                        if got[1] < want - 1e-12:
+                            waits[rid] += dt
+                        st["tau"] = got[1]
+                    if st["tau"] >= t_end - 1e-12:
+                        st["phase"], st["t1"] = "settle", t
+            if st["phase"] == "settle":
+                hold = (float(bt_port(n, "hold_duration_s", 0.5)) / kap) if k == "ExecuteTrajectory" else 0.0
+                if t - st["t1"] < hold + margin:
+                    return False
+                if k == "ExecuteTrajectory":
+                    done_ops.add((rid, str(bt_port(n, "operation_id"))))
+                st["done"] = True
+                return True
+            return False
+        st["done"] = True
+        return True
+
+    end_nom = float(table.stats.get("nominal_end_s") or 0.0) or 60.0
+    horizon = end_nom * horizon_factor + 60.0
+    t = 0.0
+    root = tree.get("root") or {}
+    completed = False
+    last_pos, last_change = dict(pos), 0.0
+    while t < horizon:
+        if tick(root, t):
+            completed = True
+            break
+        t += dt
+        if pos != last_pos:
+            last_pos, last_change = dict(pos), t
+        elif t - last_change > 30.0 and _all_blocked():
+            break                  # nothing moved for 30 s of plan time and no clock wait is left: stuck
+    stuck = None
+    if not completed:
+        stuck = {rid: {"pos": pos[rid], "waiting_for": next((o.id for o in occs[rid] if not inside[o.id]
+                                                             and not released[o.id] and not granted(o)), None)}
+                 for rid in table.robots}
+    progress = float(sum(max(p_[0], 0) * 1000.0 + p_[1] for p_ in pos.values()))
+    return {"completed": bool(completed), "end_s": round(t, 3), "nominal_end_s": round(end_nom, 3),
+            "progress": round(progress, 4),
+            "overhead_s": round(t - end_nom, 3), "waits_s": {r: round(w, 3) for r, w in waits.items()},
+            "entries": len(order_seen), "stuck": stuck, "dt": dt}
+
+
+# ── 4. annotation of the tree ─────────────────────────────────────────────────
+def annotate_tree(tree: dict, table: P.ZoneTable, *, required: bool = False) -> dict:
+    """A copy of ``tree`` with ``interlocks`` ports on the legs that overlap zones and metadata.vass."""
+    import copy
+    out = copy.deepcopy(tree)
+    legs = program_legs(out)
+    legs.pop("_end", None)
+    legs.pop("_problems", None)
+    bb = out.setdefault("blackboard", {})
+    per_leg: dict = {}
+    for z in table.zones:
+        for o in z.occ:
+            k_en = o.enter["k"] if o.enter else 0
+            k_ex = o.exit["k"] if o.exit else len(legs.get(o.rid, [])) - 1
+            for k in range(k_en, k_ex + 1):
+                e = {"zone": z.id, "occ": o.id, "order": o.order, "k": k,
+                     "enter_t": o.enter["t"] if (o.enter and o.enter["k"] == k) else None,
+                     "exit_t": o.exit["t"] if (o.exit and o.exit["k"] == k) else None}
+                if e["enter_t"] is not None and o.stop:
+                    e["stop_t"] = o.stop["t"] if o.stop["k"] == k else 0.0
+                    e["t_stop_s"] = o.t_stop_s
+                per_leg.setdefault((o.rid, k), []).append(e)
+    for rid, ls in legs.items():
+        for leg in ls:
+            ents = per_leg.get((rid, leg["k"]))
+            if not ents:
+                continue
+            tr = leg["traj"]
+            ts = [float(p["time_s"]) for p in tr]
+            for e in ents:
+                for nm in ("enter", "exit"):
+                    tv = e.get(f"{nm}_t")
+                    if tv is not None and ts:
+                        import bisect
+                        e[f"{nm}_i"] = max(0, bisect.bisect_right(ts, tv) - 1)
+            ents.sort(key=lambda e: (-1 if e["enter_t"] is None else e["enter_t"], e["zone"]))
+            node = leg["node"]
+            key = f"ilk_{rid}_{leg['op']}_{leg['k']}"
+            bb[key] = ents
+            node.setdefault("ports", {})["interlocks"] = "{" + key + "}"
+    md = out.setdefault("metadata", {})
+    md["vass"] = {"format": P.TABLE_FORMAT, "proto": P.PROTO, "arbitration": table.arbitration,
+                  "table_sha256": table.sha256, "table": table.to_json(), "required": bool(required)}
+    if "xml" in out:
+        out["xml"] = to_xml(out)
+    return out
+
+
+def check_bt(tree: dict, table: Optional[P.ZoneTable] = None) -> list:
+    """Consistency of an annotated tree with its table; [] = consistent."""
+    probs = []
+    table = table or P.table_of_tree(tree)
+    if table is None:
+        return ["no zone table"]
+    legs = program_legs(tree)
+    legs.pop("_end", None)
+    legs.pop("_problems", None)
+    bb = tree.get("blackboard") or {}
+    known = {o.id for z in table.zones for o in z.occ}
+    for rid, ls in legs.items():
+        tl = table.legs.get(rid) or []
+        if len(tl) != len(ls):
+            probs.append(f"{rid}: {len(ls)} legs in the tree, {len(tl)} in the table")
+        for leg in ls:
+            ents = P.parse_interlocks(bt_resolve(bt_port(leg["node"], "interlocks"), bb))
+            for e in ents:
+                if e.get("occ") not in known:
+                    probs.append(f"{rid} leg {leg['k']}: unknown occupancy {e.get('occ')}")
+                if int(e.get("k", leg["k"])) != leg["k"]:
+                    probs.append(f"{rid} leg {leg['k']}: entry k={e.get('k')}")
+    if table.raw.get("plan_sha256") and table.raw["plan_sha256"] != plan_sha256(tree):
+        probs.append("plan_sha256 differs: the trajectories changed after the derivation")
+    return probs
+
+
+def lockstep_setting(vass_cfg: Optional[dict] = None, env=None) -> bool:
+    """Whether zones are derived for the executor's LOCKSTEP=1: robots.yaml ``vass: {lockstep: ...}`` if set (the
+    trajectory agent does not see the cell controller's environment), else ``$LOCKSTEP`` as the executor reads it.
+    The executor refuses a table derived for the other setting when the tree has compound legs."""
+    v = (vass_cfg or {}).get("lockstep")
+    if v is not None:
+        return str(v).strip().lower() in ("1", "true", "yes", "on")
+    from agents.cell.bt_executor import lockstep_from_env
+    return lockstep_from_env(env)
+
+
+def maybe_annotate(cell_id: str, tree: dict) -> "tuple[dict, Optional[dict]]":
+    """Assembler hook: annotate when the cell (robots.yaml ``vass: {annotate: true}``) or
+    ``UMARELL_VASS_ANNOTATE=1`` asks for it. Default off: the tree is returned unchanged."""
+    import os
+    cfg = {}
+    try:
+        from agents.trajectory.tools.robot_kinematics import _load_robots_config
+        cfg = dict((_load_robots_config(cell_id) or {}).get("vass") or {})
+    except Exception:  # noqa: BLE001
+        cfg = {}
+    on = os.environ.get("UMARELL_VASS_ANNOTATE", "").strip().lower() in ("1", "true", "yes") or \
+        bool(cfg.get("annotate"))
+    if not on:
+        return tree, None
+    try:
+        zc = ZoneConfig(arbitration=str(cfg.get("arbitration", "plan")), lockstep=lockstep_setting(cfg))
+        table = derive_zones(tree, zc)
+        out = annotate_tree(tree, table, required=bool(cfg.get("required")))
+        return out, {"zones": len(table.zones), "table": table.short, "stats": table.stats}
+    except DeriveError as exc:
+        return tree, {"error": exc.code, "detail": str(exc)}
+    except Exception as exc:  # noqa: BLE001 - never break an assembly on the optional annotation
+        return tree, {"error": "derive_failed", "detail": repr(exc)}
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--plan", required=True)
+    ap.add_argument("--out", default=None, help="annotated plan (default: <plan>_vass.json)")
+    ap.add_argument("--zones", default=None, help="also write the table here")
+    ap.add_argument("--arbitration", default="plan", choices=["plan"])
+    ap.add_argument("--path-step", type=float, default=ZoneConfig.path_step_m)
+    ap.add_argument("--required", action="store_true")
+    ap.add_argument("--lockstep", choices=["auto", "on", "off"], default="auto",
+                    help="derive for the executor's LOCKSTEP=1 (no zones inside an ompl-compound step; its zones "
+                         "taken at the leg start). auto = $LOCKSTEP")
+    a = ap.parse_args(argv)
+    with open(a.plan) as f:
+        doc = json.load(f)
+    tree = doc.get("behaviour_tree") or doc
+    lockstep = lockstep_setting() if a.lockstep == "auto" else (a.lockstep == "on")
+    try:
+        table = derive_zones(tree, ZoneConfig(arbitration=a.arbitration, path_step_m=a.path_step,
+                                              lockstep=lockstep), verbose=True)
+    except DeriveError as exc:
+        print(f"[vass_zones] derivation error {exc}", file=sys.stderr)
+        return 2
+    ann = annotate_tree(tree, table, required=a.required)
+    if "behaviour_tree" in doc:
+        doc = dict(doc, behaviour_tree=ann)
+    else:
+        doc = ann
+    out = a.out or a.plan.replace(".json", "_vass.json")
+    with open(out, "w") as f:
+        json.dump(doc, f, default=P._json_default)
+    if a.zones:
+        table.save(a.zones)
+    print(json.dumps({"out": out, "zones": len(table.zones), "table": table.short, "stats": table.stats},
+                     default=str)[:2000])
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
