+# A coordinate within this fraction of a voxel of a grid plane counts as ON the
+# plane (covers float32 mesh exports up to ~8 m from the origin).
+_BOUNDARY_TOL = 1e-5
+
+
+def _side(x: float, c: float, tol: float) -> int:
+    """-1 / +1 when ``x`` lies below / above the plane coordinate ``c``, else 0."""
+    return -1 if x < c - tol else (1 if x > c + tol else 0)
+
+
+def _cell_index(x: float, voxel: float, side) -> int:
+    """Voxel index of coordinate ``x`` along one axis: ``floor(x / voxel)``,
+    except for a coordinate ON a grid plane (within ``_BOUNDARY_TOL`` voxel).
+    There the plane is shared by two cells and ``floor`` picks the one above,
+    so every face of a mesh lying on a +x / +y / +z grid plane grew a voxel
+    lid outside the mesh. ``side(c)`` names the cell on the mesh's inner side
+    of the plane at ``c``: -1 the cell below, +1 above, 0 floor (as before).
+    """
+    q = x / voxel
+    r = round(q)
+    if abs(q - r) > _BOUNDARY_TOL:
+        return math.floor(q)
+    s = side(r * voxel)
+    return r - 1 if s < 0 else r
+
+
+def _mesh_frame(triangles: list) -> tuple:
+    """(mins, maxs, orient) of one mesh: its bounds and its winding sign (+1
+    when its signed volume is >= 0, i.e. counter-clockwise seen from outside;
+    -1 for a mesh wound the other way round, e.g. mirrored by a negative scale)."""
+    mins = [math.inf, math.inf, math.inf]
+    maxs = [-math.inf, -math.inf, -math.inf]
+    vol = 0.0
+    for (a, b, c) in triangles:
+        for v in (a, b, c):
+            for d in range(3):
+                if v[d] < mins[d]: mins[d] = v[d]
+                if v[d] > maxs[d]: maxs[d] = v[d]
+        vol += (a[0] * (b[1] * c[2] - b[2] * c[1])
+                - a[1] * (b[0] * c[2] - b[2] * c[0])
+                + a[2] * (b[0] * c[1] - b[1] * c[0]))
+    return tuple(mins), tuple(maxs), (1.0 if vol >= 0.0 else -1.0)
+
+
