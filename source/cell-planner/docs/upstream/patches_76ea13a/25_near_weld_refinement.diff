+# ─── near-weld refinement ─────────────────────────────────────────────────────
+#
+# A 5 cm shell over-approximates a surface by up to a voxel, which is where the
+# tool works: at a weld. With --refine-points the shell within --refine-radius
+# of each point is rebuilt at --refine-voxel-size from the same meshes, and those
+# fine boxes are marked is_workpiece (the surface being welded; the planner's
+# tool-contact rule then lets only the weld contact touch it).
+
+def load_refine_points(path: Path) -> list:
+    """World points from a JSON file: ``[[x, y, z], ...]`` or ``{"points": [...]}``."""
+    try:
+        data = json.loads(Path(path).read_text())
+    except (OSError, ValueError) as exc:
+        _fatal(f"--refine-points {path}: cannot read JSON: {exc}")
+    if isinstance(data, dict):
+        data = data.get("points")
+    if not isinstance(data, list):
+        _fatal(f"--refine-points {path}: expected a list of [x, y, z] points or "
+               f'{{"points": [...]}}')
+    out = []
+    for n, p in enumerate(data):
+        try:
+            q = tuple(float(v) for v in p)
+        except (TypeError, ValueError):
+            q = ()
+        if len(q) != 3 or not all(math.isfinite(v) for v in q):
+            _fatal(f"--refine-points {path}: point {n} is not [x, y, z]: {p!r}")
+        out.append(q)
+    return out
+
+
+def _dist2_box(lo: tuple, hi: tuple, p: tuple) -> float:
+    """Squared distance from point ``p`` to the box [lo, hi] (0 inside)."""
+    d2 = 0.0
+    for d in range(3):
+        if p[d] < lo[d]:
+            d2 += (lo[d] - p[d]) ** 2
+        elif p[d] > hi[d]:
+            d2 += (p[d] - hi[d]) ** 2
+    return d2
+
+
+def near_points_filter(points: list, radius: float):
+    """``keep(triangle)``: the triangle's bounds come within ``radius`` of a point."""
+    r2 = radius * radius
+    lo_all = tuple(min(p[d] for p in points) - radius for d in range(3))
+    hi_all = tuple(max(p[d] for p in points) + radius for d in range(3))
+
+    def keep(tri) -> bool:
+        lo = tuple(min(v[d] for v in tri) for d in range(3))
+        hi = tuple(max(v[d] for v in tri) for d in range(3))
+        if any(hi[d] < lo_all[d] or lo[d] > hi_all[d] for d in range(3)):
+            return False
+        return any(_dist2_box(lo, hi, p) <= r2 for p in points)
+    return keep
+
+
+def refine_voxels(coarse: set, voxel: float, fine: set, fine_voxel: float,
+                  points: list, radius: float) -> tuple:
+    """(coarse cells kept, fine cells kept): a coarse cell whose centre lies
+    within ``radius - voxel`` of a point is dropped (so the whole cell is within
+    ``radius``: every surface it covered is covered by the fine shell); a fine
+    cell is kept when it comes within ``radius`` of a point."""
+    drop = radius - voxel
+    d2 = drop * drop
+    kept = set()
+    for c in coarse:
+        cen = tuple((c[d] + 0.5) * voxel for d in range(3))
+        if drop > 0 and any(sum((cen[d] - p[d]) ** 2 for d in range(3)) <= d2 for p in points):
+            continue
+        kept.add(c)
+    r2 = radius * radius
+    fine_kept = set()
+    for c in fine:
+        lo = tuple(c[d] * fine_voxel for d in range(3))
+        hi = tuple((c[d] + 1) * fine_voxel for d in range(3))
+        if any(_dist2_box(lo, hi, p) <= r2 for p in points):
+            fine_kept.add(c)
+    return kept, fine_kept
+
+
