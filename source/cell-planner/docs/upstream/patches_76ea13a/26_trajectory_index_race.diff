+@contextmanager
+def _index_locked(cell_id: str):
+    """Hold the index for one read-modify-write.
+
+    The agent stores several robots' trajectories in parallel, and an unlocked
+    load+save loses all but one of them. Locally a flock on a sidecar file in
+    the recordings dir also covers other processes planning the same cell; in
+    orchestrator mode the recordings are the owner's (and the mount read-only),
+    so only this process's writers are serialised.
+    """
+    with _index_lock:
+        if cell_store.is_remote():
+            yield
+            return
+        path = cell_store.local_path(cell_id, cell_store.KIND_RECORDINGS,
+                                     _INDEX_LOCK_NAME, for_write=True)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with open(path, "a") as handle:
+            fcntl.flock(handle, fcntl.LOCK_EX)
+            yield
+
+
 def _make_key(operation_type: str, robot_ns: str, target: list[float]) -> str:
     tx, ty, tz = round(target[0], 2), round(target[1], 2), round(target[2], 2)
     return f"{operation_type}|{robot_ns}|{tx}|{ty}|{tz}"
