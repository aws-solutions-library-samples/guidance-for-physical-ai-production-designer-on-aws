+"""The tool / electrode never enters a workpiece or fixture box, except at the weld.
+
+umarell's static rules let the welding tool into material in three ways:
+
+* ``is_workpiece`` boxes were skipped outright by the shared static check
+  (``robot_kinematics._compile_static``), so by ``_config_is_free``,
+  ``_config_collision_info``, ``check_self_collision`` and the runtime monitor
+  (arm AND tool): a departure that drags the electrode through the sheet it just
+  welded, or a transit that dips it into the part, passes every gate. Since
+  dc60669 umarell checks the arm against them (``is_workpiece`` is read as
+  ``tool_contact``), but still exempts the tool's spheres from a ``tool_contact``
+  box anywhere on it, and never checks the tool's hulls;
+* the tool is modelled by spheres (the converter's ``static_spheres``, 0.05 m).
+  They cover the tool's surface but are wider than the electrode, so at a weld
+  they always overlap the part, which is why the workpiece had to be exempt at
+  all;
+* every static check runs at the planner's samples only, while the executor
+  interpolates straight joint-space chords between them.
+
+The rule this module owns (issue 22). For every collision hull rigidly attached
+to the tool mount (electrode, stick, plate, flange: the URDF ``<collision>``
+meshes on the mount link) and every box or sphere obstacle of the cell, workpiece
+or fixture, the signed distance must not be negative (more than ``PEN_TOL_M``),
+with ONE exemption, the weld contact itself: a penetration of a box is allowed
+when the TCP is within the contact radius ``r_c`` (``collision.
+tool_contact_radius`` in robots.yaml, default ``TOOL_CONTACT_RADIUS_M`` = 5 mm) of
+a weld point of the cell's task programs that touches that box, and the whole
+intersection hull ∩ box lies inside the ball of radius ``r_c`` around that weld
+point. The same rule is applied to the tool spheres of the sphere model (surface
+outside every box; a sphere that reaches into a weld's contact ball is exempt
+against that weld's box, because the sphere is wider than the electrode, so the
+hull decides there).
+
+Along a leg the check is dense (:func:`trajectory_tool_contact_info`): the
+straight joint-space segment between consecutive samples, which is what the
+executor runs, is walked so that no point of the tool moves more than
+``TOOL_CONTACT_STEP_M`` (1 mm) between two checks where the tool is close to an
+obstacle; where the measured clearance ``d`` is larger the step grows to ``d`` of
+tool-point travel (the obstacles do not move, so the tool cannot reach one in
+less), which can never skip over a contact.
+
+Hooked in like ``self_collision`` (:func:`checker_for_model`): every arm model is
+loaded by ``utils.arm_model.load``, which registers it, so the shared validity
+predicate (``robot_kinematics._config_is_free``: every backend's search, the
+Cartesian descent / lift-off of ``leg_builder``, the IK branch choice), the
+diagnosis and the emitted-trajectory backstop (``_trajectory_collision_info``, so
+``leg_static_breach``, ``validate_trajectory_set`` and the home legs) and
+``leg_verdict`` (the dispatch facade, the assembler's audit of every leg incl. the
+home legs) all apply the same rule without each caller passing the cell.
+
+Availability follows ``leg_verdict``'s policy: a cell without meshes (or an install
+without hpp-fcl/coal) reports ``available() == False`` with the reason; the hull
+check then has no opinion and every report says it did not run
+(``tool_contact_checked`` / ``tool_hulls_checked``). The sphere part of the rule
+still runs in ``robot_kinematics``. A check that ran and broke refuses.
+"""
+from __future__ import annotations
+
+import hashlib
+import os
+import threading
+from collections import OrderedDict
+from typing import Optional
+
+import numpy as np
+
+from utils import arm_model
+
+#: Radius of the weld contact ball (m): the only place the tool may touch material.
+TOOL_CONTACT_RADIUS_M = 0.005
+#: Largest travel of any tool point between two checks near an obstacle (m).
+TOOL_CONTACT_STEP_M = 0.001
+#: Numerical tolerance of the GJK/EPA signed distance (m): a contact, not a dip.
+PEN_TOL_M = 1e-4
+#: Hull/obstacle pairs whose bounding-sphere bound is below this get the exact distance.
+_EXACT_BELOW_M = 0.05
+
+_LOCK = threading.RLock()
+_CACHE: dict = {}
+_TRAJ_CACHE: "OrderedDict" = OrderedDict()
+_TRAJ_CACHE_MAX = 1024
+_ANNOT_CACHE: dict = {}
+_WELD_CACHE: dict = {}
+_WELD_CACHE_TTL_S = 5.0
+_COMP_CACHE: dict = {}
+# The validity checker asks per STATE: the tool model and the contact radius are
+# looked up again (cell files' mtimes, robots.yaml) at most this often.
+_FRESH_S = 1.0
+_FAST: dict = {}
+
+
+class ToolHullsUnavailable(FileNotFoundError):
+    """The tool's hulls cannot be checked here (an availability failure, not a verdict)."""
+
+
+def _fcl():
+    try:
+        import hppfcl as fcl          # pinocchio 2.x
+    except ImportError:               # pragma: no cover - pinocchio >= 3
+        import coal as fcl
+    return fcl
+
+
+# ─── the cell's weld points and the contact radius ─────────────────────────────
+
+def contact_radius(cell_id: str) -> float:
+    """``collision.tool_contact_radius`` from robots.yaml (the converter writes it;
+    a cell converted before reads :data:`TOOL_CONTACT_RADIUS_M`)."""
+    import time
+    from utils import cell_layout
+    key = ("r_c", str(cell_layout.cells_root()), str(cell_id))
+    hit = _FAST.get(key)
+    now = time.monotonic()
+    if hit is not None and now - hit[0] < _FRESH_S:
+        return hit[1]
+    try:
+        from agents.trajectory.tools.robot_kinematics import _load_collision_config
+        v = _load_collision_config(cell_id).get("tool_contact_radius")
+        r = TOOL_CONTACT_RADIUS_M if v is None else max(0.0, float(v))
+    except Exception:  # noqa: BLE001 — the default is the strict value
+        return TOOL_CONTACT_RADIUS_M
+    _FAST[key] = (now, r)
+    return r
+
+
+def _unit(v) -> Optional[list]:
+    try:
+        a = np.asarray([float(x) for x in list(v)[:3]], float)
+    except (TypeError, ValueError):
+        return None
+    n = float(np.linalg.norm(a))
+    return None if n < 1e-12 else (a / n).tolist()
+
+
+def _contact(item) -> tuple:
+    """``(point, approach unit vector or None)`` from ``[x,y,z]`` or ``(p, a)``."""
+    if isinstance(item, dict):
+        return [float(v) for v in item["p"][:3]], _unit(item.get("a")) if item.get("a") else None
+    if len(item) == 2 and hasattr(item[0], "__len__"):
+        return [float(v) for v in list(item[0])[:3]], (_unit(item[1]) if item[1] is not None else None)
+    return [float(v) for v in list(item)[:3]], None
+
+
+def weld_points(cell_id: str) -> list:
+    """``(position, approach unit vector)`` of every ``weld`` operation of every task
+    program of the cell.
+
+    These are the only places the tool may touch material. A target that is not
+    a program weld gets no contact exemption unless a caller names it
+    (fail-closed).
+    """
+    import time
+    from utils import cell_layout, cell_store
+    remote = cell_store.is_remote()
+    key = (str(cell_layout.cells_root()), str(cell_id))
+    if remote:                              # over MCP: a few seconds of cache, as cell_store
+        with _LOCK:
+            hit = _WELD_CACHE.get(key)
+        if hit is not None and time.monotonic() - hit[0] < _WELD_CACHE_TTL_S:
+            return list(hit[1])
+    pts: list = []
+    try:
+        entries = cell_store.list_entries(cell_id, cell_store.KIND_TASKS, suffix=".json")
+    except Exception:  # noqa: BLE001 — no programs readable: no exemption
+        return pts
+    sig = None
+    if not remote:                          # local: re-read only when a program changed
+        sig = tuple((e.get("name"), e.get("mtime_s"), e.get("size_bytes"))
+                    for e in entries if isinstance(e, dict))
+        with _LOCK:
+            hit = _WELD_CACHE.get(key)
+        if hit is not None and hit[0] == sig:
+            return list(hit[1])
+    for e in entries:
+        name = e.get("name") if isinstance(e, dict) else None
+        if not name:
+            continue
+        try:
+            task = cell_store.read_json(cell_id, cell_store.KIND_TASKS, name) or {}
+        except Exception:  # noqa: BLE001
+            continue
+        for op in task.get("operations") or []:
+            if not isinstance(op, dict) or str(op.get("type", "weld")) != "weld":
+                continue
+            p = op.get("position")
+            if isinstance(p, dict):
+                p = [p.get("x"), p.get("y"), p.get("z")]
+            try:
+                pts.append(([float(v) for v in list(p)[:3]],
+                            _unit(op.get("approach_vector") or [0.0, 0.0, -1.0])))
+            except (TypeError, ValueError):
+                continue
+    with _LOCK:
+        _WELD_CACHE[key] = ((time.monotonic() if remote else sig), list(pts))
+    return pts
+
+
+def _point_box_distance(p, center, half) -> float:
+    d = np.abs(np.asarray(p, float) - np.asarray(center, float)) - np.asarray(half, float)
+    return float(np.linalg.norm(np.maximum(d, 0.0)))
+
+
+def _point_obstacle_distance(p, obs) -> Optional[float]:
+    t = obs.get("type", "")
+    if t == "box":
+        return _point_box_distance(p, obs["center"], obs["half_extents"])
+    if t == "sphere":
+        return max(0.0, float(np.linalg.norm(np.asarray(p, float) - np.asarray(obs["center"], float)))
+                   - float(obs["radius"]))
+    return None
+
+
+def annotate_obstacles(cell_id: str, obstacles: list, points: Optional[list] = None,
+                       radius: Optional[float] = None) -> list:
+    """``obstacles`` with ``weld_contacts`` (points), ``weld_axes`` (their approach
+    vectors) and ``contact_radius`` on every box or sphere that a program weld
+    touches (lies within the contact radius of).
+
+    Obstacles no weld touches are returned as the SAME dict objects, and an
+    annotated one is the same copy on every call with the same inputs, so callers
+    that cache by identity (vectorised kernels) keep their caches.
+    """
+    pts = weld_points(cell_id) if points is None else [_contact(p) for p in points]
+    r_c = contact_radius(cell_id) if radius is None else float(radius)
+    if not pts or not obstacles:
+        return list(obstacles)
+    sig = (round(r_c, 9), tuple((tuple(round(v, 9) for v in p),
+                                 None if a is None else tuple(round(v, 9) for v in a))
+                                for p, a in pts))
+    P = np.asarray([p for p, _a in pts], float).reshape(-1, 3)
+    out = list(obstacles)
+    todo = []
+    for k, obs in enumerate(out):
+        if not isinstance(obs, dict) or obs.get("type") not in ("box", "sphere"):
+            continue
+        key = (str(cell_id), id(obs), sig)
+        with _LOCK:
+            hit = _ANNOT_CACHE.get(key)
+        if hit is not None and hit[0] is obs:
+            out[k] = hit[1]
+        else:
+            todo.append((k, key))
+    # One vectorised pass: distance of every weld point to every unseen obstacle.
+    rows = []
+    for k, _key in todo:
+        o = out[k]
+        try:
+            if o["type"] == "box":
+                rows.append((np.asarray(o["center"], float), np.asarray(o["half_extents"], float), None))
+            else:
+                rows.append((np.asarray(o["center"], float), None, float(o["radius"])))
+        except (KeyError, TypeError, ValueError):
+            rows.append(None)
+    for (k, key), row in zip(todo, rows):
+        obs = out[k]
+        near_idx = []
+        if row is not None:
+            c, h, r = row
+            if h is not None:
+                d = np.linalg.norm(np.maximum(np.abs(P - c) - h, 0.0), axis=1)
+            else:
+                d = np.maximum(np.linalg.norm(P - c, axis=1) - r, 0.0)
+            near_idx = [int(i) for i in np.nonzero(d <= r_c + 1e-12)[0]]
+        new = (dict(obs, weld_contacts=[pts[i][0] for i in near_idx],
+                    weld_axes=[pts[i][1] for i in near_idx], contact_radius=r_c)
+               if near_idx else obs)
+        with _LOCK:
+            if len(_ANNOT_CACHE) > 65536:
+                _ANNOT_CACHE.clear()
+            _ANNOT_CACHE[key] = (obs, new)
+        out[k] = new
+    return out
+
+
+def with_contacts(cell_id: str, obstacles: list, points: list) -> list:
+    """``obstacles`` with ``points`` (``[x,y,z]`` or ``(p, approach)``) added to the
+    weld contacts of the boxes / spheres they touch, keeping the contacts already
+    there (the cell's program welds). The planner's Cartesian strokes name the weld
+    they descend onto / lift off from this way."""
+    if not points or not obstacles:
+        return list(obstacles or [])
+    extra = annotate_obstacles(cell_id, obstacles, points=points)
+    out = []
+    for old, new in zip(obstacles, extra):
+        if new is old:
+            out.append(old)
+            continue
+        pts = list(old.get("weld_contacts") or [])
+        axes = list(old.get("weld_axes") or [None] * len(pts))
+        for p, a in zip(new.get("weld_contacts") or [], new.get("weld_axes") or []):
+            if not any(np.allclose(p, q) for q in pts):
+                pts.append(p)
+                axes.append(a)
+        out.append(dict(old, weld_contacts=pts, weld_axes=axes,
+                        contact_radius=new.get("contact_radius")))
+    return out
+
+
+def in_contact_corridor(tcp, p, a, r_c: float) -> bool:
+    """Whether the TCP is ON the weld at ``p`` or on its approach axis above it.
+
+    With an approach vector ``a`` (the direction the TCP travels INTO the weld):
+    at most ``r_c`` off the axis through ``p`` and not more than ``r_c`` past ``p``.
+    Without one: within ``r_c`` of ``p``.
+    """
+    rel = np.asarray(tcp, float) - np.asarray(p, float)
+    if a is None:
+        return float(np.linalg.norm(rel)) <= r_c
+    av = np.asarray(a, float)
+    h = -float(rel @ av)                       # height above the weld, along -a
+    lat = float(np.linalg.norm(rel + h * av))
+    return lat <= r_c and h >= -r_c
+
+
+def sphere_contact_exempt(s_pos, radius: float, obs: dict, tcp) -> bool:
+    """A tool sphere at a weld on ``obs``: exempt from the sphere rule against ``obs``.
+
+    The sphere model is wider than the electrode (the tip sphere's 0.05 m against
+    a cap of 0.002-0.022 m), so on the weld and on the last centimetres of the
+    on-axis descent / lift-off it always overlaps the part. It is exempt when the
+    TCP is in that weld's contact corridor (:func:`in_contact_corridor`) and the
+    sphere reaches the contact ball; the electrode's own hulls decide there
+    (:func:`config_tool_contact_info`). Anywhere else, e.g. a departure that
+    slides off the axis, the sphere rule applies.
+    """
+    pts = obs.get("weld_contacts")
+    if not pts or tcp is None:
+        return False
+    axes = obs.get("weld_axes") or [None] * len(pts)
+    r_c = float(obs.get("contact_radius", TOOL_CONTACT_RADIUS_M))
+    s = np.asarray(s_pos, float)
+    for p, a in zip(pts, axes):
+        if (float(np.linalg.norm(s - np.asarray(p, float))) <= float(radius) + r_c
+                and in_contact_corridor(tcp, p, a, r_c)):
+            return True
+    return False
+
+
+# ─── geometry: the hulls bolted to the tool mount ──────────────────────────────
+
+def _parent_joint(obj) -> int:
+    """The joint a frame / geometry object hangs on (pinocchio 2.x names it
+    ``parent``, 3.x ``parentJoint``)."""
+    v = getattr(obj, "parentJoint", None)
+    if v is None:
+        v = getattr(obj, "parent", 0)
+    return int(v)
+
+
+def _hull_planes(conv, V: np.ndarray):
+    """Outward facet planes ``(n, e)`` with ``n·x <= e`` inside, from the hull's triangles."""
+    tris = []
+    try:
+        for i in range(int(conv.num_polygons)):
+            t = conv.polygons(i)
+            tris.append((int(t[0]), int(t[1]), int(t[2])))
+    except Exception:  # noqa: BLE001 — older/newer bindings
+        tris = []
+    if not tris:
+        try:
+            from scipy.spatial import ConvexHull
+            h = ConvexHull(V)
+            return np.asarray(h.equations[:, :3], float), -np.asarray(h.equations[:, 3], float)
+        except Exception:  # noqa: BLE001
+            return None
+    T = np.asarray(tris, int)
+    a, b, c = V[T[:, 0]], V[T[:, 1]], V[T[:, 2]]
+    n = np.cross(b - a, c - a)
+    nn = np.linalg.norm(n, axis=1)
+    keep = nn > 1e-12
+    n, a = n[keep] / nn[keep, None], a[keep]
+    centroid = V.mean(axis=0)
+    flip = np.einsum("ij,ij->i", n, centroid - a) > 0      # normal must point away
+    n[flip] *= -1.0
+    e = np.einsum("ij,ij->i", n, a)
+    return n, e
+
+
+def _build(cell_id: str, robot_ns: str) -> dict:
+    import pinocchio as pin
+    from agents.trajectory.tools.robot_kinematics import (
+        _load_robot_config, _load_clearance_policy, _tool_offsets,
+    )
+    urdf = arm_model.urdf_path(cell_id, robot_ns)
+    if urdf is None:
+        raise FileNotFoundError(f"no URDF for {robot_ns} in {cell_id}")
+    model = pin.buildModelFromUrdf(str(urdf))
+    cfg = _load_robot_config(cell_id, robot_ns)
+    tool_cfg = cfg.get("tool_collision") or {}
+    token = str(tool_cfg.get("mount_link") or "")
+    # The frame the tool spheres are placed on: the first match, as
+    # robot_kinematics._tool_spheres places them.
+    mount = next((i for i, f in enumerate(model.frames) if token and token in f.name), -1)
+    if mount < 0:
+        tip = str(cfg.get("tip_link") or "")
+        mount = model.getFrameId(tip) if tip and model.existFrame(tip) else -1
+    j_mount = _parent_joint(model.frames[mount]) if mount >= 0 else model.njoints - 1
+    if j_mount <= 0:
+        raise ValueError(f"{robot_ns}: tool mount '{token}' is not on a moving joint")
+    # The hulls need the meshes and hpp-fcl/coal; without them the sphere part of
+    # the rule still runs and ``available()`` says why the hulls were not checked.
+    hulls, hull_reason = [], ""
+    try:
+        geom = pin.buildGeomFromUrdf(model, str(urdf), pin.GeometryType.COLLISION,
+                                     package_dirs=[str(urdf.parent)])
+        for go in geom.geometryObjects:
+            if _parent_joint(go) != j_mount:
+                continue
+            go.geometry.buildConvexRepresentation(False)
+            conv = go.geometry.convex
+            V = np.asarray(conv.points(), float).reshape(-1, 3)
+            planes = _hull_planes(conv, V)
+            lo, hi = V.min(axis=0), V.max(axis=0)
+            P = go.placement                # geometry frame in the mount joint's frame
+            Vj = V @ np.asarray(P.rotation).T + np.asarray(P.translation)
+            hulls.append({"name": go.name,
+                          "mesh": os.path.basename(str(getattr(go, "meshPath", ""))),
+                          "conv": conv, "V": V, "planes": planes, "placement": P,
+                          "centre": 0.5 * (lo + hi),
+                          "radius": 0.5 * float(np.linalg.norm(hi - lo)),
+                          "reach": float(np.max(np.linalg.norm(Vj, axis=1)))})
+        if not hulls:
+            hull_reason = f"{urdf.name}: no collision geometry on the tool mount joint"
+        else:
+            _fcl()
+    except Exception as e:  # noqa: BLE001 — reported by available()
+        hulls, hull_reason = [], f"{type(e).__name__}: {e}"
+    # Tool points of the sphere model, in the mount joint's frame: the TCP first
+    # (the torch frame sphere, at tool_link_radius), then the spheres the static
+    # check places on the tool — the converter's ``static_spheres`` at
+    # ``static_radius_m``, else the arm-vs-arm ``spheres`` / axis / plates at
+    # tool_link_radius (robot_kinematics._static_bodies / _tool_offsets). Offsets
+    # are in the mount LINK frame.
+    amodel, _ad, ee = arm_model.load(cell_id, robot_ns)
+    try:
+        policy = _load_clearance_policy(cell_id)
+        frame_r = float(policy.get("tool", policy.get("normal", 0.12)))
+    except Exception:  # noqa: BLE001
+        frame_r = 0.12
+    pts, radii = [], []
+    if _parent_joint(amodel.frames[ee]) == j_mount:
+        pts.append(np.asarray(amodel.frames[ee].placement.translation, float))
+    else:                                   # TCP not on the tool joint: use the flange
+        pts.append(np.zeros(3))
+    radii.append(frame_r)
+    Mm = model.frames[mount].placement if mount >= 0 else pin.SE3.Identity()
+    static = tool_cfg.get("static_spheres") or []
+    if static:
+        offs = [np.asarray([float(v) for v in c][:3], float) for c in static]
+        off_r = float(tool_cfg.get("static_radius_m") or frame_r)
+    else:
+        offs, off_r = _tool_offsets(cfg.get("tool_collision")), frame_r
+    for off in offs:
+        pts.append(np.asarray(Mm.rotation, float) @ np.asarray(off, float)
+                   + np.asarray(Mm.translation, float))
+        radii.append(off_r)
+    pts = np.asarray(pts, float).reshape(-1, 3)
+    radii = np.asarray(radii, float)
+    tool_r = float(np.max(radii))
+    # One sphere around everything checked here (hull vertices, tool spheres incl.
+    # their radius), in the mount joint's frame: the coarse first filter per pose.
+    allp = np.vstack([pts] + [h["V"] @ np.asarray(h["placement"].rotation).T
+                              + np.asarray(h["placement"].translation) for h in hulls])
+    lo, hi = allp.min(axis=0), allp.max(axis=0)
+    t_centre = 0.5 * (lo + hi)
+    t_radius = float(np.max(np.linalg.norm(allp - t_centre, axis=1))) + tool_r
+    # Lever arms: joint j moving by |dq| moves no tool point by more than |dq| * R_j
+    # (triangle inequality along the chain). None when a joint on the chain is not
+    # a 1-dof joint: then legs are checked at their samples only.
+    reach = max([h["reach"] for h in hulls] + [float(np.max(np.linalg.norm(pts, axis=1)))])
+    levers = np.zeros(model.nq)
+    chain, j = 0.0, j_mount
+    while j > 0 and levers is not None:
+        jm = model.joints[j]
+        if jm.nq != 1:
+            levers = None
+            break
+        kind = jm.shortname().replace("JointModel", "")
+        levers[jm.idx_q] = 1.0 if "P" in kind else chain + reach
+        chain += float(np.linalg.norm(model.jointPlacements[j].translation))
+        j = int(model.parents[j])
+    yaw = float(cfg.get("base_orientation_yaw", 0.0))
+    cy, sy = np.cos(yaw), np.sin(yaw)
+    world = pin.SE3(np.array([[cy, -sy, 0.0], [sy, cy, 0.0], [0.0, 0.0, 1.0]]),
+                    np.asarray(cfg["base_position"], float))
+    return {"model": model, "data": model.createData(), "j_mount": j_mount,
+            "hulls": hulls, "hull_reason": hull_reason, "points": pts, "radii": radii,
+            "tool_r": tool_r,
+            "levers": levers, "world": world, "t_centre": t_centre, "t_radius": t_radius}
+
+
+def _entry(cell_id: str, robot_ns: str) -> dict:
+    """The arm's tool model, cached per (cells root, cell, robot, cell files'
+    mtimes): a re-converted cell or an edited URDF is checked afresh. A model that
+    cannot be built is reported and NOT cached, so a transient failure (a cell
+    store that was unreachable) does not switch the check off for the process."""
+    import time
+    from utils import cell_layout
+    from agents.trajectory.tools.leg_verdict import cell_stamp
+    name = (str(cell_layout.cells_root()), str(cell_id), str(robot_ns))
+    now = time.monotonic()
+    fast = _FAST.get(name)
+    if fast is not None and now - fast[0] < _FRESH_S:
+        return fast[1]
+    key = (*name, cell_stamp(cell_id, robot_ns) or ())
+    with _LOCK:
+        hit = _CACHE.get(key)
+        if hit is None:
+            try:
+                hit = {"ok": True, **_build(cell_id, robot_ns)}
+                for stale in [k for k in _CACHE if k[:3] == name and k != key]:
+                    del _CACHE[stale]
+                _CACHE[key] = hit
+            except Exception as e:  # noqa: BLE001 — reported, never silent
+                hit = {"ok": False, "reason": f"{type(e).__name__}: {e}"}
+                return hit
+        _FAST[name] = (now, hit)
+        return hit
+
+
+def available(cell_id: str, robot_ns: str) -> tuple:
+    """``(True, "")`` when the tool's collision HULLS can be checked, else
+    ``(False, reason)``. The sphere part of the rule runs whenever the arm model
+    loads."""
+    e = _entry(cell_id, robot_ns)
+    if not e["ok"]:
+        return False, e["reason"]
+    return (True, "") if e["hulls"] else (False, e["hull_reason"] or "no tool hulls")
+
+
+# ─── obstacles, compiled ───────────────────────────────────────────────────────
+
+def _compile(cell_id: str, obstacles: Optional[list], contact_points: Optional[list]) -> dict:
+    """The obstacles as arrays. Cached per obstacle LIST (identity, as
+    ``robot_kinematics._compile_static``) and contact points, so a planner's
+    validity checker that passes the same list per state compiles it once."""
+    if obstacles is None:
+        from agents.trajectory.tools.robot_kinematics import load_static_obstacles
+        obstacles = load_static_obstacles(cell_id)
+        return _compile_now(cell_id, obstacles, contact_points)
+    sig = None
+    try:
+        sig = repr([_contact(c) for c in (contact_points or [])])
+    except Exception:  # noqa: BLE001 — unhashable / odd input: compile afresh
+        return _compile_now(cell_id, obstacles, contact_points)
+    key = (str(cell_id), id(obstacles), len(obstacles), sig, contact_radius(cell_id))
+    with _LOCK:
+        hit = _COMP_CACHE.get(key)
+    if hit is not None and hit[0] is obstacles:
+        return hit[1]
+    comp = _compile_now(cell_id, obstacles, contact_points)
+    with _LOCK:
+        _COMP_CACHE[key] = (obstacles, comp)
+        while len(_COMP_CACHE) > 64:
+            _COMP_CACHE.pop(next(iter(_COMP_CACHE)))
+    return comp
+
+
+def _compile_now(cell_id: str, obstacles: list, contact_points: Optional[list]) -> dict:
+    r_c = contact_radius(cell_id)
+    extra = [_contact(c) for c in (contact_points or [])]
+    boxes, spheres = [], []
+    for obs in obstacles or []:
+        t = obs.get("type", "") if isinstance(obs, dict) else ""
+        if t not in ("box", "sphere"):
+            continue
+        rc = float(obs.get("contact_radius", r_c))
+        pts = list(obs.get("weld_contacts") or [])
+        axes = list(obs.get("weld_axes") or [None] * len(pts))
+        cps = [(np.asarray(p, float), None if a is None else np.asarray(a, float))
+               for p, a in zip(pts, axes)]
+        for p, a in extra:
+            d = _point_obstacle_distance(p, obs)
+            if d is not None and d <= rc + 1e-12 and not any(np.allclose(p, q) for q, _ in cps):
+                cps.append((np.asarray(p, float), None if a is None else np.asarray(a, float)))
+        rec = {"id": str(obs.get("id", "obstacle")), "workpiece": bool(obs.get("is_workpiece", False) or obs.get("tool_contact", False)),
+               "contacts": cps, "r_c": rc,
+               "obs": {"weld_contacts": [q for q, _ in cps],
+                       "weld_axes": [a for _, a in cps], "contact_radius": rc}}
+        if t == "box":
+            rec.update(c=np.asarray(obs["center"], float), h=np.asarray(obs["half_extents"], float))
+            boxes.append(rec)
+        else:
+            rec.update(c=np.asarray(obs["center"], float), r=float(obs["radius"]))
+            spheres.append(rec)
+    return {
+        "boxes": boxes, "spheres": spheres,
+        "BC": np.asarray([b["c"] for b in boxes], float).reshape(-1, 3),
+        "BH": np.asarray([b["h"] for b in boxes], float).reshape(-1, 3),
+        "BR": np.linalg.norm(np.asarray([b["h"] for b in boxes], float).reshape(-1, 3), axis=1),
+        "SC": np.asarray([s["c"] for s in spheres], float).reshape(-1, 3),
+        "SR": np.asarray([s["r"] for s in spheres], float),
+        "fcl": {},
+    }
+
+
+def _points_box_dist(P: np.ndarray, BC: np.ndarray, BH: np.ndarray) -> np.ndarray:
+    """``(len(P), len(BC))`` unsigned point-box distances (0 inside)."""
+    d = np.abs(P[:, None, :] - BC[None, :, :]) - BH[None, :, :]
+    return np.linalg.norm(np.maximum(d, 0.0), axis=-1)
+
+
+def _box_contains(P: np.ndarray, c, h, eps: float = 1e-9) -> np.ndarray:
+    return np.all(np.abs(P - c) <= h + eps, axis=1)
+
+
+def _intersection_points(Vw: np.ndarray, planes_w, c, h) -> np.ndarray:
+    """A superset of the vertices of hull ∩ box, every point of it inside both.
+
+    Vertices of the intersection of two convex polytopes are hull vertices inside
+    the box, hull edges crossing a box face, or box edges crossing a hull facet.
+    Hull edges are covered by every chord between two hull vertices (each chord
+    lies in the hull, so its face crossings lie in hull ∩ box); box edges are
+    clipped against the hull's facet planes.
+    """
+    out = [Vw[_box_contains(Vw, c, h)]]
+    n = len(Vw)
+    I, J = np.triu_indices(n, 1)
+    A, B = Vw[I], Vw[J]
+    D = B - A
+    lo, hi = c - h, c + h
+    for ax in range(3):
+        for val in (lo[ax], hi[ax]):
+            den = D[:, ax]
+            ok = np.abs(den) > 1e-15
+            t = np.full(len(A), -1.0)
+            t[ok] = (val - A[ok, ax]) / den[ok]
+            m = (t >= 0.0) & (t <= 1.0)
+            if not np.any(m):
+                continue
+            X = A[m] + t[m, None] * D[m]
+            X[:, ax] = val
+            out.append(X[_box_contains(X, c, h)])
+    if planes_w is not None:
+        nrm, e = planes_w
+        corners = np.array([[x, y, z] for x in (lo[0], hi[0]) for y in (lo[1], hi[1])
+                            for z in (lo[2], hi[2])])
+        edges = [(i, j) for i in range(8) for j in range(i + 1, 8)
+                 if int(np.sum(corners[i] != corners[j])) == 1]
+        for i, j in edges:
+            a, d = corners[i], corners[j] - corners[i]
+            na, nd = nrm @ a, nrm @ d
+            t0, t1 = 0.0, 1.0
+            feasible = True
+            for k in range(len(e)):
+                if abs(nd[k]) < 1e-15:
+                    if na[k] > e[k] + 1e-12:
+                        feasible = False
+                        break
+                    continue
+                tk = (e[k] - na[k]) / nd[k]
+                if nd[k] > 0:
+                    t1 = min(t1, tk)
+                else:
+                    t0 = max(t0, tk)
+                if t0 > t1:
+                    feasible = False
+                    break
+            if feasible:
+                out.append(np.vstack([a + t0 * d, a + t1 * d]))
+    return np.vstack(out) if out else np.zeros((0, 3))
+
+
+def _hull_exempt(hull: dict, M, box: dict, tcp: np.ndarray) -> Optional[list]:
+    """The weld point whose contact explains this hull ∩ box overlap, or ``None``."""
+    if not box["contacts"]:
+        return None
+    R, t = np.asarray(M.rotation, float), np.asarray(M.translation, float)
+    Vw = hull["V"] @ R.T + t
+    planes_w = None
+    if hull["planes"] is not None:
+        n, e = hull["planes"]
+        nw = n @ R.T
+        planes_w = (nw, e + nw @ t)
+    if planes_w is None:                    # cannot bound the overlap: no exemption
+        return None
+    X = None
+    for p, _a in box["contacts"]:
+        if float(np.linalg.norm(tcp - p)) > box["r_c"]:
+            continue
+        if X is None:
+            X = _intersection_points(Vw, planes_w, box["c"], box["h"])
+        if len(X) == 0 or float(np.max(np.linalg.norm(X - p, axis=1))) <= box["r_c"]:
+            return [round(float(v), 4) for v in p]
+    return None
+
+
+# ─── one configuration ─────────────────────────────────────────────────────────
+
+def _eval(e: dict, comp: dict, q):
+    """``(clearance lower bound, deepest breach or None, exempt contacts)`` at ``q``."""
+    import pinocchio as pin
+    fcl = _fcl() if e["hulls"] else None
+    model, data = e["model"], e["data"]
+    qv = np.zeros(model.nq)
+    qa = np.asarray(q, dtype=float)[: model.nq]
+    qv[: len(qa)] = qa
+    pin.forwardKinematics(model, data, qv)
+    W = e["world"] * data.oMi[e["j_mount"]]
+    Rw, tw = np.asarray(W.rotation, float), np.asarray(W.translation, float)
+    pts = e["points"] @ Rw.T + tw
+    tcp = pts[0]
+    pr = e["radii"]
+    best = float("inf")
+    breach = None
+    contacts = []
+
+    def consider(info):
+        # The deepest breach, the exact hulls ranked before the (coarser) spheres.
+        nonlocal breach
+        rank = (info["geometry"] != "hull", info["clearance_m"])
+        if breach is None or rank < (breach["geometry"] != "hull", breach["clearance_m"]):
+            breach = info
+
+    # Coarse filter: obstacles whose bounding sphere is far from the whole tool's
+    # bounding sphere only bound the clearance; the rest are checked in detail.
+    tc_w = Rw @ e["t_centre"] + tw
+    keep_b = keep_s = None
+    if len(comp["BC"]):
+        dcb = np.linalg.norm(comp["BC"] - tc_w, axis=1) - comp["BR"] - e["t_radius"]
+        keep_b = np.nonzero(dcb < _EXACT_BELOW_M)[0]
+        if len(keep_b) < len(dcb):
+            best = min(best, float(np.min(np.delete(dcb, keep_b))))
+    if len(comp["SC"]):
+        dcs = np.linalg.norm(comp["SC"] - tc_w, axis=1) - comp["SR"] - e["t_radius"]
+        keep_s = np.nonzero(dcs < _EXACT_BELOW_M)[0]
+        if len(keep_s) < len(dcs):
+            best = min(best, float(np.min(np.delete(dcs, keep_s))))
+    if keep_b is not None:
+        boxes = [comp["boxes"][i] for i in keep_b]
+        BC, BH = comp["BC"][keep_b], comp["BH"][keep_b]
+    else:
+        boxes, BC, BH = [], comp["BC"], comp["BH"]
+    if keep_s is not None:
+        spheres = [comp["spheres"][i] for i in keep_s]
+        SC, SR = comp["SC"][keep_s], comp["SR"][keep_s]
+    else:
+        spheres, SC, SR = [], comp["SC"], comp["SR"]
+    # The tool spheres of the sphere model (the TCP frame sphere first): surface
+    # outside every obstacle.
+    if len(pts):
+        S = pts
+        if len(BC):
+            ds = _points_box_dist(S, BC, BH) - pr[:, None]
+            for k, b in zip(*np.nonzero(ds < 0.0)):
+                box = boxes[b]
+                if sphere_contact_exempt(S[k], float(pr[k]), box["obs"], tcp):
+                    continue
+                consider({"type": "tool_penetration", "object_id": box["id"],
+                          "is_workpiece": box["workpiece"], "geometry": "sphere",
+                          "body": "tcp_sphere" if k == 0 else f"tool_sphere_{k - 1}",
+                          "link_point": [round(float(v), 4) for v in S[k]],
+                          "clearance_m": round(float(ds[k, b]), 4)})
+            # Exempt overlaps (a sphere at its weld) still bound the step: the
+            # sphere can leave the contact ball while it still overlaps the box.
+            best = min(best, float(np.min(ds)))
+        if len(SC):
+            dss = (np.linalg.norm(S[:, None, :] - SC[None, :, :], axis=-1) - SR[None, :]
+                   - pr[:, None])
+            for k, s in zip(*np.nonzero(dss < 0.0)):
+                consider({"type": "tool_penetration", "object_id": spheres[s]["id"],
+                          "is_workpiece": spheres[s]["workpiece"], "geometry": "sphere",
+                          "body": "tcp_sphere" if k == 0 else f"tool_sphere_{k - 1}",
+                          "link_point": [round(float(v), 4) for v in S[k]],
+                          "clearance_m": round(float(dss[k, s]), 4)})
+            best = min(best, float(np.min(dss)))
+    # The hulls on the tool mount: exact signed distance where close.
+    hulls = e["hulls"]
+    if not hulls:
+        return best, breach, contacts
+    req = fcl.DistanceRequest()
+    placed = []
+    for hull in hulls:
+        M = W * hull["placement"]
+        R, t = np.asarray(M.rotation, float), np.asarray(M.translation, float)
+        placed.append((M, R, t, R @ hull["centre"] + t))
+    # Broad phase for all hulls at once: bounding sphere vs obstacle (a lower bound).
+    C = np.asarray([pl[3] for pl in placed], float)
+    rad = np.asarray([h["radius"] for h in hulls], float)
+    LB = {}
+    if len(BC):
+        LB["box"] = _points_box_dist(C, BC, BH) - rad[:, None]
+    if len(SC):
+        LB["sphere"] = (np.linalg.norm(C[:, None, :] - SC[None, :, :], axis=-1)
+                        - SR[None, :] - rad[:, None])
+    for kind, lbs in LB.items():
+        near_all = lbs < _EXACT_BELOW_M
+        far = lbs[~near_all]
+        if far.size:
+            best = min(best, float(np.min(far)))
+        for h_i, i in zip(*np.nonzero(near_all)):
+            hull = hulls[h_i]
+            M, R, t, _c = placed[h_i]
+            T = fcl.Transform3f(R, t)
+            ob = boxes[i] if kind == "box" else spheres[i]
+            key = (kind, id(ob))
+            shape = comp["fcl"].get(key)
+            if shape is None:
+                if kind == "box":
+                    shape = (fcl.Box(*(2.0 * ob["h"])), fcl.Transform3f(np.eye(3), ob["c"]))
+                else:
+                    shape = (fcl.Sphere(ob["r"]), fcl.Transform3f(np.eye(3), ob["c"]))
+                comp["fcl"][key] = shape
+            res = fcl.DistanceResult()
+            d = float(fcl.distance(hull["conv"], T, shape[0], shape[1], req, res))
+            best = min(best, d)
+            if d >= -PEN_TOL_M:
+                continue
+            ex = _hull_exempt(hull, M, ob, tcp) if kind == "box" else None
+            if ex is not None:
+                contacts.append({"object_id": ob["id"], "weld": ex, "body": hull["mesh"] or hull["name"],
+                                 "clearance_m": round(d, 4)})
+                continue
+            near_w = None
+            if ob["contacts"]:
+                near_w = round(min(float(np.linalg.norm(tcp - p)) for p, _a in ob["contacts"]), 4)
+            consider({"type": "tool_penetration", "object_id": ob["id"],
+                      "is_workpiece": ob["workpiece"], "geometry": "hull",
+                      "body": hull["mesh"] or hull["name"],
+                      "point": [round(float(v), 4) for v in res.getNearestPoint2()],
+                      "link_point": [round(float(v), 4) for v in res.getNearestPoint1()],
+                      "clearance_m": round(d, 4),
+                      "tcp_to_weld_m": near_w})
+    return best, breach, contacts
+
+
+def config_tool_contact_info(cell_id: str, robot_ns: str, q, obstacles: Optional[list] = None,
+                             contact_points: Optional[list] = None) -> Optional[dict]:
+    """The deepest tool penetration of a box/sphere obstacle at ``q`` that is not
+    the weld contact, or ``None`` (also when the check is unavailable)."""
+    e = _entry(cell_id, robot_ns)
+    if not e["ok"]:
+        return None
+    comp = _compile(cell_id, obstacles, contact_points)
+    if not comp["boxes"] and not comp["spheres"]:
+        return None
+    with _LOCK:
+        _best, breach, _c = _eval(e, comp, q)
+    return breach
+
+
+def is_tool_free(cell_id: str, robot_ns: str, q, obstacles: Optional[list] = None,
+                 contact_points: Optional[list] = None, _comp: Optional[dict] = None) -> bool:
+    """Validity predicate for the planners (True when unavailable: fail-open)."""
+    e = _entry(cell_id, robot_ns)
+    if not e["ok"]:
+        return True
+    comp = _comp if _comp is not None else _compile(cell_id, obstacles, contact_points)
+    if not comp["boxes"] and not comp["spheres"]:
+        return True
+    with _LOCK:
+        _best, breach, _c = _eval(e, comp, q)
+    return breach is None
+
+
+def compile_obstacles(cell_id: str, obstacles: Optional[list] = None,
+                      contact_points: Optional[list] = None) -> dict:
+    """Pre-compiled obstacles for repeated :func:`is_tool_free` calls (``_comp=``)."""
+    return _compile(cell_id, obstacles, contact_points)
+
+
+# ─── a whole leg, densely ──────────────────────────────────────────────────────
+
+def _step(override=None) -> float:
+    """The dense-scan step near an obstacle: the argument, else
+    ``TOOL_CONTACT_STEP_M`` from the environment, else the default. A value that is
+    not a positive finite number is the default (it must not switch the check off)."""
+    import math
+    raw = override if override is not None else os.environ.get(
+        "TOOL_CONTACT_STEP_M", TOOL_CONTACT_STEP_M)
+    try:
+        v = float(raw)
+    except (TypeError, ValueError):
+        return TOOL_CONTACT_STEP_M
+    return v if math.isfinite(v) and v > 0.0 else TOOL_CONTACT_STEP_M
+
+
+def _positions(samples) -> np.ndarray:
+    rows = [(pt.get("positions") if isinstance(pt, dict) else pt) for pt in samples]
+    n = min(len(r) for r in rows)
+    return np.asarray([[float(v) for v in r[:n]] for r in rows], float)
+
+
+def trajectory_tool_contact_info(cell_id: str, robot_ns: str, samples: list,
+                                 obstacles: Optional[list] = None,
+                                 contact_points: Optional[list] = None,
+                                 dense: bool = True,
+                                 max_step_m: Optional[float] = None) -> Optional[dict]:
+    """First pose along the leg at which the tool penetrates an obstacle other than
+    at a weld contact, or ``None``.
+
+    ``dense=True`` (default) checks the executed path: the straight joint-space
+    segment between consecutive samples is walked so that no tool point moves
+    more than ``max_step_m`` (default ``TOOL_CONTACT_STEP_M``, env
+    ``TOOL_CONTACT_STEP_M``) between checks where the tool is close to an
+    obstacle; where the clearance ``d`` is larger the step is ``d`` of tool-point
+    travel. The result names ``sample_index`` (start of the segment),
+    ``segment_fraction``, the deepest breach (``worst_*``) and the number of
+    ``checks``; ``weld_contacts`` lists the exempt contacts that were seen.
+    ``None`` also when the check is unavailable (see :func:`available`).
+    """
+    if not samples:
+        return None
+    e = _entry(cell_id, robot_ns)
+    if not e["ok"]:
+        return None
+    comp = _compile(cell_id, obstacles, contact_points)
+    if not comp["boxes"] and not comp["spheres"]:
+        return None
+    step = _step(max_step_m)
+    Q = _positions(samples)
+    osig = comp.get("osig")
+    if osig is None:                        # once per compiled obstacle set
+        osig = comp["osig"] = hashlib.sha1(repr(
+            [(b["id"], b["c"].tolist(), b["h"].tolist(),
+              [(p.tolist(), None if a is None else a.tolist()) for p, a in b["contacts"]],
+              b["r_c"]) for b in comp["boxes"]]
+            + [(s["id"], s["c"].tolist(), s["r"]) for s in comp["spheres"]]
+        ).encode()).hexdigest()
+    key = (str(cell_id), str(robot_ns), bool(dense), step, osig,
+           hashlib.sha1(np.ascontiguousarray(Q).tobytes()).hexdigest())
+    with _LOCK:
+        if key in _TRAJ_CACHE:
+            _TRAJ_CACHE.move_to_end(key)
+            hit = _TRAJ_CACHE[key]
+            return None if hit is None else dict(hit)
+        info = _scan(e, comp, Q, dense, step)
+        if info is not None:
+            pt = samples[info["sample_index"]]
+            info["phase"] = pt.get("phase", "transit") if isinstance(pt, dict) else None
+        _TRAJ_CACHE[key] = None if info is None else dict(info)
+        while len(_TRAJ_CACHE) > _TRAJ_CACHE_MAX:
+            _TRAJ_CACHE.popitem(last=False)
+    return info
+
+
+def _scan(e: dict, comp: dict, Q: np.ndarray, dense: bool, step: float) -> Optional[dict]:
+    levers = e["levers"]
+    if levers is None:                          # cannot bound motion: samples only
+        dense, levers = False, np.ones(Q.shape[1])
+    state = {"first": None, "worst": None, "checks": 0, "contacts": {}}
+
+    def check(q, i, s):
+        d, breach, contacts = _eval(e, comp, q)
+        state["checks"] += 1
+        for c in contacts:
+            state["contacts"].setdefault((c["object_id"], tuple(c["weld"])), c)
+        if breach is not None:
+            rec = (breach, int(i), round(float(s), 4), q)
+            if state["first"] is None:
+                state["first"] = rec
+            w = state["worst"]
+            if w is None or ((breach["geometry"] != "hull", breach["clearance_m"])
+                             < (w[0]["geometry"] != "hull", w[0]["clearance_m"])):
+                state["worst"] = rec
+        return d
+
+    d0 = check(Q[0], 0, 0.0)
+    for i in range(len(Q) - 1):
+        qa, qb = Q[i], Q[i + 1]
+        n = min(len(levers), len(qa))
+        travel = float(np.abs(qb[:n] - qa[:n]) @ levers[:n])   # m of tool travel per unit s
+        if travel <= 0.0:
+            continue                                            # standing still: same pose
+        if dense:
+            s, d = 0.0, d0
+            while True:
+                s += max(step, d) / travel
+                if s >= 1.0:
+                    break
+                d = check(qa + s * (qb - qa), i, s)
+        d0 = check(qb, i + 1, 0.0)
+    if state["first"] is None:
+        return None
+    b, i, s, q = state["first"]
+    wb, wi, ws, _wq = state["worst"]
+    return {**b, "sample_index": i, "segment_fraction": s,
+            "positions": [round(float(v), 6) for v in q],
+            "worst_clearance_m": wb["clearance_m"], "worst_object_id": wb["object_id"],
+            "worst_body": wb["body"], "worst_geometry": wb["geometry"],
+            "worst_sample_index": wi, "worst_segment_fraction": ws,
+            "dense": bool(dense), "checks": state["checks"],
+            "weld_contacts": list(state["contacts"].values())[:8]}
+
+
+# ─── hooks: the shared predicates and leg_verdict ──────────────────────────────
+
+def owner_with_hulls(model) -> Optional[tuple]:
+    """``(cell_id, robot_ns)`` of a model loaded by ``utils.arm_model.load`` whose
+    tool hulls can be checked, else None — what the shared collision predicates
+    (``robot_kinematics``) use, as ``self_collision.checker_for_model``."""
+    owner = arm_model.owner_of(model)
+    if owner is None:
+        return None
+    return owner if available(*owner)[0] else None
+
+
+def leg_tool_breach(cell_id: str, robot_ns: str, samples: list) -> Optional[dict]:
+    """The dense tool-contact breach of one leg against the cell's obstacles (its
+    program welds the only contacts), or None — ``leg_verdict``'s ``tool`` check.
+    Raises :class:`ToolHullsUnavailable` when the tool's hulls cannot be checked
+    (no opinion), anything else when the check broke (refused)."""
+    ok, why = available(cell_id, robot_ns)
+    if not ok:
+        raise ToolHullsUnavailable(why)
+    return trajectory_tool_contact_info(cell_id, robot_ns, samples)
+
+
+def clear_cache() -> None:
+    with _LOCK:
+        for c in (_CACHE, _TRAJ_CACHE, _ANNOT_CACHE, _WELD_CACHE, _COMP_CACHE, _FAST):
+            c.clear()
