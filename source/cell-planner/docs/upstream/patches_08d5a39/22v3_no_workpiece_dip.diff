+def test_an_old_cell_reads_the_converter_default_contact_radius(cell, monkeypatch):
+    import importlib.util
+    rk = cell.rk
+    spec = importlib.util.spec_from_file_location(
+        "convert_isaac_scene", PROJECT_ROOT / "scripts" / "convert_isaac_scene.py")
+    conv = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(conv)
+    default = conv.build_parser().parse_args(["--scene-yaml", "x", "--out-dir", "y"])
+    real = rk._load_robots_config(CELL)
+    coll = {k: v for k, v in (real.get("collision") or {}).items()
+            if k != "tool_contact_radius"}
+    monkeypatch.setattr(rk, "_load_robots_config", lambda c: {**real, "collision": coll})
+    cell.tc.clear_cache()
+    assert cell.tc.contact_radius(CELL) == default.tool_contact_radius
+    monkeypatch.setattr(rk, "_load_robots_config",
+                        lambda c: {**real, "collision": {**coll, "tool_contact_radius": 0.002}})
+    cell.tc.clear_cache()
+    assert cell.tc.contact_radius(CELL) == 0.002
