index 0000000000000000000000000000000000000000..6e91babf7ca159bae166077eb39ea559082a71b4
--- /dev/null
+++ b/tests/trajectory/test_hull_backstop.py
@@ -0,0 +1,155 @@
+"""The exact hull backstop of the inter-arm gate (umarell issue 04, hull_clearance.py).
+
+The sphere gate (``inter_robot_clearance``) is only as good as the spheres it is
+given. A cell converted before ``link_collision`` existed checks the kinematic
+skeleton alone, and a drop-in sphere kernel is whatever it is; the callers of the
+gate therefore also measure the arms' convex URDF hulls exactly. The pair below
+(welding_cell_2_small, found by a seeded local search) has both poses self-free
+and clear of the cell, clears the skeleton-only sphere gate at 0.2293 m (band
+0.20 m), and robot1's tool plate hull is 120 mm deep inside robot2's link_3.
+"""
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+PROJECT_ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(PROJECT_ROOT))
+
+pytest.importorskip("pinocchio")
+
+CELL = "welding_cell_2_small"
+Q1 = [-1.85498, -0.05732, -0.57356, 2.76669, 0.83775, 2.76688]
+Q2 = [1.21452, -1.26425, -0.8201, 1.07949, -0.9023, -1.18069]
+
+
+def _still(q, t=1.0):
+    return [{"positions": list(q), "time_s": 0.0}, {"positions": list(q), "time_s": t}]
+
+
+@pytest.fixture
+def cell(monkeypatch):
+    for base in (os.environ.get("CELL_BASE_PATH"), str(PROJECT_ROOT / "cells")):
+        if base and (Path(base) / CELL).is_dir():
+            monkeypatch.setenv("CELL_BASE_PATH", base)
+            break
+    from agents.trajectory.tools import hull_clearance as hc
+    from agents.trajectory.tools import robot_kinematics as rk
+    ok, why = hc.available(CELL, "robot1")
+    if not ok:
+        pytest.skip(f"no arm hulls here: {why}")
+    return rk, hc
+
+
+def _without_envelope(rk, monkeypatch):
+    """robots.yaml as a cell converted before link_collision existed."""
+    orig = rk._load_robot_config
+    monkeypatch.setattr(rk, "_load_robot_config",
+                        lambda c, n: {k: v for k, v in orig(c, n).items()
+                                      if k != "link_collision"})
+    monkeypatch.setattr(rk, "_ENVELOPE", {})
+
+
