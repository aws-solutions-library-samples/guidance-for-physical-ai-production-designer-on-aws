+def test_an_old_cell_reads_the_converter_default_and_null_is_off(cell, monkeypatch):
+    rk, hc = cell
+    import importlib.util
+    spec = importlib.util.spec_from_file_location(
+        "convert_isaac_scene", PROJECT_ROOT / "scripts" / "convert_isaac_scene.py")
+    conv = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(conv)
+    default = conv.build_parser().parse_args(["--scene-yaml", "x", "--out-dir", "y"])
+    real = rk._load_robots_config(CELL)
+    coll = {k: v for k, v in (real.get("collision") or {}).items() if k != "hull_min_distance"}
+    monkeypatch.setattr(rk, "_load_robots_config", lambda c: {**real, "collision": coll})
+    assert rk._load_collision_config(CELL)["hull_min_distance"] == default.hull_min_distance
+    monkeypatch.setattr(rk, "_load_robots_config",
+                        lambda c: {**real, "collision": {**coll, "hull_min_distance": None}})
+    assert rk._load_collision_config(CELL)["hull_min_distance"] is None
+    legs = {"robot1": _still(Q1), "robot2": _still(Q2)}
+    assert "hull_checked" not in hc.apply_hull_backstop(CELL, legs, {"collision_free": True})
