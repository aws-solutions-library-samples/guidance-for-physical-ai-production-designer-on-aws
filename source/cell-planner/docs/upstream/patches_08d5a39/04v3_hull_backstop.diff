+def test_a_cell_without_an_envelope_is_still_refused_by_the_hulls(cell, monkeypatch):
+    rk, hc = cell
+    _without_envelope(rk, monkeypatch)
+    legs = {"robot1": _still(Q1), "robot2": _still(Q2)}
+    spheres = rk.inter_robot_clearance(CELL, legs)
+    assert spheres["collision_free"] is True and spheres["min_clearance_m"] > 0.2
+    res = _validate(trajectories=legs)
+    # Each leg is fine on its own: the refusal is the pair's hulls, nothing else.
+    assert not res.get("static_collisions") and res["joint_limits_ok"] is True
+    assert res["collision_free"] is False and res["hull_checked"] is True
+    assert res["min_hull_distance_m"] < -0.1
+    hull = [p for p in res["colliding_pairs"] if "hull_distance_m" in p]
+    assert hull and hull[0]["penetrating"] is True
