diff --git a/agents/trajectory/tools/hull_clearance.py b/agents/trajectory/tools/hull_clearance.py
new file mode 100644
index 0000000000000000000000000000000000000000..77867b90120f82702812a39a621510e13707b51b
--- /dev/null
+++ b/agents/trajectory/tools/hull_clearance.py
@@ -0,0 +1,246 @@
+"""Arm-vs-arm distance on the URDF collision hulls: an exact backstop for the sphere gate.
+
+``robot_kinematics.inter_robot_clearance`` decides "may these arms move at once?"
+on spheres: the skeleton, the tool and the converter-fitted ``link_collision``
+envelope. Spheres are an approximation of the castings, and the gate only sees
+the spheres it is given:
+
+* a cell converted before ``link_collision`` existed has no envelope, so the gate
+  checks the skeleton alone (0.12 m spheres on the kinematic chain cover 1-29 %
+  of the KR240 link hulls: on welding_cell_2_small a pair of configurations
+  clears the 0.20 m band at 0.226 m while robot2's link_5 hull sits 0.30 m deep
+  inside robot1's link_3 hull, umarell issue 04);
+* a fitted envelope covers the hull VERTICES, not necessarily every face;
+* a replaced sphere kernel (a vectorised drop-in for ``inter_robot_clearance``)
+  is whatever it is.
+
+So the CALLERS of the gate (``validate_trajectory_set``, and through it every step
+gate, the home step and the home reset; the OMPL backends' inter-arm admission)
+also measure the exact signed distance between the two arms' convex collision
+hulls on the same clock and grid, and refuse a set whose hulls come closer than
+``collision.hull_min_distance`` (robots.yaml, written by the converter; absent =
+:data:`HULL_MIN_DISTANCE_M`, ``null`` = off). It lives here and not inside the
+sphere gate so that no sphere implementation can switch it off.
+
+One cached convex ``GeometryModel`` per (cell, robot, cell files). The exact pair
+distance is computed only for hull pairs whose bounding spheres could be closer
+than the best pair found so far (branch and bound), so the result is the exact
+minimum at a fraction of the 144 GJK calls per sample.
+
+The policy for a check that does not answer is ``leg_verdict``'s: geometry that is
+UNAVAILABLE (no meshes, no hpp-fcl/coal, no URDF) gives no opinion and is reported
+(``hull_checked: False`` + ``hull_check_note``); a check that ran and BROKE raises,
+and the callers refuse (fail-closed).
+"""
+from __future__ import annotations
+
+import threading
+from typing import Optional
+
+import numpy as np
+
+from utils import arm_model
+
+#: The hull separation a cell gets when its robots.yaml does not declare
+#: ``collision.hull_min_distance`` — what scripts/convert_isaac_scene.py writes.
+#: 0.03 m absorbs about one 20 Hz poll of tracking lag between two arms.
+HULL_MIN_DISTANCE_M = 0.03
+
+_LOCK = threading.RLock()
+_CACHE: dict = {}
+
+
+class HullsUnavailable(FileNotFoundError):
+    """The arm has no hull geometry to measure (an availability failure, not a verdict)."""
+
+
+def _fcl():
+    try:
+        import hppfcl as fcl          # pinocchio 2.x
+    except ImportError:               # pragma: no cover - pinocchio >= 3
+        import coal as fcl
+    return fcl
+
+
+def _build(cell_id: str, robot_ns: str) -> dict:
+    try:
+        import pinocchio as pin
+        _fcl()
+    except ImportError as e:
+        raise HullsUnavailable(f"no geometry stack: {e}") from e
+    from agents.trajectory.tools.robot_kinematics import _load_robot_config
+    urdf = arm_model.urdf_path(cell_id, robot_ns)
+    if urdf is None:
+        raise HullsUnavailable(f"no URDF for {robot_ns} in {cell_id}")
+    model = pin.buildModelFromUrdf(str(urdf))
+    try:
+        geom = pin.buildGeomFromUrdf(model, str(urdf), pin.GeometryType.COLLISION,
+                                     package_dirs=[str(urdf.parent)])
+    except ValueError as e:           # a <collision> mesh that is not on disk
+        raise HullsUnavailable(f"{urdf.name}: {e}") from e
+    if geom.ngeoms == 0:
+        raise HullsUnavailable(f"{urdf.name} declares no <collision> geometry")
+    centres, radii = [], []
+    for go in geom.geometryObjects:
+        go.geometry.buildConvexRepresentation(False)
+        go.geometry = go.geometry.convex
+        go.geometry.computeLocalAABB()
+        lo = np.asarray(go.geometry.aabb_local.min_, float)
+        hi = np.asarray(go.geometry.aabb_local.max_, float)
+        centres.append(0.5 * (lo + hi))           # in the geometry's own frame
+        radii.append(0.5 * float(np.linalg.norm(hi - lo)))
+    cfg = _load_robot_config(cell_id, robot_ns)
+    yaw = float(cfg.get("base_orientation_yaw", 0.0))
+    cy, sy = np.cos(yaw), np.sin(yaw)
+    world = pin.SE3(np.array([[cy, -sy, 0.0], [sy, cy, 0.0], [0.0, 0.0, 1.0]]),
+                    np.asarray(cfg["base_position"], float))
+    return {"model": model, "data": model.createData(), "geom": geom,
+            "gdata": pin.GeometryData(geom), "world": world,
+            "centres": centres, "radii": np.asarray(radii)}
+
+
+def _geometry(cell_id: str, robot_ns: str) -> dict:
+    """The arm's hulls, cached per (cell, robot, cell files' mtimes): a re-converted
+    cell or an edited URDF is measured afresh. Raises :class:`HullsUnavailable`."""
+    from agents.trajectory.tools.leg_verdict import cell_stamp
+    name = (str(cell_id), str(robot_ns))
+    key = (*name, cell_stamp(cell_id, robot_ns) or ())
+    with _LOCK:
+        hit = _CACHE.get(key)
+        if hit is not None:
+            return hit
+        hit = _build(cell_id, robot_ns)
+        for stale in [k for k in _CACHE if k[:2] == name and k != key]:
+            del _CACHE[stale]
+        _CACHE[key] = hit
+        return hit
+
+
+def available(cell_id: str, robot_ns: str) -> tuple:
+    """``(True, "")`` when the arm's hulls can be measured, else ``(False, reason)``."""
+    try:
+        _geometry(cell_id, robot_ns)
+        return True, ""
+    except HullsUnavailable as e:
+        return False, str(e)
+
+
+def _placed(cell_id: str, robot_ns: str, q) -> tuple:
+    import pinocchio as pin
+    g = _geometry(cell_id, robot_ns)
+    model = g["model"]
+    qv = np.zeros(model.nq)
+    qa = np.asarray(q, dtype=float)[: model.nq]
+    qv[: len(qa)] = qa
+    pin.forwardKinematics(model, g["data"], qv)
+    pin.updateGeometryPlacements(model, g["data"], g["geom"], g["gdata"])
+    fcl = _fcl()
+    out, centres = [], []
+    for k, go in enumerate(g["geom"].geometryObjects):
+        M = g["world"] * g["gdata"].oMg[k]
+        out.append((go.name, go.geometry, fcl.Transform3f(M.rotation, M.translation)))
+        centres.append(M.rotation @ g["centres"][k] + M.translation)
+    return out, np.asarray(centres), g["radii"]
+
+
+def arm_hull_distance(cell_id: str, ns_a: str, q_a, ns_b: str, q_b) -> tuple:
+    """``(signed distance m, [hull_a, hull_b])`` of the closest hull pair of two arms.
+
+    Negative = penetration depth. Exact: a pair is skipped only when its bounding
+    spheres are farther apart than the best exact distance already found. Raises
+    :class:`HullsUnavailable` when either arm has no usable geometry.
+    """
+    fcl = _fcl()
+    with _LOCK:
+        A, ca, ra = _placed(cell_id, ns_a, q_a)
+        B, cb, rb = _placed(cell_id, ns_b, q_b)
+    lower = (np.linalg.norm(ca[:, None, :] - cb[None, :, :], axis=-1)
+             - ra[:, None] - rb[None, :])
+    order = np.argsort(lower, axis=None)
+    best, pair = float("inf"), None
+    req = fcl.DistanceRequest()
+    nb = len(B)
+    for flat in order:
+        i, j = divmod(int(flat), nb)
+        if lower[i, j] >= best:
+            break
+        res = fcl.DistanceResult()
+        d = float(fcl.distance(A[i][1], A[i][2], B[j][1], B[j][2], req, res))
+        if d < best:
+            best, pair = d, [A[i][0], B[j][0]]
+    return best, pair
+
+
+def hull_min_distance(cell_id: str) -> Optional[float]:
+    """The cell's hull separation (``collision.hull_min_distance``), None = off."""
+    from agents.trajectory.tools.robot_kinematics import _load_collision_config
+    return _load_collision_config(cell_id).get("hull_min_distance")
+
+
+def apply_hull_backstop(cell_id: str, trajectories: dict, result: dict,
+                        n_samples: int = 20) -> dict:
+    """Add the exact hull verdict to an ``inter_robot_clearance`` result.
+
+    The grid is the sphere gate's own (``validation_sample_count`` over the
+    longest leg, at least ``n_samples``), on the shared clock: an arm that has
+    finished stands at its last sample. A pair closer than the cell's
+    ``hull_min_distance`` makes the result not collision-free and is listed in
+    ``colliding_pairs`` (``hull_distance_m``, ``hulls``). The sphere verdict —
+    band, stopping distances, its clearances — is left as it is.
+
+    A no-op when the cell switches the hull check off, for fewer than two arms, and
+    when the result already carries ``min_hull_distance_m`` (an implementation of
+    the gate that measured the hulls itself). Hulls that are unavailable are
+    reported (``hull_checked: False``, ``hull_check_note``) and change nothing; any
+    other failure raises — the caller refuses.
+    """
+    from agents.trajectory.tools.robot_kinematics import validation_sample_count
+    from agents.trajectory.tools.time_parameterization import _sample_at_time
+
+    if result is None or "min_hull_distance_m" in result:
+        return result
+    hull_min = hull_min_distance(cell_id)
+    names = [ns for ns, tr in (trajectories or {}).items() if tr]
+    if hull_min is None or len(names) < 2:
+        return result
+    for ns in names:
+        ok, why = available(cell_id, ns)
+        if not ok:
+            result["hull_checked"] = False
+            result["hull_check_note"] = f"{ns}: {why}"
+            return result
+    horizon = max(float(trajectories[ns][-1].get("time_s", 0.0)) for ns in names)
+    n = validation_sample_count(horizon, floor=int(n_samples))
+    grid = [horizon * i / (n - 1) for i in range(n)] if horizon > 0 else [0.0]
+    min_hull, worst, colliding, first_t = float("inf"), None, {}, None
+    for t in grid:
+        qs = {ns: _sample_at_time(trajectories[ns], t) for ns in names}
+        for ia, a in enumerate(names):
+            for b in names[ia + 1:]:
+                hd, hp = arm_hull_distance(cell_id, a, qs[a], b, qs[b])
+                if hd < min_hull:
+                    min_hull, worst = hd, [f"{a}:{hp[0]}", f"{b}:{hp[1]}"]
+                if hd < hull_min:
+                    key = f"{a}|{b}|hull"
+                    if key not in colliding:
+                        colliding[key] = {"robots": [a, b], "time_s": round(t, 4),
+                                          "hull_distance_m": round(hd, 4),
+                                          "hulls": hp, "penetrating": bool(hd < 0)}
+                    if first_t is None:
+                        first_t = round(t, 4)
+    result["hull_checked"] = True
+    result["hull_min_distance_m"] = hull_min
+    result["min_hull_distance_m"] = round(min_hull, 4)
+    result["worst_hull_pair"] = worst
+    if colliding:
+        result["collision_free"] = False
+        result["colliding_pairs"] = list(result.get("colliding_pairs") or []) + list(
+            colliding.values())
+        if result.get("collision_time_s") is None or first_t < result["collision_time_s"]:
+            result["collision_time_s"] = first_t
+    return result
+
+
+def clear_cache() -> None:
+    with _LOCK:
+        _CACHE.clear()
