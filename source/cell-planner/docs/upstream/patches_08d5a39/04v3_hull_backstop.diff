+def test_branch_and_bound_is_the_exact_minimum(cell):
+    rk, hc = cell
+    fcl = hc._fcl()
+    rng = np.random.default_rng(4)
+    for _ in range(12):
+        qa, qb = rng.uniform(-2.0, 2.0, 6), rng.uniform(-2.0, 2.0, 6)
+        d, pair = hc.arm_hull_distance(CELL, "robot1", qa, "robot2", qb)
+        A, _ca, _ra = hc._placed(CELL, "robot1", qa)
+        B, _cb, _rb = hc._placed(CELL, "robot2", qb)
+        brute = min(float(fcl.distance(a[1], a[2], b[1], b[2], fcl.DistanceRequest(),
+                                       fcl.DistanceResult())) for a in A for b in B)
+        assert d == pytest.approx(brute, abs=1e-9)
+
