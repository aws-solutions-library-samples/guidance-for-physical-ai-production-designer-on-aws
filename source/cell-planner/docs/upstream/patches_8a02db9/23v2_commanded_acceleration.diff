+"""TOPP-RA legs are timed so that the command the driver makes of them meets the limits (issue 23).
+
+TOPP-RA's timing is bang-bang (piecewise-constant acceleration). The robot agent / ros2_control driver
+(``utils.fjt_trajectory``) sends joint_trajectory_controller one smooth curve through the 50 ms samples, and no
+smooth curve through such samples follows an acceleration jump: the command peaked at about 1.3 x the limit the leg
+was timed to. These tests pin the fix in ``time_parameterization``: the command (both curves the driver may choose,
+as a goal of its own and, where flagged, with its ends held still) stays within the limits at every execution
+scale, the path is unchanged, and ``TOPP_COMMANDED_LIMITS=0`` restores the previous timing. At umarell 76ea13a a
+path without ``max_deviation_rad`` is timed exactly, one rest-to-rest TOPP-RA piece per straight segment: each piece is
+checked with its junctions held still. Pure numpy + toppra.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from utils import fjt_trajectory as F
+
+toppra = pytest.importorskip("toppra")
+
+from agents.trajectory.tools import time_parameterization as TP  # noqa: E402
+
+VEL = np.array([2.722714, 2.722714, 2.722714, 5.759586, 5.759586, 10.73377])
+ACC = np.array([3.0, 3.0, 3.0, 6.0, 6.0, 8.0])
+PATH = [[0.0, -1.5708, 1.5708, 0.0, 0.0, 0.0], [0.6, -1.4, 1.5, 0.4, 0.3, 0.2],
+        [1.5, -1.2, 1.3, 1.6, -0.6, 1.2], [1.98, -1.46, 1.68, 2.43, -1.69, 2.02]]
+
+
+def _arrays(points):
+    t = np.array([p["time_s"] for p in points])
+    q = np.array([p["positions"] for p in points])
+    v = np.array([p["velocities"] for p in points])
+    a = np.array([p["accelerations"] for p in points])
+    return t, q, v, a
+
+
+def _peaks(traj, limit, scale=1.0):
+    """(per-cycle, continuous) peak of the driver's command / (limit x scale^2)."""
+    t, q, v, a = _arrays(F.fjt_points(traj, velocity_scale=scale))
+    lim = np.asarray(limit) * scale * scale
+    cyc = float((F.cycle_accelerations(t, q, v, a) / lim).max())
+    cont = float((F.segment_peak_accelerations(t, q, v, a).max(axis=0) / lim).max())
+    return cyc, cont
+
+
+@pytest.fixture
+def previous_timing(monkeypatch):
+    monkeypatch.setenv("TOPP_COMMANDED_LIMITS", "0")
+
+
+@pytest.mark.parametrize("vs", [1.0, 0.7, 0.3])
+def test_the_command_stays_within_the_limit_at_every_execution_scale(vs):
+    traj = TP.parameterize(PATH, vel_limits=VEL, accel_limits=ACC, velocity_scale=vs)
+    for scale in (1.0, 0.5, 0.25):
+        cyc, cont = _peaks(traj, ACC * vs * vs, scale)
+        assert cyc <= 1.0 + 1e-6, (vs, scale, cyc)
+        assert cont <= 1.0 + 1e-6, (vs, scale, cont)
+
+
+def test_the_previous_timing_overshoots(previous_timing):
+    traj = TP.parameterize(PATH, vel_limits=VEL, accel_limits=ACC, velocity_scale=1.0)
+    cyc, _ = _peaks(traj, ACC)
+    assert cyc > 1.15                     # the issue: about 1.3 x the limit
+
+
+def test_the_path_is_kept(monkeypatch):
+    """Every sample lies on the path the previous timing follows (TOPP-RA's spline through the same knots)."""
+    new = TP.parameterize(PATH, vel_limits=VEL, accel_limits=ACC, velocity_scale=0.7)
+    monkeypatch.setenv("TOPP_COMMANDED_LIMITS", "0")
+    dense = np.array([p["positions"] for p in TP.parameterize(PATH, vel_limits=VEL, accel_limits=ACC,
+                                                                velocity_scale=0.7, dt=0.0005)])
+    for p in new:
+        x = np.asarray(p["positions"])
