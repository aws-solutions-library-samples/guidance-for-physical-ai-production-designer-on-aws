+# ─── Limits as the driver commands them (issue 23) ───────────────────────────
+# TOPP-RA's timing is bang-bang: its acceleration is piecewise constant and
+# jumps between the limits (at rest, at every accelerate / brake switch, at a
+# rest-to-rest corner of the exact candidate). The driver (utils.fjt_trajectory,
+# issue 20) sends joint_trajectory_controller one smooth (C2) curve through the
+# emitted samples, and no smooth curve through 50 ms samples follows a jump:
+# its acceleration overshoots next to every switch by about 0.13 x the jump
+# (the cubic spline's 2 - sqrt(3) ringing), so the command peaked at 1.3-1.5 x
+# the limit the leg was timed to, at any speed scale. The fix keeps the path
+# and TOPP-RA, and checks each piece the way it will be commanded
+# (``commanded_acceleration_ratio``: the driver's own derivatives of the
+# emitted samples, both curves it may choose between, then the exact peak of
+# the controller's quintic on every segment). Where that exceeds a joint's
+# limit, that joint's acceleration limit is lowered locally (a bump in time
+# around the offending segments, falling to nothing over _CMD_WINDOW_SAMPLES
+# samples, so the lowered limit itself causes no new jump) and TOPP-RA is
+# solved again on the same path and grid; the rest of the piece keeps its
+# time-optimal timing. A uniform time stretch is the last resort, so the
+# result always meets the limits. Samples are evenly spaced and carry 9
+# decimals (``_emit_uniform``). ``TOPP_COMMANDED_LIMITS=0`` restores the
+# previous timing exactly.
+
+_CMD_TARGET = 0.995         # aim for this fraction of the limit where it is exceeded
+_CMD_WINDOW_SAMPLES = 2.0   # half-width of the local reduction, in output samples
+_CMD_MIN_SCALE = 0.2        # never lower a local limit below this fraction
+_CMD_DIGITS = 9             # decimals of the emitted positions / velocities
+_CMD_ROUNDING_TOL = 0.0     # rad/s^2 slack for rounding (1e-9 rad: < 5e-6 rad/s^2 over >= 25 ms): none
+
+
+def _commanded_limits_on() -> bool:
+    return os.environ.get("TOPP_COMMANDED_LIMITS", "1").strip().lower() not in ("0", "false", "no", "off")
+
+
+def _commanded_max_iter() -> int:
+    try:
+        return max(0, int(os.environ.get("TOPP_COMMANDED_MAX_ITER", "16")))
+    except ValueError:
+        return 16
+
+
+def _emit_uniform(jnt_traj, dt: float, k: float = 1.0, digits: int = _CMD_DIGITS) -> list[dict]:
+    """Samples of a TOPP-RA result after a uniform time stretch ``k``: the same
+    number as every ``dt`` s, but evenly spaced (T / ceil(T / dt) <= dt), each
+    sampled at its rounded time; positions and the velocities of that timing
+    with ``digits`` decimals, at rest at both ends. A last sample 0-``dt`` after
+    the one before turns position rounding into acceleration spikes in the
+    driver's command; 1e-6 rad over 50 ms is ~2e-3 rad/s^2, a fifth of a slow
+    approach's acceleration limit."""
+    import numpy as np
+
+    duration = float(jnt_traj.duration)
+    duration_out = duration * k
+    n = max(1, int(np.ceil(duration_out / dt - 1e-9)))
+    ts = np.round(np.arange(n + 1) * (duration_out / n), 4)
+    tau = np.minimum(ts / k, duration)
+    tau[-1] = duration
+    qs = np.asarray(jnt_traj(tau), float)
+    qds = np.asarray(jnt_traj(tau, 1), float) / k
+    qds[0] = qds[-1] = 0.0                           # TOPP-RA starts and ends at rest
+    return [{"positions": [round(float(v), digits) for v in qs[i]],
+             "velocities": [round(float(v), digits) for v in qds[i]],
+             "time_s": round(float(ts[i]), 4)} for i in range(len(ts))]
+
+
+def commanded_acceleration_ratio(traj: Sequence[dict], accel_limits: Sequence[float],
+                                 still_ends: tuple = (True, True), rounding_tol: float = 0.0):
+    """How far the command a driver sends for ``traj`` goes past the limits.
+
+    ``traj``: timed samples ``[{"positions", "velocities"?, "time_s"}]``;
+    ``accel_limits``: per joint (rad/s^2), the limit the leg was timed to.
+    Returns ``(t0, t1, ratio)``: segment start / end times and an (N-1, dof)
+    array of the segment's peak |acceleration| / limit, for the command of
+    ``utils.fjt_trajectory`` (the robot agent / ros2_control driver),
+    interpolated by joint_trajectory_controller (quintic), exact (continuous,
+    so it bounds the per-cycle value at any controller rate). Each segment gets
+    the largest of the curves the driver may send: with the samples'
+    velocities or with the spline's (its choice between them depends on the
+    execution ``velocity_scale``), each as a goal of its own (end points at
+    rest with the curve's acceleration) and, at the ends flagged in
+    ``still_ends`` (start, end), embedded in a longer goal (that end held
+    still). Both curves are exact time scalings of themselves, so a ratio <= 1
+    holds at every execution scale. ``rounding_tol`` (rad/s^2) is subtracted
+    from every peak first. ``None`` when ``utils.fjt_trajectory`` cannot be
+    imported.
+    """
+    import numpy as np
+    try:
+        from utils import fjt_trajectory as F
+    except Exception:
+        return None
+    pts = list(traj)
+    if len(pts) < 2:
+        return None
+    dof = min(len(pts[0]["positions"]), len(accel_limits))
+    t = np.array([float(p["time_s"]) for p in pts])
+    q = np.array([[float(x) for x in p["positions"][:dof]] for p in pts])
+    vg = F._given(pts, "velocities", dof)
+    if vg is not None and not np.any(vg):
+        vg = None
+    rests = F.timing_rests(pts, use_velocities=vg is not None)
+    al = np.asarray(accel_limits, float)[:dof]
+    tol = float(rounding_tol)
+    ratio = np.zeros((len(t) - 1, dof))
+    for cand in F.derivative_candidates(t, q, vg, rests):
+        if cand is None:
+            continue
+        v, a = cand
+        ratio = np.maximum(ratio, (F.segment_peak_accelerations(t, q, v, a) - tol) / al)
+        if still_ends[0] or still_ends[1]:
+            a = a.copy()                             # embedded: those ends held still
+            if still_ends[0]:
+                a[0] = 0.0
+            if still_ends[1]:
+                a[-1] = 0.0
+            ratio = np.maximum(ratio, (F.segment_peak_accelerations(t, q, v, a) - tol) / al)
+    return t[:-1], t[1:], ratio
+
+
+def _scaled_acceleration_constraint(al, scale):
+    """TOPP-RA joint acceleration constraint whose limit at gridpoint i, joint j
+    is ``al[j] * scale[i, j]`` (rows of the canonical constraint divided by the
+    scale; same F, g at every gridpoint)."""
+    import numpy as np
+    import toppra.constraint as constraint
+    from toppra.constraint.linear_constraint import canlinear_colloc_to_interpolate
+
+    class _Scaled(constraint.JointAccelerationConstraint):
+        def compute_constraint_params(self, path, gridpoints, *args, **kwargs):
+            ps = path(gridpoints, 1) / scale
+            pss = path(gridpoints, 2) / scale
+            dof = path.dof
+            F_ = np.vstack([np.eye(dof), -np.eye(dof)])
+            g = np.concatenate([self.alim[:, 1], -self.alim[:, 0]])
+            return canlinear_colloc_to_interpolate(ps, pss, np.zeros_like(ps), F_, g, None, None,
+                                                   gridpoints, identical=True)
+
+    return _Scaled(np.vstack([-al, al]).T)
+
+
+def _within_commanded_limits(constraint, algo, jnt_traj, vl, al, dt: float,
+                             still_ends=(True, True)) -> list[dict]:
+    """One TOPP-RA piece emitted (``_emit_uniform``) and re-timed until the
+    driver's command stays within ``al``; see the comment block above."""
+    import numpy as np
+
+    out = _emit_uniform(jnt_traj, dt)
+    chk = commanded_acceleration_ratio(out, al, still_ends, _CMD_ROUNDING_TOL)
+    if chk is None:
+        return out
+    t0, t1, r = chk
+    if not len(r) or float(r.max()) <= 1.0:
+        return out
+    path = jnt_traj._path
+    grid = np.asarray(jnt_traj._ss, float)          # the gridpoints it was solved on
+    n_knots = len(getattr(path, "ss_waypoints", ())) or 2
+    scale = np.ones((len(grid), len(al)))
+    half = _CMD_WINDOW_SAMPLES * dt
+    for _ in range(_commanded_max_iter()):
+        tg = np.asarray(jnt_traj._ts, float)        # gridpoint times
+        fac = np.ones_like(scale)
+        for j in range(len(al)):
+            bad = np.flatnonzero(r[:, j] > _CMD_TARGET)
+            if not len(bad):
+                continue
+            # 1 on the offending segment, falling linearly to 0 at +- half
+            d = np.maximum(np.maximum(t0[bad][None, :] - tg[:, None], tg[:, None] - t1[bad][None, :]), 0.0)
+            bump = np.clip(1.0 - d / half, 0.0, 1.0)
+            fac[:, j] = np.min(1.0 - bump * (1.0 - _CMD_TARGET / r[bad, j])[None, :], axis=1)
+        scale = np.maximum(scale * fac, _CMD_MIN_SCALE)
+        try:
+            jt = _toppra_within(constraint, algo, path, grid, vl, al, n_knots, accel_scale=scale)
+        except Exception:
+            jt = None
+        if jt is None or not (float(jt.duration) > 0):
+            break
+        cand = _emit_uniform(jt, dt)
+        jnt_traj, out = jt, cand
+        t0, t1, r = commanded_acceleration_ratio(cand, al, still_ends, _CMD_ROUNDING_TOL)
+        if float(r.max()) <= 1.0:
+            return out
+    # Last resort: stretch the last timing uniformly (acceleration ~ 1/k^2).
+    k = 1.0
+    for _ in range(12):
+        k *= float(np.sqrt(max(float(r.max()), 1.0))) * 1.002
+        out = _emit_uniform(jnt_traj, dt, k)
+        t0, t1, r = commanded_acceleration_ratio(out, al, still_ends, _CMD_ROUNDING_TOL)
+        if float(r.max()) <= 1.0:
+            break
+    return out
+
+
+def _commanded_pieces(constraint, algo, pieces, vl, al, dt: float, still_ends=(True, True)):
+    """``pieces`` (TOPP-RA results, each from rest to rest) emitted one after
+    the other on one clock, each within the commanded limits. The junction
+    between two pieces is a stop the driver holds still (an exact 0 velocity),
+    so each piece is checked with that end held still; ``still_ends`` are the
+    outer ends'. ``None`` if a piece has no duration."""
+    out: list = []
+    t0 = 0.0
+    m = len(pieces)
+    for i, jt in enumerate(pieces):
+        if not (float(jt.duration) > 0):
+            return None
+        ends = (i > 0 or still_ends[0], i < m - 1 or still_ends[1])
+        seg = _within_commanded_limits(constraint, algo, jt, vl, al, dt, ends)
+        first = 1 if out else 0                  # the junction point once
+        out += [{**p, "time_s": round(t0 + float(p["time_s"]), 4)} for p in seg[first:]]
+        t0 = float(out[-1]["time_s"])
+    return out
+
+
+def _samples_inside(traj: Sequence[dict], box) -> bool:
+    """Whether every emitted sample is in the joint box (``joint_limits`` tolerance)."""
+    import numpy as np
+    from agents.trajectory.tools.joint_limits import JOINT_LIMIT_TOL_RAD
+
+    lo, hi = (np.asarray(b, float) for b in box)
+    qs = np.array([p["positions"] for p in traj], float)
+    n = min(qs.shape[1], len(lo), len(hi))
+    return not ((qs[:, :n] > hi[:n] + JOINT_LIMIT_TOL_RAD).any()
+                or (qs[:, :n] < lo[:n] - JOINT_LIMIT_TOL_RAD).any())
+
