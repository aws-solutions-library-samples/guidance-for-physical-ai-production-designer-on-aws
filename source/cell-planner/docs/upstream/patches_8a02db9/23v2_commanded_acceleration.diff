+def segment_peak_accelerations(times, positions, velocities, accelerations):
+    """(N-1, dof) array: the largest |acceleration| of joint_trajectory_controller's
+    quintic command on each segment between consecutive points (exact: the
+    acceleration of a quintic is a cubic, its extremes are at the segment ends
+    or where the jerk vanishes). A segment of zero duration gives 0.
+
+    This is the continuous command, so it bounds ``cycle_accelerations`` at any
+    controller cycle and any uniform time scaling (a per-cycle second difference
+    is an average of the continuous acceleration). The planner uses it to time
+    legs whose command stays within the limits (time_parameterization).
+    """
+    import numpy as np
+    t = np.asarray(times, float)
+    q = np.asarray(positions, float)
+    if len(t) < 2:
+        return np.zeros((0, q.shape[1] if q.ndim == 2 else 0))
+    v = np.asarray(velocities, float)
+    a = np.asarray(accelerations, float)
+    h = np.diff(t)
+    ok = h > _MIN_DT_S
+    T = np.where(ok, h, 1.0)[:, None]
+    p0, p1, v0, v1, a0, a1 = q[:-1], q[1:], v[:-1], v[1:], a[:-1], a[1:]
+    c3 = (-20 * p0 + 20 * p1 - 3 * a0 * T ** 2 + a1 * T ** 2 - 12 * v0 * T - 8 * v1 * T) / (2 * T ** 3)
+    c4 = (30 * p0 - 30 * p1 + 3 * a0 * T ** 2 - 2 * a1 * T ** 2 + 16 * v0 * T + 14 * v1 * T) / (2 * T ** 4)
+    c5 = (-12 * p0 + 12 * p1 - a0 * T ** 2 + a1 * T ** 2 - 6 * v0 * T - 6 * v1 * T) / (2 * T ** 5)
+
+    def acc(x):
+        return np.abs(a0 + x * (6 * c3 + x * (12 * c4 + x * 20 * c5)))
+
+    peak = np.maximum(np.abs(a0), np.abs(a1))
+    # jerk 6 c3 + 24 c4 x + 60 c5 x^2 = 0 inside (0, T)
+    A, B, C = 60 * c5, 24 * c4, 6 * c3
+    scale = np.abs(A) * T ** 2 + np.abs(B) * T + np.abs(C) + 1e-300
+    quad = np.abs(A) * T ** 2 > 1e-12 * scale
+    disc = np.where(quad, B * B - 4 * A * C, 0.0)
+    sq = np.sqrt(np.maximum(disc, 0.0))
+    A_ = np.where(quad, A, 1.0)
+    B_ = np.where(np.abs(B) > 0, B, 1.0)
+    roots = (np.where(quad & (disc >= 0), (-B - sq) / (2 * A_), -1.0),
+             np.where(quad & (disc >= 0), (-B + sq) / (2 * A_), -1.0),
+             np.where(~quad & (np.abs(B) > 0), -C / B_, -1.0))
+    for x in roots:
+        inside = (x > 0) & (x < T)
+        peak = np.where(inside, np.maximum(peak, acc(np.where(inside, x, 0.0))), peak)
+    peak[~ok] = 0.0
+    return peak
+
