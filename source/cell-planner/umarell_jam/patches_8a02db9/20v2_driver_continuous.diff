+        return True
+
+    def send_goal_async(self, goal):
+        SENT.append(goal)
+        res = types.SimpleNamespace(result=types.SimpleNamespace(error_code=0))
+        return _Done(types.SimpleNamespace(accepted=True, get_result_async=lambda: _Done(res)))
+
