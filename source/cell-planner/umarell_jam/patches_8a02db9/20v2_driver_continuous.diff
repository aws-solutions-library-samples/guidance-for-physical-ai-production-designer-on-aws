@@ -0,0 +1,229 @@
+"""FollowJointTrajectory points carry the timing's derivatives (utils.fjt_trajectory).
+
+The robot agent and the ros2_control driver used to send ``velocities = [0.0] * 6``
+with every point. joint_trajectory_controller interpolates such a goal with
+rest-to-rest cubic segments, so the arm stopped at every waypoint. These tests pin
+the replacement: velocities and accelerations of one smooth curve through the timed
+positions, exact rests at the ends and in holds, and the JTC interpolation that
+the simulated controllers now share. Pure numpy, no ROS.
+"""
+from __future__ import annotations
+
+import math
+
+import numpy as np
+import pytest
+
+from utils import fjt_trajectory as F
+
+
+def _rest_to_rest(T=2.0, dt=0.05, amp=(0.8, -0.5, 0.3, 1.2, -0.9, 2.0)):
+    """A smooth rest-to-rest move (quintic smoothstep) sampled at ``dt``, with its
+    exact velocity, as a planner would emit it."""
+    amp = np.asarray(amp)
+    ts = np.append(np.arange(0.0, T, dt), T)
+    x = ts / T
+    s = 10 * x ** 3 - 15 * x ** 4 + 6 * x ** 5
+    sd = (30 * x ** 2 - 60 * x ** 3 + 30 * x ** 4) / T
+    q = s[:, None] * amp
+    v = sd[:, None] * amp
+    return ts, q, v
+
+
+def _traj(ts, q, v=None):
+    out = []
+    for i, t in enumerate(ts):
+        p = {"positions": [float(x) for x in q[i]], "time_s": float(t)}
+        if v is not None:
+            p["velocities"] = [float(x) for x in v[i]]
+        out.append(p)
+    return out
+
+
+def _command(points, cycle=0.004, tail=0.1):
+    pts = [dict(p, t=p["time_s"]) for p in points]
+    ts = np.arange(0.0, pts[-1]["t"] + tail, cycle)
+    return ts, np.array([F.sample(pts, t)[0] for t in ts])
+
+
+def test_positions_only_plan_gets_the_velocities_of_its_timing():
+    ts, q, v = _rest_to_rest()
+    pts = F.fjt_points(_traj(ts, q))
+    V = np.array([p["velocities"] for p in pts])
+    assert np.all(V[0] == 0.0) and np.all(V[-1] == 0.0)
+    # interior: the C2 spline through the samples recovers the timing's velocity
+    assert np.abs(V[1:-1] - v[1:-1]).max() < 0.01 * np.abs(v).max()
+    assert all(len(p["accelerations"]) == 6 for p in pts)
+
+
+def test_the_arm_no_longer_stops_at_every_waypoint():
+    ts, q, v = _rest_to_rest()
+    fixed = F.fjt_points(_traj(ts, q))
+    zeros = [dict(p, velocities=[0.0] * 6) for p in _traj(ts, q)]   # what the agent sent
+    peak_a = (np.abs(np.gradient(v, ts, axis=0))).max(axis=0)
+    for points, expect_ok in ((fixed, True), (zeros, False)):
+        tc, Q = _command(points)
+        acc = np.abs(np.diff(Q, 2, axis=0)) / 0.004 ** 2
+        ratio = float((acc.max(axis=0) / peak_a).max())
+        assert (ratio < 1.2) == expect_ok, ratio
+
+
+def test_planner_velocities_are_forwarded_when_they_match_the_timing():
+    ts, q, v = _rest_to_rest()
+    pts = F.fjt_points(_traj(ts, q, v))
+    V = np.array([p["velocities"] for p in pts])
+    assert np.allclose(V[1:-1], v[1:-1], atol=1e-8)
+
+
+def test_stale_planner_velocities_are_not_forwarded():
+    """A copy re-timed 2x slower that kept its velocities: they no longer belong."""
+    ts, q, v = _rest_to_rest()
+    stale = _traj(2.0 * ts, q, v)
+    V = np.array([p["velocities"] for p in F.fjt_points(stale)])
+    assert np.abs(V[1:-1] - 0.5 * v[1:-1]).max() < 0.01 * np.abs(v).max()
+
+
+def test_velocity_scale_scales_time_and_derivatives_together():
+    ts, q, v = _rest_to_rest()
+    base = F.fjt_points(_traj(ts, q, v))
+    slow = F.fjt_points(_traj(ts, q, v), velocity_scale=0.5)
+    assert slow[-1]["time_s"] == pytest.approx(2 * base[-1]["time_s"])
+    for b, s in zip(base, slow):
+        assert s["positions"] == b["positions"]
+        assert np.allclose(s["velocities"], 0.5 * np.asarray(b["velocities"]), atol=1e-8)
+        assert np.allclose(s["accelerations"], 0.25 * np.asarray(b["accelerations"]), atol=1e-6)
+
+
+def test_scale_time_returns_a_copy():
+    traj = [{"positions": [0.0], "time_s": 1.0, "velocities": [2.0]}]
+    out = F.scale_time(traj, 0.5)
+    assert out[0]["time_s"] == 2.0 and out[0]["velocities"] == [1.0]
+    assert traj[0]["time_s"] == 1.0 and traj[0]["velocities"] == [2.0]
+
+
+def test_a_hold_inside_a_goal_stays_still():
+    ts, q, _v = _rest_to_rest()
+    t1 = ts[-1]
+    traj = _traj(ts, q) + [{"positions": [float(x) for x in q[-1]], "time_s": t1 + 0.5}]
+    traj += [{"positions": [float(x) for x in q[-1 - i]], "time_s": t1 + 0.5 + ts[i]}
+             for i in range(1, len(ts))]
+    pts = F.fjt_points(traj)
+    i_hold = len(ts) - 1
+    for i in (i_hold, i_hold + 1):
+        assert pts[i]["velocities"] == [0.0] * 6 and pts[i]["accelerations"] == [0.0] * 6
+    held = [F.sample([dict(p, t=p["time_s"]) for p in pts], t)[0]
+            for t in np.linspace(t1, t1 + 0.5, 25)]
+    assert np.abs(np.asarray(held) - q[-1]).max() < 1e-12
+
+
+def test_one_and_two_point_moves_are_rest_to_rest():
+    one = F.fjt_points([{"positions": [1.0] * 6, "time_s": 2.5}])
+    assert one[0]["velocities"] == [0.0] * 6 and one[0]["accelerations"] == [0.0] * 6
+    two = F.fjt_points([{"positions": [0.0] * 6, "time_s": 0.0},
+                        {"positions": [1.0] * 6, "time_s": 2.0}])
+    for p in two:
+        assert p["velocities"] == [0.0] * 6 and p["accelerations"] == [0.0] * 6
+
+
+def test_positions_are_padded_to_six_joints():
+    pts = F.fjt_points([{"positions": [0.1, 0.2], "time_s": 0.0},
+                        {"positions": [0.3, 0.4], "time_s": 1.0}])
+    assert [len(p["positions"]) for p in pts] == [6, 6]
+    assert pts[0]["positions"][2:] == [0.0] * 4
+
+
+@pytest.mark.parametrize("fields,mode", [((), "linear"), (("velocities",), "cubic"),
+                                         (("velocities", "accelerations"), "quintic")])
+def test_sample_uses_the_interpolation_jtc_picks(fields, mode):
+    p0 = {"t": 0.0, "positions": [0.0], "velocities": [0.5], "accelerations": [1.0]}
+    p1 = {"t": 1.0, "positions": [1.0], "velocities": [0.5], "accelerations": [-1.0]}
+    a = {k: v for k, v in p0.items() if k in ("t", "positions") + fields}
+    b = {k: v for k, v in p1.items() if k in ("t", "positions") + fields}
+    assert F.segment_mode(a, b) == mode
+    q0, v0, a0 = F.sample([a, b], 1e-9)
+    q1, v1, a1 = F.sample([a, b], 1.0 - 1e-9)
+    assert q0[0] == pytest.approx(0.0, abs=1e-6) and q1[0] == pytest.approx(1.0, abs=1e-6)
+    if mode != "linear":
+        assert v0[0] == pytest.approx(0.5, abs=1e-6) and v1[0] == pytest.approx(0.5, abs=1e-6)
+    if mode == "quintic":
+        assert a0[0] == pytest.approx(1.0, abs=1e-5) and a1[0] == pytest.approx(-1.0, abs=1e-5)
+    q_end, v_end, _ = F.sample([a, b], 5.0)
+    assert q_end == [1.0] and v_end == [0.0]
+
+
+def test_derived_curve_is_c2_through_the_knots():
+    ts, q, _v = _rest_to_rest(dt=0.07)
+    pts = [dict(p, t=p["time_s"]) for p in F.fjt_points(_traj(ts, q))]
+    for k in range(1, len(pts) - 1):
+        t = pts[k]["t"]
+        left = F.sample(pts, t - 1e-7)
+        right = F.sample(pts, t + 1e-7)
+        assert np.allclose(left[0], q[k], atol=1e-6)
+        assert np.allclose(left[1], right[1], atol=1e-4)
+        assert np.allclose(left[2], right[2], atol=1e-2)
+
+
+def test_topp_ra_emits_the_velocities_of_its_timing():
+    pytest.importorskip("toppra")
+    from agents.trajectory.tools.time_parameterization import parameterize
+    path = [[0.0, -1.5708, 1.5708, 0.0, 0.0, 0.0], [0.6, -1.4, 1.5, 0.4, 0.3, 0.2],
+            [1.5, -1.2, 1.3, 1.6, -0.6, 1.2], [1.98, -1.46, 1.68, 2.43, -1.69, 2.02]]
+    vel = [2.72, 2.72, 2.72, 5.76, 5.76, 10.7]
+    traj = parameterize(path, vel_limits=vel, accel_limits=[3, 3, 3, 6, 6, 8], velocity_scale=0.7)
+    assert all("velocities" in p for p in traj)
+    assert traj[0]["velocities"] == [0.0] * 6 and traj[-1]["velocities"] == [0.0] * 6
+    t = np.array([p["time_s"] for p in traj])
+    q = np.array([p["positions"] for p in traj])
+    v = np.array([p["velocities"] for p in traj])
+    assert (np.abs(v) <= 0.7 * np.asarray(vel) * 1.001 + 1e-6).all()
+    slope = np.diff(q, axis=0) / np.diff(t)[:, None]
+    assert np.abs(0.5 * (v[:-1] + v[1:]) - slope).max() < 0.05
+    # and the driver forwards them (they belong to the timing); a sample a few ms
+    # after the previous one gets the fitted curve's value, which is within 1e-4
+    sent = np.array([p["velocities"] for p in F.fjt_points(traj)])
+    assert np.allclose(sent[1:-2], v[1:-2], atol=1e-8)
+    assert np.allclose(sent[-2], v[-2], atol=1e-4)
+
+
+def test_rest_masks():
+    t = [0.0, 0.1, 0.2, 0.3, 0.4]
+    q = [[0.0], [0.1], [0.1], [0.2], [0.3]]
+    rest, still = F.rest_masks(t, q)
+    assert rest.tolist() == [True, True, True, False, True]
+    assert still.tolist() == [False, True, True, False, False]
+    assert math.isclose(F.REST_TOL_RAD, 1e-9)
+
+
+def test_a_phase_seam_is_a_rest():
+    """Each phase of a two-phase leg is timed rest-to-rest: the seam is a stop."""
+    ts, q, _v = _rest_to_rest()
+    traj = [dict(p, phase="transit") for p in _traj(ts, q)]
+    t1 = ts[-1]
+    traj += [{"positions": [float(x) for x in q[-1] + 0.1 * (q[-1 - i] - q[-1])], "phase": "approach",
+              "time_s": float(t1 + ts[i])} for i in range(1, len(ts))]
+    pts = F.fjt_points(traj)
+    seam = len(ts) - 1
+    assert pts[seam]["velocities"] == [0.0] * 6 and pts[seam]["accelerations"] == [0.0] * 6
+    assert any(abs(v) > 1e-3 for v in pts[seam - 1]["velocities"])
+    assert any(abs(v) > 1e-4 for v in pts[seam + 1]["velocities"])
+
+
+def test_all_zero_velocities_are_the_old_format_not_a_timing():
+    ts, q, v = _rest_to_rest()
+    zeros = [dict(p, velocities=[0.0] * 6) for p in _traj(ts, q)]
+    V = np.array([p["velocities"] for p in F.fjt_points(zeros)])
+    assert np.abs(V[1:-1] - v[1:-1]).max() < 0.01 * np.abs(v).max()
+
+
+def test_a_last_sample_just_after_the_previous_one_gives_no_spurious_acceleration():
+    """TOPP-RA's last sample often lands 1 ms after the one before it; positions are
+    rounded to 1e-6 rad, so the slope between them is noise."""
+    T = 2.001
+    ts = np.append(np.arange(0.0, 2.0 + 1e-9, 0.05), T)
+    x = ts / T
+    s = 10 * x ** 3 - 15 * x ** 4 + 6 * x ** 5
+    q = np.round(s[:, None] * np.array([0.8, -0.5, 0.3, 1.2, -0.9, 2.0]), 6)
+    pts = F.fjt_points(_traj(ts, q))
+    A = np.abs(np.array([p["accelerations"] for p in pts]))
+    peak_true = 5.774 * 2.0 / T ** 2              # smoothstep peak acceleration, A6
+    assert A.max() < 1.2 * peak_true
