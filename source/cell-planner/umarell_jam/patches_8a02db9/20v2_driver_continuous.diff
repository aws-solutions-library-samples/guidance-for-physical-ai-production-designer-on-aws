+++ b/utils/fjt_trajectory.py
@@ -0,0 +1,449 @@
+"""
+FollowJointTrajectory points with derivatives that agree with the timed trajectory.
+
+ros2_control's ``joint_trajectory_controller`` (JTC) interpolates each segment
+according to the fields that BOTH of its points carry:
+
+  * positions only                          -> linear (velocity jumps at every point)
+  * positions + velocities                  -> cubic Hermite
+  * positions + velocities + accelerations  -> quintic Hermite
+
+Sending ``velocities = [0.0] * 6`` with every point (what the robot agent and
+the ros2_control driver did) makes every segment a rest-to-rest cubic: the arm
+stops at every waypoint, 20 times a second on a 20 Hz plan, and the commanded
+acceleration between two stops is many times the limit the plan was timed to.
+
+``with_derivatives`` / ``fjt_points`` give every point of a timed trajectory
+``[{"positions", "time_s", ...}]`` the velocity and acceleration of ONE smooth
+(C2) curve through all the timed positions:
+
+  * velocities: the planner's own (``"velocities"`` on every point; TOPP-RA
+    attaches them), unless the command they give is clearly rougher than with
+    the velocities of the C2 cubic spline through the timed positions (a copy
+    re-timed without scaling its velocities). Older plans and hand-built moves
+    carry none and get the spline's;
+  * accelerations: those of the C2 interpolant through these positions and
+    velocities. A planner's sampled acceleration is not used: TOPP-RA's is
+    piecewise constant, and a point sample of it can sit on either side of a
+    switch;
+  * rest points are exactly at rest: velocity 0 at the first and the last point
+    of a goal; velocity and acceleration 0 at both ends of a hold (consecutive
+    points with the same positions) and at the seam of a two-phase leg (umarell
+    times transit and approach rest-to-rest each), so holds stay stationary and
+    consecutive goals join without a velocity jump. A two-point move is a
+    minimum-jerk rest-to-rest quintic.
+
+The curve passes through every point at its time; between points it is what the
+timed trajectory's own interpolating spline would be. It does not change the
+timing: a timing that is infeasible stays infeasible.
+
+``sample`` is the controller side: JTC's ``splines`` interpolation of such
+points, used by the simulated controllers so that what a simulation shows is
+what the hardware controller will command.
+
+Pure Python + numpy, no ROS import: unit-testable on a bare host.
+"""
+from __future__ import annotations
+
+from typing import Optional, Sequence
+
+# A segment whose every joint moves less than this (rad) is a hold. Plans store
+# positions rounded to 1e-6 rad, so a hold is an exact repeat.
+REST_TOL_RAD = 1e-9
+# Segments shorter than this (s) carry no slope information.
+_MIN_DT_S = 1e-9
+
+
+def _arr(rows, n: int):
+    import numpy as np
+    out = np.zeros((len(rows), n))
+    for i, r in enumerate(rows):
+        r = [float(v) for v in list(r)[:n]]
+        out[i, :len(r)] = r
+    return out
+
+
+def _given(points: Sequence[dict], key: str, n: int):
+    """The ``key`` field of every point as an (N, n) array, or None unless every
+    point carries a list of at least ``n`` values."""
+    rows = [p.get(key) for p in points]
+    if not rows or any(r is None or len(r) < n for r in rows):
+        return None
+    return _arr(rows, n)
+
+
+def rest_masks(times, positions):
+    """(rest, still) boolean masks over the points.
+
+    ``rest``: velocity 0 there: the first and the last point, and both ends of a
+    segment with no motion (a hold) or of zero duration.
+    ``still``: acceleration 0 as well: both ends of such a segment, so the hold
+    is stationary.
+    """
+    import numpy as np
+    t = np.asarray(times, float)
+    q = np.asarray(positions, float)
+    n = len(t)
+    rest = np.zeros(n, bool)
+    still = np.zeros(n, bool)
+    if n == 0:
+        return rest, still
+    rest[0] = rest[-1] = True
+    if n == 1:
+        still[0] = True
+    else:
+        seg = (np.abs(np.diff(q, axis=0)).max(axis=1) <= REST_TOL_RAD) | (np.diff(t) <= _MIN_DT_S)
+        still[:-1] |= seg
+        still[1:] |= seg
+        rest |= still
+    return rest, still
+
+
+def _slopes(t, q):
+    import numpy as np
+    h = np.diff(t)
+    ok = h > _MIN_DT_S
+    s = np.zeros((len(h), q.shape[1]))
+    s[ok] = np.diff(q, axis=0)[ok] / h[ok][:, None]
+    return h, s
+
+
+def _spline_velocities(t, q, rest):
+    """Knot velocities of the C2 cubic spline through (t, q), clamped to 0 at
+    the rest points (each run between rests is solved on its own)."""
+    import numpy as np
+    n = len(t)
+    v = np.zeros_like(q)
+    if n < 3:
+        return v
+    h, s = _slopes(t, q)
+    idx = np.flatnonzero(rest)
+    for i0, i1 in zip(idx[:-1], idx[1:]):
+        m = i1 - i0                      # segments in the run; unknowns v[i0+1 .. i1-1]
+        if m < 2:
+            continue
+        # h_i v_{i-1} + 2 (h_{i-1} + h_i) v_i + h_{i-1} v_{i+1} = 3 (h_i s_{i-1} + h_{i-1} s_i)
+        k = np.arange(i0 + 1, i1)
+        sub = h[k]                       # coefficient of v_{i-1}
+        diag = 2.0 * (h[k - 1] + h[k])
+        sup = h[k - 1]                   # coefficient of v_{i+1}
+        rhs = 3.0 * (h[k][:, None] * s[k - 1] + h[k - 1][:, None] * s[k])
+        cp = np.zeros(len(k))
+        dp = np.zeros((len(k), q.shape[1]))
+        for j in range(len(k)):          # Thomas algorithm (diagonally dominant)
+            den = diag[j] - (sub[j] * cp[j - 1] if j else 0.0)
+            cp[j] = sup[j] / den
+            dp[j] = (rhs[j] - (sub[j] * dp[j - 1] if j else 0.0)) / den
+        for j in range(len(k) - 1, -1, -1):
+            v[k[j]] = dp[j] - (cp[j] * v[k[j] + 1] if j < len(k) - 1 else 0.0)
+    return v
+
+
+def _knot_accelerations(t, q, v):
+    """Acceleration at each knot of the cubic Hermite curve through (t, q, v):
+    the mean of the two adjacent segments' end values (they are equal where the
+    curve is C2, e.g. for the spline velocities)."""
+    import numpy as np
+    n = len(t)
+    a = np.zeros_like(q)
+    if n < 2:
+        return a
+    h, s = _slopes(t, q)
+    hs = np.where(h > _MIN_DT_S, h, 1.0)[:, None]
+    left = (6.0 * s - 4.0 * v[:-1] - 2.0 * v[1:]) / hs      # at the start of segment i
+    right = (-6.0 * s + 2.0 * v[:-1] + 4.0 * v[1:]) / hs    # at the end of segment i
+    a[0] = left[0]
+    a[-1] = right[-1]
+    if n > 2:
+        a[1:-1] = 0.5 * (right[:-1] + left[1:])
+    return a
+
+
+# The planner's velocities are forwarded unless the command they give is more
+# than 20 % rougher (peak per-cycle acceleration, any joint; + 1e-3 rad/s^2) than
+# the spline's. Measured on 216 random TOPP-RA legs: the exact velocities pass on
+# 210 (they sample a bang-bang acceleration, so they are not always the
+# smoothest); copies re-timed by >= 5 % without scaling their velocities never.
+_ROUGHER_OK = 1.2
+_ROUGH_FLOOR = 1e-3
+
+# Two points this close in time (fraction of the median spacing) and in joint
+# space are not fitted separately: the slope between them is position rounding.
+_KNOT_DT_FRAC = 0.5
+_KNOT_DQ_RAD = 1e-4
+
+
+def _knots(times, positions, must=None):
+    """Indices of the points the curve is fitted to.
+
+    A point that follows the previous fitted one by less than half the median
+    spacing AND by less than 1e-4 rad on every joint is skipped: the slope
+    between them is mostly position rounding (plans round to 1e-6 rad, and
+    TOPP-RA's last sample of a phase lands anywhere from 0 to 50 ms after the
+    one before it, where the arm is nearly at rest). The last point and the
+    ``must`` points (rests) are always fitted, in place of a skippable fitted
+    point just before them. Skipped points get the curve's derivatives.
+    """
+    import numpy as np
+    t = np.asarray(times, float)
+    q = np.asarray(positions, float)
+    n = len(t)
+    if n < 3:
+        return np.arange(n)
+    must = np.zeros(n, bool) if must is None else np.asarray(must, bool).copy()
+    must[0] = must[-1] = True
+    h = np.diff(t)
+    pos = h[h > _MIN_DT_S]
+    thr = _KNOT_DT_FRAC * float(np.median(pos)) if len(pos) else 0.0
+
+    def close(i, j):
+        return t[i] - t[j] < thr and float(np.abs(q[i] - q[j]).max()) < _KNOT_DQ_RAD
+
+    keep = [0]
+    for i in range(1, n):
+        c = close(i, keep[-1])
+        if not must[i]:
+            if not c:
+                keep.append(i)
+        elif c and not must[keep[-1]]:
+            keep[-1] = i
+        else:
+            keep.append(i)
+    return np.asarray(keep)
+
+
+def _hermite_at(tk, qk, vk, t):
+    """(velocity, acceleration) at times ``t`` of the cubic Hermite curve
+    through the knots (tk, qk, vk)."""
+    import numpy as np
+    i = np.clip(np.searchsorted(tk, t, side="right") - 1, 0, len(tk) - 2)
+    T = np.maximum(tk[i + 1] - tk[i], _MIN_DT_S)[:, None]
+    x = (t - tk[i])[:, None]
+    p0, p1, v0, v1 = qk[i], qk[i + 1], vk[i], vk[i + 1]
+    c2 = (-3 * p0 + 3 * p1 - 2 * v0 * T - v1 * T) / T ** 2
+    c3 = (2 * p0 - 2 * p1 + v0 * T + v1 * T) / T ** 3
+    return v0 + 2 * c2 * x + 3 * c3 * x ** 2, 2 * c2 + 6 * c3 * x
+
+
+def cycle_accelerations(times, positions, velocities, accelerations, cycle: float = 0.004):
+    """Per-joint peak |acceleration| that joint_trajectory_controller asks of the
+    drive: its quintic interpolation of the points sampled every ``cycle`` s
+    (plus the hold after the last point), second differences. (dof,) array."""
+    import numpy as np
+    t = np.asarray(times, float)
+    q = np.asarray(positions, float)
+    if len(t) < 2:
+        return np.zeros(q.shape[1])
+    v = np.asarray(velocities, float)
+    a = np.asarray(accelerations, float)
+    g = t[0] + cycle * np.arange(int((t[-1] - t[0]) / cycle) + 3)
+    i = np.clip(np.searchsorted(t, g, side="right") - 1, 0, len(t) - 2)
+    T = np.maximum(t[i + 1] - t[i], _MIN_DT_S)[:, None]
+    x = np.minimum(g - t[i], t[i + 1] - t[i])[:, None]
+    p0, p1, v0, v1, a0, a1 = q[i], q[i + 1], v[i], v[i + 1], a[i], a[i + 1]
+    c3 = (-20 * p0 + 20 * p1 - 3 * a0 * T ** 2 + a1 * T ** 2 - 12 * v0 * T - 8 * v1 * T) / (2 * T ** 3)
+    c4 = (30 * p0 - 30 * p1 + 3 * a0 * T ** 2 - 2 * a1 * T ** 2 + 16 * v0 * T + 14 * v1 * T) / (2 * T ** 4)
+    c5 = (-12 * p0 + 12 * p1 - a0 * T ** 2 + a1 * T ** 2 - 6 * v0 * T - 6 * v1 * T) / (2 * T ** 5)
+    Q = p0 + x * (v0 + x * (0.5 * a0 + x * (c3 + x * (c4 + x * c5))))
+    Q[g >= t[-1]] = q[-1]
+    if len(Q) < 3:
+        return np.zeros(q.shape[1])
+    return np.abs(np.diff(Q, 2, axis=0)).max(axis=0) / cycle ** 2
+
+
+def estimate_derivatives(times, positions, velocities=None, rests=None):
+    """(velocities, accelerations) as (N, dof) arrays for a timed path.
+
+    The curve is fitted to the knots of ``_knots`` (every point except one that
+    follows the previous knot closely at rounding-level displacement) and
+    evaluated at every point.
+
+    Velocities: the planner's (``velocities``), unless the command they give is
+    rougher than the C2 cubic spline's through the positions: its peak
+    per-cycle acceleration (``cycle_accelerations``) more than 20 % above the
+    spline's on some joint. Exact derivatives of the timing pass; velocities
+    that do not belong to it (e.g. a copy re-timed without scaling them) bend
+    the curve between the points and are replaced by the spline's.
+    Accelerations: those of the C2 interpolant through the positions and the
+    chosen velocities. Rest points per ``rest_masks``; a run with a single
+    moving segment (a two-point move) is a minimum-jerk quintic (zero
+    acceleration at both ends). ``rests`` (bool per point, optional) marks
+    further points where the timing itself is at rest (e.g. the seam of a
+    two-phase leg, timed rest-to-rest on each side): velocity and acceleration
+    0 there, and the spline is clamped there.
+    """
+    import numpy as np
+    t = np.asarray(times, float)
+    q = np.asarray(positions, float)
+    n = len(t)
+    rest, still = rest_masks(t, q)
+    if rests is not None:
+        rests = np.asarray(rests, bool)
+        rest |= rests
+        still |= rests
+    if n >= 2:
+        idx = np.flatnonzero(rest)
+        single = idx[np.flatnonzero(np.diff(idx) == 1)]
+        still[single] = True             # both ends of a one-segment run
+        still[single + 1] = True
+    k = _knots(t, q, rest)
+    tk, qk = t[k], q[k]
+    rest_k = rest_masks(tk, qk)[0] | rest[k]
+    dropped = np.setdiff1d(np.arange(n), k)
+
+    def curve(vk):
+        vk = np.where(rest_k[:, None], 0.0, vk)
+        v = np.zeros_like(q)
+        a = np.zeros_like(q)
+        v[k] = vk
+        a[k] = _knot_accelerations(tk, qk, vk)
+        if len(dropped):
+            v[dropped], a[dropped] = _hermite_at(tk, qk, vk, t[dropped])
+        v[rest] = 0.0
+        a[still] = 0.0
+        return v, a
+
+    v, a = curve(_spline_velocities(tk, qk, rest_k))
+    if velocities is not None and n >= 2:
+        vg, ag = curve(np.asarray(velocities, float)[k])
+        if np.all(cycle_accelerations(t, q, vg, ag)
+                  <= _ROUGHER_OK * cycle_accelerations(t, q, v, a) + _ROUGH_FLOOR):
+            v, a = vg, ag
+    return v, a
+
+
+def timing_rests(points: Sequence[dict], use_velocities: bool = True):
+    """Interior points where the timing is known to be at rest: the last point of
+    a ``phase`` (umarell times each phase of a two-phase leg rest-to-rest:
+    transit, then approach) and, with ``use_velocities``, points whose planner
+    velocity is exactly 0 on every joint. Bool list."""
+    n = len(points)
+    out = [False] * n
+    for i in range(1, n - 1):
+        ph, nxt = points[i].get("phase"), points[i + 1].get("phase")
+        vel = points[i].get("velocities") if use_velocities else None
+        if (ph is not None and nxt is not None and ph != nxt) or (vel and not any(vel)):
+            out[i] = True
+    return out
+
+
+def with_derivatives(trajectory: Sequence[dict], n_joints: Optional[int] = None,
+                     time_key: str = "time_s") -> list[dict]:
+    """Copies of the points with ``positions`` (padded with 0.0 to ``n_joints``),
+    ``velocities`` and ``accelerations`` from ``estimate_derivatives``; every
+    other key is kept."""
+    import numpy as np
+    pts = list(trajectory)
+    if not pts:
+        return []
+    n = int(n_joints) if n_joints else max(len(p["positions"]) for p in pts)
+    t = np.array([float(p.get(time_key, 0.0)) for p in pts])
+    q = _arr([p["positions"] for p in pts], n)
+    vg = _given(pts, "velocities", n)
+    if vg is not None and not np.any(vg):
+        vg = None                        # all-zero placeholders (the old goal format) carry no timing
+    v, a = estimate_derivatives(t, q, vg, timing_rests(pts, use_velocities=vg is not None))
+    out = []
+    for i, p in enumerate(pts):
+        d = dict(p)
+        d["positions"] = [float(x) for x in q[i]]
+        d["velocities"] = [round(float(x), 9) for x in v[i]]
+        d["accelerations"] = [round(float(x), 9) for x in a[i]]
+        out.append(d)
+    return out
+
+
+def scale_time(trajectory: Sequence[dict], velocity_scale: float,
+               time_key: str = "time_s") -> list[dict]:
+    """A copy slowed down by ``velocity_scale`` (> 0): times divided by it,
+    velocities multiplied by it, accelerations by its square. Same path."""
+    k = float(velocity_scale)
+    out = []
+    for p in trajectory:
+        d = dict(p)
+        if k > 0 and k != 1.0:
+            if time_key in d:
+                d[time_key] = float(d[time_key]) / k
+            if d.get("velocities"):
+                d["velocities"] = [float(x) * k for x in d["velocities"]]
+            if d.get("accelerations"):
+                d["accelerations"] = [float(x) * k * k for x in d["accelerations"]]
+        out.append(d)
+    return out
+
+
+def fjt_points(trajectory: Sequence[dict], velocity_scale: float = 1.0,
+               n_joints: int = 6) -> list[dict]:
+    """What a FollowJointTrajectory goal should carry for ``trajectory``:
+    ``[{"positions", "velocities", "accelerations", "time_s"}]``, with
+    ``time_s`` already divided by ``velocity_scale``."""
+    return [{"positions": p["positions"], "velocities": p["velocities"],
+             "accelerations": p["accelerations"], "time_s": float(p["time_s"])}
+            for p in with_derivatives(scale_time(trajectory, velocity_scale), n_joints)]
+
+
+# ── Controller side: JTC "splines" interpolation ─────────────────────────────
+
+def segment_mode(p0: dict, p1: dict) -> str:
+    """JTC's choice for the segment p0 -> p1, by the fields BOTH points carry."""
+    if p0.get("velocities") and p1.get("velocities"):
+        return "quintic" if (p0.get("accelerations") and p1.get("accelerations")) else "cubic"
+    return "linear"
+
+
+def _segment(p0, v0, a0, p1, v1, a1, T, x, mode):
+    """(q, qd, qdd) at time x in [0, T] of one segment (lists of floats).
+    Polynomial coefficients as in joint_trajectory_controller's trajectory.cpp."""
+    q, qd, qdd = [], [], []
+    for k in range(len(p0)):
+        if mode == "linear":
+            c = (p0[k], (p1[k] - p0[k]) / T, 0.0, 0.0, 0.0, 0.0)
+        elif mode == "cubic":
+            c = (p0[k], v0[k],
+                 (-3 * p0[k] + 3 * p1[k] - 2 * v0[k] * T - v1[k] * T) / T ** 2,
+                 (2 * p0[k] - 2 * p1[k] + v0[k] * T + v1[k] * T) / T ** 3, 0.0, 0.0)
+        else:
+            c = (p0[k], v0[k], 0.5 * a0[k],
+                 (-20 * p0[k] + 20 * p1[k] - 3 * a0[k] * T ** 2 + a1[k] * T ** 2
+                  - 12 * v0[k] * T - 8 * v1[k] * T) / (2 * T ** 3),
+                 (30 * p0[k] - 30 * p1[k] + 3 * a0[k] * T ** 2 - 2 * a1[k] * T ** 2
+                  + 16 * v0[k] * T + 14 * v1[k] * T) / (2 * T ** 4),
+                 (-12 * p0[k] + 12 * p1[k] - a0[k] * T ** 2 + a1[k] * T ** 2
+                  - 6 * v0[k] * T - 6 * v1[k] * T) / (2 * T ** 5))
+        q.append(c[0] + x * (c[1] + x * (c[2] + x * (c[3] + x * (c[4] + x * c[5])))))
+        qd.append(c[1] + x * (2 * c[2] + x * (3 * c[3] + x * (4 * c[4] + x * 5 * c[5]))))
+        qdd.append(2 * c[2] + x * (6 * c[3] + x * (12 * c[4] + x * 20 * c[5])))
+    return q, qd, qdd
+
+
+def sample(points: Sequence[dict], t: float, time_key: str = "t"):
+    """Commanded (positions, velocities, accelerations) at time ``t`` of a goal's
+    points, as ros2_control's joint_trajectory_controller interpolates them
+    (``interpolation_method: splines``). Before the first point: the first point;
+    after the last point: the last point, at rest.
+    """
+    if not points:
+        return [], [], []
+    n = len(points[0]["positions"])
+    zero = [0.0] * n
+    first, last = points[0], points[-1]
+    if t <= float(first[time_key]):
+        return (list(first["positions"]), list(first.get("velocities") or zero),
+                list(first.get("accelerations") or zero))
+    if t >= float(last[time_key]):
+        return list(last["positions"]), zero, zero
+    lo, hi = 0, len(points) - 1
+    while hi - lo > 1:                   # t0 <= t < t1
+        mid = (lo + hi) // 2
+        if float(points[mid][time_key]) <= t:
+            lo = mid
+        else:
+            hi = mid
+    p0, p1 = points[lo], points[hi]
+    T = float(p1[time_key]) - float(p0[time_key])
+    if T <= _MIN_DT_S:
+        return (list(p1["positions"]), list(p1.get("velocities") or zero),
+                list(p1.get("accelerations") or zero))
+    return _segment(p0["positions"], p0.get("velocities") or zero, p0.get("accelerations") or zero,
+                    p1["positions"], p1.get("velocities") or zero, p1.get("accelerations") or zero,
+                    T, t - float(p0[time_key]), segment_mode(p0, p1))
