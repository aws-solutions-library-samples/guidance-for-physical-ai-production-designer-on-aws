+        "builtin_interfaces.msg": m("builtin_interfaces.msg",
+                                    Duration=lambda sec=0, nanosec=0: _Msg(sec=sec, nanosec=nanosec)),
+        "sensor_msgs": m("sensor_msgs"),
+        "sensor_msgs.msg": m("sensor_msgs.msg", JointState=_Msg),
+        "std_msgs": m("std_msgs"),
+        "std_msgs.msg": m("std_msgs.msg", String=_Msg, Bool=_Msg),
+    }
+
+
+@pytest.fixture
+def ros_stubs():
+    with patch.dict(sys.modules, _stub_modules()):
+        SENT.clear()
+        yield
+
+
+def _load(rel):
+    spec = importlib.util.spec_from_file_location(f"_t_{Path(rel).stem}", ROOT / rel)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _leg(T=2.0, dt=0.05):
+    ts = np.append(np.arange(0.0, T, dt), T)
+    x = ts / T
+    s = 10 * x ** 3 - 15 * x ** 4 + 6 * x ** 5
+    amp = np.array([0.8, -0.5, 0.3, 1.2, -0.9, 2.0])
+    return [{"positions": [float(v) for v in s[i] * amp], "time_s": float(ts[i])}
+            for i in range(len(ts))]
+
+
+def _points(goal):
+    return [{"t": p.time_from_start.sec + p.time_from_start.nanosec * 1e-9,
+             "positions": list(p.positions), "velocities": list(p.velocities),
+             "accelerations": list(p.accelerations)} for p in goal.trajectory.points]
+
+
+def _moving_interior(points):
+    return [p for p in points[1:-1]]
+
+
+def test_robot_agent_goal_carries_the_timing_derivatives(ros_stubs):
+    from agents.robot import robot_agent
+    goal = robot_agent._build_fjt_goal(_leg())
+    pts = _points(goal)
+    assert pts[0]["velocities"] == [0.0] * 6 and pts[-1]["velocities"] == [0.0] * 6
+    assert all(any(abs(v) > 1e-4 for v in p["velocities"]) for p in _moving_interior(pts))
+    assert all(len(p["accelerations"]) == 6 for p in pts)
+    assert pts[-1]["t"] == pytest.approx(2.0, abs=1e-6)
+
+
+def test_robot_agent_velocity_scale_scales_the_derivatives(ros_stubs):
+    from agents.robot import robot_agent
+    from utils.fjt_trajectory import scale_time
+    full = _points(robot_agent._build_fjt_goal(_leg()))
+    half = _points(robot_agent._build_fjt_goal(scale_time(_leg(), 0.5)))
+    assert half[-1]["t"] == pytest.approx(2 * full[-1]["t"], abs=1e-6)
+    for f, h in zip(full, half):
+        assert np.allclose(h["velocities"], 0.5 * np.asarray(f["velocities"]), atol=1e-7)
+
+
+def test_ros2_control_driver_forwards_scaled_derivatives(ros_stubs):
+    from agents.robot.drivers.ros2_control_driver import Ros2ControlDriver
+    drv = Ros2ControlDriver(object(), "/x/follow_joint_trajectory")
+    r = drv.execute_trajectory(_leg(), [f"j{i}" for i in range(6)], velocity_scale=0.5)
+    assert r["success"]
+    pts = _points(SENT[-1])
+    assert pts[-1]["t"] == pytest.approx(4.0, abs=1e-6)
+    assert all(any(abs(v) > 1e-4 for v in p["velocities"]) for p in _moving_interior(pts))
+    peak = max(max(abs(v) for v in p["velocities"]) for p in pts)
+    assert peak == pytest.approx(0.5 * 1.875 * 2.0 / 2.0, rel=0.02)    # smoothstep peak, A6 amp 2.0
+
+
+def test_sim_controller_follows_jtc_and_does_not_teleport(ros_stubs):
+    pc = _load("controller/pinocchio_robot_controller.py")
+    start = [0.0] * 6
+    target = [0.6, -0.4, 0.2, 0.5, -0.3, 0.8]
+    pts = pc._prepare_points([{"positions": target, "velocities": [0.0] * 6,
+                               "accelerations": [0.0] * 6, "t": 2.5}], start)
+    q0, _v0 = pc._sample_trajectory(pts, 0.0)
+    q_mid, v_mid = pc._sample_trajectory(pts, 1.25)
+    q_end, v_end = pc._sample_trajectory(pts, 3.0)
+    assert q0 == start
+    assert np.allclose(q_mid, 0.5 * np.asarray(target), atol=1e-9)        # min-jerk midpoint
+    assert np.allclose(v_mid, 1.875 * np.asarray(target) / 2.5, atol=1e-9)
+    assert q_end == target and v_end == [0.0] * 6
+
+
+def test_sim_controller_reproduces_stop_and_go_for_zero_velocities(ros_stubs):
+    """What a client sending zero velocities gets on hardware, the sim now shows."""
+    pc = _load("controller/pinocchio_robot_controller.py")
+    pts = pc._prepare_points([{"positions": [0.0] * 6, "velocities": [0.0] * 6, "t": 0.0},
+                              {"positions": [0.1] * 6, "velocities": [0.0] * 6, "t": 0.05},
+                              {"positions": [0.2] * 6, "velocities": [0.0] * 6, "t": 0.10}], [0.0] * 6)
+    _q, v = pc._sample_trajectory(pts, 0.05)
+    assert v == [0.0] * 6
+
+
+def test_isaac_stream_lasts_as_long_as_the_goal(ros_stubs):
+    from agents.robot import robot_agent
+    ic = _load("controller/isaac_sim_controller.py")
+    goal = robot_agent._build_fjt_goal(_leg(T=2.0))
+    dense = ic._interpolate_trajectory([0.0] * 6, goal.trajectory.points, 50.0)
+    assert len(dense) == 100                      # 2.0 s at 50 Hz (was 80: 40 ms per 50 ms segment)
+    assert np.allclose(dense[-1], goal.trajectory.points[-1].positions)
