+def prompt_cache_ttl() -> str:
+    """umarell-fast U1 (patch U1_02): ``LLM_PROMPT_CACHE=1h`` (or ``60m`` / ``3600``) selects the
+    1-hour cache TTL; any other "on" value keeps the 5-minute default. A long ReAct turn (a slow
+    planner call) can outlive 5 minutes, after which the next turn re-writes the whole prefix."""
+    v = (os.environ.get("LLM_PROMPT_CACHE") or "").strip().lower()
+    return "1h" if v in ("1h", "60m", "3600") else "5m"
+
+
+def reasoning_effort() -> Optional[str]:
+    """umarell-fast U1 (patch U1_02): ``LLM_EFFORT``, the Claude ``output_config.effort`` level
+    (low/medium/high/xhigh/max) with adaptive thinking; unset / empty = model default (no thinking
+    fields sent)."""
+    v = (os.environ.get("LLM_EFFORT") or "").strip().lower()
+    return v or None
+
+
