(*
 * FB_JointAngleEncoder
 * Device simulator R1 (robot1), cell welding_cell_2_small. Generated by bt2plc 0.1.0.
 *
 * Encodes six KUKA robot joint angles (REAL degrees) into the VASS Option area
 * as scaled fixed-point INTs (0.02 deg per count, big-endian byte order).
 *
 * Encoding per encoding.md:
 *   count = ROUND(angle_deg / 0.02)   clamped to [-32768, +32767]
 *   Byte layout: big-endian (high byte first) in each 2-byte pair
 *
 * Output abyOption = Option area aVassInputData[16..27], 2 bytes per axis
 * (PLC_PRG copies it into the robot -> PLC telegram):
 *   abyOption[0-1]  = bytes 16-17 = A1,  abyOption[2-3]   = bytes 18-19 = A2,
 *   abyOption[4-5]  = bytes 20-21 = A3,  abyOption[6-7]   = bytes 22-23 = A4,
 *   abyOption[8-9]  = bytes 24-25 = A5,  abyOption[10-11] = bytes 26-27 = A6
 *)

FUNCTION_BLOCK FB_JointAngleEncoder
VAR_INPUT
    rA1_deg     : REAL := 0.0;      (* Axis 1 angle in degrees *)
    rA2_deg     : REAL := 0.0;      (* Axis 2 angle in degrees *)
    rA3_deg     : REAL := 0.0;      (* Axis 3 angle in degrees *)
    rA4_deg     : REAL := 0.0;      (* Axis 4 angle in degrees *)
    rA5_deg     : REAL := 0.0;      (* Axis 5 angle in degrees *)
    rA6_deg     : REAL := 0.0;      (* Axis 6 angle in degrees *)
END_VAR

VAR_OUTPUT
    (* Encoded INT values (for monitoring/debug) *)
    iA1_count   : INT;
    iA2_count   : INT;
    iA3_count   : INT;
    iA4_count   : INT;
    iA5_count   : INT;
    iA6_count   : INT;

    (* Option area bytes 16..27 of the robot -> PLC telegram, big-endian A1..A6 *)
    abyOption   : ARRAY[0..11] OF BYTE;
END_VAR

VAR CONSTANT
    SCALE_FACTOR    : REAL := 0.02;     (* degrees per count *)
    INV_SCALE       : REAL := 50.0;     (* 1/0.02 = 50, multiply for speed *)
    COUNT_MAX       : DINT := 32767;
    COUNT_MIN       : DINT := -32768;
END_VAR

VAR
    _arDeg      : ARRAY[1..6] OF REAL;
    _aiCount    : ARRAY[1..6] OF INT;
    _diTemp     : DINT;
    _wTemp      : WORD;
    _i          : INT;
END_VAR
