(*
 * ST_VASS_OutputTelegram
 * Full VASS output telegram - 32 bytes (PLC -> robot), Slot 2 DIO256 outputs.
 * bt2plc use: bytes 4-5 PLAN_ID WORD LE during a production job (GVL_Program.PLAN_ID_BYTE),
 *             bytes 12-15 zone GRANT DWORD LE (GVL_Program.GRANT_BYTE).
 * Device simulator R1 (robot1), cell welding_cell_2_small. Generated by bt2plc 0.1.0.
 *)

TYPE ST_VASS_OutputTelegram :
STRUCT
    stControlWord       : ST_VASS_ControlWord;    (* Bytes 0-1:   Control word *)
    wJobNr              : WORD;                   (* Bytes 2-3:   Requested job number *)
    wParameter1         : WORD;                   (* Bytes 4-5:   Parameter 1 *)
    wParameter2         : WORD;                   (* Bytes 6-7:   Parameter 2 *)
    wSpeedOverride      : WORD;                   (* Bytes 8-9:   Speed override % *)
    wToolRequest        : WORD;                   (* Bytes 10-11: Tool change request *)
    wUserWord6          : WORD;                   (* Bytes 12-13: User command data *)
    wUserWord7          : WORD;                   (* Bytes 14-15: User command data *)
    wUserWord8          : WORD;                   (* Bytes 16-17: User command data *)
    wUserWord9          : WORD;                   (* Bytes 18-19: User command data *)
    wUserWord10         : WORD;                   (* Bytes 20-21: User command data *)
    wUserWord11         : WORD;                   (* Bytes 22-23: User command data *)
    wUserWord12         : WORD;                   (* Bytes 24-25: User command data *)
    wUserWord13         : WORD;                   (* Bytes 26-27: User command data *)
    wUserWord14         : WORD;                   (* Bytes 28-29: User command data *)
    wUserWord15         : WORD;                   (* Bytes 30-31: User command data *)
END_STRUCT
END_TYPE
