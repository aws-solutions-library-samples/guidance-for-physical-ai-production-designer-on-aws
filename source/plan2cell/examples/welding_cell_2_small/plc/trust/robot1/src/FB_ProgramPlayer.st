(*
 * FB_ProgramPlayer
 * Device simulator R1 (robot1), cell welding_cell_2_small, tree bt_1790934549_welding_cell_2_small. Generated by bt2plc 0.1.0.
 *
 * Plays the bt2plc robot program (GVL_Program) for PROD_FOLGE, or a blind joint
 * move to the home pose for HOME_FOLGE. Robot side of the zone protocol, per op k
 * with mask M = GVL_Program.aOps[k].dwZoneMask:
 *   1  wStep := k                          (also for M = 0)
 *   2  if M <> 0: REQUEST := M             (same call / telegram as wStep)
 *   3  if M <> 0: wait (GRANT AND M) = M
 *   4  start delay; trajectory (x rVelScale x override); hold
 *   5  if M <> 0: REQUEST := 0
 *   6  if M <> 0: wait (GRANT AND M) = 0   (4-phase, before the next REQUEST)
 *   7  next op; after the last op: bDone, wStep := 0 (same call)
 *
 * Timing: all times are REAL seconds accumulated from rDt (seconds per call, the
 * device task interval). Motion time advances by rDt * rRate * rVelScale, delay and
 * hold by rDt (the override does not scale dwell times). No TIME() / TON is used.
 * Zero-time transitions fall through within one call (at most N_MAX_TRANSITIONS),
 * but wStep changes at most once per call, so every step is visible to the head PLC.
 * Joints (deg) are linearly interpolated between waypoints and published as rA1..rA6_deg.
 * Abort (bAbort level while busy): REQUEST := 0, wStep := 0, the pose is held.
 * The robot powers up at GVL_Program.arHomeDeg.
 *)

FUNCTION_BLOCK FB_ProgramPlayer
VAR_INPUT
    bStart          : BOOL;                 (* Rising edge: start wJob *)
    wJob            : WORD;                 (* Folge to play: PROD_FOLGE or HOME_FOLGE *)
    bAbort          : BOOL;                 (* Level: stop / cancel / drives off / E-stop *)
    dwGrant         : DWORD;                (* Zone GRANT bits from the head PLC *)
    rRate           : REAL := 1.0;          (* Speed override factor (1.0 = 100 %) *)
    rDt             : REAL := 0.02;         (* Seconds per call (task interval) *)
END_VAR

VAR_OUTPUT
    eState          : E_PlayerState;        (* Current state *)
    bBusy           : BOOL;                 (* Program running *)
    bDone           : BOOL;                 (* Latched until next start *)
    bError          : BOOL;                 (* Latched until next start *)
    wErrorCode      : WORD;                 (* Error code, GVL_Program.ERR_xxx *)
    wWarningCode    : WORD;                 (* Warning code, GVL_Program.WARN_xxx, latched until next start *)
    wStep           : WORD;                 (* 1-based op index, 0 = none *)
    dwRequest       : DWORD;                (* Zone REQUEST bits to the head PLC *)
    bAtHome         : BOOL;                 (* All joints within R_AT_HOME_TOL_DEG of arHomeDeg *)
    rA1_deg         : REAL;                 (* Axis 1 angle *)
    rA2_deg         : REAL;                 (* Axis 2 angle *)
    rA3_deg         : REAL;                 (* Axis 3 angle *)
    rA4_deg         : REAL;                 (* Axis 4 angle *)
    rA5_deg         : REAL;                 (* Axis 5 angle *)
    rA6_deg         : REAL;                 (* Axis 6 angle *)
END_VAR

VAR CONSTANT
    N_MAX_TRANSITIONS : INT := 8;           (* Fall-through bound per call *)
END_VAR

VAR
    _eState         : E_PlayerState := E_PlayerState#PS_IDLE;
    _rtrigStart     : R_TRIG;
    _bFirstCall     : BOOL := TRUE;

    (* === Current op === *)
    _nOp            : INT;                  (* 1-based op index, 0 = HOME_FOLGE move *)
    _dwMask         : DWORD;                (* Zone mask of the current op *)
    _bHomeMove      : BOOL;                 (* Current move is a blind home move *)
    _nWp            : INT;                  (* Current waypoint segment start *)
    _nLast          : INT;                  (* Last waypoint of the current op, 0 = none *)
    _rVel           : REAL;                 (* Velocity scale of the current move *)

    (* === Time (s) === *)
    _rDtCall        : REAL;                 (* rDt limited to 0..1 s *)
    _rRateCall      : REAL;                 (* rRate limited to >= 0 *)
    _rT             : REAL;                 (* Motion time since move start *)
    _rTimer         : REAL;                 (* Delay / hold timer *)
    _rDur           : REAL;                 (* Duration of the blind home move *)
    _rAlpha         : REAL;                 (* Interpolation factor 0..1 *)
    _rSpan          : REAL;                 (* Waypoint segment duration *)

    (* === Pose (deg) === *)
    _arQ            : ARRAY[1..6] OF REAL;  (* Current joint angles *)
    _arQ0           : ARRAY[1..6] OF REAL;  (* Pose at the start of a blind home move *)
    _arQa           : ARRAY[1..6] OF REAL;  (* Segment start waypoint *)
    _arQb           : ARRAY[1..6] OF REAL;  (* Segment end waypoint *)

    (* === Fall-through === *)
    _nPass          : INT;
    _bAdvance       : BOOL;                 (* A transition happened in this pass *)
    _bStepSet       : BOOL;                 (* wStep changed in this call *)
    _bMoveDone      : BOOL;
    _i              : INT;
END_VAR
(*
 * FB_ProgramPlayer - Implementation
 *)

(* ============================================================================
   INIT - the robot powers up at the home pose
   ============================================================================ *)
IF _bFirstCall THEN
    FOR _i := 1 TO 6 DO
        _arQ[_i] := GVL_Program.arHomeDeg[_i];
    END_FOR
    _bFirstCall := FALSE;
END_IF

_rDtCall := LIMIT(0.0, rDt, 1.0);
_rRateCall := MAX(rRate, 0.0);
_rtrigStart(CLK := bStart);

(* ============================================================================
   ABORT - stop / cancel / drives off / E-stop: REQUEST := 0, wStep := 0, hold pose
   ============================================================================ *)
IF bAbort AND bBusy THEN
    _eState := E_PlayerState#PS_IDLE;
    bBusy := FALSE;
    wStep := WORD#0;
    dwRequest := DWORD#0;
END_IF

(* ============================================================================
   CLOCK - advance the timer of the state that is active at the start of the call
   (a state entered during this call starts counting with the next call)
   ============================================================================ *)
IF _eState = E_PlayerState#PS_DELAY OR _eState = E_PlayerState#PS_HOLD THEN
    _rTimer := _rTimer + _rDtCall;
ELSIF _eState = E_PlayerState#PS_MOVE THEN
    _rT := _rT + _rDtCall * _rRateCall * _rVel;
END_IF

(* ============================================================================
   START
   ============================================================================ *)
IF _rtrigStart.Q AND NOT bBusy AND NOT bAbort THEN
    bDone := FALSE;
    bError := FALSE;
    wErrorCode := WORD#0;
    wWarningCode := WORD#0;
    wStep := WORD#0;
    dwRequest := DWORD#0;
    _nOp := 0;
    _dwMask := DWORD#0;
    _rT := 0.0;
    _rTimer := 0.0;
    IF wJob = GVL_Program.HOME_FOLGE THEN
        (* Blind joint move from the current pose to arHomeDeg: no step, no zones *)
        FOR _i := 1 TO 6 DO
            _arQ0[_i] := _arQ[_i];
        END_FOR
        _bHomeMove := TRUE;
        _nLast := 0;
        _rVel := 1.0;
        _rDur := GVL_Program.R_HOME_S;
        bBusy := TRUE;
        _eState := E_PlayerState#PS_MOVE;
    ELSIF wJob = GVL_Program.PROD_FOLGE AND GVL_Program.N_OPS > 0 THEN
        bBusy := TRUE;
        _eState := E_PlayerState#PS_NEXT_OP;
    ELSE
        wErrorCode := GVL_Program.ERR_UNKNOWN_FOLGE;
        _eState := E_PlayerState#PS_ERROR;
    END_IF
END_IF

(* ============================================================================
   STATE MACHINE - falls through zero-time transitions (bounded)
   ============================================================================ *)
_bStepSet := FALSE;
FOR _nPass := 1 TO N_MAX_TRANSITIONS DO
    _bAdvance := FALSE;

    CASE _eState OF

    E_PlayerState#PS_IDLE:
        bBusy := FALSE;
        wStep := WORD#0;
        dwRequest := DWORD#0;

    E_PlayerState#PS_NEXT_OP:
        (* wStep changes at most once per call: the head checks step + 1 per telegram *)
        IF NOT _bStepSet THEN
            _nOp := _nOp + 1;
            IF _nOp > GVL_Program.N_OPS THEN
                _eState := E_PlayerState#PS_DONE;
            ELSE
                wStep := INT_TO_WORD(_nOp);
                _bStepSet := TRUE;
                _dwMask := GVL_Program.aOps[_nOp].dwZoneMask;
                IF _dwMask <> DWORD#0 THEN
                    dwRequest := _dwMask;           (* same telegram as wStep *)
                    _eState := E_PlayerState#PS_WAIT_GRANT;
                ELSE
                    _rTimer := 0.0;
                    _eState := E_PlayerState#PS_DELAY;
                END_IF
            END_IF
            _bAdvance := TRUE;
        END_IF

    E_PlayerState#PS_WAIT_GRANT:
        IF (dwGrant AND _dwMask) = _dwMask THEN
            _rTimer := 0.0;
            _eState := E_PlayerState#PS_DELAY;
            _bAdvance := TRUE;
        END_IF

    E_PlayerState#PS_DELAY:
        IF _rTimer >= GVL_Program.aOps[_nOp].rDelay_s THEN
            (* Begin the motion of op _nOp *)
            _rT := 0.0;
            _rVel := GVL_Program.aOps[_nOp].rVelScale;
            IF _rVel <= 0.0 THEN
                _rVel := 1.0;
            END_IF
            _bHomeMove := GVL_Program.aOps[_nOp].bBlindHome;
            IF _bHomeMove THEN
                FOR _i := 1 TO 6 DO
                    _arQ0[_i] := _arQ[_i];
                END_FOR
                _rDur := GVL_Program.R_HOME_S;
                _nLast := 0;
            ELSE
                _nWp := GVL_Program.aOps[_nOp].nFirstWp;
                _nLast := GVL_Program.aOps[_nOp].nLastWp;
                IF _nWp < 1 OR _nLast < _nWp OR _nLast > GVL_Program.N_WP THEN
                    _nLast := 0;                    (* no valid trajectory: zero-length move *)
                ELSE
                    (* Start deviation: the trajectory should start at the current pose *)
                    _arQa[1] := GVL_Program.aWp[_nWp].rA1;
                    _arQa[2] := GVL_Program.aWp[_nWp].rA2;
                    _arQa[3] := GVL_Program.aWp[_nWp].rA3;
                    _arQa[4] := GVL_Program.aWp[_nWp].rA4;
                    _arQa[5] := GVL_Program.aWp[_nWp].rA5;
                    _arQa[6] := GVL_Program.aWp[_nWp].rA6;
                    FOR _i := 1 TO 6 DO
                        IF ABS(_arQ[_i] - _arQa[_i]) > GVL_Program.R_START_TOL_DEG THEN
                            wWarningCode := GVL_Program.WARN_START_DEVIATION;
                        END_IF
                    END_FOR
                END_IF
            END_IF
            _eState := E_PlayerState#PS_MOVE;
            _bAdvance := TRUE;
        END_IF

    E_PlayerState#PS_MOVE:
        _bMoveDone := FALSE;
        IF _bHomeMove THEN
            (* Blind joint move: linear in joint space over R_HOME_S *)
            IF _rDur > 0.0 THEN
                _rAlpha := LIMIT(0.0, _rT / _rDur, 1.0);
            ELSE
                _rAlpha := 1.0;
            END_IF
            FOR _i := 1 TO 6 DO
                _arQ[_i] := _arQ0[_i] + _rAlpha * (GVL_Program.arHomeDeg[_i] - _arQ0[_i]);
            END_FOR
            _bMoveDone := _rAlpha >= 1.0;
        ELSIF _nLast < 1 THEN
            _bMoveDone := TRUE;
        ELSE
            (* Trajectory: find the segment [_nWp, _nWp + 1] that contains _rT *)
            WHILE _nWp < _nLast DO
                IF GVL_Program.aWp[_nWp + 1].rT <= _rT THEN
                    _nWp := _nWp + 1;
                ELSE
                    EXIT;
                END_IF
            END_WHILE
            _arQa[1] := GVL_Program.aWp[_nWp].rA1;
            _arQa[2] := GVL_Program.aWp[_nWp].rA2;
            _arQa[3] := GVL_Program.aWp[_nWp].rA3;
            _arQa[4] := GVL_Program.aWp[_nWp].rA4;
            _arQa[5] := GVL_Program.aWp[_nWp].rA5;
            _arQa[6] := GVL_Program.aWp[_nWp].rA6;
            IF _nWp >= _nLast THEN
                FOR _i := 1 TO 6 DO
                    _arQ[_i] := _arQa[_i];
                END_FOR
                _bMoveDone := TRUE;
            ELSE
                _arQb[1] := GVL_Program.aWp[_nWp + 1].rA1;
                _arQb[2] := GVL_Program.aWp[_nWp + 1].rA2;
                _arQb[3] := GVL_Program.aWp[_nWp + 1].rA3;
                _arQb[4] := GVL_Program.aWp[_nWp + 1].rA4;
                _arQb[5] := GVL_Program.aWp[_nWp + 1].rA5;
                _arQb[6] := GVL_Program.aWp[_nWp + 1].rA6;
                _rSpan := GVL_Program.aWp[_nWp + 1].rT - GVL_Program.aWp[_nWp].rT;
                IF _rSpan > 0.0 THEN
                    _rAlpha := LIMIT(0.0, (_rT - GVL_Program.aWp[_nWp].rT) / _rSpan, 1.0);
                ELSE
                    _rAlpha := 1.0;
                END_IF
                FOR _i := 1 TO 6 DO
                    _arQ[_i] := _arQa[_i] + _rAlpha * (_arQb[_i] - _arQa[_i]);
                END_FOR
            END_IF
        END_IF
        IF _bMoveDone THEN
            IF _nOp = 0 THEN
                _eState := E_PlayerState#PS_DONE;   (* HOME_FOLGE finished *)
            ELSE
                _rTimer := 0.0;
                _eState := E_PlayerState#PS_HOLD;
            END_IF
            _bAdvance := TRUE;
        END_IF

    E_PlayerState#PS_HOLD:
        IF _rTimer >= GVL_Program.aOps[_nOp].rHold_s THEN
            IF _dwMask <> DWORD#0 THEN
                dwRequest := DWORD#0;
                _eState := E_PlayerState#PS_WAIT_RELEASE;
            ELSE
                _eState := E_PlayerState#PS_NEXT_OP;
            END_IF
            _bAdvance := TRUE;
        END_IF

    E_PlayerState#PS_WAIT_RELEASE:
        (* 4-phase: the GRANT must drop before the next REQUEST *)
        IF (dwGrant AND _dwMask) = DWORD#0 THEN
            _eState := E_PlayerState#PS_NEXT_OP;
            _bAdvance := TRUE;
        END_IF

    E_PlayerState#PS_DONE:
        bBusy := FALSE;
        bDone := TRUE;
        wStep := WORD#0;
        dwRequest := DWORD#0;
        _eState := E_PlayerState#PS_IDLE;

    E_PlayerState#PS_ERROR:
        bBusy := FALSE;
        bError := TRUE;
        wStep := WORD#0;
        dwRequest := DWORD#0;
        _eState := E_PlayerState#PS_IDLE;

    END_CASE

    IF NOT _bAdvance THEN
        EXIT;
    END_IF
END_FOR

(* ============================================================================
   PUBLISH
   ============================================================================ *)
bAtHome := TRUE;
FOR _i := 1 TO 6 DO
    IF ABS(_arQ[_i] - GVL_Program.arHomeDeg[_i]) > GVL_Program.R_AT_HOME_TOL_DEG THEN
        bAtHome := FALSE;
    END_IF
END_FOR
rA1_deg := _arQ[1];
rA2_deg := _arQ[2];
rA3_deg := _arQ[3];
rA4_deg := _arQ[4];
rA5_deg := _arQ[5];
rA6_deg := _arQ[6];
eState := _eState;
END_FUNCTION_BLOCK
