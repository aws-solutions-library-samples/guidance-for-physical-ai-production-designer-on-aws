(*
 * ST_VASS_StatusWord
 * VASS robot status word - input bytes 0-1 (robot -> PLC), Slot 2 DIO256.
 * Device simulator R1 (robot1), cell welding_cell_2_small. Generated by bt2plc 0.1.0.
 *)

TYPE ST_VASS_StatusWord :
STRUCT
    (* Byte 0 *)
    bDrivesPowered      : BOOL;   (* Bit 0: Drives are powered on *)
    bProgRunning        : BOOL;   (* Bit 1: Program is running *)
    bAtHome             : BOOL;   (* Bit 2: Robot at home position *)
    bInPosition         : BOOL;   (* Bit 3: Robot in target position *)
    bModeExt            : BOOL;   (* Bit 4: External automatic mode active *)
    bReady              : BOOL;   (* Bit 5: Robot ready for command *)
    bError              : BOOL;   (* Bit 6: Error present *)
    bWarning            : BOOL;   (* Bit 7: Warning present *)

    (* Byte 1 *)
    bSafetyGateOK       : BOOL;   (* Bit 8: Safety gate closed *)
    bEStopNotActive     : BOOL;   (* Bit 9: E-Stop NOT active (NC logic) *)
    bProgFinished       : BOOL;   (* Bit 10: Program/job finished *)
    bJobAcknowledge     : BOOL;   (* Bit 11: Job number acknowledged *)
    bToolActive         : BOOL;   (* Bit 12: Tool/gripper active *)
    bPartPresent        : BOOL;   (* Bit 13: Part present in gripper *)
    bPeriphReady        : BOOL;   (* Bit 14: Peripheral devices ready *)
    bMaintRequired      : BOOL;   (* Bit 15: Maintenance required *)
END_STRUCT
END_TYPE
