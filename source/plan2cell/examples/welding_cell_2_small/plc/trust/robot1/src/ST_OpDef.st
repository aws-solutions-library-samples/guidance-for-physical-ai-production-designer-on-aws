(*
 * ST_OpDef
 * One op of the bt2plc robot program (row of GVL_Program.aOps).
 * Op k plays waypoints GVL_Program.aWp[nFirstWp..nLastWp] under the zone mask dwZoneMask.
 * Blind home op: bBlindHome = TRUE, nFirstWp = nLastWp = 0 (joint move to arHomeDeg over R_HOME_S).
 * Device simulator R1 (robot1), cell welding_cell_2_small. Generated by bt2plc 0.1.0.
 *)

TYPE ST_OpDef :
STRUCT
    sName           : STRING(32);   (* Operation id, e.g. 'W01' *)
    nFirstWp        : INT;          (* First waypoint index in aWp (0 = none) *)
    nLastWp         : INT;          (* Last waypoint index in aWp (0 = none) *)
    dwZoneMask      : DWORD;        (* REQUEST/GRANT bits (zones 0..30, bit 31 = permit) *)
    tDelay          : TIME;         (* Start delay after the grant *)
    tHold           : TIME;         (* Hold time at the end pose *)
    rDelay_s        : REAL;         (* Start delay in s (used by FB_ProgramPlayer) *)
    rHold_s         : REAL;         (* Hold time in s (used by FB_ProgramPlayer) *)
    rVelScale       : REAL;         (* Velocity scale of the trajectory (1.0 = nominal) *)
    bBlindHome      : BOOL;         (* TRUE = blind joint move to the home pose *)
END_STRUCT
END_TYPE
