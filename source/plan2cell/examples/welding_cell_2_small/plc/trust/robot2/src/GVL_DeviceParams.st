NAMESPACE GVL_DeviceParams
(*
 * GVL_DeviceParams
 * PROFINET device identity parameters.
 * Device simulator R2 (robot2, station kuka-robi2), cell welding_cell_2_small. Generated by bt2plc 0.1.0.
 *
 * These parameters configure how the CODESYS PROFINET Device presents itself
 * on the network. They MUST match what the Siemens PLC expects (from the GSDML).
 *
 * In CODESYS, these are typically set via:
 *   1. The "PROFINET Device IEC Objects" tab in the device editor
 *   2. Or programmatically by writing to the device parameter structure
 *
 * The CODESYS PROFINET Device stack reads these at startup and uses them
 * in DCP responses and during the PROFINET connection establishment.
 *
 * IMPORTANT: The default CODESYS values (VendorId=0x02CC, DeviceId=0x1017)
 * will NOT work with the Siemens PLC that expects KUKA (0x019B / 0x0301).
 * You MUST override them.
 *)

{attribute 'qualified_only'}
VAR_GLOBAL
    (* === KUKA VKRCnexxt Device Identity === *)
    (* These values come from GSDML-V2.25-KUKA-Roboter-GmbH-VKR C4-Device-V1.0 *)

    VENDOR_ID           : UINT        := 16#019B;                 (* KUKA Roboter GmbH *)
    DEVICE_ID           : UINT        := 16#0301;                 (* VKR C4 Device *)
    STATION_TYPE        : STRING(240) := 'KUKA VKR C4';           (* Station type string *)
    DEVICE_TYPE         : STRING(28)  := 'KUKA VKR C4';           (* Device type string *)
    ORDER_ID            : STRING(20)  := 'KUKA VKRC nexxt';       (* Order number *)
    HW_REVISION         : UINT        := 1;                       (* Hardware revision *)
    SW_REV_PREFIX       : USINT       := 16#56;                   (* 'V' in ASCII *)
    SW_REV_MAJOR        : UINT        := 8;                       (* V8.x *)
    SW_REV_MINOR        : UINT        := 2;                       (* x.2 *)
    SW_REV_PATCH        : UINT        := 0;                       (* x.x.0 *)

    (* === Module Identification Numbers (from GSDML) === *)
    MODULE_IDENT_DAP    : DWORD       := DWORD#16#00000301;       (* DAP - Slot 0 *)
    MODULE_IDENT_FDIO64 : DWORD       := DWORD#16#0000008F;       (* PROFIsafe - Slot 1 *)
    MODULE_IDENT_DIO256 : DWORD       := DWORD#16#00001000;       (* VASS telegram - Slot 2 *)
    SUBMODULE_IDENT     : DWORD       := DWORD#16#00000001;       (* Submodule ident (all slots) *)

    (* === PROFIsafe Parameters (Slot 1) === *)
    (* These must match the F-parameter record in the PLC safety configuration *)
    F_SIL_LEVEL         : UINT        := 3;                       (* SIL 3 *)
    F_CRC_LENGTH        : UINT        := 3;                       (* 3-byte CRC *)
    F_WD_TIME_DEFAULT   : UINT        := 500;                     (* Watchdog 500ms *)
    F_BLOCK_ID          : UINT        := 0;                       (* Block ID *)
    F_PAR_CRC_DEFAULT   : UINT        := 16#FF59;                 (* Default F_Par_CRC = 65369 *)
END_VAR
END_NAMESPACE
