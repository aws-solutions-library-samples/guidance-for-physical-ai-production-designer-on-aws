(*
 * FB_VassRobot
 * Generated by bt2plc 0.1.0 for cell cell_2robot (plan bt_1791274820_cell_2robot)
 *
 * VW VASS protocol driver for ONE robot (KUKA VKRC nexxt V8.2 DIM 2 via PROFINET).
 * Portable: no pointers, no REFERENCE, no OOP - the robot IO is passed as struct
 * copies (stIn / stOut) by the caller (FB_Cell, PLC_PRG copies GVL_IO).
 *
 *   Bring-up : SAFETY_ENABLE (T_BRINGUP_LIMIT: PROFINET / PROFIsafe connection set-up)
 *              -> DRIVES_ON -> MODE_EXT -> IDLE   (T_HANDSHAKE each)
 *   Job      : WAIT_READY -> SEND (echo checked) -> START (T_START_PULSE) -> WAIT_RUNNING
 *              -> RUNNING -> DONE   (WAIT_RUNNING -> DONE if the job finished between scans)
 *              (RUNNING -> ERROR ERR_ROBOT_STOPPED only after ProgRunning and ProgFinished
 *              stayed low for T_STOP_DEBOUNCE: a robot may publish the two bits in different
 *              bus frames at the Folge end)
 *              (T_HANDSHAKE per handshake state)
 *   Abort    : STOPPING (Stop + Cancel held >= T_STOP_PULSE and until ProgRunning drops)
 *   Recovery : ERROR -> RESET (Reset held T_RESET_PULSE >= 500 ms while bCmdReset stays TRUE;
 *              bCmdReset dropped = reset cancelled -> ERROR) -> SAFETY_ENABLE
 *              (still ProgRunning after the pulse -> ERROR, ERR_STOP_TIMEOUT)
 *   Command handshake: bCmdJob is a level request (rising edge latched),
 *              bJobDone the acknowledge (cleared while bCmdJob = FALSE).
 *
 * Stop is never dropped while the robot still reports ProgRunning (also in ERROR / RESET).
 * ProgRunning outside a job (OFF, bring-up, IDLE) -> ERROR (ERR_UNEXPECTED_RUN, Stop + Cancel).
 * The zone GRANT bytes (GVL_Cell.GRANT_BYTE .. +3) are written 0 here: FB_Cell encodes
 * them after FB_ZoneArbiter has run, so a grant reaches the robot in the scan it is computed.
 *
 * Profile vw-ks24 (GVL_Cell.PROFILE_VW): the VW tech package on the robot does the Folge
 * handshake, so the signal map and the job states differ (same state names):
 *   status  : ready A9, safety A10 + A13, auto A12, home A15 (PF0), Folge end A14,
 *             echo PRG_NR_REFL A1-8, op index P_PktNr_SPS, error code VW_FEH_BIN_A
 *   commands: drives E10, Folge number PRG_NR E1-8, start SRB E9 (level), reset E26
 *   job     : SEND writes PRG_NR and waits for the echo; START holds SRB until the robot
 *             leaves home (its cycle-start point clears PF0); RUNNING waits for Folge end;
 *             DONE clears PRG_NR and waits for the Folge end to fall
 *   zones   : REQUEST bit z is synthesised as "requesting or occupying",
 *             A(80+n) OR NOT A(40+n), which is exactly the REQUEST semantics of the arbiter;
 *             the release is A(40+n) going TRUE again. There is no 4-phase handshake.
 *   stop    : no Stop/Cancel bits exist; the head drops the drives, withdraws the partner
 *             releases (the robot's online driving condition stops it on the path) and clears
 *             PRG_NR. Recovery needs manual homing (PF0), there is no blind HOME Folge.
 *)

FUNCTION_BLOCK FB_VassRobot
VAR_INPUT
    bEnable             : BOOL := TRUE;
    nRobot              : INT := 1;         (* 1-based robot index (profile vw-ks24: interlock map) *)
    bPowerOn            : BOOL;             (* Level: bring the robot up *)
    bCmdJob             : BOOL;             (* Level request (rising edge latched): run job wJobNr *)
    wJobNr              : WORD;             (* Folge number, latched at job accept *)
    bProdJob            : BOOL;             (* wJobNr is the production Folge: send PLAN_ID, track wLastStep *)
    bCmdStop            : BOOL;             (* Level: abort the active job *)
    bCmdReset           : BOOL;             (* Rising edge in RS_ERROR: reset the robot; hold until bError drops *)
    stIn                : ST_RobotIn;       (* Copy of this robot's GVL_IO inputs *)
END_VAR

VAR_OUTPUT
    stOut               : ST_RobotOut;      (* Copy to this robot's GVL_IO outputs (GRANT bytes = 0) *)
    eState              : E_RobotState;
    eError              : E_CellError;
    bIdle               : BOOL;
    bBusy               : BOOL;             (* Job, stopping or resetting *)
    bJobActive          : BOOL;             (* Job started and ProgRunning *)
    bJobDone            : BOOL;             (* Job finished (cleared while bCmdJob = FALSE) *)
    bError              : BOOL;             (* RS_ERROR or RS_RESET *)

    (* Decoded robot status *)
    bDrivesOn           : BOOL;
    bProgRunning        : BOOL;
    bAtHome             : BOOL;
    bModeExt            : BOOL;
    bRobotReady         : BOOL;
    bRobotError         : BOOL;
    bProgFinished       : BOOL;
    bJobAck             : BOOL;
    bSafetyOK           : BOOL;
    wActiveJob          : WORD;             (* Echoed job number *)
    wStep               : WORD;             (* Reported op index, 0 = no program *)
    wLastStep           : WORD;             (* Max op index of the running production job (cleared at job accept) *)
    dwZoneReq           : DWORD;            (* REQUEST DWORD: zone bits 0..30, permit bit 31 *)
    wRobotErrorCode     : WORD;
END_VAR

VAR
    _eState             : E_RobotState := E_RobotState#RS_OFF;
    _eLastState         : E_RobotState := E_RobotState#RS_OFF;
    _wJob               : WORD;             (* Job number latched at accept *)
    _bProdJob           : BOOL;             (* Latched bProdJob *)
    _bJobPending        : BOOL;             (* Job edge seen, not yet accepted *)
    _bInJob             : BOOL;
    _bUp                : BOOL;
    _bNoJob             : BOOL;             (* Off / bring-up / idle: ProgRunning is not expected *)

    (* Commands to the robot *)
    _bSafeEnable        : BOOL;
    _bDrivesOnCmd       : BOOL;
    _bExtCmd            : BOOL;
    _bStartCmd          : BOOL;
    _bStopCmd           : BOOL;
    _bCancelCmd         : BOOL;
    _bResetCmd          : BOOL;
    _bJobReqCmd         : BOOL;

    (* Timers *)
    _tonStep            : TON;              (* State timeout, restarts on every state change *)
    _tonPulse           : TON;              (* Start / stop / reset pulse width *)
    _tonStopDebounce    : TON;              (* RS_JOB_RUNNING: ProgRunning + ProgFinished low (T_STOP_DEBOUNCE) *)
    _tStepLimit         : TIME;

    (* Edge detection *)
    _rtrigJob           : R_TRIG;
    _rtrigReset         : R_TRIG;

    (* Profile vw-ks24 *)
    _bFolgeEnd          : BOOL;             (* A14 Folge end *)
    _bVwStarted         : BOOL;             (* SRB acknowledged: the robot left its home point *)
    _nIdx               : INT;              (* signal index 1..256 *)
    _nB                 : INT;              (* telegram byte of _nIdx *)
    _nBit               : INT;              (* bit of _nIdx *)
    _wTmp               : WORD;
    _bTmp               : BOOL;
    _z                  : INT;
    _n                  : INT;

    _i                  : INT;
END_VAR
(*
 * FB_VassRobot - Implementation
 * Reads the robot status from stIn, writes the commands to stOut.
 *)

IF NOT bEnable THEN
    FOR _i := 0 TO 31 DO
        stOut.aVassOut[_i] := BYTE#0;
    END_FOR
    FOR _i := 0 TO 7 DO
        stOut.abySafeOut[_i] := BYTE#0;
    END_FOR
    _eState := E_RobotState#RS_OFF;
    _eLastState := E_RobotState#RS_OFF;
    _bJobPending := FALSE;
    eState := _eState;
    eError := E_CellError#ERR_NONE;
    bIdle := FALSE;
    bBusy := FALSE;
    bJobActive := FALSE;
    bJobDone := FALSE;
    bError := FALSE;
    wLastStep := WORD#0;
    RETURN;
END_IF

(* ============================================================================
   DECODE ROBOT STATUS (robot -> PLC)
   ============================================================================ *)

(* The job state of the scan we start in (the global transitions below may change it); the
   vw-ks24 decode needs it for the "occupied" term. *)
_bInJob := (_eState = E_RobotState#RS_JOB_WAIT_READY) OR (_eState = E_RobotState#RS_JOB_SEND)
           OR (_eState = E_RobotState#RS_JOB_START) OR (_eState = E_RobotState#RS_JOB_WAIT_RUNNING)
           OR (_eState = E_RobotState#RS_JOB_RUNNING);

IF GVL_Cell.PROFILE_VW THEN
    (* ---- VW KS24 signal map (status bits addressed by $OUT index) ---- *)
    _nIdx := GVL_Cell.VW_READY_OUT;
    _nB := (_nIdx - 1) / 8;
    _nBit := (_nIdx - 1) MOD 8;
    bRobotReady := (SHR(BYTE_TO_WORD(stIn.aVassIn[_nB]), _nBit) AND WORD#1) = WORD#1;

    _nIdx := GVL_Cell.VW_AUTO_OUT;
    _nB := (_nIdx - 1) / 8;
    _nBit := (_nIdx - 1) MOD 8;
    bModeExt := (SHR(BYTE_TO_WORD(stIn.aVassIn[_nB]), _nBit) AND WORD#1) = WORD#1;

    _nIdx := GVL_Cell.VW_PF0_OUT;
    _nB := (_nIdx - 1) / 8;
    _nBit := (_nIdx - 1) MOD 8;
    bAtHome := (SHR(BYTE_TO_WORD(stIn.aVassIn[_nB]), _nBit) AND WORD#1) = WORD#1;

    _nIdx := GVL_Cell.VW_END_OUT;
    _nB := (_nIdx - 1) / 8;
    _nBit := (_nIdx - 1) MOD 8;
    _bFolgeEnd := (SHR(BYTE_TO_WORD(stIn.aVassIn[_nB]), _nBit) AND WORD#1) = WORD#1;
    bProgFinished := _bFolgeEnd;

    (* A10 (RK100: user_saf and em_stop group) is the drive / safety-circuit feedback; A9
       (Bereit) drops while a Folge runs, so it is only used for the job handshake. *)
    _nIdx := GVL_Cell.VW_RK100_OUT;
    _nB := (_nIdx - 1) / 8;
    _nBit := (_nIdx - 1) MOD 8;
    _bTmp := (SHR(BYTE_TO_WORD(stIn.aVassIn[_nB]), _nBit) AND WORD#1) = WORD#1;
    bDrivesOn := _bTmp;
    _nIdx := GVL_Cell.VW_ESTOP_OUT;
    _nB := (_nIdx - 1) / 8;
    _nBit := (_nIdx - 1) MOD 8;
    bSafetyOK := _bTmp AND ((SHR(BYTE_TO_WORD(stIn.aVassIn[_nB]), _nBit) AND WORD#1) = WORD#1)
                 AND stIn.abySafeIn[0].0 AND stIn.abySafeIn[1].4;

    (* Echo: PRG_NR_REFL A1-8 *)
    wActiveJob := BYTE_TO_WORD(stIn.aVassIn[0]);
    bJobAck := (wActiveJob <> WORD#0) AND (wActiveJob = _wJob);

    (* Op index: P_PktNr_SPS, 16 bits little-endian from VW_STEP_OUT *)
    _nB := (GVL_Cell.VW_STEP_OUT - 1) / 8;
    wStep := BYTE_TO_WORD(stIn.aVassIn[_nB]) OR SHL(BYTE_TO_WORD(stIn.aVassIn[_nB + 1]), 8);

    (* Error code: VW_FEH_BIN_A, 8 bits *)
    _nB := (GVL_Cell.VW_ERR_OUT - 1) / 8;
    wRobotErrorCode := BYTE_TO_WORD(stIn.aVassIn[_nB]);
    bRobotError := wRobotErrorCode <> WORD#0;

    (* REQUEST bit z = A(80+n) OR NOT A(40+n): requesting, or inside ("occupied"). The
       release is A(40+n) going TRUE again, which drops the bit. The "occupied" term counts
       only while this driver has a job: an all-zero frame (robot not connected yet, PROFINET
       down) would otherwise read as "inside every interlock". *)
    dwZoneReq := DWORD#0;
    FOR _z := 1 TO GVL_Cell.N_ZONES DO
        _n := GVL_Cell.anInterlock[(nRobot - 1) * GVL_Cell.N_ZONES + _z];
        IF (_n >= 1) AND (_n <= 16) THEN
            _nIdx := GVL_Cell.VW_REQ_OUT + _n - 1;
            _nB := (_nIdx - 1) / 8;
            _nBit := (_nIdx - 1) MOD 8;
            _bTmp := (SHR(BYTE_TO_WORD(stIn.aVassIn[_nB]), _nBit) AND WORD#1) = WORD#1;
            _nIdx := GVL_Cell.VW_REL_OUT + _n - 1;
            _nB := (_nIdx - 1) / 8;
            _nBit := (_nIdx - 1) MOD 8;
            IF _bTmp OR (_bInJob AND ((SHR(BYTE_TO_WORD(stIn.aVassIn[_nB]), _nBit) AND WORD#1) = WORD#0)) THEN
                dwZoneReq := dwZoneReq OR SHL(DWORD#1, _z - 1);
            END_IF
        END_IF
    END_FOR

    (* No ProgRunning bit: the Folge runs while its number is echoed and the robot is neither
       at its home point nor reporting the Folge end. *)
    bProgRunning := (wActiveJob <> WORD#0) AND (wActiveJob = _wJob) AND NOT bAtHome
                    AND NOT _bFolgeEnd;
ELSE
    (* Status word byte 0 / 1 *)
    bDrivesOn     := stIn.aVassIn[0].0;
    bProgRunning  := stIn.aVassIn[0].1;
    bAtHome       := stIn.aVassIn[0].2;
    bModeExt      := stIn.aVassIn[0].4;
    bRobotReady   := stIn.aVassIn[0].5;
    bRobotError   := stIn.aVassIn[0].6;
    bProgFinished := stIn.aVassIn[1].2;
    bJobAck       := stIn.aVassIn[1].3;

    (* Echoed job number from bytes 2-3 (or byte 2 only) *)
    IF GVL_Cell.JOB_NUMBER_BYTE THEN
        wActiveJob := BYTE_TO_WORD(stIn.aVassIn[2]);
    ELSE
        wActiveJob := BYTE_TO_WORD(stIn.aVassIn[2])
                      OR SHL(BYTE_TO_WORD(stIn.aVassIn[3]), 8);
    END_IF

    (* Op index (WORD LE) and zone REQUEST (DWORD LE) *)
    wStep := BYTE_TO_WORD(stIn.aVassIn[GVL_Cell.STEP_BYTE])
             OR SHL(BYTE_TO_WORD(stIn.aVassIn[GVL_Cell.STEP_BYTE + 1]), 8);

    dwZoneReq := BYTE_TO_DWORD(stIn.aVassIn[GVL_Cell.REQ_BYTE])
                 OR SHL(BYTE_TO_DWORD(stIn.aVassIn[GVL_Cell.REQ_BYTE + 1]), 8)
                 OR SHL(BYTE_TO_DWORD(stIn.aVassIn[GVL_Cell.REQ_BYTE + 2]), 16)
                 OR SHL(BYTE_TO_DWORD(stIn.aVassIn[GVL_Cell.REQ_BYTE + 3]), 24);

    (* Error code from bytes 10-11 *)
    wRobotErrorCode := BYTE_TO_WORD(stIn.aVassIn[10])
                       OR SHL(BYTE_TO_WORD(stIn.aVassIn[11]), 8);

    (* Safety status: SafeIn0.0 drives OK, SafeIn1.4 E-Stop OK *)
    bSafetyOK := stIn.abySafeIn[0].0 AND stIn.abySafeIn[1].4;
END_IF

(* SIMULATION ONLY (bt2plc [[robot]] safety_bypass -> GVL_Cell.abSafetyBypass, e.g. a KUKA virtual controller whose FDIO64
   slot carries no F-data to this non-safety controller): the slot-1 bits are not required. The
   vw-ks24 drive / E-stop status bits still count. *)
IF (nRobot >= 1) AND (nRobot <= GVL_Cell.N_ROBOTS) AND GVL_Cell.abSafetyBypass[nRobot] THEN
    IF GVL_Cell.PROFILE_VW THEN
        _nIdx := GVL_Cell.VW_ESTOP_OUT;
        _nB := (_nIdx - 1) / 8;
        _nBit := (_nIdx - 1) MOD 8;
        bSafetyOK := bDrivesOn AND ((SHR(BYTE_TO_WORD(stIn.aVassIn[_nB]), _nBit) AND WORD#1) = WORD#1);
    ELSE
        bSafetyOK := TRUE;
    END_IF
END_IF

(* ============================================================================
   EDGES
   ============================================================================ *)
_rtrigJob(CLK := bCmdJob);
_rtrigReset(CLK := bCmdReset);
IF _rtrigJob.Q THEN
    _bJobPending := TRUE;
END_IF
IF NOT bCmdJob THEN
    _bJobPending := FALSE;
END_IF

(* ============================================================================
   GLOBAL TRANSITIONS
   ============================================================================ *)
_bInJob := (_eState = E_RobotState#RS_JOB_WAIT_READY) OR (_eState = E_RobotState#RS_JOB_SEND)
           OR (_eState = E_RobotState#RS_JOB_START) OR (_eState = E_RobotState#RS_JOB_WAIT_RUNNING)
           OR (_eState = E_RobotState#RS_JOB_RUNNING);
_bUp := _bInJob OR (_eState = E_RobotState#RS_IDLE);
_bNoJob := (_eState = E_RobotState#RS_OFF) OR (_eState = E_RobotState#RS_SAFETY_ENABLE)
           OR (_eState = E_RobotState#RS_DRIVES_ON) OR (_eState = E_RobotState#RS_MODE_EXT)
           OR (_eState = E_RobotState#RS_IDLE);

IF _bInJob AND bCmdStop THEN
    _eState := E_RobotState#RS_STOPPING;
ELSIF _bUp AND bRobotError THEN
    eError := E_CellError#ERR_ROBOT_ERROR;
    _eState := E_RobotState#RS_ERROR;
ELSIF _bUp AND NOT bSafetyOK THEN
    eError := E_CellError#ERR_SAFETY_LOST;
    _eState := E_RobotState#RS_ERROR;
ELSIF _bUp AND NOT bDrivesOn THEN
    eError := E_CellError#ERR_DRIVES_LOST;
    _eState := E_RobotState#RS_ERROR;
ELSIF _bNoJob AND bProgRunning AND NOT GVL_Cell.PROFILE_VW THEN
    (* a program runs that this driver did not start (head restart / download, manual
       start): RS_ERROR holds Stop + Cancel while ProgRunning *)
    eError := E_CellError#ERR_UNEXPECTED_RUN;
    _eState := E_RobotState#RS_ERROR;
END_IF

(* ============================================================================
   STATE TIMER (after the global transitions: a new state always starts with
   fresh timers, also when it was entered by a global transition this scan)
   ============================================================================ *)
IF _eState <> _eLastState THEN
    _tonStep(IN := FALSE);
    _tonPulse(IN := FALSE);
    _tonStopDebounce(IN := FALSE);
    _eLastState := _eState;
END_IF
IF _eState = E_RobotState#RS_STOPPING THEN
    _tStepLimit := GVL_Cell.T_ABORT_LIMIT;
ELSIF _eState = E_RobotState#RS_SAFETY_ENABLE THEN
    _tStepLimit := GVL_Cell.T_BRINGUP_LIMIT;    (* PROFINET / PROFIsafe connection set-up *)
ELSE
    _tStepLimit := GVL_Cell.T_HANDSHAKE;        (* drives / EXT and job handshakes *)
END_IF
_tonStep(IN := TRUE, PT := _tStepLimit);

(* ============================================================================
   STATE MACHINE
   ============================================================================ *)
CASE _eState OF

E_RobotState#RS_OFF:
    _bSafeEnable := FALSE;
    _bDrivesOnCmd := FALSE;
    _bExtCmd := FALSE;
    _bJobReqCmd := FALSE;
    _bStartCmd := FALSE;
    _bStopCmd := FALSE;
    _bCancelCmd := FALSE;
    _bResetCmd := FALSE;
    IF bPowerOn THEN
        _eState := E_RobotState#RS_SAFETY_ENABLE;
    END_IF

E_RobotState#RS_SAFETY_ENABLE:
    _bSafeEnable := TRUE;
    IF bSafetyOK THEN
        _eState := E_RobotState#RS_DRIVES_ON;
    ELSIF _tonStep.Q THEN
        eError := E_CellError#ERR_SAFETY_TIMEOUT;
        _eState := E_RobotState#RS_ERROR;
    END_IF

E_RobotState#RS_DRIVES_ON:
    _bDrivesOnCmd := TRUE;
    IF bDrivesOn THEN
        _eState := E_RobotState#RS_MODE_EXT;
    ELSIF _tonStep.Q THEN
        eError := E_CellError#ERR_DRIVES_TIMEOUT;
        _eState := E_RobotState#RS_ERROR;
    END_IF

E_RobotState#RS_MODE_EXT:
    _bExtCmd := TRUE;
    IF bModeExt THEN
        _eState := E_RobotState#RS_IDLE;
    ELSIF _tonStep.Q THEN
        eError := E_CellError#ERR_EXT_TIMEOUT;
        _eState := E_RobotState#RS_ERROR;
    END_IF

E_RobotState#RS_IDLE:
    _bJobReqCmd := FALSE;
    _bStartCmd := FALSE;
    _bStopCmd := FALSE;
    _bCancelCmd := FALSE;
    IF NOT bCmdJob THEN
        bJobDone := FALSE;
    END_IF
    IF NOT bPowerOn THEN
        _eState := E_RobotState#RS_OFF;
    ELSIF _bJobPending THEN
        _bJobPending := FALSE;
        _wJob := wJobNr;
        _bProdJob := bProdJob;
        bJobDone := FALSE;
        wLastStep := WORD#0;
        _eState := E_RobotState#RS_JOB_WAIT_READY;
    END_IF

E_RobotState#RS_JOB_WAIT_READY:
    _bJobReqCmd := FALSE;                   (* guarantees a rising edge in RS_JOB_SEND *)
    _bVwStarted := FALSE;
    IF GVL_Cell.PROFILE_VW THEN
        (* the robot waits at its home point with PRG_NR_REFL = 0 *)
        IF bRobotReady AND bAtHome AND (wActiveJob = WORD#0) THEN
            _eState := E_RobotState#RS_JOB_SEND;
        ELSIF _tonStep.Q THEN
            eError := E_CellError#ERR_NOT_READY;
            _eState := E_RobotState#RS_ERROR;
        END_IF
    ELSIF bRobotReady AND NOT bJobAck THEN
        _eState := E_RobotState#RS_JOB_SEND;
    ELSIF _tonStep.Q THEN
        eError := E_CellError#ERR_NOT_READY;
        _eState := E_RobotState#RS_ERROR;
    END_IF

E_RobotState#RS_JOB_SEND:
    _bJobReqCmd := TRUE;                    (* vw: PRG_NR is written in the encode section *)
    IF GVL_Cell.PROFILE_VW THEN
        (* the robot mirrors PRG_NR on A1-8 while it waits for the Folge start *)
        IF wActiveJob = _wJob THEN
            _eState := E_RobotState#RS_JOB_START;
        ELSIF _tonStep.Q THEN
            eError := E_CellError#ERR_ACK_TIMEOUT;
            _eState := E_RobotState#RS_ERROR;
        END_IF
    ELSIF bJobAck THEN
        _bJobReqCmd := FALSE;
        IF wActiveJob = _wJob THEN
            _eState := E_RobotState#RS_JOB_START;
        ELSE
            eError := E_CellError#ERR_ECHO_MISMATCH;
            _eState := E_RobotState#RS_ERROR;
        END_IF
    ELSIF _tonStep.Q THEN
        _bJobReqCmd := FALSE;
        eError := E_CellError#ERR_ACK_TIMEOUT;
        _eState := E_RobotState#RS_ERROR;
    END_IF

E_RobotState#RS_JOB_START:
    _bStartCmd := TRUE;
    IF GVL_Cell.PROFILE_VW THEN
        (* SRB stays a level until the robot leaves its home point (its cycle start clears PF0) *)
        _bJobReqCmd := TRUE;                (* keep PRG_NR *)
        IF NOT bAtHome THEN
            _bVwStarted := TRUE;
            _bStartCmd := FALSE;
            _eState := E_RobotState#RS_JOB_RUNNING;
        ELSIF _tonStep.Q THEN
            eError := E_CellError#ERR_START_TIMEOUT;
            _eState := E_RobotState#RS_ERROR;
        END_IF
    ELSE
        _bJobReqCmd := FALSE;
        _tonPulse(IN := TRUE, PT := GVL_Cell.T_START_PULSE);
        IF _tonPulse.Q THEN
            _bStartCmd := FALSE;
            _eState := E_RobotState#RS_JOB_WAIT_RUNNING;
        END_IF
    END_IF

E_RobotState#RS_JOB_WAIT_RUNNING:
    _bStartCmd := FALSE;
    IF bProgRunning THEN
        _eState := E_RobotState#RS_JOB_RUNNING;
    ELSIF bProgFinished THEN
        (* finished between two scans - the robot clears ProgFinished on job accept *)
        _eState := E_RobotState#RS_JOB_DONE;
    ELSIF _tonStep.Q THEN
        eError := E_CellError#ERR_START_TIMEOUT;
        _eState := E_RobotState#RS_ERROR;
    END_IF

E_RobotState#RS_JOB_RUNNING:
    (* no timeout here: per-op watchdogs in FB_Cell, HOME uses T_HOME_LIMIT *)
    IF GVL_Cell.PROFILE_VW THEN
        _bJobReqCmd := TRUE;                (* keep PRG_NR until the Folge end *)
        IF _bFolgeEnd THEN
            _eState := E_RobotState#RS_JOB_DONE;
        END_IF
    ELSE
        (* ProgRunning low without ProgFinished is a stop only when it lasts T_STOP_DEBOUNCE:
           the robot writes the two bits to its outputs one after the other (KRL submit), so a
           bus frame taken between them shows both low for one cycle at a normal Folge end. *)
        _tonStopDebounce(IN := NOT bProgRunning AND NOT bProgFinished, PT := GVL_Cell.T_STOP_DEBOUNCE);
        IF bProgFinished AND NOT bProgRunning THEN
            _eState := E_RobotState#RS_JOB_DONE;
        ELSIF _tonStopDebounce.Q THEN
            eError := E_CellError#ERR_ROBOT_STOPPED;
            _eState := E_RobotState#RS_ERROR;
        END_IF
    END_IF

E_RobotState#RS_JOB_DONE:
    IF GVL_Cell.PROFILE_VW THEN
        (* clear PRG_NR, then wait for the Folge end (A14) to fall before the next job *)
        _bJobReqCmd := FALSE;
        IF NOT _bFolgeEnd THEN
            bJobDone := TRUE;
            _eState := E_RobotState#RS_IDLE;
        ELSIF _tonStep.Q THEN
            eError := E_CellError#ERR_HANDSHAKE;
            _eState := E_RobotState#RS_ERROR;
        END_IF
    ELSE
        bJobDone := TRUE;
        _eState := E_RobotState#RS_IDLE;
    END_IF

E_RobotState#RS_STOPPING:
    _bJobReqCmd := FALSE;                   (* vw: clears PRG_NR; FB_Cell withdraws the grants
                                               and partner releases, which stops the robot on
                                               its path through its own driving condition *)
    _bStartCmd := FALSE;
    _bStopCmd := TRUE;
    _bCancelCmd := TRUE;
    IF GVL_Cell.PROFILE_VW THEN
        _bDrivesOnCmd := FALSE;             (* no Stop/Cancel bits in KS24: drop the drives *)
    END_IF
    _tonPulse(IN := TRUE, PT := GVL_Cell.T_STOP_PULSE);
    IF _tonPulse.Q AND NOT bProgRunning THEN
        _bStopCmd := FALSE;
        _bCancelCmd := FALSE;
        _eState := E_RobotState#RS_IDLE;
    ELSIF _tonStep.Q THEN
        (* keep Stop + Cancel: RS_ERROR holds them while ProgRunning *)
        eError := E_CellError#ERR_STOP_TIMEOUT;
        _eState := E_RobotState#RS_ERROR;
    END_IF

E_RobotState#RS_ERROR:
    _bJobReqCmd := FALSE;
    _bStartCmd := FALSE;
    _bStopCmd := bProgRunning;              (* never drop Stop while the robot still runs *)
    _bCancelCmd := bProgRunning;
    _bResetCmd := FALSE;
    IF _rtrigReset.Q THEN
        _eState := E_RobotState#RS_RESET;
    END_IF

E_RobotState#RS_RESET:
    _bStopCmd := bProgRunning;
    _bCancelCmd := bProgRunning;
    (* DrivesOn low while Reset is held: a KUKA controller switches the drives on only at a rising edge of
       $DRIVES_ON after the messages are acknowledged ($CONF_MESS), so RS_DRIVES_ON must raise it again *)
    _bDrivesOnCmd := FALSE;
    _bResetCmd := TRUE;                     (* held >= 500 ms - robot requirement *)
    _tonPulse(IN := TRUE, PT := GVL_Cell.T_RESET_PULSE);
    IF NOT bCmdReset THEN
        (* reset withdrawn by the cell (operator stop): Reset low, error kept *)
        _bResetCmd := FALSE;
        _eState := E_RobotState#RS_ERROR;
    ELSIF _tonPulse.Q THEN
        _bResetCmd := FALSE;
        IF bProgRunning THEN
            (* never leave the error with a running program: RS_ERROR keeps Stop + Cancel *)
            eError := E_CellError#ERR_STOP_TIMEOUT;
            _eState := E_RobotState#RS_ERROR;
        ELSIF NOT bRobotError THEN
            eError := E_CellError#ERR_NONE;
            _eState := E_RobotState#RS_SAFETY_ENABLE;
        ELSE
            eError := E_CellError#ERR_RESET_FAILED;
            _eState := E_RobotState#RS_ERROR;
        END_IF
    END_IF

END_CASE

(* ============================================================================
   JOB STATUS
   ============================================================================ *)
_bInJob := (_eState = E_RobotState#RS_JOB_WAIT_READY) OR (_eState = E_RobotState#RS_JOB_SEND)
           OR (_eState = E_RobotState#RS_JOB_START) OR (_eState = E_RobotState#RS_JOB_WAIT_RUNNING)
           OR (_eState = E_RobotState#RS_JOB_RUNNING);
bJobActive := bProgRunning AND ((_eState = E_RobotState#RS_JOB_START)
              OR (_eState = E_RobotState#RS_JOB_WAIT_RUNNING) OR (_eState = E_RobotState#RS_JOB_RUNNING));

(* Latched max op index of the running production job (step 0 = between jobs) *)
IF bJobActive AND _bProdJob AND (wStep > wLastStep) THEN
    wLastStep := wStep;
END_IF

(* ============================================================================
   ENCODE COMMANDS (PLC -> robot)
   ============================================================================ *)
IF GVL_Cell.PROFILE_VW THEN
    (* ---- VW KS24 commands: PRG_NR A1-8, SRB, drives, acknowledge ---- *)
    FOR _i := 0 TO 31 DO
        stOut.aVassOut[_i] := BYTE#0;
    END_FOR
    (* PRG_NR only from RS_JOB_SEND on: in RS_JOB_WAIT_READY the robot must still echo 0
       (it picks the number up through cell.src as soon as it is written). *)
    IF _bJobReqCmd THEN
        stOut.aVassOut[0] := WORD_TO_BYTE(_wJob AND WORD#16#FF);
    END_IF
    _nIdx := GVL_Cell.VW_SRB_IN;
    _nB := (_nIdx - 1) / 8;
    _nBit := (_nIdx - 1) MOD 8;
    IF _bStartCmd THEN
        _wTmp := BYTE_TO_WORD(stOut.aVassOut[_nB]) OR SHL(WORD#1, _nBit);
        stOut.aVassOut[_nB] := WORD_TO_BYTE(_wTmp);
    END_IF
    _nIdx := GVL_Cell.VW_DRIVES_IN;
    _nB := (_nIdx - 1) / 8;
    _nBit := (_nIdx - 1) MOD 8;
    IF _bDrivesOnCmd THEN
        _wTmp := BYTE_TO_WORD(stOut.aVassOut[_nB]) OR SHL(WORD#1, _nBit);
        stOut.aVassOut[_nB] := WORD_TO_BYTE(_wTmp);
    END_IF
    _nIdx := GVL_Cell.VW_RESET_IN;
    _nB := (_nIdx - 1) / 8;
    _nBit := (_nIdx - 1) MOD 8;
    IF _bResetCmd THEN
        _wTmp := BYTE_TO_WORD(stOut.aVassOut[_nB]) OR SHL(WORD#1, _nBit);
        stOut.aVassOut[_nB] := WORD_TO_BYTE(_wTmp);
    END_IF
    (* PLAN_ID on a free telegram byte pair, only with the production job (0 = no check) *)
    IF (GVL_Cell.PLAN_ID_BYTE > 0) AND _bInJob AND _bProdJob THEN
        stOut.aVassOut[GVL_Cell.PLAN_ID_BYTE]     := WORD_TO_BYTE(GVL_Cell.PLAN_ID AND WORD#16#FF);
        stOut.aVassOut[GVL_Cell.PLAN_ID_BYTE + 1] := WORD_TO_BYTE(SHR(GVL_Cell.PLAN_ID, 8) AND WORD#16#FF);
    END_IF
    (* The interlock grants E(80+n) and partner releases E(40+n) are written by FB_Cell. *)
ELSE
stOut.aVassOut[0].0 := _bDrivesOnCmd;
stOut.aVassOut[0].1 := _bStartCmd;
stOut.aVassOut[0].2 := _bStopCmd;
stOut.aVassOut[0].3 := _bCancelCmd;
stOut.aVassOut[0].4 := _bExtCmd;
stOut.aVassOut[0].5 := _bResetCmd;
stOut.aVassOut[0].6 := FALSE;               (* homing uses HOME_FOLGE, not HomeRequest *)
(* MoveEnable: held in every state but RS_OFF, also through a reset (DrivesOn drops there for the
   $DRIVES_ON edge). A KUKA KSS 9.2 maps $MOVE_ENABLE to it: it refuses EXT with $MOVE_ENABLE on the
   always-TRUE $IN[1025] (M_249), and a motion enable that dropped with DrivesOn needs a new
   acknowledgement (M_1210) before the drives come on. The robot simulator ignores this bit. *)
stOut.aVassOut[0].7 := _eState <> E_RobotState#RS_OFF;
stOut.aVassOut[1].0 := _bJobReqCmd;

(* Job number, bytes 2-3 (or byte 2 only) *)
IF _bInJob THEN
    stOut.aVassOut[2] := WORD_TO_BYTE(_wJob AND WORD#16#FF);
    IF GVL_Cell.JOB_NUMBER_BYTE THEN
        stOut.aVassOut[3] := BYTE#0;
    ELSE
        stOut.aVassOut[3] := WORD_TO_BYTE(SHR(_wJob, 8) AND WORD#16#FF);
    END_IF
ELSE
    stOut.aVassOut[2] := BYTE#0;
    stOut.aVassOut[3] := BYTE#0;
END_IF

(* PLAN_ID, only with the production job *)
IF _bInJob AND _bProdJob THEN
    stOut.aVassOut[GVL_Cell.PLAN_ID_BYTE]     := WORD_TO_BYTE(GVL_Cell.PLAN_ID AND WORD#16#FF);
    stOut.aVassOut[GVL_Cell.PLAN_ID_BYTE + 1] := WORD_TO_BYTE(SHR(GVL_Cell.PLAN_ID, 8) AND WORD#16#FF);
ELSE
    stOut.aVassOut[GVL_Cell.PLAN_ID_BYTE]     := BYTE#0;
    stOut.aVassOut[GVL_Cell.PLAN_ID_BYTE + 1] := BYTE#0;
END_IF

(* GRANT bytes: encoded by FB_Cell after FB_ZoneArbiter *)
stOut.aVassOut[GVL_Cell.GRANT_BYTE]     := BYTE#0;
stOut.aVassOut[GVL_Cell.GRANT_BYTE + 1] := BYTE#0;
stOut.aVassOut[GVL_Cell.GRANT_BYTE + 2] := BYTE#0;
stOut.aVassOut[GVL_Cell.GRANT_BYTE + 3] := BYTE#0;
END_IF

(* Safe outputs *)
IF _bSafeEnable THEN
    stOut.abySafeOut[0] := BYTE#16#01;      (* drive enable *)
    stOut.abySafeOut[1] := BYTE#16#0F;      (* zones 1-4 enable *)
ELSE
    stOut.abySafeOut[0] := BYTE#0;
    stOut.abySafeOut[1] := BYTE#0;
END_IF

(* ============================================================================
   PUBLISH
   ============================================================================ *)
eState := _eState;
bIdle  := (_eState = E_RobotState#RS_IDLE);
bBusy  := _bInJob OR (_eState = E_RobotState#RS_STOPPING) OR (_eState = E_RobotState#RS_RESET);
bError := (_eState = E_RobotState#RS_ERROR) OR (_eState = E_RobotState#RS_RESET);
END_FUNCTION_BLOCK
