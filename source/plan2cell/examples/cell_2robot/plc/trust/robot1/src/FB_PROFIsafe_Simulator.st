(*
 * FB_PROFIsafe_Simulator
 * Device simulator R1 (robot1), cell cell_2robot. Generated by bt2plc 0.1.0.
 *
 * Simulates the PROFIsafe protocol layer for the FDIO64 module (Slot 1).
 * In a real KUKA controller, the PROFIsafe stack handles CRC generation,
 * sequence counters, and watchdog monitoring.
 *
 * For simulation purposes, this FB:
 * - Monitors the safe output bytes from the PLC (abySafeOut = copy of GVL_IO.bySafeOut0..7)
 * - Provides a "communication OK" flag
 *
 * IMPORTANT: This does NOT provide real functional safety!
 * It only generates data patterns that allow the PLC's PROFIsafe stack
 * to accept the device as communicating. For real safety testing,
 * you need a certified PROFIsafe device or test equipment.
 *
 * PROFIsafe frame structure per IEC 61784-3-3:
 *   [User Data (8 bytes)] [Status/Control (1 byte)] [CRC (3 bytes)]
 *
 * Status byte bits (F_Input from device):
 *   Bit 0: Toggle bit (alternates each cycle)
 *   Bit 1: Reserved
 *   Bit 2: Data valid
 *   Bit 3-7: Reserved / Sequence counter
 *
 * Control byte bits (F_Output from controller):
 *   Bit 0: Toggle bit
 *   Bit 1: Activate device
 *   Bit 2: Reserved
 *   Bit 3-7: Reserved
 *)

FUNCTION_BLOCK FB_PROFIsafe_Simulator
VAR_INPUT
    bEnable         : BOOL := TRUE;
    dwF_Source_Add  : DWORD := DWORD#1;     (* F_Source_Add from parameterization *)
    dwF_Dest_Add    : DWORD := DWORD#1;     (* F_Dest_Add from parameterization *)
    tF_WD_Time      : TIME := T#500MS;      (* Watchdog time *)
    abySafeOut      : ARRAY[0..7] OF BYTE;  (* Safe outputs PLC -> robot (GVL_IO.bySafeOut0..7) *)
END_VAR

VAR_OUTPUT
    bCommOK         : BOOL;                 (* PROFIsafe communication established *)
    bDataValid      : BOOL;                 (* Safe data is valid *)
    bWatchdogError  : BOOL;                 (* Watchdog timeout *)
END_VAR

VAR
    _bToggleBit     : BOOL;                 (* Toggle bit for sequence *)
    _nSeqCounter    : BYTE;                 (* Sequence counter 0-31 *)
    _nCycleCount    : UDINT;                (* Absolute cycle counter *)

    (* Watchdog *)
    _tonWatchdog    : TON;
    _bPLCSafeActive : BOOL;

    (* CRC calculation helper *)
    _dwCrcSeed      : DWORD;
END_VAR
(*
 * FB_PROFIsafe_Simulator - Implementation
 * Works on the input image abySafeOut (PLC_PRG copies GVL_IO.bySafeOut0..7).
 *)

IF NOT bEnable THEN
    bCommOK := FALSE;
    bDataValid := FALSE;
    RETURN;
END_IF

IF _nCycleCount < UDINT#4000000000 THEN
    _nCycleCount := _nCycleCount + 1;
ELSE
    _nCycleCount := 0;
END_IF

(* ============================================================================
   MONITOR PLC SAFE OUTPUT DATA
   ============================================================================ *)
_bPLCSafeActive := (abySafeOut[0] <> BYTE#0) OR (abySafeOut[1] <> BYTE#0);

(* Watchdog *)
_tonWatchdog(IN := NOT _bPLCSafeActive, PT := tF_WD_Time);
bWatchdogError := _tonWatchdog.Q;

bCommOK := _bPLCSafeActive AND NOT bWatchdogError;
bDataValid := bCommOK;
END_FUNCTION_BLOCK
