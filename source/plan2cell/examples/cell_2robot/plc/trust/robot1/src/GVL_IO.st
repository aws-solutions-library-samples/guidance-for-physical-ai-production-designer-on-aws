NAMESPACE GVL_IO
(*
 * GVL_IO
 * Global variable list for the PROFINET device I/O mapping.
 * Device simulator R1 (robot1, station kuka-robi1), cell cell_2robot. Generated by bt2plc 0.1.0.
 *
 * These variables are mapped to the PROFINET device modules via the I/O Mapping tab.
 * Do NOT use AT addresses - the mapping is done in the device configuration.
 * Only PLC_PRG accesses this GVL: it copies the commands into local images and writes
 * the robot status back as a whole array / as scalars (the FBs never touch GVL_IO).
 *
 * Module mapping (set in I/O Mapping tab of each module):
 *   SafeIO_FDIO64 (Slot 1):
 *     "8 safe digital inputs" channels  -> GVL_IO.bySafeIn0..bySafeIn7
 *     "8 safe digital outputs" channels -> GVL_IO.bySafeOut0..bySafeOut7
 *
 *   VASS_DIO256 (Slot 2):
 *     Input channel  -> GVL_IO.aVassInputData
 *     Output channel -> GVL_IO.aVassOutputData
 *)

{attribute 'qualified_only'}
VAR_GLOBAL
    (* ========================================================================
       SLOT 1 - PROFIsafe FDIO64 Module
       8 individual USINT/BYTE channels per direction
       Map each one to the corresponding "8 safe digital inputs/outputs" row
       ======================================================================== *)

    (* Safe Inputs: Robot -> PLC (mapped to "8 safe digital inputs" channels) *)
    bySafeIn0       : BYTE;     (* Safe input byte 0: Drive status *)
    bySafeIn1       : BYTE;     (* Safe input byte 1: Gate/protection *)
    bySafeIn2       : BYTE;     (* Safe input byte 2: STO/SS1/SS2/SOS/SLS *)
    bySafeIn3       : BYTE;     (* Safe input byte 3: User *)
    bySafeIn4       : BYTE;     (* Safe input byte 4: User *)
    bySafeIn5       : BYTE;     (* Safe input byte 5: User *)
    bySafeIn6       : BYTE;     (* Safe input byte 6: User *)
    bySafeIn7       : BYTE;     (* Safe input byte 7: User *)

    (* Safe Outputs: PLC -> Robot (mapped to "8 safe digital outputs" channels) *)
    bySafeOut0      : BYTE;     (* Safe output byte 0: Drive enable, E-Stop, SS1/SS2 *)
    bySafeOut1      : BYTE;     (* Safe output byte 1: Zone enables *)
    bySafeOut2      : BYTE;     (* Safe output byte 2: User *)
    bySafeOut3      : BYTE;     (* Safe output byte 3: User *)
    bySafeOut4      : BYTE;     (* Safe output byte 4: User *)
    bySafeOut5      : BYTE;     (* Safe output byte 5: User *)
    bySafeOut6      : BYTE;     (* Safe output byte 6: User *)
    bySafeOut7      : BYTE;     (* Safe output byte 7: User *)

    (* ========================================================================
       SLOT 2 - DIO256 VASS Telegram
       32 bytes per direction as arrays
       ======================================================================== *)

    (* VASS Inputs: Robot -> PLC (32 bytes) *)
    aVassInputData      : ARRAY[0..31] OF BYTE;

    (* VASS Outputs: PLC -> Robot (32 bytes) *)
    aVassOutputData     : ARRAY[0..31] OF BYTE;
END_VAR
END_NAMESPACE
