    bSafe_Reserved16        : BOOL;   (* Bit 6: Reserved *)
    bSafe_Reserved17        : BOOL;   (* Bit 7: Reserved *)

    (* Bytes 2-7: Additional safe control *)
    bySafe_UserOutput2      : BYTE;   (* Byte 2: User safe output *)
    bySafe_UserOutput3      : BYTE;   (* Byte 3: User safe output *)
    bySafe_UserOutput4      : BYTE;   (* Byte 4: User safe output *)
    bySafe_UserOutput5      : BYTE;   (* Byte 5: User safe output *)
    bySafe_UserOutput6      : BYTE;   (* Byte 6: User safe output *)
    bySafe_UserOutput7      : BYTE;   (* Byte 7: User safe output *)
