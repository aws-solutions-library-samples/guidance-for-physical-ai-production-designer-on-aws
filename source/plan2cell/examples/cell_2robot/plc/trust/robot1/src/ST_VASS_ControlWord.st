(*
 * ST_VASS_ControlWord
 * VASS PLC control word - output bytes 0-1 (PLC -> robot), Slot 2 DIO256.
 * Device simulator R1 (robot1), cell cell_2robot. Generated by bt2plc 0.1.0.
 *)

TYPE ST_VASS_ControlWord :
STRUCT
    (* Byte 0 *)
    bDrivesOn           : BOOL;   (* Bit 0: Enable drives *)
    bProgStart          : BOOL;   (* Bit 1: Start program *)
    bProgStop           : BOOL;   (* Bit 2: Stop program *)
    bProgCancel         : BOOL;   (* Bit 3: Cancel program *)
    bModeRequest        : BOOL;   (* Bit 4: Request EXT mode *)
    bReset              : BOOL;   (* Bit 5: Reset error *)
    bHomeRequest        : BOOL;   (* Bit 6: Move to home *)
    bConfirm            : BOOL;   (* Bit 7: Confirm/acknowledge *)

    (* Byte 1 *)
    bJobRequest         : BOOL;   (* Bit 8: New job request *)
    bGripperOpen        : BOOL;   (* Bit 9: Open gripper *)
    bGripperClose       : BOOL;   (* Bit 10: Close gripper *)
    bPeriphRelease      : BOOL;   (* Bit 11: Release peripheral *)
    bSpeedOverride      : BOOL;   (* Bit 12: Apply speed override *)
    bReserved13         : BOOL;   (* Bit 13: Reserved *)
    bReserved14         : BOOL;   (* Bit 14: Reserved *)
    bReserved15         : BOOL;   (* Bit 15: Reserved *)
END_STRUCT
END_TYPE
