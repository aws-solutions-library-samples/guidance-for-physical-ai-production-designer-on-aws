(*
 * ST_SafeInput
 * PROFIsafe (Slot 1 - FDIO64) safe inputs: robot -> PLC, 8 bytes user data.
 * GSDML: 8x Unsigned8 Input + F_MessageTrailer4Byte.
 * Device simulator R1 (robot1), cell cell_2robot. Generated by bt2plc 0.1.0.
 *)

TYPE ST_SafeInput :
STRUCT
    (* Byte 0: Safe robot status *)
    bSafe_DrivesOK          : BOOL;   (* Bit 0: Safe drives monitoring OK *)
    bSafe_RobotStopped      : BOOL;   (* Bit 1: Robot safely stopped (SOS/SS1) *)
    bSafe_ReducedSpeed      : BOOL;   (* Bit 2: Safe reduced speed active (SLS) *)
    bSafe_AxisMonitoring    : BOOL;   (* Bit 3: Safe axis range monitoring OK *)
    bSafe_ToolOK            : BOOL;   (* Bit 4: Safe tool monitoring OK *)
    bSafe_WorkspaceOK       : BOOL;   (* Bit 5: Safe workspace monitoring OK *)
    bSafe_Reserved06        : BOOL;   (* Bit 6: Reserved *)
    bSafe_Reserved07        : BOOL;   (* Bit 7: Reserved *)

    (* Byte 1: Safe gate/zone status *)
    bSafe_Gate1Closed       : BOOL;   (* Bit 0: Safety gate 1 closed *)
    bSafe_Gate2Closed       : BOOL;   (* Bit 1: Safety gate 2 closed *)
    bSafe_Gate3Closed       : BOOL;   (* Bit 2: Safety gate 3 closed *)
    bSafe_LightCurtainOK    : BOOL;   (* Bit 3: Light curtain free *)
    bSafe_EStopOK           : BOOL;   (* Bit 4: E-Stop not pressed (NC) *)
    bSafe_EnablingDevice    : BOOL;   (* Bit 5: Enabling device pressed (T1/T2) *)
    bSafe_OperatorSafe      : BOOL;   (* Bit 6: Operator protection OK *)
    bSafe_Reserved17        : BOOL;   (* Bit 7: Reserved *)

    (* Byte 2: Extended safe status *)
    bSafe_STO_Active        : BOOL;   (* Bit 0: Safe Torque Off active *)
    bSafe_SS1_Active        : BOOL;   (* Bit 1: Safe Stop 1 active *)
    bSafe_SS2_Active        : BOOL;   (* Bit 2: Safe Stop 2 active *)
    bSafe_SOS_Active        : BOOL;   (* Bit 3: Safe Operating Stop active *)
    bSafe_SLS_Active        : BOOL;   (* Bit 4: Safely-Limited Speed active *)
    bSafe_SLP_Active        : BOOL;   (* Bit 5: Safely-Limited Position active *)
    bSafe_Reserved26        : BOOL;   (* Bit 6: Reserved *)
    bSafe_FaultPresent      : BOOL;   (* Bit 7: Safety fault present *)

    (* Bytes 3-7: Additional safe signals *)
    bySafe_UserInput3       : BYTE;   (* Byte 3: User safe input *)
    bySafe_UserInput4       : BYTE;   (* Byte 4: User safe input *)
    bySafe_UserInput5       : BYTE;   (* Byte 5: User safe input *)
    bySafe_UserInput6       : BYTE;   (* Byte 6: User safe input *)
    bySafe_UserInput7       : BYTE;   (* Byte 7: User safe input *)
END_STRUCT
END_TYPE
