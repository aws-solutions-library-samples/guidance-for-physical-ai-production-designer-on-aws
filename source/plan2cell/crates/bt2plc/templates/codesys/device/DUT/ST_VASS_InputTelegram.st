(*
 * ST_VASS_InputTelegram
 * Full VASS input telegram - 32 bytes (robot -> PLC), Slot 2 DIO256 inputs.
 * bt2plc use: bytes 4-5 wCurrentStep = op index (GVL_Program.STEP_BYTE),
 *             bytes 16-27 joint angles A1..A6 (FB_JointAngleEncoder),
 *             bytes 28-31 zone REQUEST DWORD LE (GVL_Program.REQ_BYTE).
 * Device simulator {{ROBOT_TAG}} ({{ROBOT_NS}}), cell {{CELL_ID}}. Generated by {{GENERATOR}}.
 *)

TYPE ST_VASS_InputTelegram :
STRUCT
    stStatusWord        : ST_VASS_StatusWord;     (* Bytes 0-1:   Status word *)
    wActiveJobNr        : WORD;                   (* Bytes 2-3:   Active job number *)
    wCurrentStep        : WORD;                   (* Bytes 4-5:   Current program step *)
    wSpeedActual        : WORD;                   (* Bytes 6-7:   Actual speed % *)
    wActiveToolNr       : WORD;                   (* Bytes 8-9:   Active tool number *)
    wErrorCode          : WORD;                   (* Bytes 10-11: Active error code *)
    wWarningCode        : WORD;                   (* Bytes 12-13: Active warning code *)
    wPositionX          : INT;                    (* Bytes 14-15: Position X (0.1mm) *)
    wPositionY          : INT;                    (* Bytes 16-17: Position Y (0.1mm) *)
    wPositionZ          : INT;                    (* Bytes 18-19: Position Z (0.1mm) *)
    wUserWord10         : WORD;                   (* Bytes 20-21: User data *)
    wUserWord11         : WORD;                   (* Bytes 22-23: User data *)
    wUserWord12         : WORD;                   (* Bytes 24-25: User data *)
    wUserWord13         : WORD;                   (* Bytes 26-27: User data *)
    wUserWord14         : WORD;                   (* Bytes 28-29: User data *)
    wUserWord15         : WORD;                   (* Bytes 30-31: User data *)
END_STRUCT
END_TYPE
