(*
 * ST_Waypoint
 * One trajectory waypoint (row of GVL_Program.aWp). Flat fields for portability.
 * rT = seconds from op start; angles in degrees (KUKA A1..A6 after joint sign/offset mapping).
 * Device simulator {{ROBOT_TAG}} ({{ROBOT_NS}}), cell {{CELL_ID}}. Generated by {{GENERATOR}}.
 *)

TYPE ST_Waypoint :
STRUCT
    rT              : REAL;         (* Time from op start (s) *)
    rA1             : REAL;         (* Axis 1 (deg) *)
    rA2             : REAL;         (* Axis 2 (deg) *)
    rA3             : REAL;         (* Axis 3 (deg) *)
    rA4             : REAL;         (* Axis 4 (deg) *)
    rA5             : REAL;         (* Axis 5 (deg) *)
    rA6             : REAL;         (* Axis 6 (deg) *)
END_STRUCT
END_TYPE
