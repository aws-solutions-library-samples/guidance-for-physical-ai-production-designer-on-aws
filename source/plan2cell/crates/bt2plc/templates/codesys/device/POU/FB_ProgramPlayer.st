(*
 * FB_ProgramPlayer
 * Device simulator {{ROBOT_TAG}} ({{ROBOT_NS}}), cell {{CELL_ID}}, tree {{TREE_ID}}. Generated by {{GENERATOR}}.
 *
 * Plays the bt2plc robot program (GVL_Program) for PROD_FOLGE, or a blind joint
 * move to the home pose for HOME_FOLGE. Robot side of the zone protocol, per op k
 * with mask M = GVL_Program.aOps[k].dwZoneMask:
 *   1  wStep := k                          (also for M = 0)
 *   2  if M <> 0: REQUEST := M             (same call / telegram as wStep)
 *   3  if M <> 0: wait (GRANT AND M) = M
 *   4  start delay; trajectory (x rVelScale x override); hold
 *   5  if M <> 0: REQUEST := 0
 *   6  if M <> 0: wait (GRANT AND M) = 0   (4-phase, before the next REQUEST)
 *   7  next op; after the last op: bDone, wStep := 0 (same call)
 *
 * Timing: all times are REAL seconds accumulated from rDt (seconds per call, the
 * device task interval). Motion time advances by rDt * rRate * rVelScale, delay and
 * hold by rDt (the override does not scale dwell times). No TIME() / TON is used.
 * Zero-time transitions fall through within one call (at most N_MAX_TRANSITIONS),
 * but wStep changes at most once per call, so every step is visible to the head PLC.
 * Joints (deg) are linearly interpolated between waypoints and published as rA1..rA6_deg.
 * Abort (bAbort level while busy): REQUEST := 0, wStep := 0, the pose is held.
 * The robot powers up at GVL_Program.arHomeDeg.
 *)

FUNCTION_BLOCK FB_ProgramPlayer
VAR_INPUT
    bStart          : BOOL;                 (* Rising edge: start wJob *)
    wJob            : WORD;                 (* Folge to play: PROD_FOLGE or HOME_FOLGE *)
    bAbort          : BOOL;                 (* Level: stop / cancel / drives off / E-stop *)
    dwGrant         : DWORD;                (* Zone GRANT bits from the head PLC *)
    rRate           : REAL := 1.0;          (* Speed override factor (1.0 = 100 %) *)
    rDt             : REAL := 0.02;         (* Seconds per call (task interval) *)
END_VAR

VAR_OUTPUT
    eState          : E_PlayerState;        (* Current state *)
    bBusy           : BOOL;                 (* Program running *)
    bDone           : BOOL;                 (* Latched until next start *)
    bError          : BOOL;                 (* Latched until next start *)
    wErrorCode      : WORD;                 (* Error code, GVL_Program.ERR_xxx *)
    wWarningCode    : WORD;                 (* Warning code, GVL_Program.WARN_xxx, latched until next start *)
    wStep           : WORD;                 (* 1-based op index, 0 = none *)
    dwRequest       : DWORD;                (* Zone REQUEST bits to the head PLC *)
    bAtHome         : BOOL;                 (* All joints within R_AT_HOME_TOL_DEG of arHomeDeg *)
    rA1_deg         : REAL;                 (* Axis 1 angle *)
    rA2_deg         : REAL;                 (* Axis 2 angle *)
    rA3_deg         : REAL;                 (* Axis 3 angle *)
    rA4_deg         : REAL;                 (* Axis 4 angle *)
    rA5_deg         : REAL;                 (* Axis 5 angle *)
    rA6_deg         : REAL;                 (* Axis 6 angle *)
END_VAR

VAR CONSTANT
    N_MAX_TRANSITIONS : INT := 8;           (* Fall-through bound per call *)
END_VAR

VAR
    _eState         : E_PlayerState := E_PlayerState.PS_IDLE;
    _rtrigStart     : R_TRIG;
    _bFirstCall     : BOOL := TRUE;

    (* === Current op === *)
    _nOp            : INT;                  (* 1-based op index, 0 = HOME_FOLGE move *)
    _dwMask         : DWORD;                (* Zone mask of the current op *)
    _bHomeMove      : BOOL;                 (* Current move is a blind home move *)
    _nWp            : INT;                  (* Current waypoint segment start *)
    _nLast          : INT;                  (* Last waypoint of the current op, 0 = none *)
    _rVel           : REAL;                 (* Velocity scale of the current move *)

    (* === Time (s) === *)
    _rDtCall        : REAL;                 (* rDt limited to 0..1 s *)
    _rRateCall      : REAL;                 (* rRate limited to >= 0 *)
    _rT             : REAL;                 (* Motion time since move start *)
    _rTimer         : REAL;                 (* Delay / hold timer *)
    _rDur           : REAL;                 (* Duration of the blind home move *)
    _rAlpha         : REAL;                 (* Interpolation factor 0..1 *)
    _rSpan          : REAL;                 (* Waypoint segment duration *)

    (* === Pose (deg) === *)
    _arQ            : ARRAY[1..6] OF REAL;  (* Current joint angles *)
    _arQ0           : ARRAY[1..6] OF REAL;  (* Pose at the start of a blind home move *)
    _arQa           : ARRAY[1..6] OF REAL;  (* Segment start waypoint *)
    _arQb           : ARRAY[1..6] OF REAL;  (* Segment end waypoint *)

    (* === Fall-through === *)
    _nPass          : INT;
    _bAdvance       : BOOL;                 (* A transition happened in this pass *)
    _bStepSet       : BOOL;                 (* wStep changed in this call *)
    _bMoveDone      : BOOL;
    _i              : INT;
END_VAR
