(*
 * FB_VASS_DeviceSimulator
 * Device simulator {{ROBOT_TAG}} ({{ROBOT_NS}}, station {{STATION}}), cell {{CELL_ID}}, tree {{TREE_ID}}.
 * Generated by {{GENERATOR}}.
 *
 * Simulates a KUKA KR C4 robot responding to VW VASS commands via PROFINET.
 *
 * This FB reads the PLC commands from its input images (PLC -> robot):
 *   aVassOutputData = copy of GVL_IO.aVassOutputData, abySafeOut = GVL_IO.bySafeOut0..7
 * and produces the robot status images (robot -> PLC):
 *   aVassInputData (bytes 16-27 = 0, the joint encoder fills them in PLC_PRG), abySafeIn.
 * PLC_PRG copies the images from / to GVL_IO; this FB never accesses GVL_IO.
 *
 * Job handshake (as the original simulator): drives on after 2 s, EXT mode, Ready,
 * JobRequest edge -> JobAck + job echo (clears ProgFinished), ProgStart edge -> start,
 * Stop/Cancel level -> stop, Reset held 500 ms -> clear error, gripper, speed override.
 * Job execution is delegated to FB_ProgramPlayer (GVL_Program):
 *   PROD_FOLGE: the bt2plc program; PLAN_ID (bytes PLAN_ID_BYTE..+1, latched at job accept)
 *               must equal GVL_Program.PLAN_ID at ProgStart, else ERR_PLAN_MISMATCH, no start.
 *   HOME_FOLGE: blind joint move to arHomeDeg (also on a HomeRequest [0].6 edge while Ready).
 *   other:      ERR_UNKNOWN_FOLGE, no start.
 * Zone protocol: wCurrentStep at bytes STEP_BYTE..+1, REQUEST DWORD LE at REQ_BYTE..+3,
 * GRANT DWORD LE read from bytes GRANT_BYTE..+3 (GVL_Program offsets).
 * At the end ProgRunning := FALSE, ProgFinished := TRUE and step := 0 in the same scan.
 *)

FUNCTION_BLOCK FB_VASS_DeviceSimulator
VAR_INPUT
    bEnable             : BOOL := TRUE;             (* Enable simulation *)
    wRobotID            : WORD := WORD#1;           (* Robot identification number 1-8 *)
    aVassOutputData     : ARRAY[0..31] OF BYTE;     (* VASS telegram PLC -> robot (GVL_IO.aVassOutputData) *)
    abySafeOut          : ARRAY[0..7] OF BYTE;      (* Safe outputs PLC -> robot (GVL_IO.bySafeOut0..7) *)
    rDt                 : REAL := 0.02;             (* Task interval in s (GVL_Program.R_TASK_S) *)
END_VAR

VAR_OUTPUT
    bActive             : BOOL;                     (* Simulator is active *)
    eCurrentMode        : E_RobotMode;              (* Current operating mode *)
    eProgramState       : E_ProgramState;           (* Current program state *)
    bSafetyOK           : BOOL;                     (* Safety system healthy *)
    aVassInputData      : ARRAY[0..31] OF BYTE;     (* VASS telegram robot -> PLC (bytes 16-27 = 0) *)
    abySafeIn           : ARRAY[0..7] OF BYTE;      (* Safe inputs robot -> PLC (GVL_IO.bySafeIn0..7) *)

    (* Joint angles from the program player (deg) *)
    rA1_deg             : REAL;
    rA2_deg             : REAL;
    rA3_deg             : REAL;
    rA4_deg             : REAL;
    rA5_deg             : REAL;
    rA6_deg             : REAL;

    (* Diagnostics *)
    wActiveJob          : WORD;                     (* Accepted job number (Folge) *)
    wCurrentStep        : WORD;                     (* Current op index, 0 = none *)
    wErrorCode          : WORD;                     (* Active error code *)
    dwRequest           : DWORD;                    (* Zone REQUEST bits sent to the head PLC *)
    dwGrant             : DWORD;                    (* Zone GRANT bits received from the head PLC *)
    ePlayerState        : E_PlayerState;            (* State of the program player *)
END_VAR

VAR
    (* === Internal Robot State === *)
    _bDrivesPowered     : BOOL;
    _bInExtMode         : BOOL;
    _bReady             : BOOL;
    _bError             : BOOL;
    _bProgRunning       : BOOL;
    _bAtHome            : BOOL := TRUE;
    _bInPosition        : BOOL := TRUE;
    _bProgFinished      : BOOL;
    _bJobAcknowledged   : BOOL;
    _bGripperClosed     : BOOL;
    _bPartPresent       : BOOL;
    _bPeriphReady       : BOOL := TRUE;

    _wActiveJob         : WORD;
    _wCurrentStep       : WORD;
    _wSpeed             : WORD := WORD#100;
    _wToolNr            : WORD := WORD#1;
    _wErrorCode         : WORD;
    _wWarningCode       : WORD;

    (* Simulated position (0.1mm units) *)
    _iPositionX         : INT := 5000;              (* 500.0 mm *)
    _iPositionY         : INT := 0;
    _iPositionZ         : INT := 10000;             (* 1000.0 mm *)

    (* === Safety State === *)
    _bSafe_DrivesOK     : BOOL := TRUE;
    _bSafe_Stopped      : BOOL := TRUE;
    _bSafe_EStopOK      : BOOL := TRUE;
    _bSafe_GatesClosed  : BOOL := TRUE;
    _bSafe_Fault        : BOOL;
    _bSafe_STO          : BOOL;
    _bSafe_SS1          : BOOL;

    (* PROFIsafe CRC simulation *)
    _bySafeTrailerStatus : BYTE;
    _nSafeCycleCount     : UDINT;

    (* === Timers === *)
    _tonDriveStartup    : TON;                      (* Simulate drive power-on delay *)
    _tonErrorReset      : TON;                      (* Simulate error reset delay *)
    _tonGripperAction   : TON;                      (* Simulate gripper open/close time *)

    (* === Edge Detection === *)
    _rtrigProgStart     : R_TRIG;
    _rtrigProgStop      : R_TRIG;
    _rtrigReset         : R_TRIG;
    _rtrigJobReq        : R_TRIG;
    _rtrigDrivesOn      : R_TRIG;
    _rtrigHome          : R_TRIG;
    _rtrigGripOpen      : R_TRIG;
    _rtrigGripClose     : R_TRIG;
    _rtrigSafeStop1     : R_TRIG;
    _rtrigSafeEStop     : R_TRIG;

    (* === Program player (bt2plc program / blind home) === *)
    _fbPlayer           : FB_ProgramPlayer;
    _bPlayerStart       : BOOL;                     (* Start pulse for the player *)
    _wPlayerJob         : WORD;                     (* Folge passed to the player *)
    _bStartOk           : BOOL;
    _wPlanId            : WORD;                     (* PLAN_ID latched at job accept *)
    _dwGrant            : DWORD;
    _dwRequest          : DWORD;
    _rRate              : REAL;                     (* Speed override factor *)
    _wPlayerWarning     : WORD;                     (* Last player warning (copy on change) *)

    (* === Decoded PLC commands (aVassOutputData bytes 0-1, abySafeOut byte 0) === *)
    _bCmdDrivesOn       : BOOL;                     (* [0].0 Drives on *)
    _bCmdProgStart      : BOOL;                     (* [0].1 Program start *)
    _bCmdProgStop       : BOOL;                     (* [0].2 Program stop *)
    _bCmdProgCancel     : BOOL;                     (* [0].3 Program cancel *)
    _bCmdModeExt        : BOOL;                     (* [0].4 EXT mode request *)
    _bCmdReset          : BOOL;                     (* [0].5 Reset *)
    _bCmdHome           : BOOL;                     (* [0].6 Home request *)
    _bCmdJobReq         : BOOL;                     (* [1].0 Job request *)
    _bCmdGripOpen       : BOOL;                     (* [1].1 Gripper open *)
    _bCmdGripClose      : BOOL;                     (* [1].2 Gripper close *)
    _bCmdSpeedOverride  : BOOL;                     (* [1].4 Apply speed override *)
    _bSafeCmdDriveEnable : BOOL;                    (* Safe [0].0 Drive enable *)
    _bSafeCmdEStop      : BOOL;                     (* Safe [0].1 External E-Stop *)
    _bSafeCmdSS1        : BOOL;                     (* Safe [0].2 Safe Stop 1 *)

    (* === Local working variables === *)
    _wRequestedJob      : WORD;
    _wSpeedCmd          : WORD;
    _nIdx               : INT;
    _i                  : INT;
END_VAR
