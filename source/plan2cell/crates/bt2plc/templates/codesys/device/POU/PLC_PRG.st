(*
 * PLC_PRG
 * Main program of the KUKA VASS device simulator {{ROBOT_TAG}} ({{ROBOT_NS}}, station {{STATION}}),
 * cell {{CELL_ID}}, tree {{TREE_ID}}. Generated by {{GENERATOR}}.
 *
 * I/O Flow (only this program accesses GVL_IO; FBs work on the local images):
 *   PLC -> PROFINET -> GVL_IO.aVassOutputData[0..31] -> aVassOutputData -> simulator reads commands
 *   PLC -> PROFIsafe -> GVL_IO.bySafeOut0..7         -> abySafeOut      -> simulator reads safe cmds
 *   simulator -> aVassInputData -> GVL_IO.aVassInputData[0..31] (whole array) -> PROFINET -> PLC
 *   simulator -> abySafeIn      -> GVL_IO.bySafeIn0..7 (scalars)              -> PROFIsafe -> PLC
 *
 * Joint angle flow:
 *   FB_ProgramPlayer (inside fbVassSimulator, GVL_Program) -> FB_JointAngleEncoder
 *   -> aVassInputData[16..27]
 *
 * Task: MainTask, interval GVL_Program.R_TASK_S (passed to the player as rDt)
 *)

PROGRAM PLC_PRG
VAR
    (* Main simulator instances *)
    fbVassSimulator         : FB_VASS_DeviceSimulator;
    fbSafetySimulator       : FB_PROFIsafe_Simulator;

    (* Joint angle encoding *)
    fbJointEncoder          : FB_JointAngleEncoder;

    (* === Configuration === *)
    bSimulatorEnable        : BOOL := TRUE;     (* Enable/disable simulator *)

    (* PROFIsafe parameters *)
    dwF_Source_Add          : DWORD := DWORD#1;
    dwF_Dest_Add            : DWORD := DWORD#1;
    tF_WD_Time              : TIME := T#500MS;

    (* === Local I/O images (copied from / to GVL_IO as a whole) === *)
    aVassOutputData         : ARRAY[0..31] OF BYTE;     (* PLC -> robot *)
    aVassInputData          : ARRAY[0..31] OF BYTE;     (* robot -> PLC *)
    abySafeOut              : ARRAY[0..7] OF BYTE;      (* PLC -> robot, GVL_IO.bySafeOut0..7 *)
    abySafeIn               : ARRAY[0..7] OF BYTE;      (* robot -> PLC, GVL_IO.bySafeIn0..7 *)

    (* === Diagnostic outputs === *)
    bSimActive              : BOOL;
    eMode                   : E_RobotMode;
    eProgState              : E_ProgramState;
    bSafetyHealthy          : BOOL;
    bSafeCommOK             : BOOL;
    wActiveJob              : WORD;
    wCurrentStep            : WORD;
    dwRequest               : DWORD;
    dwGrant                 : DWORD;
    ePlayerState            : E_PlayerState;

    (* Joint angle monitor (decoded back for verification) *)
    rMonitor_A1_deg         : REAL;
    rMonitor_A2_deg         : REAL;
    rMonitor_A3_deg         : REAL;
    rMonitor_A4_deg         : REAL;
    rMonitor_A5_deg         : REAL;
    rMonitor_A6_deg         : REAL;

    (* === Test/Debug signals === *)
    bTest_InjectError       : BOOL;
    bTest_InjectSafetyFault : BOOL;
    wTest_ErrorCode         : WORD := WORD#16#0010;

    _i                      : INT;
END_VAR
