(*
 * GVL_IO - Head PLC I/O, one block per robot
 * Generated by {{GENERATOR}} for cell {{CELL_ID}} (plan {{TREE_ID}})
 *
 * This is the PROFINET Controller (master) side.
 * From the controller's perspective:
 *   "Inputs"  = data received FROM the robot device (robot status)
 *   "Outputs" = data sent TO the robot device (PLC commands)
 *
 * Map in the I/O Mapping tab of each KUKA device under the PN-Controller:
 *   SafeIO_FDIO64_<tag> inputs  -> bySafeIn0_<tag>..bySafeIn7_<tag>
 *   SafeIO_FDIO64_<tag> outputs -> bySafeOut0_<tag>..bySafeOut7_<tag>
 *   VASS_DIO256_<tag> inputs    -> aVassInputData_<tag>
 *   VASS_DIO256_<tag> outputs   -> aVassOutputData_<tag>
 *
 * Only PLC_PRG accesses this GVL: whole arrays and single bytes are copied
 * into / out of FB_Cell (never write single elements of these arrays).
 *)

{attribute 'qualified_only'}
VAR_GLOBAL
{{#robots}}
    (* ========================================================================
       {{r.tag}} - {{r.ns}} - {{r.device_name}} ({{r.station}}, {{r.ip}})
       ======================================================================== *)

    (* SLOT 1 - PROFIsafe FDIO64: safe status FROM robot (8 bytes) *)
    bySafeIn0_{{r.tag}}            : BYTE;     (* Byte 0: Drives OK, Stopped, Reduced speed... *)
    bySafeIn1_{{r.tag}}            : BYTE;     (* Byte 1: Gates, E-Stop, Enabling... *)
    bySafeIn2_{{r.tag}}            : BYTE;     (* Byte 2: STO, SS1, SS2, SOS, SLS... *)
    bySafeIn3_{{r.tag}}            : BYTE;
    bySafeIn4_{{r.tag}}            : BYTE;
    bySafeIn5_{{r.tag}}            : BYTE;
    bySafeIn6_{{r.tag}}            : BYTE;
    bySafeIn7_{{r.tag}}            : BYTE;

    (* SLOT 1 - PROFIsafe FDIO64: safe commands TO robot (8 bytes) *)
    bySafeOut0_{{r.tag}}           : BYTE;     (* Byte 0: Drive enable, E-Stop, SS1, SS2, SLS... *)
    bySafeOut1_{{r.tag}}           : BYTE;     (* Byte 1: Zone enables *)
    bySafeOut2_{{r.tag}}           : BYTE;
    bySafeOut3_{{r.tag}}           : BYTE;
    bySafeOut4_{{r.tag}}           : BYTE;
    bySafeOut5_{{r.tag}}           : BYTE;
    bySafeOut6_{{r.tag}}           : BYTE;
    bySafeOut7_{{r.tag}}           : BYTE;

    (* SLOT 2 - DIO256 VASS telegram (32 bytes each direction) *)
    aVassInputData_{{r.tag}}       : ARRAY[0..31] OF BYTE;         (* VASS status FROM robot *)
    aVassOutputData_{{r.tag}}      : ARRAY[0..31] OF BYTE;         (* VASS commands TO robot *)

{{/robots}}
END_VAR
