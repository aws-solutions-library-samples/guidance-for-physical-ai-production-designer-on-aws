(*
 * FB_ZoneArbiter
 * Generated by {{GENERATOR}} for cell {{CELL_ID}} (plan {{TREE_ID}})
 *
 * Zone (mutex) and permit arbiter, data-driven by GVL_Cell (aTickets, anZoneFirst/Count,
 * aOps[].dwZoneMask / nPredFirst / nPredCount, aPreds).
 *
 * REQUEST / GRANT DWORD: bits 0..30 = zones 1..31, bit 31 = PERMIT (GVL_Cell.PERMIT_MASK).
 *   GP_PLANNED : a zone is granted only to its next ticket holder, only if the request
 *                equals the op's full mask and the reported op index matches the ticket.
 *   GP_FCFS    : free zones to any requester whose request equals the op mask, oldest
 *                request first, ties by robot index; zones of an older requester that
 *                waits only for occupied zones are reserved against younger ones.
 *                BT ordering is NOT preserved by the zones.
 *   PERMIT     : granted for op (r, k) iff every pred (q, j) of the op has anDone[q] >= j.
 *                Not a mutex: never held against other robots, released when bit 31 drops.
 * Both policies grant all bits of an op in the same scan (all-or-nothing).
 *
 * Checks: 4-phase handshake (op index must not change while a grant is held), release
 * only by a robot that runs OK, holder raising extra bits; request mask and ticket checks
 * are evaluated once (op index, REQUEST) has been stable for tDebounce.
 * Fail closed: any violation latches bFault and drops all grants until bReset.
 *
 * Timing uses tNow (monotonic TIME from the caller's clock), no timer instances.
 *)

FUNCTION_BLOCK FB_ZoneArbiter
VAR_INPUT
    bReset              : BOOL;             (* Level: rewind tickets, clear holders, grants and fault *)
    bEnable             : BOOL;             (* New grants allowed *)
    ePolicy             : E_GrantPolicy := E_GrantPolicy.GP_PLANNED;
    tDebounce           : TIME := T#200MS;  (* (op index, REQUEST) stable time before mask / ticket checks *)
    tNow                : TIME;             (* Monotonic time of this scan *)
    abRobotOk           : ARRAY[1..{{N_ROBOTS}}] OF BOOL;      (* Production job running, no robot error *)
    awStep              : ARRAY[1..{{N_ROBOTS}}] OF WORD;      (* Reported op index, 0 = none *)
    adwReq              : ARRAY[1..{{N_ROBOTS}}] OF DWORD;     (* REQUEST DWORD *)
    anDone              : ARRAY[1..{{N_ROBOTS}}] OF INT;       (* Ops completed per robot in this cycle *)
END_VAR

VAR_OUTPUT
    adwGrant            : ARRAY[1..{{N_ROBOTS}}] OF DWORD;     (* GRANT DWORD per robot *)
    anHolder            : ARRAY[1..{{N_ZONES_DIM}}] OF INT;    (* Robot holding the zone, 0 = free *)
    anTicket            : ARRAY[1..{{N_ZONES_DIM}}] OF INT;    (* Next ticket index in GVL_Cell.aTickets *)
    bAllConsumed        : BOOL;             (* No zone held and (planned) every ticket consumed *)
    bFault              : BOOL;
    eFault              : E_CellError;
    nFaultRobot         : INT;
    nFaultZone          : INT;
END_VAR

VAR
    _udiScan            : UDINT;            (* Scan counter: request age for FCFS *)
    _audiWaitSince      : ARRAY[1..{{N_ROBOTS}}] OF UDINT;     (* Scan of the first pending request, 0 = none *)
    _abPicked           : ARRAY[1..{{N_ROBOTS}}] OF BOOL;
    _anGrantStep        : ARRAY[1..{{N_ROBOTS}}] OF INT;       (* Op index at the time of the grant *)
    _awPrevStep         : ARRAY[1..{{N_ROBOTS}}] OF WORD;
    _adwPrevReq         : ARRAY[1..{{N_ROBOTS}}] OF DWORD;
    _atChange           : ARRAY[1..{{N_ROBOTS}}] OF TIME;      (* tNow of the last (op index, REQUEST) change *)
    _abStable           : ARRAY[1..{{N_ROBOTS}}] OF BOOL;
    _eNew               : E_CellError;
    _nNewRobot          : INT;
    _nNewZone           : INT;
    _k                  : INT;
    _r                  : INT;
    _rr                 : INT;
    _rSel               : INT;
    _z                  : INT;
    _p                  : INT;
    _q                  : INT;
    _iOp                : INT;
    _nStep              : INT;
    _nTicket            : INT;
    _nLastTicket        : INT;
    _nPredFirst         : INT;
    _nPredLast          : INT;
    _dwBit              : DWORD;
    _dwExp              : DWORD;            (* Expected REQUEST of the reported op *)
    _dwZones            : DWORD;            (* Zone bits of _dwExp (permit bit removed) *)
    _dwReserved         : DWORD;            (* FCFS: zones reserved by older requesters this scan *)
    _bOk                : BOOL;             (* All zones of the op grantable *)
    _bPermitOk          : BOOL;             (* All permit predecessors done *)
    _bPending           : BOOL;
END_VAR
