(*
 * FB_Cell
 * Generated by {{GENERATOR}} for cell {{CELL_ID}} (plan {{TREE_ID}})
 *
 * Cell control for {{N_ROBOTS}} robot(s): bring-up, blind homing (HOME_FOLGE), production
 * cycle (awRobotProdFolge started on every active robot; the robots run autonomously),
 * zone / permit arbitration (FB_ZoneArbiter), supervision (op index sequence, per-op
 * watchdog, zone-wait deadline, stall, program completeness), abort (stop all, drop grants,
 * rewind tickets), recovery confirmation and reset (Reset held >= 500 ms).
 *
 *   INIT -> BRINGUP -> HOMING_SELECT <-> HOMING_RUN -> READY -> START_JOBS -> RUNNING
 *        -> CYCLE_DONE -> READY ...
 *   any fault -> ABORTING -> ERROR -(bReset)-> RESETTING -> BRINGUP -> HOMING_SELECT ...
 *   abort with a robot inside its program (op index > 0, grant held, program left
 *   incomplete or away from home), or the first bring-up after INIT (head restart /
 *   download) with an active robot away from home:
 *        ... BRINGUP -> RECOVERY -(bRecoveryConfirm)-> RESETTING -> BRINGUP -> HOMING_SELECT
 *        (operator moves the robots clear in T1 first; homing is then always sequential)
 *   Start-up homing stays automatic when every active robot is at home.
 *
 * Operator: a bStop edge is latched in every state until it is consumed - abort (normal
 * states), cancel of the reset -> ERROR (INIT / RESETTING, driver Reset low), or cleared
 * (ERROR). A bReset edge in ABORTING is applied when ERROR is reached.
 *
 * Scan order: robot drivers (commands of the previous scan) -> op index tracking ->
 * faults known so far -> arbiter (this scan's inputs, no new grants after a fault) ->
 * watchdogs -> faults -> state machine -> GRANT bytes (0 when a fault is latched).
 * Op supervision runs whenever a robot's production job is commanded / running, in any
 * cell state: op index sequence, zone ops left without grant, op index 0 while running.
 *
 * Portable: one FB_VassRobot instance per robot (no FB instance arrays), timers are
 * TIME stamps of one free-running clock (_tNow).
 *)

FUNCTION_BLOCK FB_Cell
VAR_INPUT
    bEnable             : BOOL := TRUE;
    bAutoRun            : BOOL := TRUE;     (* Level: start a cycle whenever READY *)
    bStart              : BOOL;             (* Rising edge: start one cycle *)
    bStop               : BOOL;             (* Rising edge: abort (ERR_OPERATOR_STOP) *)
    bReset              : BOOL;             (* Rising edge in CS_ERROR: reset robots and cell *)
    bRecoveryConfirm    : BOOL;             (* Rising edge (from CS_ERROR on, while bRecoveryRequired): robots cleared *)
    astIn               : ARRAY[1..{{N_ROBOTS}}] OF ST_RobotIn;    (* Robot inputs (copied from GVL_IO) *)
END_VAR

VAR_OUTPUT
    astOut              : ARRAY[1..{{N_ROBOTS}}] OF ST_RobotOut;   (* Robot outputs (copied to GVL_IO) *)
    eState              : E_CellState;
    eError              : E_CellError;      (* First fault, ERR_NONE when OK *)
    nErrorRobot         : INT;              (* Robot of the fault, 0 = cell *)
    nErrorOp            : INT;              (* Op index of the fault, 0 = none *)
    nErrorZone          : INT;              (* Zone of the fault, 0 = none *)
    bCycleActive        : BOOL;             (* START_JOBS or RUNNING *)
    bError              : BOOL;             (* Fault latched until the reset is done *)
    bHomingRequired     : BOOL;         (* Profile vw-ks24: a robot is not at home and must be
                                           jogged there by the operator (no blind HOME Folge) *)
    bRecoveryRequired   : BOOL;             (* bRecoveryConfirm needed before homing (abort mid-cycle / start-up away from home) *)
    udiCycles           : UDINT;            (* Completed production cycles *)
    tLastCycle          : TIME;             (* Duration of the last cycle (RUNNING) *)
    aeRobotState        : ARRAY[1..{{N_ROBOTS}}] OF E_RobotState;
    aeRobotError        : ARRAY[1..{{N_ROBOTS}}] OF E_CellError;
    awStep              : ARRAY[1..{{N_ROBOTS}}] OF WORD;          (* Reported op index *)
    adwReq              : ARRAY[1..{{N_ROBOTS}}] OF DWORD;         (* REQUEST per robot *)
    adwGrant            : ARRAY[1..{{N_ROBOTS}}] OF DWORD;         (* GRANT per robot (as sent) *)
    anDone              : ARRAY[1..{{N_ROBOTS}}] OF INT;           (* Ops completed in this cycle *)
    anHolder            : ARRAY[1..{{N_ZONES_DIM}}] OF INT;        (* Zone holder, 0 = free *)
    anTicket            : ARRAY[1..{{N_ZONES_DIM}}] OF INT;        (* Next ticket per zone *)
END_VAR

VAR
    (* ========================================================================
       ROBOT DRIVERS (one instance per robot) AND ARBITER
       ======================================================================== *)
{{#robots}}    fbRobot_{{r.tag}}          : FB_VassRobot;     (* {{r.i}}: {{r.ns}} - {{r.device_name}} ({{r.ip}}) *)
{{/robots}}    fbArbiter           : FB_ZoneArbiter;

    (* ========================================================================
       CELL STATE
       ======================================================================== *)
    _eState             : E_CellState := E_CellState.CS_INIT;
    _eLastState         : E_CellState := E_CellState.CS_INIT;
    _bFault             : BOOL;             (* Fault latched (eError valid) *)
    _bPowerOn           : BOOL;             (* Robots: bring up *)
    _bArbReset          : BOOL := TRUE;     (* Arbiter reset in the next scan *)
    _bNeedRecovery      : BOOL;             (* Latched at an abort with a robot inside its program *)
    _bRecoveryHoming    : BOOL;             (* Homing after recovery: always sequential *)
    _bEngaged           : BOOL;             (* A robot is inside its production program / holds a grant *)
    _bConfirmLatch      : BOOL;             (* bRecoveryConfirm edge seen since CS_ERROR *)
    _bFirstBringup      : BOOL := TRUE;     (* First bring-up after CS_INIT: check the home poses *)
    _bStopReq           : BOOL;             (* bStop edge, latched until consumed *)
    _bResetReq          : BOOL;             (* bReset edge seen in CS_ABORTING, applied in CS_ERROR *)
    _bFaultScan         : BOOL;             (* Fault source known before the arbiter call (this scan) *)

    (* ========================================================================
       ROBOT STATUS (copied from the driver instances every scan)
       ======================================================================== *)
    _abIdle             : ARRAY[1..{{N_ROBOTS}}] OF BOOL;
    _abBusy             : ARRAY[1..{{N_ROBOTS}}] OF BOOL;
    _abDrvError         : ARRAY[1..{{N_ROBOTS}}] OF BOOL;          (* Driver in RS_ERROR / RS_RESET *)
    _abJobActive        : ARRAY[1..{{N_ROBOTS}}] OF BOOL;
    _abJobDone          : ARRAY[1..{{N_ROBOTS}}] OF BOOL;
    _abAtHome           : ARRAY[1..{{N_ROBOTS}}] OF BOOL;
    _abRobotError       : ARRAY[1..{{N_ROBOTS}}] OF BOOL;          (* Robot reports Error *)
    _abProgRunning      : ARRAY[1..{{N_ROBOTS}}] OF BOOL;          (* Robot reports ProgRunning *)
    _awLastStep         : ARRAY[1..{{N_ROBOTS}}] OF WORD;

    (* ========================================================================
       COMMANDS TO THE ROBOT DRIVERS (used in the next scan)
       ======================================================================== *)
    _abJobCmd           : ARRAY[1..{{N_ROBOTS}}] OF BOOL;
    _awJob              : ARRAY[1..{{N_ROBOTS}}] OF WORD;
    _abProdCmd          : ARRAY[1..{{N_ROBOTS}}] OF BOOL;          (* Commanded job is the production Folge *)
    _abStopCmd          : ARRAY[1..{{N_ROBOTS}}] OF BOOL;
    _abResetCmd         : ARRAY[1..{{N_ROBOTS}}] OF BOOL;
    _abHoming           : ARRAY[1..{{N_ROBOTS}}] OF BOOL;

    (* ========================================================================
       PRODUCTION CYCLE SUPERVISION
       ======================================================================== *)
    _abHasJob           : ARRAY[1..{{N_ROBOTS}}] OF BOOL;          (* Active robot with ops *)
    _abRobotOk          : ARRAY[1..{{N_ROBOTS}}] OF BOOL;          (* Arbiter input *)
    _anDone             : ARRAY[1..{{N_ROBOTS}}] OF INT;           (* Arbiter input: ops completed *)
    _anStepSeen         : ARRAY[1..{{N_ROBOTS}}] OF INT;           (* Op index seen last scan (incl. 0) *)
    _anLastStep         : ARRAY[1..{{N_ROBOTS}}] OF INT;           (* Last validated non-zero op index *)
    _abGranted          : ARRAY[1..{{N_ROBOTS}}] OF BOOL;          (* Current zone op has been granted *)
    _abOpRun            : ARRAY[1..{{N_ROBOTS}}] OF BOOL;          (* Op watchdog running *)
    _atOpStart          : ARRAY[1..{{N_ROBOTS}}] OF TIME;
    _abStallRun         : ARRAY[1..{{N_ROBOTS}}] OF BOOL;          (* Stall watchdog running *)
    _atStallStart       : ARRAY[1..{{N_ROBOTS}}] OF TIME;
    _abZeroRun          : ARRAY[1..{{N_ROBOTS}}] OF BOOL;          (* Op index 0 watchdog running *)
    _atZeroStart        : ARRAY[1..{{N_ROBOTS}}] OF TIME;
    _tCycleStart        : TIME;

    (* ========================================================================
       TIME BASE / TIMERS / EDGES
       ======================================================================== *)
    _tonClock           : TON;              (* Free-running clock, restarted every hour *)
    _tClockBase         : TIME;
    _tNow               : TIME;             (* Monotonic time of this scan *)
    _tonState           : TON;              (* State timeout, restarts on every state change *)
    _tLimit             : TIME;
    _rtrigStart         : R_TRIG;
    _rtrigStop          : R_TRIG;
    _rtrigReset         : R_TRIG;
    _rtrigConfirm       : R_TRIG;

    (* ========================================================================
       SCRATCH
       ======================================================================== *)
    _eNew               : E_CellError;
    _nNewRobot          : INT;
    _nNewOp             : INT;
    _nHomeCount         : INT;
    _nDone              : INT;
    _r                  : INT;
    _iOp                : INT;
    _nStep              : INT;
    _nPrev              : INT;              (* Op index that is left *)
    _tZeroLimit         : TIME;
    _dwGrant            : DWORD;
    _bBypass            : BOOL;
    _bAll               : BOOL;
    _bSequential        : BOOL;

    (* Profile vw-ks24: interlock grant / partner release encoding *)
    _z                  : INT;
    _q                  : INT;
    _nIl                : INT;
    _nIlQ               : INT;
    _nIdx               : INT;
    _nB                 : INT;
    _nBit               : INT;
    _wBits              : WORD;
    _bGrantBit          : BOOL;
    _bPartner           : BOOL;
END_VAR
