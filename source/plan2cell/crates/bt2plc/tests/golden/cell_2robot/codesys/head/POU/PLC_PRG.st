(*
 * PLC_PRG - Head PLC cell program
 * Generated by bt2plc 0.1.0 for cell cell_2robot (plan bt_1791274820_cell_2robot)
 *
 * Copies every robot's GVL_IO block into the cell's input array, runs FB_Cell and
 * copies the commands back (whole arrays / single bytes only).
 *
 * Operator (plain VARs, pulses are cleared after each scan):
 *   bAutoRun          Level: start a cycle whenever the cell is READY
 *                     (initialised from GVL_Cell.AUTO_RUN on the first scan)
 *   bStart            Pulse: start one cycle
 *   bStop             Pulse: abort (ERR_OPERATOR_STOP); latched in every state, also
 *                     cancels a running reset (CS_RESETTING -> CS_ERROR)
 *   bReset            Pulse: reset after an error (a pulse during CS_ABORTING is kept)
 *   bRecoveryConfirm  Pulse: after an abort mid-cycle or a start-up with an active robot
 *                     away from home, robots moved clear -> sequential blind homing
 *
 * Status: PLC_PRG.fbCell.eState / eError / nErrorRobot / nErrorOp / nErrorZone /
 *         bRecoveryRequired / udiCycles / tLastCycle / aeRobotState / awStep / adwGrant ...
 *
 * Task: MainTask (4 ms cycle)
 *)

PROGRAM PLC_PRG
VAR
    (* Cell controller *)
    fbCell              : FB_Cell;

    (* === Operator === *)
    bAutoRun            : BOOL := TRUE;     (* overwritten by GVL_Cell.AUTO_RUN on the first scan *)
    bStart              : BOOL;
    bStop               : BOOL;
    bReset              : BOOL;
    bRecoveryConfirm    : BOOL;

    (* === Status readback === *)
    eCellState          : E_CellState;
    eCellError          : E_CellError;
    bCellError          : BOOL;
    bRecoveryRequired   : BOOL;
    udiCycles           : UDINT;

    (* Robot input images for fbCell *)
    _astIn              : ARRAY[1..1] OF ST_RobotIn;
    _bFirstScan         : BOOL := TRUE;
END_VAR
