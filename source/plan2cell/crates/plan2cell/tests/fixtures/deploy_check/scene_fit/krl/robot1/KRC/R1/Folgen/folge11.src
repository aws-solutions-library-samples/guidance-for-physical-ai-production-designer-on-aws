&ACCESS RVP
&REL 1
&COMMENT bt2krl vw-ks24 production Folge 11 plan 16#A1BE
DEF FOLGE11()
   ; Generated by bt2krl 0.1.0 from bt2plc plan bt_1792156523_scene_fit (cell scene_fit), PLAN_ID 16#A1BE
   ; Robot robot1 (R1), controller robot1, model unknown, joint mapping identity
   ; Profile vw-ks24 (VW KS24 / TPVW 8.1.8).
   ; Do not edit: regenerate with bt2krl (plain KRL, no inline forms).
   ; Production Folge: 3 ops; per op: op index BT_PKTNR, interlock request + MAKRO20 handshake, motion (exact stop at the end), hold, interlock release
   ; The VW tech package does the Folge handshake (cell.src, AUE_INIT/WAIT/END).
   ;FOLD AUE INIT
      VW(#VW_AUE_INIT,TRUE)
      PENTER:
      INTERRUPT DECL 10 WHEN $CYCFLAG[254]==FALSE DO VW(#FB_STOP,TRUE)
      INTERRUPT ON 10
      INT10=TRUE
   ;ENDFOLD
   ;FOLD VWP0 P0 10 PCT
      ; P0 = home: VW_INIT runs BAS(#INITMOV); AUE_WAIT later sets $H_POS here
      VW(#VW_INIT,TRUE)
      VW_USR_R (#USR_INIT)
      BAS(#VEL_PTP,10)
      $APO.CPTP=100
      PTP P0
      $OUT[15]=TRUE ; PF0 Grundstellung
      ; MAKRO0 RUECKSETZEN_EA: resets A33-A96 (also the tool releases)
      SEL_RES=SELECT(#MAKRO,0,TRUE,,,,,FALSE)
   ;ENDFOLD
   ;FOLD VWAUEWAIT
      VW(#VW_AUE_WAIT,TRUE )
      IF N_VW==TRUE THEN
         GOTO PEXIT
      ENDIF
   ;ENDFOLD
   ;FOLD VWSTART 16#00000003
      ; release every interlock this robot uses: IL01=V1 IL02=V2
      $OUT[15]=FALSE ; PF0 off
      ; MAKRO50 Ini Merker: the cyclic flags of the driving conditions
      SEL_RES=SELECT(#MAKRO,50,TRUE,,,,,FALSE)
      $OUT[41]=TRUE ; release V1
      $OUT[42]=TRUE ; release V2
   ;ENDFOLD
   ;FOLD VWFB 16#00000000
      VALCYCFL30=$CYCFLAG[254]
      $CYCFLAG[254]=($CYCFLAG[30]) AND $CYCFLAG[255] OR ($TIMER[61]<0)
      VW(#FB_CHECK,TRUE)
   ;ENDFOLD
   ;FOLD OP 1 W02 MASK 16#00000001
      ; zones IL01
      BT_PKTNR=1
      ;FOLD VWLOCK 16#00000001
         ; enter IL01=V1
         $OUT[81]=TRUE ; request V1
         ; MAKRO20 semantics, inline for these interlocks only
         $OUT[41]=$OUT[41] OR $OUT[81]
         ; PLC grant of the request
         $LOOP_MSG[]="E81"
         $LOOP_CONT=TRUE
         WAIT FOR ($IN[81]) OR (NOT $LOOP_CONT AND ($MODE_OP<>#EX))
         $LOOP_MSG[]="                                                                                                                                "
         ; partner release
         $LOOP_MSG[]="E41"
         $LOOP_CONT=TRUE
         WAIT FOR ($IN[41]) OR (NOT $LOOP_CONT AND ($MODE_OP<>#EX))
         $LOOP_MSG[]="                                                                                                                                "
         $OUT[41]=FALSE ; occupied
         $OUT[81]=FALSE
      ;ENDFOLD
      ;FOLD VWFB 16#00000001
         VALCYCFL30=$CYCFLAG[254]
         $CYCFLAG[254]=($CYCFLAG[30] AND $IN[41]) AND $CYCFLAG[255] OR ($TIMER[61]<0)
         VW(#FB_CHECK,TRUE)
      ;ENDFOLD
      BAS(#VEL_PTP,3)
      PTP P1 C_PTP
      BAS(#VEL_PTP,5)
      PTP P2 C_PTP
      BAS(#VEL_PTP,8)
      PTP P3 C_PTP
      BAS(#VEL_PTP,11)
      PTP P4 C_PTP
      BAS(#VEL_PTP,13)
      PTP P5 C_PTP
      BAS(#VEL_PTP,12)
      PTP P6 C_PTP
      BAS(#VEL_PTP,9)
      PTP P7 C_PTP
      BAS(#VEL_PTP,7)
      PTP P8 C_PTP
      BAS(#VEL_PTP,5)
      PTP P9 C_PTP
      BAS(#VEL_PTP,2)
      PTP P10 C_PTP
      BAS(#VEL_PTP,6)
      PTP P11 C_PTP
      BAS(#VEL_PTP,8)
      PTP P12 C_PTP
      BAS(#VEL_PTP,3)
      PTP P13
      WAIT SEC 0.5 ; hold
      ;FOLD VWUNLOCK 16#00000001
         ; leave IL01=V1
         $OUT[41]=TRUE ; release V1
      ;ENDFOLD
      ;FOLD VWFB 16#00000000
         VALCYCFL30=$CYCFLAG[254]
         $CYCFLAG[254]=($CYCFLAG[30]) AND $CYCFLAG[255] OR ($TIMER[61]<0)
         VW(#FB_CHECK,TRUE)
      ;ENDFOLD
      WAIT SEC 0.1 ; step dwell
   ;ENDFOLD
   ;FOLD OP 2 W04 MASK 16#00000002
      ; zones IL02
      BT_PKTNR=2
      ;FOLD VWLOCK 16#00000002
         ; enter IL02=V2
         $OUT[82]=TRUE ; request V2
         ; MAKRO20 semantics, inline for these interlocks only
         $OUT[42]=$OUT[42] OR $OUT[82]
         ; PLC grant of the request
         $LOOP_MSG[]="E82"
         $LOOP_CONT=TRUE
         WAIT FOR ($IN[82]) OR (NOT $LOOP_CONT AND ($MODE_OP<>#EX))
         $LOOP_MSG[]="                                                                                                                                "
         ; partner release
         $LOOP_MSG[]="E42"
         $LOOP_CONT=TRUE
         WAIT FOR ($IN[42]) OR (NOT $LOOP_CONT AND ($MODE_OP<>#EX))
         $LOOP_MSG[]="                                                                                                                                "
         $OUT[42]=FALSE ; occupied
         $OUT[82]=FALSE
      ;ENDFOLD
      ;FOLD VWFB 16#00000002
         VALCYCFL30=$CYCFLAG[254]
         $CYCFLAG[254]=($CYCFLAG[30] AND $IN[42]) AND $CYCFLAG[255] OR ($TIMER[61]<0)
         VW(#FB_CHECK,TRUE)
      ;ENDFOLD
      BAS(#VEL_PTP,4)
      PTP P14 C_PTP
      PTP P15 C_PTP
      BAS(#VEL_PTP,10)
      PTP P16 C_PTP
      BAS(#VEL_PTP,13)
      PTP P17 C_PTP
      BAS(#VEL_PTP,11)
      PTP P18 C_PTP
      BAS(#VEL_PTP,7)
      PTP P19 C_PTP
      BAS(#VEL_PTP,3)
      PTP P20 C_PTP
      BAS(#VEL_PTP,6)
      PTP P21 C_PTP
      BAS(#VEL_PTP,8)
      PTP P22 C_PTP
      BAS(#VEL_PTP,3)
      PTP P23
      WAIT SEC 0.5 ; hold
      ;FOLD VWUNLOCK 16#00000002
         ; leave IL02=V2
         $OUT[42]=TRUE ; release V2
      ;ENDFOLD
      ;FOLD VWFB 16#00000000
         VALCYCFL30=$CYCFLAG[254]
         $CYCFLAG[254]=($CYCFLAG[30]) AND $CYCFLAG[255] OR ($TIMER[61]<0)
         VW(#FB_CHECK,TRUE)
      ;ENDFOLD
      WAIT SEC 0.1 ; step dwell
   ;ENDFOLD
   ;FOLD OP 3 HOME MASK 16#00000001
      ; zones IL01
      BT_PKTNR=3
      ;FOLD VWLOCK 16#00000001
         ; enter IL01=V1
         $OUT[81]=TRUE ; request V1
         ; MAKRO20 semantics, inline for these interlocks only
         $OUT[41]=$OUT[41] OR $OUT[81]
         ; PLC grant of the request
         $LOOP_MSG[]="E81"
         $LOOP_CONT=TRUE
         WAIT FOR ($IN[81]) OR (NOT $LOOP_CONT AND ($MODE_OP<>#EX))
         $LOOP_MSG[]="                                                                                                                                "
         ; partner release
         $LOOP_MSG[]="E41"
         $LOOP_CONT=TRUE
         WAIT FOR ($IN[41]) OR (NOT $LOOP_CONT AND ($MODE_OP<>#EX))
         $LOOP_MSG[]="                                                                                                                                "
         $OUT[41]=FALSE ; occupied
         $OUT[81]=FALSE
      ;ENDFOLD
      ;FOLD VWFB 16#00000001
         VALCYCFL30=$CYCFLAG[254]
         $CYCFLAG[254]=($CYCFLAG[30] AND $IN[41]) AND $CYCFLAG[255] OR ($TIMER[61]<0)
         VW(#FB_CHECK,TRUE)
      ;ENDFOLD
      BAS(#VEL_PTP,5)
      PTP P24 C_PTP
      BAS(#VEL_PTP,2)
      PTP P25 C_PTP
      BAS(#VEL_PTP,6)
      PTP P26 C_PTP
      BAS(#VEL_PTP,9)
      PTP P27 C_PTP
      BAS(#VEL_PTP,12)
      PTP P28 C_PTP
      BAS(#VEL_PTP,15)
      PTP P29 C_PTP
      BAS(#VEL_PTP,18)
      PTP P30 C_PTP
      BAS(#VEL_PTP,17)
      PTP P31 C_PTP
      BAS(#VEL_PTP,14)
      PTP P32 C_PTP
      BAS(#VEL_PTP,11)
      PTP P33 C_PTP
      BAS(#VEL_PTP,6)
      PTP P34 C_PTP
      BAS(#VEL_PTP,2)
      PTP P35
      ;FOLD VWMAKRO 15
         ; Gesamtfertigmeldung
         SEL_RES=SELECT(#MAKRO,15,TRUE,,,,,FALSE)
      ;ENDFOLD
      ;FOLD VWUNLOCK 16#00000001
         ; leave IL01=V1
         $OUT[41]=TRUE ; release V1
      ;ENDFOLD
      ;FOLD VWFB 16#00000000
         VALCYCFL30=$CYCFLAG[254]
         $CYCFLAG[254]=($CYCFLAG[30]) AND $CYCFLAG[255] OR ($TIMER[61]<0)
         VW(#FB_CHECK,TRUE)
      ;ENDFOLD
      WAIT SEC 0.1 ; step dwell
   ;ENDFOLD
   BT_PKTNR=0
   ;FOLD AUE END
      VW(#VW_AUE_END,TRUE)
      GOTO PENTER
      PEXIT:
   ;ENDFOLD
END