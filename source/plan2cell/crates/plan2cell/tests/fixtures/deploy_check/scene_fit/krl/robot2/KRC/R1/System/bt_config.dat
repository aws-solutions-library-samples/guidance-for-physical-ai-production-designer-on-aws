; bt2krl vw-ks24: merge into KRC/R1/System/$config.dat (fold USER GLOBALS), robot robot2 plan 16#A1BE
; The VW KS24 standard already declares PRG_NR, PRG_NR_REFL, SEL_RES, INT10, VALCYCFL30,
; N_VW and the interlock signals A41-56 / A81-96; only what bt2krl adds is listed here.
;FOLD BT2KRL robot2 16#A1BE
   SIGNAL BT_PKTNR $OUT[97] TO $OUT[112] ; op index (the outputs of the VW P_PktNr_SPS, which is local to vw_usr_r)
   ; no PLAN_ID check: the VW standard has no signal for it (see INSTALL.md)
;ENDFOLD