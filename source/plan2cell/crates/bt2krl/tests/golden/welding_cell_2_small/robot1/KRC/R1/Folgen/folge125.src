&ACCESS RVP
&REL 1
&COMMENT bt2krl sim home Folge 125 plan 16#F77E
DEF FOLGE125()
   DECL REAL BT_V,BT_T
   ; Generated by bt2krl 0.1.0 from bt2plc plan bt_1790934549_welding_cell_2_small (cell welding_cell_2_small), PLAN_ID 16#F77E
   ; Robot robot1 (R1), controller robot1, model KR240R2900_ULTRA, joint mapping identity
   ; Profile sim (bt2plc simulator telegram). NEVER install on a VW KS24 robot:
   ; its signals collide with the VW standard (Fertigmeldung, interlocks, PRG_NR).
   ; Do not edit: regenerate with bt2krl (plain KRL, no inline forms).
   ; HOME Folge: blind joint PTP to home_pose_deg; no step, no zones
   ;FOLD INI
      BAS(#INITMOV,0)
      $ADVANCE=3
      $APO.CPTP=100
   ;ENDFOLD
   BT_RUN=TRUE
   ;FOLD HOME MOVE PHOME 7.0 S
      ; Velocity from the current pose so that the PTP takes about the home time
      BT_V=ABS(PHOME.A1-$AXIS_ACT.A1)/105.1
      BT_T=ABS(PHOME.A2-$AXIS_ACT.A2)/101.0
      IF BT_T>BT_V THEN
         BT_V=BT_T
      ENDIF
      BT_T=ABS(PHOME.A3-$AXIS_ACT.A3)/107.0
      IF BT_T>BT_V THEN
         BT_V=BT_T
      ENDIF
      BT_T=ABS(PHOME.A4-$AXIS_ACT.A4)/135.7
      IF BT_T>BT_V THEN
         BT_V=BT_T
      ENDIF
      BT_T=ABS(PHOME.A5-$AXIS_ACT.A5)/128.8
      IF BT_T>BT_V THEN
         BT_V=BT_T
      ENDIF
      BT_T=ABS(PHOME.A6-$AXIS_ACT.A6)/205.9
      IF BT_T>BT_V THEN
         BT_V=BT_T
      ENDIF
      BT_V=100.0*BT_V/7.0
      IF BT_V<1.0 THEN
         BT_V=1.0
      ENDIF
      IF BT_V>100.0 THEN
         BT_V=100.0
      ENDIF
      BAS(#VEL_PTP,BT_V)
      PTP PHOME
   ;ENDFOLD
   ;FOLD DONE
      WAIT SEC 0 ; advance-run stop
      BT_FIN=TRUE
      BT_RUN=FALSE
   ;ENDFOLD
END