         BT_REQ0=0
         BT_REQ1=0
         BT_REQ2=0
         BT_REQ3=0
      ENDIF
   ;ENDFOLD
   ;FOLD STATUS
      ; ProgRunning low only after ProgFinished is out: read BT_RUN first, write BT_O_FIN first
      BT_PRUN=BT_RUN AND NOT BT_ABRT
      BT_O_FIN=BT_FIN
      BT_O_RUN=BT_PRUN
      BT_O_DRIVES=$PERI_RDY
      BT_O_HOME=(ABS($AXIS_ACT.A1-BT_HOME.A1)<=0.5) AND (ABS($AXIS_ACT.A2-BT_HOME.A2)<=0.5) AND (ABS($AXIS_ACT.A3-BT_HOME.A3)<=0.5) AND (ABS($AXIS_ACT.A4-BT_HOME.A4)<=0.5) AND (ABS($AXIS_ACT.A5-BT_HOME.A5)<=0.5) AND (ABS($AXIS_ACT.A6-BT_HOME.A6)<=0.5)
      BT_O_INPOS=NOT BT_RUN
      BT_O_EXT=($MODE_OP==#EX)
      BT_O_READY=BT_READY
      BT_O_ERROR=BT_ERR
      BT_O_WARN=(BT_WCODE<>0)
      BT_O_GATES=$USER_SAF
      BT_O_ESTOP=$ALARM_STOP
      BT_O_JOBACK=BT_ACK
      BT_O_PERIPH=TRUE
      BT_ECHO=BT_JOBNR
      BT_ERRCODE=BT_ECODE
      BT_WARNCODE=BT_WCODE
   ;ENDFOLD
   ;FOLD JOINT ENCODER: A1..A6 as INT16 big-endian, 0.02 deg/count, bytes 16-27
      BT_Q=$AXIS_ACT.A1*50
      IF BT_Q<0 THEN
