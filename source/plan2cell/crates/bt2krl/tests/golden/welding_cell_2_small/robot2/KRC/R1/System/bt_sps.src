      BT_M_RESET=BT_C_RESET
   ;ENDFOLD
   ;FOLD NO FOLGE ACTIVE: STEP := 0, REQUEST := 0 (outputs persist after a cancel)
      IF NOT BT_RUN OR BT_ABRT THEN
