      ENDIF
      BT_JNT4=(BT_Q-(BT_Q B_AND 255))/256
      BT_JNT5=BT_Q B_AND 255
      BT_Q=$AXIS_ACT.A4*50
      IF BT_Q<0 THEN
         BT_Q=BT_Q+65536
      ENDIF
      BT_JNT6=(BT_Q-(BT_Q B_AND 255))/256
      BT_JNT7=BT_Q B_AND 255
      BT_Q=$AXIS_ACT.A5*50
      IF BT_Q<0 THEN
         BT_Q=BT_Q+65536
      ENDIF
      BT_JNT8=(BT_Q-(BT_Q B_AND 255))/256
      BT_JNT9=BT_Q B_AND 255
      BT_Q=$AXIS_ACT.A6*50
      IF BT_Q<0 THEN
         BT_Q=BT_Q+65536
      ENDIF
      BT_JNT10=(BT_Q-(BT_Q B_AND 255))/256
      BT_JNT11=BT_Q B_AND 255
   ;ENDFOLD
END