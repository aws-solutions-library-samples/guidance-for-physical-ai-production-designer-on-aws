      IF BT_RUN AND NOT BT_ABRT THEN
         IF BT_C_STOP OR BT_C_CANCEL OR NOT $PERI_RDY OR NOT $ALARM_STOP OR ($PRO_STATE1<>#P_ACTIVE) THEN
            BT_ABRT=TRUE
         ENDIF
      ENDIF
   ;ENDFOLD
   ;FOLD JOB HANDSHAKE
      IF BT_C_JOBREQ AND NOT BT_M_JOB AND BT_READY THEN
         BT_JOBNR=BT_JOB
         BT_PLANL=BT_PLANID
         BT_ACK=TRUE
         BT_FIN=FALSE
      ENDIF
      IF NOT BT_C_JOBREQ THEN
         BT_ACK=FALSE
      ENDIF
      BT_M_JOB=BT_C_JOBREQ
      IF BT_C_START AND NOT BT_M_START AND BT_READY AND (BT_JOBNR<>0) THEN
         BT_START=TRUE
      ENDIF
      BT_M_START=BT_C_START
   ;ENDFOLD
   ;FOLD RESET: edge clears the warning, held 500 ms clears the error
      IF BT_C_RESET THEN
