&ACCESS RVP
&REL 1
&COMMENT bt2krl sim job loop plan 16#F77E
DEF BT_CELL()
   ; Generated by bt2krl 0.1.0 from bt2plc plan bt_1790934549_welding_cell_2_small (cell welding_cell_2_small), PLAN_ID 16#F77E
   ; Robot robot2 (R2), controller robot2, model KR240R2900_ULTRA, joint mapping identity
   ; Profile sim (bt2plc simulator telegram). NEVER install on a VW KS24 robot:
   ; its signals collide with the VW standard (Fertigmeldung, interlocks, PRG_NR).
   ; Do not edit: regenerate with bt2krl (plain KRL, no inline forms).
   ; Started once in EXT mode ($EXT_START); every job runs inside this loop.
   ; bt_sps latches BT_START on a ProgStart edge while Ready (job number in BT_JOBNR).
   ;FOLD INI
      BT_RUN=FALSE
      BT_ABRT=FALSE
      INTERRUPT DECL 20 WHEN BT_ABRT DO BT_ABORT()
   ;ENDFOLD
   LOOP
      WAIT FOR BT_START
      BT_START=FALSE
      INTERRUPT ON 20
      SWITCH BT_JOBNR
         CASE 11
            FOLGE11()
         CASE 125
            FOLGE125()
         DEFAULT
            BT_ECODE=257
            BT_ERR=TRUE
      ENDSWITCH
      INTERRUPT OFF 20
      IF BT_ABRT THEN
         ; aborted (interrupt RESUME or an abort guard RETURN): never resume the cycle
         BT_STEP=0
         $OUT[225]=FALSE ; RELEASE IL01
         $OUT[226]=FALSE ; RELEASE IL02
         BT_FIN=FALSE
         BT_RUN=FALSE
         BT_ABRT=FALSE
      ENDIF
   ENDLOOP
END

DEF BT_ABORT()
   ; Stop/Cancel, drives off, E-stop or interpreter stop while a Folge runs:
   ; brake, STEP := 0, REQUEST := 0, ProgRunning off without ProgFinished, leave the Folge.
   BRAKE
   BT_STEP=0
   $OUT[225]=FALSE ; RELEASE IL01
   $OUT[226]=FALSE ; RELEASE IL02
   BT_FIN=FALSE
   BT_RUN=FALSE
   RESUME
END