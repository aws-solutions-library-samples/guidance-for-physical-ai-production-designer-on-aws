@@ -816,6 +816,15 @@ impl DesignTokens {
             .get_mut(&egui::FontFamily::Proportional)
             .unwrap()
             .insert(0, "Inter-Medium".into());
+        // Without egui's `default_fonts` (FactoryOS turns them off) monospace has no font at all:
+        // Inter then, until the host installs its own.
+        let monospace = font_definitions
+            .families
+            .entry(egui::FontFamily::Monospace)
+            .or_default();
+        if monospace.is_empty() {
+            monospace.push("Inter-Medium".into());
+        }
 
         ctx.set_fonts(font_definitions);
     }
