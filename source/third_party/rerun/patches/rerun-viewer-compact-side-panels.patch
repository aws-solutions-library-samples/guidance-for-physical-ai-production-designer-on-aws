+/// The host's sections filling the panel: all but the last at their default size (resizable),
+/// the last taking the rest.
+fn custom_panel_sections_fill_ui(ui: &mut egui::Ui, sections: &[crate::startup_options::CustomLeftPanelSection]) {
+    let panel_height = ui.available_height();
+    let visible: Vec<_> = sections
+        .iter()
+        .filter(|section| section.is_visible.as_ref().is_none_or(|is_visible| is_visible()))
+        .collect();
+    let Some((last, others)) = visible.split_last() else { return };
+    for section in others {
+        egui::Panel::top(section.id)
+            .frame(egui::Frame::new())
+            .resizable(true)
+            .min_size(60.0)
+            .max_size((ui.available_height() - 60.0).max(60.0))
             .default_size(panel_height * section.default_height_fraction)
             .show(ui, |ui| (section.ui)(ui));
     }
+    (last.ui)(ui);
 }
 
