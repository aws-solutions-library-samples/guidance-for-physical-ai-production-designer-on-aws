+/// Host-provided panes (see [`crate::StartupOptions::left_panel_sections`]), stacked at the top
+/// of a side panel, each resizable.
+fn custom_panel_sections_ui(ui: &mut egui::Ui, sections: &[crate::startup_options::CustomLeftPanelSection]) {
+    let panel_height = ui.available_height();
+    for section in sections {
+        if section.is_visible.as_ref().is_some_and(|is_visible| !is_visible()) {
+            continue;
+        }
+        let max_size = (ui.available_height() - 150.0).max(60.0);
+        egui::Panel::top(section.id)
+            .frame(egui::Frame::new())
+            .resizable(true)
+            .min_size(60.0)
+            .max_size(max_size)
+            .default_size(panel_height * section.default_height_fraction)
+            .show(ui, |ui| (section.ui)(ui));
+    }
+}
+
 pub fn default_blueprint_panel_width(screen_width: f32) -> f32 {
     (0.35 * screen_width).min(200.0).round()
 }
