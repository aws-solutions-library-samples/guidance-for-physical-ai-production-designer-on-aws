[Unit]
Description=factoryos-backend (wasm viewer + API + Zenoh over /zenoh on port 80)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/factoryos/current/bin/factoryos-backend

[Service]
User=factoryos
WorkingDirectory=/var/lib/factoryos
# The release is FACTORY_OS_HOME (bin/, web/, cells/, assets/); data and config live outside it, so
# a deploy never touches them.
Environment=FACTORY_OS_HOME=/opt/factoryos/current
# The workspace it serves (FACTORY_OS_WORKSPACE, from the instance's tags: factoryos-workspace
# configure) and the release it runs (FACTORY_OS_RELEASE, written by factoryos-deploy).
EnvironmentFile=-/etc/factoryos/workspace.env
EnvironmentFile=-/etc/factoryos/release.env
# A server connected to a plan2cell cell (a test server, or a workspace sharing it): the cell control
# Lambda (FACTORY_OS_CELL_CONTROL_FUNCTION, _REGION) and the backend's part in the cell
# (FACTORY_OS_CELL_ROLE=supervisor|operator, default supervisor: one per cell runs auto-restart;
# FACTORY_OS_CELL_SUPERVISOR, the supervisor's name an operator shows); infra/lib/test-server-stack.ts,
# plan2cell/infra/test-server/connect-cell.sh, factoryos-workspace connect-cell. Absent elsewhere. A workspace's
# own virtual cell adds FACTORY_OS_CELL_CONTROL_QUALIFIER=ws-<alias> (function factoryos-cell),
# FACTORY_OS_CELL_WIRE_DIR and FACTORY_OS_PLAN2CELL_CELL_CONFIG (the wiring the backend writes per launch).
EnvironmentFile=-/etc/factoryos/cell-control.env
# NICE DCV at /dcv/<target>/ through DCV Connection Gateways on this machine (FACTORY_OS_DCV_*: _GATEWAY,
# _TARGETS, _GATEWAY_IPS, _VERIFIER_PEERS; services/dcv.rs, plan2cell/infra/test-server/dcv-gateway.sh).
# Absent elsewhere.
EnvironmentFile=-/etc/factoryos/dcv.env
# Port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# Native Zenoh peers stay local; browsers use /zenoh on port 80.
ExecStart=/opt/factoryos/current/bin/factoryos-backend --bind 0.0.0.0:80 --web-root /opt/factoryos/current/web --config /var/lib/factoryos/factoryos.config.json --zenoh-listen tcp/127.0.0.1:7447
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
