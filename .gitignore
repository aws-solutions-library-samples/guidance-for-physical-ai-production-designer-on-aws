### This Guidance (source/ is the runnable tree; see source/.gitignore for the rest) ###
# Rust build output of the three workspaces
/source/target/
/source/cell/target/
/source/plan2cell/target/
# The web viewer's npm packages and build (scripts/build-web.sh)
/source/web/node_modules/
/source/web/dist/
# The Rerun checkout of scripts/fetch-rerun.sh; only PIN and patches/ are committed
/source/third_party/rerun/src/
# Products saved by a local backend (productsDir defaults to products/ next to the config file)
/source/products/
# The CDK app's synthesized output, packages and context cache (deployment/)
/deployment/node_modules/
/deployment/cdk.out/
/deployment/cdk.context.json
